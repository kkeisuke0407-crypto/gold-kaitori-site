---
type Props = {
  label: string;
  position: string;
  intentGroup: string;
  primaryKeyword: string;
  compact?: boolean;
  href?: string;
  sublabel?: string;
};

const { label, position, intentGroup, primaryKeyword, compact = false, href, sublabel } = Astro.props;
const isAffiliate = !href;
---
<a
  href={href || "#"}
  class:list={["shift-cta", compact && "shift-cta--compact", !isAffiliate && "shift-cta--inpage"]}
  data-affiliate={isAffiliate ? "manekiya" : undefined}
  data-inpage-cta={!isAffiliate ? "true" : undefined}
  data-cta-position={position}
  data-cta-text={label}
  data-intent-group={intentGroup}
  data-primary-keyword={primaryKeyword}
  rel={isAffiliate ? "nofollow sponsored" : undefined}
>
  <span>{label}</span>
  <small>{sublabel || (isAffiliate ? "まねきや公式の査定条件へ" : "このページ内の解説へ")}</small>
</a>
