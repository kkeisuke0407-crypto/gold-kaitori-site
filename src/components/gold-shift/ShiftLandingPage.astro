---
import type { GoldShiftPage } from "../../data/goldShiftPages";
import { GOLD_COMPARISON_UPDATED_AT } from "../../data/goldComparison";
import GoldComparison from "./GoldComparison.astro";
import ShiftCta from "./ShiftCta.astro";

type Props = { page: GoldShiftPage };
const { page } = Astro.props;
const canonical = `https://kaitori.hakobu-family.com/shift/${page.slug}/`;
const ogImage = `https://kaitori.hakobu-family.com${page.hero.backgroundImage}`;
const h1Lines = page.hero.h1.split("\n");
const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: page.faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: { "@type": "Answer", text: faq.answer }
  }))
};
const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: page.seoTitle,
  description: page.metaDescription,
  dateModified: GOLD_COMPARISON_UPDATED_AT,
  mainEntityOfPage: canonical,
  image: ogImage,
  author: { "@type": "Organization", name: "金買取査定ナビ" }
};
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{page.seoTitle}</title>
    <meta name="description" content={page.metaDescription} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="article" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:site_name" content="金買取査定ナビ" />
    <meta property="og:title" content={page.seoTitle} />
    <meta property="og:description" content={page.metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700;900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/shift/shift-lp.css?v=20260913-2" />
    <!-- 計測タグ（買取サイト共通のプロパティ）。GA4 → Clarity の順。page_view は shift-lp.js が属性付きで送る。 -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-DMCWVLP3E3"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){ dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', 'G-DMCWVLP3E3', { 'send_page_view': false });
      gtag('config', 'AW-18129603657');
    </script>
    <script is:inline>
      (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r); t.async=1; t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0]; y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", "wxnujpnscp");
    </script>
  </head>
  <body
    data-lp-slug={page.slug}
    data-intent-group={page.intentGroup}
    data-primary-keyword={page.primaryKeyword}
  >
    <header class="shift-site-header">
      <div class="shift-shell shift-site-header__inner">
        <a href="/" class="shift-brand" aria-label="金買取査定ナビ トップへ">
          <span class="shift-brand__mark" aria-hidden="true">価</span>
          <span class="shift-brand__text"><b>金買取査定ナビ</b><small>暮らしの整理・価値確認ガイド</small></span>
        </a>
        <div class="shift-header-meta"><span>PR</span><small>情報確認 2026.09.13</small></div>
      </div>
    </header>

    <main>
      <section class="shift-hero" id="top" style={`--hero-image: url('${page.hero.backgroundImage}')`}>
        <div class="shift-hero__shade" aria-hidden="true"></div>
        <div class="shift-shell shift-hero__inner">
          <div class="shift-hero__copy">
            <p class="shift-hero__eyebrow">{page.hero.eyebrow}</p>
            <h1>{h1Lines.map((line, index) => <>{line}{index < h1Lines.length - 1 && <br />}</>)}</h1>
            <p class="shift-hero__lead">{page.hero.lead}</p>
            <ShiftCta label={page.hero.ctaText} position="hero" intentGroup={page.intentGroup} primaryKeyword={page.primaryKeyword} href={page.hero.ctaAnchor} />
            <p class="shift-hero__micro">このボタンは記事内の解説へ移動します。売却を決める前に、まず確認できます。</p>
          </div>
        </div>
      </section>

      <nav class="shift-toc" aria-label="ページ内メニュー">
        <div class="shift-shell">
          <a href="#answer">まず結論</a>
          <a href="#howto">確認方法</a>
          <a href="#appraisal">判断の境界</a>
          <a href="#selection">選び方</a>
          <a href="#comparison">3社比較</a>
          <a href="#faq">FAQ</a>
        </div>
      </nav>

      <section class="shift-section shift-section--answer" id="answer" data-funnel-stage="quick_answer" aria-labelledby="answer-title">
        <div class="shift-shell shift-shell--reading">
          <div class="quick-answer">
            <p class="quick-answer__label">先に結論</p>
            <h2 id="answer-title">{page.quickAnswer.title}</h2>
            <p class="quick-answer__lead">{page.quickAnswer.answer}</p>
            <ul>{page.quickAnswer.points.map((point) => <li>{point}</li>)}</ul>
            <aside class="discovery-box" aria-label="確認前に知っておきたいこと">
              <p>ここがポイント</p>
              <h3>{page.quickAnswer.discovery.title}</h3>
              <span>{page.quickAnswer.discovery.text}</span>
            </aside>
          </div>
        </div>
      </section>

      <div id="howto">
        {page.sections.map((section, sectionIndex) => (
          <section class:list={["shift-section", sectionIndex % 2 === 1 && "shift-section--tint"]} aria-labelledby={`section-${sectionIndex}-title`}>
            <div class="shift-shell shift-shell--reading">
              <header class="shift-heading">
                <p class="shift-kicker">{section.eyebrow}</p>
                <h2 id={`section-${sectionIndex}-title`}>{section.title}</h2>
              </header>
              <div class="shift-prose">{section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}</div>

              {section.checklist && (
                <ul class="check-grid">{section.checklist.map((item) => <li><span aria-hidden="true">✓</span>{item}</li>)}</ul>
              )}

              {section.steps && (
                <ol class="step-grid">
                  {section.steps.map((step, index) => <li><b>{String(index + 1).padStart(2, "0")}</b><div><h3>{step.title}</h3><p>{step.text}</p></div></li>)}
                </ol>
              )}

              {section.table && (
                <div class="article-table-wrap" role="region" aria-label={`${section.title}の表`} tabindex="0">
                  <table class="article-table">
                    <thead><tr>{section.table.headers.map((header) => <th>{header}</th>)}</tr></thead>
                    <tbody>{section.table.rows.map((row) => <tr>{row.map((cell) => <td>{cell}</td>)}</tr>)}</tbody>
                  </table>
                </div>
              )}

              {section.warning && (
                <aside class="warning-box"><b>{section.warning.title}</b><p>{section.warning.text}</p></aside>
              )}
            </div>
          </section>
        ))}
      </div>

      <section class="shift-section shift-section--bridge" id="appraisal" data-funnel-stage="bridge" aria-labelledby="bridge-title">
        <div class="shift-shell shift-shell--reading">
          <header class="shift-heading shift-heading--center">
            <p class="shift-kicker">ここから価値確認へ</p>
            <h2 id="bridge-title">{page.bridge.title}</h2>
            <p>{page.bridge.lead}</p>
          </header>
          <div class="bridge-flow" aria-label="確認から査定までの流れ">
            <span>自分で確認</span><i aria-hidden="true">→</i><span>判断しにくい</span><i aria-hidden="true">→</i><span>処分しない</span><i aria-hidden="true">→</i><span>専門査定</span><i aria-hidden="true">→</i><span>3社比較</span>
          </div>
          <div class="bridge-columns">
            <article><h3>自分でできる範囲</h3><ul>{page.bridge.selfCheck.map((item) => <li>{item}</li>)}</ul></article>
            <article><h3>専門確認が向くケース</h3><ul>{page.bridge.hardToJudge.map((item) => <li>{item}</li>)}</ul></article>
          </div>
          <ShiftCta label={page.ctaLabels.bridge} position="bridge" intentGroup={page.intentGroup} primaryKeyword={page.primaryKeyword} />
        </div>
      </section>

      <section class="shift-section shift-section--criteria" id="selection" aria-labelledby="selection-title">
        <div class="shift-shell shift-shell--reading">
          <header class="shift-heading">
            <p class="shift-kicker">比較する前に</p>
            <h2 id="selection-title">{page.selectionGuide.title}</h2>
            <p>{page.selectionGuide.lead}</p>
          </header>
          <ol class="criteria-grid">
            {page.selectionGuide.points.map((point, index) => <li><b>{index + 1}</b><span>{point}</span></li>)}
          </ol>
          <p class="criteria-conclusion">{page.selectionGuide.conclusion}</p>
          <ShiftCta label="この条件で3社を比較する" position="selection" intentGroup={page.intentGroup} primaryKeyword={page.primaryKeyword} href="#comparison" sublabel="このページ内の比較表へ" compact />
        </div>
      </section>

      <GoldComparison intentGroup={page.intentGroup} primaryKeyword={page.primaryKeyword} ctaLabel={page.ctaLabels.comparison} />

      <section class="shift-section shift-section--manekiya" id="manekiya" data-funnel-stage="manekiya" aria-labelledby="manekiya-title">
        <div class="shift-shell">
          <div class="manekiya-card">
            <div class="manekiya-card__intro">
              <p class="shift-kicker">1位の確認先</p>
              <h2 id="manekiya-title">まねきやで、まず対象品と査定方法を確認</h2>
              <p>{page.manekiyaIntro}</p>
              <div class="manekiya-reason"><b>このページで1位にした理由</b><p>{page.manekiyaReason}</p></div>
              <ShiftCta label={page.ctaLabels.manekiya} position="manekiya_detail" intentGroup={page.intentGroup} primaryKeyword={page.primaryKeyword} />
            </div>
            <div class="manekiya-card__facts">
              <article><span>01</span><h3>取扱カテゴリ</h3><p>金・貴金属、プラチナ、宝石、ブランド品などを公式掲載。</p></article>
              <article><span>02</span><h3>選べる方法</h3><p>店頭・出張・宅配の3つから、品数や持ち運びに合わせて確認。</p></article>
              <article><span>03</span><h3>当日の相場</h3><p>公式サイトで貴金属相場を確認。実際の査定額とは分けて考えます。</p></article>
              <article><span>04</span><h3>申込前の確認</h3><p>対象品、店舗、費用、キャンセルなど最新条件を公式で確認。</p></article>
            </div>
          </div>
        </div>
      </section>

      <section class="shift-section shift-section--faq" id="faq" aria-labelledby="faq-title">
        <div class="shift-shell shift-shell--reading">
          <header class="shift-heading shift-heading--center"><p class="shift-kicker">よくある質問</p><h2 id="faq-title">迷いやすい点を確認</h2></header>
          <div class="faq-list">
            {page.faqs.map((faq, index) => <details open={index === 0}><summary>{faq.question}</summary><p>{faq.answer}</p></details>)}
          </div>
        </div>
      </section>

      <section class="shift-section shift-section--sources" id="sources" aria-labelledby="sources-title">
        <div class="shift-shell shift-shell--reading">
          <header class="shift-heading"><p class="shift-kicker">根拠を確認</p><h2 id="sources-title">参照した一次・公式情報</h2><p>各リンクは2026年9月13日に確認しました。制度・条件は変更されるため、判断時に再確認してください。</p></header>
          <ol class="source-list">
            {page.sources.map((source) => <li><a href={source.url} target="_blank" rel="nofollow noopener">{source.label}</a><span>{source.publisher} / {source.kind} / 確認日 {source.checkedAt}</span></li>)}
            <li><a href="https://manekiya.shop/" target="_blank" rel="nofollow noopener">まねきや公式</a><span>まねきや / 公式情報 / 確認日 2026-09-13</span></li>
            <li><a href="https://www.otakaraya.jp/visiting/" target="_blank" rel="nofollow noopener">おたからや 出張査定買取</a><span>おたからや / 公式情報 / 確認日 2026-09-13</span></li>
            <li><a href="https://brandrevalue.com/service/" target="_blank" rel="nofollow noopener">ブラリバ サービスについて</a><span>ブラリバ / 公式情報 / 確認日 2026-09-13</span></li>
          </ol>
        </div>
      </section>

      <section class="shift-final" aria-labelledby="final-title">
        <div class="shift-shell shift-shell--reading">
          <p>処分・売却を急がないために</p>
          <h2 id="final-title">まず価値を確認してから、残すか決める</h2>
          <span>査定額と条件を見て、残す・譲る・手放すを選べます。</span>
          <ShiftCta label={page.ctaLabels.final} position="final" intentGroup={page.intentGroup} primaryKeyword={page.primaryKeyword} />
        </div>
      </section>
    </main>

    <footer class="shift-footer">
      <div class="shift-shell">
        <p>当ページは広告（PR）を含みます。掲載順位は当サイトの編集方針によるもので、買取価格・査定結果・キャンペーン適用を保証しません。相続・税務・金融機関・介護施設の個別判断は、それぞれの公式窓口または専門家へご確認ください。</p>
        <nav aria-label="運営情報"><a href="/privacy/">プライバシーポリシー</a><a href="/disclosure/">広告掲載について</a><a href="/operator/">運営者情報</a></nav>
      </div>
    </footer>

    <aside class="shift-sticky" data-sticky hidden aria-label="まねきや査定へのショートカット">
      <a href="#" data-affiliate="manekiya" data-cta-position="sticky" data-cta-text={page.ctaLabels.sticky} data-intent-group={page.intentGroup} data-primary-keyword={page.primaryKeyword} rel="nofollow sponsored"><span>{page.ctaLabels.sticky}</span><small>まねきや公式へ</small></a>
    </aside>
    <script src="/shift/shift-lp.js?v=20260913-2" defer></script>
  </body>
</html>
