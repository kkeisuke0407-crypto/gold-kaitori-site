---
import ShiftCta from "./ShiftCta.astro";
import {
  goldComparisonCompanies,
  goldComparisonPolicy,
  GOLD_COMPARISON_UPDATED_AT
} from "../../data/goldComparison";

type Props = {
  intentGroup: string;
  primaryKeyword: string;
  ctaLabel: string;
};

const { intentGroup, primaryKeyword, ctaLabel } = Astro.props;
---
<section class="shift-section shift-section--comparison" id="comparison" data-funnel-stage="comparison" aria-labelledby="comparison-title">
  <div class="shift-shell">
    <header class="shift-heading shift-heading--center">
      <p class="shift-kicker">査定先を比べる</p>
      <h2 id="comparison-title">この条件で比べた3社</h2>
      <p>直前の選び方に沿って、品物との相性・査定方法・申込条件を比べます。価格の高さを保証する順位ではありません。</p>
    </header>

    <div class="comparison-cards">
      {goldComparisonCompanies.map((company) => (
        <article class:list={["comparison-card", company.rank === 1 && "comparison-card--primary"]}>
          <div class="comparison-card__rank"><b>{company.rank}</b><span>位</span></div>
          <div class="comparison-card__head">
            <p>{company.label}</p>
            <h3>{company.name} <small>PR</small></h3>
          </div>
          <dl>
            <div><dt>向いている方</dt><dd>{company.bestFor}</dd></div>
            <div><dt>査定・買取方法</dt><dd>{company.methods}</dd></div>
            <div><dt>主な対象</dt><dd>{company.categories}</dd></div>
            <div><dt>比較ポイント</dt><dd>{company.decisionPoint}</dd></div>
          </dl>
          <p class="comparison-card__caution">{company.caution}</p>
          {company.affiliate ? (
            <ShiftCta label={ctaLabel} position="comparison" intentGroup={intentGroup} primaryKeyword={primaryKeyword} compact />
          ) : (
            <a class="official-link" href={company.href} target="_blank" rel="nofollow sponsored noopener" data-company={company.id} data-cta-position="comparison_official">
              {company.name}公式を確認
            </a>
          )}
        </article>
      ))}
    </div>

    <div class="comparison-table-wrap" role="region" aria-label="買取3社の比較表" tabindex="0">
      <table class="comparison-table">
        <thead>
          <tr>
            <th>比較項目</th>
            {goldComparisonCompanies.map((company) => <th class:list={[company.rank === 1 && "is-primary"]}>{company.rank}位<br />{company.name}</th>)}
          </tr>
        </thead>
        <tbody>
          <tr><th>向く状況</th>{goldComparisonCompanies.map((company) => <td class:list={[company.rank === 1 && "is-primary"]}>{company.label}</td>)}</tr>
          <tr><th>方法</th>{goldComparisonCompanies.map((company) => <td class:list={[company.rank === 1 && "is-primary"]}>{company.methods}</td>)}</tr>
          <tr><th>判断材料</th>{goldComparisonCompanies.map((company) => <td class:list={[company.rank === 1 && "is-primary"]}>{company.decisionPoint}</td>)}</tr>
        </tbody>
      </table>
    </div>

    <div class="comparison-policy">
      <p><b>情報確認日</b> {GOLD_COMPARISON_UPDATED_AT}</p>
      <ul>{goldComparisonPolicy.map((item) => <li>{item}</li>)}</ul>
    </div>
  </div>
</section>
