---
const PAGE_TITLE = "結婚指輪は売れる？｜名前入り・刻印・片方だけOK 高額買取おすすめTOP3";
const PAGE_DESC = "結婚指輪を売っていいか迷う方へ。名前入り・イニシャル・離婚した指輪・片方だけ・古い指輪でも“査定対象”になるケースが多いです。本日のプラチナ相場と参考買取額、おすすめ買取店をやさしく解説。査定は無料・売るかは後で決められます。";
const CANONICAL = "https://kaitori.hakobu-family.com/LP4/";
const OGP_IMAGE = "https://kaitori.hakobu-family.com/images/item-platinum-ring.webp";

import { getRates, yen, MARKET_SOURCE_URL } from "../../lib/rates.js";
const rates = await getRates();
const ringEx = (w) => `約${Math.round(rates.pt900 * w * 0.85).toLocaleString("ja-JP")}〜${Math.round(rates.pt900 * w).toLocaleString("ja-JP")}円`;
// キャンペーン残日数（まねきや 6/30まで）
const campEnd = new Date('2026-06-30T23:59:59+09:00');
const today   = new Date(new Date().toLocaleString('en-US',{timeZone:'Asia/Tokyo'}));
const campDays = Math.max(0, Math.ceil((campEnd - today) / 86400000));

const faqJsonLd = {
  "@context": "https://schema.org", "@type": "FAQPage",
  "mainEntity": [
    ["結婚指輪を売るのは問題ないですか？", "まったく問題ありません。買い替えやライフステージの変化、整理のために結婚指輪を手放す方はとても多くいます。まずは金額を知るだけでも大丈夫です。"],
    ["離婚した指輪を売る人は多いですか？", "多いです。気持ちの区切りとして査定に出す方は珍しくありません。名前入り・片方だけでも査定対象になります。"],
    ["名前（イニシャル）入りでも売れますか？", "売れます。名前や日付の刻印があっても、プラチナの価値は変わりません。刻印は地金に溶かす工程で残らないため、情報が残る心配もありません。"],
    ["片方だけでも売れますか？", "売れます。片方だけ・ペアの一方だけでも、地金として重さで査定されます。"],
    ["婚約指輪も売れますか？", "売れます。婚約指輪はプラチナ等の地金に加え、ダイヤなどの宝石も合わせて評価してもらえることがあります。"],
    ["保証書・鑑定書がなくても売れますか？", "なくても査定・買取できます。あれば査定がスムーズになることがありますが、必須ではありません。"],
    ["査定後に断れますか？", "断れます。多くのお店で、金額に納得できなければ無料でキャンセルできます。売るかは金額を見てから決められます。"]
  ].map(([q, a]) => ({ "@type": "Question", "name": q, "acceptedAnswer": { "@type": "Answer", "text": a } }))
};

// アフィリエイトリンク（manekiya / otakaraya は実リンク、buraibaは要設定）
const AFF_MANEKIYA = "https://ad-fam.com/ad/p/r?_site=49248&_article=16522";
const AFF_OTAKARAYA = "https://lp.otakaraya.jp/lp-gold-a/";
---
<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{PAGE_TITLE}</title>
  <meta name="description" content={PAGE_DESC} />
  <link rel="canonical" href={CANONICAL} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={PAGE_TITLE} />
  <meta property="og:description" content={PAGE_DESC} />
  <meta property="og:url" content={CANONICAL} />
  <meta property="og:image" content={OGP_IMAGE} />
  <meta property="og:locale" content="ja_JP" />
  <meta name="twitter:card" content="summary_large_image" />
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700;900&display=swap" onload="this.onload=null;this.rel='stylesheet'" />
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700;900&display=swap" /></noscript>
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-DMCWVLP3E3"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){ dataLayer.push(arguments); }
    gtag('js', new Date()); gtag('config', 'G-DMCWVLP3E3'); gtag('config', 'AW-18129603657');
  </script>
  <script is:inline>
    (function(c,l,a,r,i,t,y){ c[a]=c[a]||function(){ (c[a].q=c[a].q||[]).push(arguments); };
      t=l.createElement(r); t.async=1; t.src="https://www.clarity.ms/tag/"+i;
      y=l.getElementsByTagName(r)[0]; y.parentNode.insertBefore(t,y);
    })(window, document, "clarity", "script", "wxnujpnscp");
  </script>
</head>
<body data-landing-intent="lp4"
  data-aff-manekiya={AFF_MANEKIYA} data-aff-otakaraya={AFF_OTAKARAYA} data-aff-buraiba="https://brandrevalue.com/">

  <main>
    <!-- 01 FV -->
    <section class="fv">
      <div class="wrap">
        <!-- ヒーロー画像 -->
        <h1 class="fv-hero-wrap">
          <img src="/images/fv-hero-pt2.webp" alt="結婚指輪は売れる？名前入り・刻印・片方だけでも査定対象｜高額買取おすすめTOP3｜まねきや・おたからや・ブラリバ" width="1536" height="1024" loading="eager" fetchpriority="high" decoding="async" class="fv-hero-img" />
        </h1>

        <!-- 信頼ストリップ -->
        <ul class="trust-strip">
          <li><b>★4.8</b><span>Google口コミ</span></li>
          <li><b>120万点</b><span>査定実績</span></li>
          <li><b>0円</b><span>査定・出張・<br />キャンセル料</span></li>
          <li><b>OK</b><span>他店で<br />断られた品も</span></li>
        </ul>

        <!-- 結論ボックス（結婚指輪向け） -->
        <div class="fv-conc">
          <p class="fv-conc-ttl">結婚指輪は売れる？</p>
          <p class="fv-conc-sub">刻印入り・名前入り・片方だけでも“査定対象”になります</p>
          <ul>
            <li>高額買取<b>おすすめTOP3</b>を比較</li>
            <li>電話申込で買取金額<b>最大30%UP</b></li>
            <li>名前入り・刻印・片方だけ・婚約指輪もOK</li>
            <li><b>査定だけでもOK</b>／売るかは金額を見てから</li>
          </ul>
          <div class="cta-pair">
            <a href="#" class="btn btn-phone" data-aff="manekiya" data-track="fv_conc_phone" rel="nofollow sponsored"><i>☎</i>電話で無料査定する</a>
            <a href="#" class="btn btn-web" data-aff="manekiya" data-track="fv_conc_web" rel="nofollow sponsored">WEBで査定する</a>
          </div>
        </div>

        <!-- ④ キャンペーンバナー（電話申込限定 最大30%UP・手数料完全無料）ポコポコ＋キラキラ -->
        <div class="fv-banner">
          {campDays > 0 ? (
            <a href="#" class="fv-banner-link" data-aff="manekiya" data-track="camp_fv" rel="nofollow sponsored">
              <img src="/images/fv-camp30.webp" alt="6/1〜6/30 期間限定 まねきや お電話申込の方限定 買取金額 最大30%UP・買取手数料完全無料 今すぐ電話で申し込む" width="1536" height="1024" loading="eager" decoding="async" />
            </a>
          ) : (
            <a href="#" class="camp2-cta" data-aff="manekiya" data-track="camp_fv_cta" rel="nofollow sponsored">
              <i>☎</i>電話で無料査定する
            </a>
          )}
        </div>

        <div class="cta-pair">
          <a href="#" class="btn btn-phone" data-aff="manekiya" data-track="fv_phone" rel="nofollow sponsored"><i>☎</i>電話で無料査定する</a>
          <a href="#" class="btn btn-web" data-aff="manekiya" data-track="fv_web" rel="nofollow sponsored">WEBで無料査定</a>
        </div>
        <p class="cta-note">無料・出張＆宅配OK・査定後に売らなくても大丈夫</p>
      </div>
    </section>

    <!-- 02 共感セクション -->
    <section class="sec sec-cream" id="empathy">
      <div class="wrap">
        <div class="sec-head"><span class="chip">😟 売る前の不安</span><h2>結婚指輪を売る前に、<br />こんな不安ありませんか？</h2></div>
        <ul class="fear-list">
          <li><b>名前が入っている</b></li>
          <li><b>イニシャルが入っている</b></li>
          <li><b>離婚して使わなくなった</b></li>
          <li><b>片方しか残っていない</b></li>
          <li><b>傷だらけになっている</b></li>
          <li><b>20年以上前の指輪</b></li>
          <li><b>そもそも、本当に売っていいのか迷う</b></li>
        </ul>
      </div>
    </section>

    <!-- 03 回答セクション -->
    <section class="sec" id="answer">
      <div class="wrap">
        <div class="sec-head"><span class="chip">✅ 結論</span><h2>実は結婚指輪は<br />“査定対象になる”ことが多いです</h2></div>
        <div class="answer-box">
          <p class="answer-lead">結婚指輪は<b>デザイン</b>ではなく、<b>プラチナや金などの素材の価値</b>を中心に査定されます。</p>
          <p>そのため、次のような指輪でも査定対象になることがあります。</p>
          <ul class="answer-list">
            <li>名前・イニシャル入り</li>
            <li>傷あり・変形</li>
            <li>片方だけ</li>
            <li>古いデザイン</li>
          </ul>
          <p class="answer-note">🔒 名前や刻印は、地金に溶かす工程で残りません。個人情報が残る心配はありません。</p>
        </div>
        <a href="#" class="camp2-cta" data-aff="manekiya" data-track="answer_phone" rel="nofollow sponsored">
          <i>☎</i>売れる？を電話で聞いてみる
        </a>
        <p class="point-cta-note">9時〜21時（年中無休）／査定だけ・相談だけでもOK</p>
      </div>
    </section>

    <!-- 04 相場セクション（結婚指輪向け参考価格） -->
    <section class="sec sec-mint" id="rate">
      <div class="wrap">
        <div class="sec-head"><span class="chip">💎 相場</span><h2>本日のプラチナ買取相場</h2><p>結婚指輪はPt900が定番。重さ×単価がおおよその目安です。</p></div>
        <div class="rate-grid">
          <div><span>Pt1000</span><b>{yen(rates.pt1000)}</b><small>/g</small></div>
          <div><span>Pt950</span><b>{yen(rates.pt950)}</b><small>/g</small></div>
          <div class="rate-hot"><span>Pt900</span><b>{yen(rates.pt900)}</b><small>/g</small></div>
          <div><span>Pt850</span><b>{yen(rates.pt850)}</b><small>/g</small></div>
        </div>
        <p class="rate-updated">{rates.updatedAt}・出典：まねきや本日相場 ／ 📈 歴史的な高値圏</p>

        <div class="rate-ex">
          <h3>結婚指輪の参考買取額（Pt900の場合）</h3>
          <ul>
            <li><span>結婚指輪 1本（約3g）</span><b>{ringEx(3)}</b></li>
            <li><span>結婚指輪 ペア（2本・約6g）</span><b>{ringEx(6)}</b></li>
            <li><span>ペア＋婚約指輪（約10g）</span><b>{ringEx(10)}</b></li>
          </ul>
          <p class="note">※地金だけのおおよその目安。婚約指輪の宝石（ダイヤ等）は別途プラス評価。重量・状態で変わります。</p>
        </div>
        <a href="#" class="camp2-cta" data-aff="manekiya" data-track="rate_phone" rel="nofollow sponsored">
          <i>☎</i>今の金額を電話で確認する
        </a>
        <p class="point-cta-note">電話申込で買取金額 最大30%UP／査定だけ・相談だけでもOK</p>
      </div>
    </section>

    <!-- 05 比較表（ここで初めて3社） -->
    <section class="sec" id="ranking">
      <div class="wrap">
        <div class="sec-head"><span class="chip">🏆 比較</span><h2>結婚指輪 高額買取おすすめTOP3</h2><p>編集部がおすすめする3社を比較しました。</p></div>
        <div class="fv-tbl-head"><span class="fv-tbl-ttl">結婚指輪 買取 3社比較</span><i class="pr">PR</i></div>
        <div class="fv-tbl-wrap">
          <table class="fv-tbl">
            <thead>
              <tr>
                <th class="fv-th-item"></th>
                <th class="fv-th fv-th1 fv-th-gold"><span class="fv-rk-badge">👑 1位</span>まねきや<br /><a href="#" data-aff="manekiya" data-track="fv_tbl_bn_manekiya" rel="nofollow sponsored" style="display:block;"><img src="/images/manekiya_bn.png" alt="まねきや" style="width:100%;max-width:110px;height:auto;display:block;margin:4px auto 0;border-radius:4px;" loading="lazy" /></a></th>
                <th class="fv-th"><span class="fv-rk-badge2">🥈 2位</span>おたからや<br /><a href="#" data-aff="otakaraya" data-track="fv_tbl_bn_otakaraya" rel="nofollow sponsored" style="display:block;"><img src="/images/300_250-2.jpg" alt="おたからや" style="width:100%;max-width:110px;height:auto;display:block;margin:4px auto 0;border-radius:4px;" loading="lazy" /></a></th>
                <th class="fv-th"><span class="fv-rk-badge3">🥉 3位</span>ブラリバ<br /><a href="#" data-aff="buraiba" data-track="fv_tbl_bn_buraiba" rel="nofollow sponsored" style="display:block;"><img src="/images/300_250-3.jpg" alt="ブラリバ" style="width:100%;max-width:110px;height:auto;display:block;margin:4px auto 0;border-radius:4px;" loading="lazy" /></a></th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td class="fv-td-item">買取価格</td>
                <td class="fv-td fv-td1"><span class="mk good">◎</span><b>高価買取に強み<br />（編集部評価）</b></td>
                <td class="fv-td"><span class="mk ok">〇</span>高め</td>
                <td class="fv-td"><span class="mk ok">〇</span>高め</td>
              </tr>
              <tr>
                <td class="fv-td-item">手数料</td>
                <td class="fv-td fv-td1"><span class="mk good">◎</span><b>0円（完全無料）</b></td>
                <td class="fv-td"><span class="mk ok">〇</span>0円</td>
                <td class="fv-td"><span class="mk ok">〇</span>0円</td>
              </tr>
              <tr class="fv-tr-camp">
                <td class="fv-td-item">当サイト限定<br />キャンペーン</td>
                <td class="fv-td fv-td1">
                  {campDays > 0 ? (
                    <>
                      <span class="camp-badge">手数料10%無料</span><br />
                      <b class="up30">買取金額<br />最大<em>30%</em>UP</b>
                    </>
                  ) : (
                    <b>公式キャンペーン<br />要確認</b>
                  )}
                </td>
                <td class="fv-td"><span class="mk ok">〇</span><b>買取価格<br />最大20%UP</b></td>
                <td class="fv-td gray"><span class="mk bad">✕</span>なし</td>
              </tr>
              <tr>
                <td class="fv-td-item">結婚指輪<br />対応</td>
                <td class="fv-td fv-td1"><span class="mk good">◎</span>刻印・名前入り<br />片方だけもOK</td>
                <td class="fv-td"><span class="mk good">◎</span>結婚指輪<br />対応</td>
                <td class="fv-td"><span class="mk ok">〇</span>宝石付き中心</td>
              </tr>
              <tr>
                <td class="fv-td-item">査定方法</td>
                <td class="fv-td fv-td1"><span class="mk good">◎</span>店舗・宅配<br />・出張</td>
                <td class="fv-td"><span class="mk ok">〇</span>店舗・出張</td>
                <td class="fv-td"><span class="mk good">◎</span>店舗・宅配<br />・出張</td>
              </tr>
              <tr class="fv-tr-cta">
                <td class="fv-td-item">電話相談</td>
                <td class="fv-td fv-td1">
                  <small class="cta-sub">＼査定だけでもOK／</small>
                  <a href="#" class="btn btn-phone sm" data-aff="manekiya" data-track="fv_tbl_phone" rel="nofollow sponsored"><i>☎</i>30%UP条件を聞く</a>
                  <a href="#" class="btn btn-web sm mt4" data-aff="manekiya" data-track="fv_tbl_web" rel="nofollow sponsored">WEBで査定</a>
                  {campDays > 0 && <p class="countdown">⏳ キャンペーン終了まで<br /><b>あと{campDays}日！</b></p>}
                </td>
                <td class="fv-td">
                  <a href="#" class="btn btn-ghost sm" data-aff="otakaraya" data-track="fv_tbl_otakaraya" rel="nofollow sponsored">公式サイト</a>
                </td>
                <td class="fv-td">
                  <a href="#" class="btn btn-ghost sm" data-aff="buraiba" data-track="fv_tbl_buraiba" rel="nofollow sponsored">公式サイト</a>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
        <p class="note">※買取価格・キャンペーン内容は変更になる場合があります。最新情報は各社公式でご確認ください。</p>
      </div>
    </section>

    <!-- 06 1位深掘り -->
    <section class="sec sec-mint" id="deep">
      <div class="wrap">
        <div class="sec-head"><span class="chip">👑 1位くわしく</span><h2>なぜ「まねきや」が1位なの？</h2></div>
        <div class="deep">
          <div class="deep-rings">
            <p class="deep-rings-ttl">💍 こんな結婚指輪も“対応できる指輪”です</p>
            <ul>
              <li>結婚指輪</li><li>婚約指輪</li><li>刻印・名前入り</li><li>片方だけ</li><li>金とのコンビ</li>
            </ul>
          </div>
          <ul class="deep-merit">
            <li><b>手数料0円</b>で、提示された金額をそのまま受け取りやすい</li>
            <li><b>X線の機械</b>で、刻印がない指輪・古い指輪も正確に調べてくれる</li>
            <li>海外にも売り先を持っていて、高めの金額が出やすい</li>
            <li>名前入り・離婚した指輪・20年以上前の指輪もまず相談OK</li>
          </ul>
          <div class="flow">
            <h3>査定のかんたんな流れ</h3>
            <ol>
              <li><b>申し込み</b><span>WEB（1分ほど）か電話で予約</span></li>
              <li><b>査定</b><span>店頭・出張・宅配から選べる</span></li>
              <li><b>金額を確認</b><span>納得したら、その場で現金</span></li>
            </ol>
            <p class="flow-fee">査定料・出張料・キャンセル料はすべて<b>0円</b>。売るかは金額を見てから決められます。</p>
          </div>
        </div>
        <div class="cta-pair">
          <a href="#" class="btn btn-phone" data-aff="manekiya" data-track="deep_phone" rel="nofollow sponsored"><i>☎</i>電話で無料査定</a>
          <a href="#" class="btn btn-web" data-aff="manekiya" data-track="deep_web" rel="nofollow sponsored">ネットで無料査定（最短30秒）</a>
        </div>
      </div>
    </section>

    <!-- 07 口コミ（結婚指輪を売った人の声） -->
    <section class="sec sec-cream" id="voice">
      <div class="wrap">
        <div class="sec-head"><span class="chip">💬 口コミ</span><h2>結婚指輪を売った方の声</h2></div>
        <div class="rk-voice-list">
          <div class="voice voice-lg">
            <span class="stars">★★★★★</span>
            <b class="voice-ttl">結婚指輪を売りました。手数料0円で安心でした。</b>
            <p>離婚をきっかけに、ずっとしまっていた結婚指輪を思い切って査定に。名前の刻印が入っていて不安でしたが問題なく査定対象で、手数料0円。思ったより高くて、気持ちの整理もつきました。</p>
            <small>50代・女性／Pt900 結婚指輪</small>
          </div>
          <div class="voice voice-lg">
            <span class="stars">★★★★★</span>
            <b class="voice-ttl">片方だけ・傷ありでも査定してもらえました。</b>
            <p>片方をなくしてしまった結婚指輪と、傷だらけの指輪をまとめて。「片方だけでも大丈夫ですよ」と言ってもらえて安心。丁寧に説明してくれて、納得して売れました。</p>
            <small>40代・女性／Pt900 結婚指輪（片方）</small>
