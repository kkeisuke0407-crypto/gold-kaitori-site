---
const PAGE_TITLE = "プラチナ指輪はいくら？Pt900・Pt950の買取価格を今すぐ確認｜金買取査定ナビ";
const PAGE_DESC = "Pt900・Pt950・Pt850のプラチナ指輪が今いくらになるか、当日の買取単価と概算計算で確認。手数料0円・提示額がそのまま手取りの相談先を、目的別に整理しました。結婚指輪や古い指輪もまず査定額を確認。";
const CANONICAL = "https://kaitori.hakobu-family.com/platinum/";
const OGP_IMAGE = "https://kaitori.hakobu-family.com/images/item-platinum-ring.webp";

import { getRates, yen, MARKET_SOURCE_URL } from "../../lib/rates.js";
const rates = await getRates();
// Pt950はPt1000とPt900の中間として概算（実額は査定時に確定）
const pt950 = rates.pt950;
// FVの代表例：Pt900の指輪 約4g
const sampleWeight = 4;
const sampleLow = Math.round(rates.pt900 * sampleWeight * 0.9);
const sampleHigh = rates.pt900 * sampleWeight;

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Pt900のプラチナ指輪はいくらで売れますか？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "当日のPt900買取単価×重さ（グラム）が目安です。例えばPt900の指輪が約4gなら、当日の単価で概算が出せます。実際の金額は刻印・重量・宝石やデザインの有無・査定日で変わるため、査定時に確認してください。"
      }
    },
    {
      "@type": "Question",
      "name": "手数料はかかりますか？提示額から引かれませんか？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "「手数料無料」と書かれていても、グラム単価を下げて実質的に差し引く店もあります。大切なのは手数料の有無より、提示額がそのまま手取りになるか・出張料やキャンセル料などの後出し費用がないかを、申し込み前に確認することです。"
      }
    },
    {
      "@type": "Question",
      "name": "結婚指輪や古いプラチナ指輪、刻印が薄い品も査定できますか？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "結婚指輪、金とのコンビ、刻印が薄い・読めない指輪も、プラチナとして査定対象になる場合があります。自分で価値を決めて処分する前に、まず査定額を確認してください。"
      }
    },
    {
      "@type": "Question",
      "name": "査定後に売らない選択はできますか？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "売却するかは査定額と費用を見てから決められます。申し込む前に、キャンセル時費用・返送料・出張料を確認しておくと安心です。"
      }
    },
    {
      "@type": "Question",
      "name": "このページは買取店の公式サイトですか？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "いいえ。当サイトは買取店の公式サイトではなく、広告（PR）を含む比較・案内ページです。最新の価格・条件はリンク先の公式ページで確認してください。"
      }
    }
  ]
};
---
<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{PAGE_TITLE}</title>
  <meta name="description" content={PAGE_DESC} />
  <link rel="canonical" href={CANONICAL} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={PAGE_TITLE} />
  <meta property="og:description" content={PAGE_DESC} />
  <meta property="og:url" content={CANONICAL} />
  <meta property="og:image" content={OGP_IMAGE} />
  <meta property="og:locale" content="ja_JP" />
  <meta property="og:site_name" content="金買取査定ナビ" />
  <meta name="twitter:card" content="summary_large_image" />
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700;900&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/styles.css?v=20260531-2" />
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-DMCWVLP3E3"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){ dataLayer.push(arguments); }
    gtag('js', new Date());
    gtag('config', 'G-DMCWVLP3E3');
    gtag('config', 'AW-18129603657');
  </script>
  <script is:inline>
    (function(c,l,a,r,i,t,y){
      c[a]=c[a]||function(){ (c[a].q=c[a].q||[]).push(arguments); };
      t=l.createElement(r); t.async=1; t.src="https://www.clarity.ms/tag/"+i;
      y=l.getElementsByTagName(r)[0]; y.parentNode.insertBefore(t,y);
    })(window, document, "clarity", "script", "wxnujpnscp");
  </script>
</head>
<body data-landing-intent="platinum">
  <header class="site-header">
    <div class="container header-inner">
      <a href="/platinum/" class="brand" aria-label="金買取査定ナビ">
        <span class="brand-mark">Pt</span>
        <span class="brand-text">プラチナ指輪の査定額ナビ</span>
      </a>
      <span class="pr-chip header-pr">PR</span>
    </div>
  </header>

  <main>
    <!-- FV：1画面で「いくら」に即答 -->
    <section class="hero platinum-hero">
      <div class="container hero-inner">
        <div class="hero-copy">
          <p class="eyebrow">Pt900・Pt950・Pt850の指輪をお持ちの方へ</p>
          <h1>プラチナ指輪、<br />今日<span class="no-break">いくら</span>？</h1>
          <p class="hero-lead">
            プラチナの買取価格は <strong>当日の単価 × 重さ</strong> で決まります。
            下の概算ですぐ目安が分かります。<span class="manekiya-pop manekiya-pop-invert">手数料0円・提示額がそのまま手取り</span>の相談先を、目的別に整理しました。
          </p>
          <div class="hero-alert">
            <span>まず金額だけ</span>
            <strong>売るかは査定額を聞いてから <small>無料・その場で概算OK</small></strong>
          </div>
          <div class="hero-actions" aria-label="主要アクション">
            <a href="#" class="btn btn-primary btn-phone-primary" data-affiliate="manekiya" data-track="platinum_hero_phone" rel="nofollow sponsored">電話でプラチナの概算を聞く</a>
            <a href="#estimate" class="btn btn-secondary" data-scroll-to="#estimate" data-track="platinum_hero_to_calc">30秒で概算を出す</a>
          </div>
          <p class="cta-microcopy">概算は当日単価をもとにした目安です。実際の金額は刻印・重量・宝石やデザインの有無・査定日で変わります。</p>
          <ul class="hero-points" aria-label="このページで分かること">
            <li>Pt900・Pt950の今日の単価</li>
            <li>自分の指輪のだいたいの額</li>
            <li>手数料0・後出し費用なしの相談先</li>
            <li>結婚指輪・古い指輪も対象</li>
          </ul>
        </div>

        <aside class="hero-panel platinum-rate-panel" aria-label="本日のプラチナ買取単価">
          <div class="rate-panel">
            <div class="rate-panel-head">
              <span>本日のプラチナ買取単価</span>
              <strong>1gあたりの参考価格</strong>
            </div>
            <div class="rate-hero">
              <div>
                <span>Pt900</span>
                <strong>{yen(rates.pt900)}<small>/g</small></strong>
              </div>
              <div>
                <span>Pt950</span>
                <strong>{yen(pt950)}<small>/g</small></strong>
              </div>
            </div>
            <div class="rate-grid">
              <div class="rate-feature rate-platinum"><span>Pt1000</span><strong>{yen(rates.pt1000)}<small>/g</small></strong></div>
              <div class="rate-feature rate-platinum"><span>Pt850</span><strong>{yen(rates.pt850)}<small>/g</small></strong></div>
              <div><span>K18（金）</span><strong>{yen(rates.k18)}<small>/g</small></strong></div>
              <div><span>金 K24</span><strong>{yen(rates.gold)}<small>/g</small></strong></div>
            </div>
            <div class="rate-sample">
              <span>たとえば</span>
              <strong>Pt900の指輪 約{sampleWeight}gなら、目安 約{yen(sampleLow)}〜{yen(sampleHigh)}</strong>
            </div>
            <p>{rates.updatedAt}・田中貴金属の店頭買取単価をもとに算出。Pt950・Pt900・Pt850やK18などの各純度は純度比による参考概算で、手数料・状態・お店により実際の買取価格は異なります。正確な金額は店舗でご確認ください。<a href={MARKET_SOURCE_URL} target="_blank" rel="noopener noreferrer nofollow">本日相場</a></p>
          </div>
        </aside>
      </div>
    </section>

    <!-- その場概算：競合がやっていない差別化要素 -->
    <section class="section estimate-calc-section" id="estimate">
      <div class="container">
        <div class="section-head">
          <span class="section-kicker">30秒で概算</span>
          <h2>あなたのプラチナ指輪、だいたいいくら？</h2>
          <p>純度と重さを入れるだけ。当日の単価でその場で目安を計算します。問い合わせ前に、おおよその額を持っておけます。</p>
        </div>
        <div class="calc-shell">
          <form
            class="calc-form"
            data-platinum-calc
            data-rate-pt1000={rates.pt1000}
            data-rate-pt950={pt950}
            data-rate-pt900={rates.pt900}
            data-rate-pt850={rates.pt850}
            data-rate-k18={rates.k18}
          >
            <label>
              <span>純度（刻印）</span>
              <select name="purity" data-calc-purity>
                <option value="pt900">Pt900</option>
                <option value="pt950">Pt950</option>
                <option value="pt1000">Pt1000</option>
                <option value="pt850">Pt850</option>
                <option value="k18">K18 / 金とのコンビ</option>
              </select>
            </label>
            <label>
              <span>重さ（g）<small>分からなければ指輪は3〜5g目安</small></span>
              <input type="number" inputmode="decimal" min="0" step="0.1" placeholder="例：4" name="weight" data-calc-weight />
            </label>
            <button type="submit" class="btn btn-primary" data-track="platinum_calc_submit">概算を出す</button>
          </form>
          <div class="calc-result" data-calc-result hidden aria-live="polite">
            <span>当日単価での目安</span>
            <strong data-calc-amount>—</strong>
            <p data-calc-note></p>
            <a href="#" class="btn btn-primary btn-phone-primary" data-affiliate="manekiya" data-track="platinum_calc_cta" rel="nofollow sponsored">この概算で正式査定の条件を聞く</a>
            <small>概算＝当日単価×重さの目安です。宝石・デザイン部分や状態で実額は変わります。正式な金額は査定で確定します。</small>
          </div>
        </div>
      </div>
    </section>

    <!-- 手数料の正直な話：CTR最強クラスタの痛点を解消 -->
    <section class="section fee-honest-section">
      <div class="container fee-honest-layout">
        <div>
          <span class="section-kicker">損したくない人へ</span>
          <h2>「手数料無料」より、<br />提示額がそのまま手取りか</h2>
          <p>
            プラチナ買取で多い後悔は、手数料そのものより
            <strong>「無料と書いてあったのに、単価が安くて結局少なかった」</strong>というもの。
            見るべきは“無料表記”ではなく、<strong>提示額＝受取額か／後から引かれる費用がないか</strong>です。
          </p>
          <a href="#" class="btn btn-primary" data-affiliate="manekiya" data-track="platinum_fee_cta" rel="nofollow sponsored">手数料・手取りの条件を確認する</a>
        </div>
        <div class="fee-check-card" aria-label="申し込み前に確認したい費用">
          <div class="fee-trap">
            <strong>“無料”の落とし穴</strong>
            <p>グラム単価を下げて、実質的に手数料分を回収する店があります。単価を聞いて比べるのが確実です。</p>
          </div>
          <ul class="fee-check-list">
            <li><span>◯</span>提示額がそのまま手取りになるか</li>
            <li><span>◯</span>査定料・出張料・宅配返送料は0円か</li>
            <li><span>◯</span>キャンセル時に費用が発生しないか</li>
            <li><span>◯</span>グラム単価をその場で教えてくれるか</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- あなたの品も対象 -->
    <section class="section item-proof-section" id="items">
      <div class="container">
        <div class="section-head">
          <span class="section-kicker">こんな指輪も対象</span>
          <h2>古い・刻印が薄い・結婚指輪でも、まず査定額を確認</h2>
          <p>「売れないかも」と自分で決めて処分する前に。プラチナなら値段が付く場合があります。</p>
        </div>
        <div class="item-proof-grid item-proof-grid-strong">
          <article>
            <img src="/images/item-platinum-ring.webp" alt="古いプラチナ指輪の査定イメージ" loading="lazy" />
            <span>Pt900</span><strong>古いプラチナ指輪</strong><p>刻印が薄くても、重さと品位を見てもらえます。</p>
          </article>
          <article>
            <img src="/images/item-gemstone-ring.webp" alt="石付きプラチナ指輪の査定イメージ" loading="lazy" />
            <span>石付き</span><strong>ダイヤ・宝石付き</strong><p>地金部分に加え、石やデザインの扱いも確認できます。</p>
          </article>
          <article>
            <img src="/images/item-platinum-ring.webp" alt="プラチナ結婚指輪の査定イメージ" loading="lazy" />
            <span>結婚指輪</span><strong>使わない結婚指輪</strong><p>ペア・片方だけでも査定対象になる場合があります。</p>
          </article>
          <article>
            <img src="/images/item-broken-necklace.webp" alt="金とプラチナのコンビ品の査定イメージ" loading="lazy" />
            <span>コンビ</span><strong>金×プラチナのコンビ</strong><p>K18とのコンビ品も、素材ごとに見てもらえます。</p>
          </article>
        </div>
      </div>
    </section>

    <!-- 適性別の相談先（STEP6：順位でなく目的の違いで住み分け） -->
    <section class="section compare-section" id="compare">
      <div class="container">
        <div class="section-head">
          <span class="section-kicker">目的別に選ぶ</span>
          <h2>あなたはどっち？目的で合う相談先を選ぶ</h2>
          <p>「順位」ではなく「自分の目的」で選ぶのが失敗しないコツです。プラチナ指輪で多い2つの目的で整理しました。</p>
        </div>

        <div class="purpose-nav" aria-label="目的別の相談先">
          <article class="purpose-card purpose-card-top">
            <div class="rank-badge rank-gold" aria-label="手数料・手取り重視で1位">
              <span class="rank-crown" aria-hidden="true">👑</span>
              <span class="rank-no">手取り重視<small>No.1</small></span>
            </div>
            <div class="purpose-head">
              <span>こんな人に</span>
              <h3>手数料・手取りで損したくない</h3>
            </div>
            <p>「提示額がそのまま欲しい」「単価をその場で知りたい」人向け。手数料0・後出し費用なしで、概算から相談しやすい。</p>
            <div class="purpose-pick">
              <strong><span class="manekiya-pop">まねきや</span></strong>
              <span class="pr-chip">PR</span>
            </div>
            <ul class="purpose-points">
              <li>査定料・出張料・キャンセル料の負担なしと案内</li>
              <li>店頭・出張・宅配から選べる</li>
              <li>古い指輪・コンビ・刻印薄も相談しやすい</li>
            </ul>
            <a href="#" class="btn btn-primary btn-wide btn-phone-primary" data-affiliate="manekiya" data-track="platinum_compare_manekiya" rel="nofollow sponsored">手取りの条件を電話で確認</a>
          </article>

          <article class="purpose-card purpose-card-second">
            <div class="rank-badge rank-silver" aria-label="店舗網・対面で1位">
              <span class="rank-crown" aria-hidden="true">🥈</span>
              <span class="rank-no">店舗網重視<small>No.1</small></span>
            </div>
            <div class="purpose-head">
              <span>こんな人に</span>
              <h3>近所で対面・持ち込みで安心したい</h3>
            </div>
            <p>「全国に店舗が多い大手で対面したい」「実店舗に持ち込みたい」人向け。知名度と店舗網で選びたいならこちら。</p>
            <div class="purpose-pick">
              <strong>おたからや</strong>
              <span class="pr-chip">PR</span>
            </div>
            <ul class="purpose-points">
              <li>全国に多数の店舗網がある</li>
              <li>対面で持ち込んで相談したい人向け</li>
              <li>条件・対応店舗はリンク先で確認</li>
            </ul>
            <a href="#" class="btn btn-outline btn-wide" data-affiliate="otakaraya" data-track="platinum_compare_otakaraya" rel="nofollow sponsored">店舗・条件を見てみる</a>
          </article>
        </div>

        <div class="comparison-board" aria-label="目的別の比較">
          <div class="comparison-row comparison-head" role="row">
            <div role="columnheader">見るポイント</div>
            <div role="columnheader"><span class="manekiya-table-name">まねきや</span> <span class="pr-chip">PR</span></div>
            <div role="columnheader">おたからや <span class="pr-chip">PR</span></div>
          </div>
          <div class="comparison-row" role="row">
            <div role="cell">手数料・手取りの分かりやすさ</div>
            <div class="mark-best" role="cell"><span>◎</span>手数料0・提示額が手取り</div>
            <div class="mark-normal" role="cell"><span>○</span>条件はリンク先で確認</div>
          </div>
          <div class="comparison-row" role="row">
            <div role="cell">対面・店舗網のひろさ</div>
            <div class="mark-normal" role="cell"><span>○</span>店頭・出張・宅配に対応</div>
            <div class="mark-best" role="cell"><span>◎</span>全国の店舗網が強み</div>
          </div>
          <div class="comparison-row" role="row">
            <div role="cell">プラチナ指輪の相談しやすさ</div>
            <div class="mark-best" role="cell"><span>◎</span>古い・コンビ・刻印薄も相談可</div>
            <div class="mark-normal" role="cell"><span>○</span>買取対象は広い</div>
          </div>
        </div>
        <p class="campaign-note">※当ページは広告（PR）を含みます。各社の最新の価格・手数料・対応条件はリンク先の公式ページで確認してください。</p>
      </div>
    </section>

    <!-- 安心・速い -->
    <section class="reassurance-band" aria-label="査定前の安心ポイント">
      <div class="container reassurance-grid">
        <div>
          <span>01</span>
          <strong>聞くだけ無料・売るのは後で決められる</strong>
          <p>査定額と費用を見てから、売るかどうかを判断できます。</p>
        </div>
        <div>
          <span>02</span>
          <strong>状態が悪くても値段が付くことがある</strong>
          <p>変形・刻印薄・片方だけの結婚指輪も、まず見てもらえます。</p>
        </div>
        <div>
          <span>03</span>
          <strong>持ち歩きが不安なら出張・宅配も</strong>
          <p>高額品や複数点は、家にいながら相談する方法もあります。</p>
        </div>
      </div>
    </section>

    <section class="section flow-section">
      <div class="container">
        <div class="section-head">
          <span class="section-kicker">流れ</span>
          <h2>3ステップで、プラチナ指輪の金額が分かる</h2>
        </div>
        <div class="flow-grid">
          <article>
            <div class="flow-ribbon">まずここ</div>
            <span>01</span>
            <h3>純度と重さを確認</h3>
            <p>Pt900・Pt950などの刻印と、だいたいの重さをチェック。上の概算でも目安が出ます。</p>
          </article>
          <article>
            <span>02</span>
            <h3>公式で条件を確認</h3>
            <p>電話相談またはWEB査定予約で、単価・手数料・査定方法を確認します。</p>
          </article>
          <article>
            <span>03</span>
            <h3>金額を聞いて判断</h3>
            <p>提示額と費用を見て、売るかどうかを決めます。聞いてから決められます。</p>
          </article>
        </div>
        <div class="flow-cta">
