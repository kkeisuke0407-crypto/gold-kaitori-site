---
const PAGE_TITLE = "Pt900・Pt950プラチナ指輪の買取価格・査定条件を比較｜売る前にチェック";
const PAGE_DESC = "Pt900・Pt950のプラチナ指輪を売る前に。本日の参考相場と、査定料・手数料・電話/WEB査定のしやすさを比較。古い指輪・宝石付きも査定対象。";
const CANONICAL = "https://kaitori.hakobu-family.com/pt-kaitori/";
const OGP_IMAGE = "https://kaitori.hakobu-family.com/images/item-platinum-ring.webp";

import { getRates, yen, MARKET_SOURCE_URL } from "../../lib/rates.js";
import { getOtakaraya } from "../../lib/otakaraya.js";
const rates = await getRates();
const otakaraya = getOtakaraya();
const ringEx = (w) => `約${Math.round(rates.pt900 * w * 0.85).toLocaleString("ja-JP")}〜${Math.round(rates.pt900 * w).toLocaleString("ja-JP")}円`;
// キャンペーン残日数（まねきや 6/30まで）
const campEnd = new Date('2026-06-30T23:59:59+09:00');
const today   = new Date(new Date().toLocaleString('en-US',{timeZone:'Asia/Tokyo'}));
const campDays = Math.max(0, Math.ceil((campEnd - today) / 86400000));
const todayLabel = today.getFullYear() + "年" + (today.getMonth() + 1) + "月" + today.getDate() + "日";

const faqJsonLd = {
  "@context": "https://schema.org", "@type": "FAQPage",
  "mainEntity": [
    ["プラチナ指輪は1点だけでも査定できますか？", "はい、1点からでも無料で査定してもらえます。点数が少なくても断られることはほとんどありません。"],
    ["Pt900の指輪はいくらで売れますか？", "重さ×その日のグラム単価がおおよその目安です。本日のPt900は約" + yen(rates.pt900) + "/gで、例えば4gの指輪なら地金だけで" + ringEx(4) + "ほどが目安です（状態・宝石で変わります）。"],
    ["結婚指輪や婚約指輪も売れますか？", "売れます。シンプルな結婚指輪はプラチナの地金として、宝石付きの婚約指輪は石も合わせて見てもらえます。"],
    ["刻印入りの指輪でも買取できますか？", "イニシャルや日付の刻印があっても、プラチナとしての価値は変わりません。問題なく買取できます。"],
    ["片方だけの指輪でも売れますか？", "片方だけ・ペアの一方だけでも売れます。地金として重さで査定されます。"],
    ["ダイヤや宝石付きの指輪は高くなりますか？", "石の種類や大きさによっては、地金に上乗せされて高くなることがあります。石も見てくれるお店を選ぶのがおすすめです。"],
    ["鑑定書や保証書がなくても大丈夫ですか？", "なくても査定・買取できます。あれば査定がスムーズになることがありますが、必須ではありません。"],
    ["査定後にキャンセルできますか？", "ほとんどのお店で、査定額に納得できなければ無料でキャンセルできます。売るかは金額を見てから決められます。"],
    ["出張査定は無料ですか？", "今回紹介する店は出張料・査定料・キャンセル料が無料と案内されています。詳しくは各店の公式でご確認ください。"],
    ["Pt900の結婚指輪は売れますか？", "売れます。Pt900は結婚指輪で最も多い純度で、地金として重さ×単価で査定されます。本日のPt900は約" + yen(rates.pt900) + "/gです。"],
    ["名前（イニシャル）入りの指輪は売れますか？", "売れます。名前や日付の刻印が入っていても、プラチナとしての価値は変わりません。溶かして地金にする過程で刻印は残りません。"],
    ["離婚した結婚指輪も売れますか？", "もちろん売れます。買い替えや気持ちの整理で手放す方はとても多く、片方だけ・ペアの一方だけでも査定できます。"],
    ["20年前の古いプラチナ指輪でも売れますか？", "売れます。デザインが古くても、プラチナの地金としての価値はしっかりあります。むしろ相場は当時より高くなっている場合が多いです。"],
    ["プラチナか分からない指輪も査定できますか？", "できます。刻印が読めない・刻印がない場合でも、X線検査で成分を正確に調べてもらえます。まずは無料査定で確認するのがおすすめです。"],
    ["どのタイミングで売るのがよいですか？", "プラチナ相場は毎日動きます。相場が高いうちに、まず今の金額を確認しておくのがおすすめです。"],
    ["指輪を売ると税金はかかりますか？", "多くの場合は非課税です。貴金属の売却益は譲渡所得にあたり、給与所得者ならその年の利益が合計50万円までは特別控除でかからないことがほとんどです。高額な場合や営利目的の売買は扱いが異なるため、詳しくは国税庁の案内や税務署・税理士にご確認ください。"],
    ["買取にクーリングオフは使えますか？", "訪問購入（出張買取）の場合、原則として契約書面を受け取った日から8日間はクーリングオフ（申込みの撤回）ができます。一方で、店頭買取・宅配買取は対象外です。詳しい条件は各店の契約書面でご確認ください。"]
  ].map(([q, a]) => ({ "@type": "Question", "name": q, "acceptedAnswer": { "@type": "Answer", "text": a } }))
};

// アフィリエイトリンク（manekiya / otakaraya は実リンク、buraibaは要設定）
const AFF_MANEKIYA = "https://ad-fam.com/ad/p/r?_site=49248&_article=16522";
const AFF_OTAKARAYA = "https://lp.otakaraya.jp/lp-gold-a/";
---
<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{PAGE_TITLE}</title>
  <meta name="description" content={PAGE_DESC} />
  <link rel="canonical" href={CANONICAL} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={PAGE_TITLE} />
  <meta property="og:description" content={PAGE_DESC} />
  <meta property="og:url" content={CANONICAL} />
  <meta property="og:image" content={OGP_IMAGE} />
  <meta property="og:locale" content="ja_JP" />
  <meta name="twitter:card" content="summary_large_image" />
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700;900&display=swap" onload="this.onload=null;this.rel='stylesheet'" />
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700;900&display=swap" /></noscript>
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-DMCWVLP3E3"></script>
  <script is:inline defer src="/cta-hours.js"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){ dataLayer.push(arguments); }
    gtag('js', new Date()); gtag('config', 'G-DMCWVLP3E3'); gtag('config', 'AW-18129603657');
  </script>
  <script is:inline>
    (function(c,l,a,r,i,t,y){ c[a]=c[a]||function(){ (c[a].q=c[a].q||[]).push(arguments); };
      t=l.createElement(r); t.async=1; t.src="https://www.clarity.ms/tag/"+i;
      y=l.getElementsByTagName(r)[0]; y.parentNode.insertBefore(t,y);
    })(window, document, "clarity", "script", "wxnujpnscp");
  </script>
</head>
<body data-landing-intent="lp2nd"
  data-aff-manekiya={AFF_MANEKIYA} data-aff-otakaraya={AFF_OTAKARAYA} data-aff-buraiba="https://brandrevalue.com/">

  <main>
    <!-- 01 FV -->
    <section class="fv">
      <div class="wrap">
        <!-- ヒーロー画像 -->
        <h1 class="fv-hero-wrap">
          <a href="#" class="fv-hero-link" data-aff="manekiya" data-track="fv_hero" rel="nofollow sponsored"><img src="/images/hero-pt-kaitori.webp" alt="Pt900・Pt950のプラチナ指輪、売る前に査定条件を比較｜まねきや・おたからや・ブラリバ" width="1672" height="941" loading="eager" fetchpriority="high" decoding="async" class="fv-hero-img" /></a>
        </h1>
        <div class="fv-datebadge">
          <span class="fv-db-tag"><i class="fv-db-dot"></i>最新版</span>
          <span class="fv-db-date">{todayLabel}</span>
          <span class="fv-db-txt">📍 6月限定キャンペーンあり</span>
        </div>


        <!-- ① 本日のプラチナ相場（価格を最速で表示）＋ ② 重さ別参考価格 -->
        <div class="fv-rate" id="rate">
          <div class="rate-hero">
            <p class="rate-hero-ttl"><i class="live-dot"></i>本日のプラチナ買取相場<span class="rate-hero-badge">📈 歴史的高値圏</span></p>
            <div class="rate-hero-main">
              <div class="rh-card rh-hot">
                <span class="rh-label">Pt1000（純プラチナ）</span>
                <span class="rh-price"><span class="rh-num">{yen(rates.pt1000)}</span><small>/g</small></span>
                {rates.ptDiff !== 0 && (<span class={"rate-diff " + (rates.ptDiff>=0?"up":"down")}>前日比 {rates.ptDiff>=0?"+":"−"}{Math.abs(rates.ptDiff).toLocaleString("ja-JP")}円</span>)}
              </div>
              <div class="rh-card">
                <span class="rh-label">Pt900</span>
                <span class="rh-price"><span class="rh-num">{yen(rates.pt900)}</span><small>/g</small></span>
                <span class="rh-note">指輪に多い純度</span>
              </div>
            </div>
            <div class="rate-mk-offer">
              <p class="rate-mk-txt"><span class="rate-mk-cp">【6月限定】</span><a href="#" class="rate-mk-link" data-aff="manekiya" data-track="rate_text_manekiya" rel="nofollow sponsored">まねきや</a>なら、当サイトから電話査定をしていただくと<b class="rate-mk-up">買取額30％UP＋手数料10％無料</b></p>
              <a href="#" class="btn btn-phone full" data-aff="manekiya" data-track="rate_phone" rel="nofollow sponsored"><i>☎</i>まずは電話で無料査定をする</a>
            </div>
            <details class="rate-more">
              <summary>Pt950・Pt850 も見る</summary>
              <div class="rate-grid-mini">
                <div><span>Pt950</span><b>{yen(rates.pt950)}</b></div>
                <div><span>Pt850</span><b>{yen(rates.pt850)}</b></div>
              </div>
            </details>
            <p class="rate-hero-date">{rates.updatedAt}・田中貴金属の店頭買取単価より</p>
            <p class="rate-purity-note">※各純度は純プラチナの買取単価から純度比で算出した参考値です。指輪などの製品は石・加工で変わります。正確な金額は店舗でご確認ください。</p>
          </div>
          <div class="ref-price satei-price">
            <h3 class="ref-ttl">あなたのプラチナ指輪、今ならいくら？<span>査定額はシンプルな“かけ算”で決まります</span></h3>

            <div class="satei-eq">
              <div class="satei-eq-cell satei-eq-rate">
                <span class="satei-eq-cap">📊 本日のPt900相場</span>
                <b class="satei-eq-num">{yen(rates.pt900)}<small>/g</small></b>
                <span class="satei-eq-up">歴史的な高値圏 ↑</span>
              </div>
              <span class="satei-eq-op">×</span>
              <div class="satei-eq-cell satei-eq-item">
                <span class="satei-eq-cap">💍 あなたの指輪</span>
                <ul class="satei-mini">
                  <li><i>💎</i>素材・純度<small>Pt900／950／コンビ</small></li>
                  <li><i>⚖️</i>重量<small>g数が多いほどUP</small></li>
                  <li><i>🔧</i>状態<small>傷・変形・壊れOK</small></li>
                  <li><i>💰</i>手数料<small>まねきやは0円</small></li>
                  <li><i>🎁</i>キャンペーン<small>適用でさらに上乗せ</small></li>
                </ul>
              </div>
              <span class="satei-eq-op">＝</span>
              <div class="satei-eq-cell satei-eq-result">
                <span class="satei-eq-cap">💰 あなたの受取額</span>
                <b class="satei-eq-mark">??? 円</b>
                <span class="satei-eq-rsub">無料査定ではじめて確定</span>
              </div>
            </div>

            <div class="satei-loss">
              <i>⚠️</i><p>査定は<b>完全無料</b>。今の相場を知らずに眠らせている人ほど、<b>気づかないうちに損</b>をしています。</p>
            </div>

            <div class="ref-bridge">
              <a href="#" class="camp2-cta ref-cta" data-aff="manekiya" data-track="ref_official" rel="nofollow sponsored"><span class="ref-cp">まねきやで</span><span class="ref-mn">「本当の受取額」を確認する</span></a>
              <p class="point-cta-note">無料査定／9時〜21時（年中無休）／売却は金額を見てから判断でOK</p>
            </div>
          </div>
        </div>

        <!-- 3社比較表 -->
        <div class="fv-tbl-head"><span class="fv-tbl-ttl">高く売れるのはどこ？ プラチナ買取おすすめ3社比較</span><i class="pr">PR</i></div>
        <div class="fv-tbl-wrap">
          <table class="fv-tbl">
            <thead>
              <tr>
                <th class="fv-th fv-th1 fv-th-gold"><span class="fv-rk-badge">👑 1位</span><a href="#" data-aff="manekiya" data-track="fv_tbl_bn_manekiya" rel="nofollow sponsored" style="display:block;"><img src="/images/manekiya_bn.png" width="300" height="250" alt="まねきや" style="width:100%;max-width:110px;height:auto;display:block;margin:4px auto 0;border-radius:4px;" loading="lazy" /><span class="fv-th-name">まねきや</span></a></th>
                <th class="fv-th"><span class="fv-rk-badge2">🥈 2位</span><a href="#" data-aff="otakaraya" data-track="fv_tbl_bn_otakaraya" rel="nofollow sponsored" style="display:block;"><img src="/images/300_250-2.jpg" width="300" height="250" alt="おたからや" style="width:100%;max-width:110px;height:auto;display:block;margin:4px auto 0;border-radius:4px;" loading="lazy" /><span class="fv-th-name">おたからや</span></a></th>
                <th class="fv-th"><span class="fv-rk-badge3">🥉 3位</span><a href="#" data-aff="buraiba" data-track="fv_tbl_bn_buraiba" rel="nofollow sponsored" style="display:block;"><img src="/images/300_250-3.jpg" width="300" height="250" alt="ブラリバ" style="width:100%;max-width:110px;height:auto;display:block;margin:4px auto 0;border-radius:4px;" loading="lazy" /><span class="fv-th-name">ブラリバ</span></a></th>
              </tr>
            </thead>
            <tbody>
              <tr class="cmp-band"><td colspan="3">買取価格</td></tr>
              <tr>
                <td class="fv-td fv-td1"><span class="mk good">◎</span><b>高価買取に強み<br />（編集部評価）</b></td>
                <td class="fv-td"><span class="mk ok">〇</span>高め</td>
                <td class="fv-td"><span class="mk ok">〇</span>高め</td>
              </tr>
              <tr class="cmp-band"><td colspan="3">手数料</td></tr>
              <tr>
                <td class="fv-td fv-td1"><span class="mk good">◎</span><b>0円（完全無料）</b></td>
                <td class="fv-td"><span class="mk ok">〇</span>0円</td>
                <td class="fv-td"><span class="mk ok">〇</span>0円</td>
              </tr>
              <tr class="cmp-band"><td colspan="3">当サイト限定キャンペーン</td></tr>
              <tr class="fv-tr-camp">
                <td class="fv-td fv-td1">
                  {campDays > 0 ? (
                    <>
                      <span class="camp-badge camp-badge-sparkle">6月限定</span><br />
                      <b class="up30">買取金額<br />最大<em>30%</em>UP</b>
                    </>
                  ) : (
                    <b>公式キャンペーン<br />要確認</b>
                  )}
                </td>
                <td class="fv-td"><span class="mk ok">〇</span><b>買取価格<br />最大20%UP</b></td>
                <td class="fv-td gray"><span class="mk bad">✕</span>なし</td>
              </tr>
              <tr class="cmp-band"><td colspan="3">結婚指輪・刻印対応</td></tr>
              <tr>
                <td class="fv-td fv-td1"><span class="mk good">◎</span>結婚指輪・刻印<br />名前入り・片方OK</td>
                <td class="fv-td"><span class="mk good">◎</span>結婚指輪<br />対応</td>
                <td class="fv-td"><span class="mk ok">〇</span>宝石付き<br />中心</td>
              </tr>
              <tr class="cmp-band"><td colspan="3">壊れた品でもOK</td></tr>
              <tr>
                <td class="fv-td fv-td1"><span class="mk good">◎</span>他社で断られた<br />物でもOK</td>
                <td class="fv-td"><span class="mk good">◎</span>他社で断られた<br />物でもOK</td>
                <td class="fv-td"><span class="mk tri">△</span>要相談</td>
              </tr>
              <tr class="cmp-band"><td colspan="3">査定方法</td></tr>
              <tr>
                <td class="fv-td fv-td1"><span class="mk good">◎</span>店舗・宅配<br />・出張</td>
                <td class="fv-td"><span class="mk ok">〇</span>店舗・出張</td>
                <td class="fv-td"><span class="mk good">◎</span>店舗・宅配<br />・出張</td>
              </tr>
              <tr class="fv-tr-cta">
                <td class="fv-td fv-td1">
                  <small class="cta-sub">＼手取りは査定で／</small>
                  <a href="#" class="btn btn-official sm" data-aff="manekiya" data-track="fv_tbl_official" rel="nofollow sponsored">無料査定</a>
                  {campDays > 0 && <p class="countdown">キャンペーン終了まで<b>あと{campDays}日！</b></p>}
                </td>
                <td class="fv-td">
                  <a href="#" class="btn btn-ghost sm" data-aff="otakaraya" data-track="fv_tbl_otakaraya" rel="nofollow sponsored">無料査定</a>
                </td>
                <td class="fv-td">
                  <a href="#" class="btn btn-ghost sm" data-aff="buraiba" data-track="fv_tbl_buraiba" rel="nofollow sponsored">無料査定</a>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
        <p class="note note-basis">※比較表の「買取価格」評価（◎/〇）は、各社公式サイトの記載・キャンペーン・買取実績にもとづく当編集部の主観的な比較評価であり、買取価格の優劣を保証するものではありません。〔評価の根拠〕まねきや：買取手数料0円／電話申込で買取金額最大30%UP／即日現金化（公式キャンペーン・実績）　おたからや：世界{otakaraya.storesComma}店舗以上の買取規模・買取専門26年・手数料0円（公式）　ブランドリバリュー：宝石・ブランド品を含めた再販ルートによる評価（公式）</p>


      </div>
    </section>

    <!-- 03 高く売るコツ -->
    <section class="sec" id="point">
      <div class="wrap">
        <div class="sec-head"><h2>高く売るための3つのポイント</h2><p>お店選びの前に、これだけ知っておきましょう。</p></div>
        <img class="point-img" src="/images/point-3diff-pt2.webp" alt="売る前に知っておきたい3つの差｜売るタイミング・相見積もり・キャンペーン｜まねきや 電話申込で買取金額最大30%UP" width="1024" height="1536" loading="lazy" />
        <a href="#" class="camp2-cta" data-aff="manekiya" data-track="point_official" rel="nofollow sponsored">
          買取価格30％UPの条件を確認する
        </a>
        <p class="point-cta-note">9時〜21時（年中無休）／査定だけ・相談だけでもOK</p>
      </div>
    </section>

    <!-- 05 ランキング -->
    <section class="sec" id="ranking">
      <div class="wrap">
        <div class="sec-head"><h2>プラチナ指輪 高額買取ランキング</h2><p>編集部がおすすめする3社をくわしく紹介します。</p></div>

        <!-- 1位 -->
        <article class="rk rk-1">
          <div class="rk-editor-pick">編集部イチオシ</div>
          <div class="rk-ribbon"><i>👑</i>第1位</div>
          <div class="rk-head"><h3>まねきや</h3><i class="pr">PR</i></div>
          <a href="#" data-aff="manekiya" data-track="rk_head_bn" rel="nofollow sponsored" style="display:block;margin:10px 0;">
            <img src="/images/manekiya_bn.png" width="300" height="250" alt="まねきや" style="width:100%;max-width:320px;height:auto;display:block;margin:0 auto;border-radius:8px;" loading="lazy" />
          </a>
          <p class="rk-for">プラチナ指輪を、できるだけ高く・手取りを減らさず売りたい人に</p>
          <table class="rk-spec">
            <tbody>
