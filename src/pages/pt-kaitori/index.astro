    .btn.full{ display:flex; width:100%; margin-top:10px; }
    .btn.sm{ min-height:42px; font-size:13px; padding:0 12px; box-shadow:none; }
    .cta-pair{ display:flex; flex-direction:column; gap:10px; margin-top:18px; }
    .cta-pair .btn{ width:92%; margin:0 auto; padding:8px 16px; font-size:clamp(14px,4vw,16px); white-space:normal; line-height:1.25; text-align:center; }
    .cta-pair .btn i{ font-size:14px; flex:0 0 auto; }
    /* 電話を主役に：ペア内のWEBは二次（アウトライン） */
    .cta-pair .btn-web{ background:#fff; color:var(--green-d); border:2px solid var(--green-d); box-shadow:none; }
    /* 電話おすすめのマイクロコピー */
    .cta-rec{ text-align:center; font-size:12.5px; font-weight:900; color:var(--coral-d); margin:14px 0 -2px; line-height:1.55; }
    .cta-note{ text-align:center; font-size:13px; color:var(--sub); margin:8px 0 0; }

    /* 01 FV */
    .fv{ background:linear-gradient(180deg,#EAF6F2, #fff); padding:24px 0 34px; }
    .camp-img{ display:block; margin:0 0 16px; border-radius:14px; overflow:hidden; box-shadow:0 8px 20px rgba(183,28,22,.28); text-decoration:none; }
    .camp-img img{ width:100%; height:auto; display:block; }

    /* 背景画像バナー＋文字オーバーレイ */
    .camp2{ margin:0 0 16px; }
    .camp2-banner{
      position:relative; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:3px;
      aspect-ratio:995/295; width:100%; padding:2.5% 6%; box-sizing:border-box;
      background:url("/images/camp-banner-bg.webp") center/100% 100% no-repeat;
