      .fv-banner-link::after{ animation:none; display:none; }
      .camp-img{ animation:none; }
      .camp-img::after{ animation:none; display:none; }
      .fv-hero-wrap::after{ animation:none; display:none; }
      .fade-in,.fade-in.visible{ opacity:1; transform:none; transition:none; }
    }

    /* ④ キャンペーンバナー（ポコポコ＋キラキラ） */
    .fv-banner{ margin:14px 0; }
    .fv-banner-link{
      display:block; position:relative; border-radius:14px; overflow:hidden;
      box-shadow:0 10px 24px rgba(201,126,0,.32);
      animation:pokopoko 1.15s ease-in-out infinite;
    }
    .fv-banner-link img{ width:100%; height:auto; display:block; }
    /* キラキラ：斜めの光が定期的に横切る */
    .fv-banner-link::after{
      content:""; position:absolute; top:-20%; left:-70%; width:45%; height:140%;
      background:linear-gradient(100deg, transparent, rgba(255,255,255,.65), transparent);
      transform:skewX(-18deg); pointer-events:none;
      animation:bannerShine 2.8s ease-in-out infinite;
    }
    @keyframes bannerShine{
      0%{ left:-70%; } 55%{ left:130%; } 100%{ left:130%; }
    }

    /* ヒーロー画像 */
    .fv-hero-wrap{ position:relative; overflow:hidden; border-radius:14px; box-shadow:0 6px 18px rgba(0,0,0,.12); margin:0 0 14px; font-size:0; line-height:0; }
    /* ヒーローのキラッ（光が斜めに横切る） */
    .fv-hero-wrap::after{
      content:""; position:absolute; top:-25%; left:-75%; width:50%; height:150%;
      background:linear-gradient(100deg, transparent, rgba(255,255,255,.7), transparent);
      transform:skewX(-18deg); pointer-events:none; z-index:2;
      animation:bannerShine 3.6s ease-in-out infinite;
    }
    .trust-strip{ list-style:none; display:grid; grid-template-columns:repeat(4,1fr); gap:6px; margin:0 0 14px; padding:0; }
    .trust-strip li{ background:var(--mint); border:1px solid #d6ece4; border-radius:10px; padding:8px 4px; text-align:center; display:flex; flex-direction:column; align-items:center; justify-content:flex-start; gap:2px; }
    .trust-strip b{ color:var(--green-d); font-size:clamp(15px,4.6vw,19px); line-height:1.1; }
    .trust-strip span{ color:var(--sub); font-size:9px; line-height:1.25; font-weight:700; }
    .fv-hero-img{ width:100%; height:auto; display:block; border-radius:14px; box-shadow:0 6px 18px rgba(0,0,0,.12); }
    /* スマホ：ヒーロー画像を枠なし・画面いっぱい（full-bleed）に */
    @media (max-width:600px){
      .fv{ padding-top:0; }
      .fv-hero-wrap{ width:100vw; margin-left:calc(50% - 50vw); margin-right:calc(50% - 50vw); margin-bottom:14px; border-radius:0; box-shadow:none; }
      .wrap .point-img{ width:100vw; max-width:100vw; margin-left:calc(50% - 50vw); margin-right:calc(50% - 50vw); border-radius:0; box-shadow:none; }
      .fv-hero-img{ border-radius:0; box-shadow:none; }
    }
    /* ① FV直下の相場ブロック（価格を最速で見せる） */
    .fv-rate{ margin:14px 0; padding:14px; background:#F2FBF8; border:2px solid var(--green); border-radius:16px; box-shadow:0 8px 22px rgba(14,120,100,.10); }
    .fv-rate-ttl{ display:flex; align-items:center; gap:6px; font-size:15px; font-weight:900; color:var(--green-d); margin:0 0 10px; }
    .fv-rate .rate-grid{ margin:0; }
    .fv-rate .rate-ex{ margin-top:14px; }
    .fv-rate .camp2-cta{ margin-top:12px; }

    .rate-chip{ background:#fff; border:1px solid var(--line); border-radius:14px; padding:12px 14px; display:flex; flex-wrap:wrap; align-items:center; gap:6px 12px; box-shadow:0 6px 18px rgba(20,60,50,.06); }
    .rate-chip>span{ font-size:13px; font-weight:900; color:var(--green-d); width:100%; }
    .rate-chip b{ font-size:16px; }
    .rate-chip small{ width:100%; color:var(--sub); font-size:12px; }

    /* FV 3社比較表 */
    .rate-cta{ position:relative; overflow:hidden; display:flex; flex-direction:column; align-items:center; gap:3px; margin:2px 0 6px; padding:15px 16px; background:linear-gradient(180deg,#FF5A4D,#E01F1F); color:#fff; border-radius:14px; text-decoration:none; text-align:center; box-shadow:0 8px 20px rgba(224,31,31,.30); animation:pokopoko 1.15s ease-in-out infinite; }
    .rate-cta::after{ content:""; position:absolute; top:-20%; left:-70%; width:45%; height:140%; background:linear-gradient(100deg,transparent,rgba(255,255,255,.6),transparent); transform:skewX(-18deg); pointer-events:none; animation:bannerShine 2.8s ease-in-out infinite; }
    .rate-cta>*{ position:relative; z-index:1; }
    .rate-cta:active{ transform:translateY(1px); }
    .rate-cta-main{ font-size:16.5px; font-weight:900; line-height:1.35; }
    .rate-cta-main::before{ content:"▶ "; font-size:13px; }
    .rate-cta-sub{ font-size:11px; font-weight:700; opacity:.92; }
    @media (prefers-reduced-motion: reduce){ .rate-cta{ animation:none; } .rate-cta::after{ display:none; } }
    .fv-tbl-head{ display:flex; align-items:center; gap:8px; margin:16px 0 6px; }
    .fv-tbl-ttl{ font-weight:900; font-size:clamp(11px,3.5vw,14px); color:var(--ink); white-space:nowrap; }
    .fv-tbl-head .pr{ margin-left:auto; }
    .fv-tbl-wrap{ margin:0 0 8px; overflow-x:auto; -webkit-overflow-scrolling:touch; border-radius:16px; border:1px solid var(--line); box-shadow:0 6px 18px rgba(20,60,50,.07); }
    .fv-tbl{ width:100%; min-width:340px; border-collapse:collapse; background:#fff; font-size:12.5px; }
    .fv-tbl th,.fv-tbl td{ padding:10px 8px; text-align:center; border-bottom:1px solid var(--line); vertical-align:middle; line-height:1.35; }
    .fv-th-item{ background:#F4F8F6; font-size:0; width:0; padding:0; }
    .fv-th{ background:#F4F8F6; font-weight:900; font-size:13px; color:var(--ink); }
    .fv-th-name{ display:block; text-align:center; font-size:.85em; font-weight:700; margin-top:4px; color:var(--ink); text-decoration:underline; }
    .fv-th1{ background:#FFFCF2; }
    .fv-td-item{ text-align:left; font-size:12px; font-weight:700; color:var(--ink); background:#FAFCFB; padding:10px 8px; white-space:nowrap; position:sticky; left:0; z-index:1; }
    .fv-td{ background:#fff; }
    .fv-td1{ background:#FFFCF2; }
    .fv-td .mk{ display:block; font-size:20px; font-weight:900; line-height:1; margin-bottom:3px; }
    .mk.good{ color:#E8920A; }
    .mk.ok{ color:#3AA17E; }
    .mk.tri{ color:#C99A3A; }
    .mk.bad{ color:#C0392B; }
    .fv-td1 b,.fv-td1 strong{ color:var(--green-d); }
    .fv-td.gray{ color:var(--sub); }
    .fv-rk-badge{ display:block; font-size:11px; color:var(--coral-d); font-weight:900; margin-bottom:3px; }
    .fv-rk-badge2,.fv-rk-badge3{ display:block; font-size:11px; color:var(--sub); font-weight:700; margin-bottom:3px; }
    .fv-tr-camp .fv-td{ background:#FFF8F0; }
    .fv-tr-camp .fv-td1{ background:#FFF3E0; }
    .camp-badge{ display:inline-block; background:#E0322C; color:#fff; font-size:10px; font-weight:900; border-radius:999px; padding:1px 8px; margin-bottom:4px; }
    .camp-badge-sparkle{ position:relative; overflow:hidden; background:linear-gradient(180deg,#FF6B5C,#E0322C); box-shadow:0 2px 6px rgba(224,50,44,.35); }
    .camp-badge-sparkle::after{ content:""; position:absolute; top:-30%; left:-70%; width:45%; height:160%; background:linear-gradient(100deg,transparent,rgba(255,255,255,.9),transparent); transform:skewX(-18deg); pointer-events:none; animation:bannerShine 2.4s ease-in-out infinite; }
    @media (prefers-reduced-motion:reduce){ .camp-badge-sparkle::after{ animation:none; display:none; } }
    .up30{ font-size:13px; line-height:1.3; color:var(--coral-d); }
    .up30 em{ font-style:normal; font-size:22px; font-weight:900; }
    /* 相場下：まねきや電話査定オファー */
    .rate-mk-offer{ margin-top:14px; }
    .rate-mk-txt{ font-size:13px; line-height:1.7; font-weight:700; color:var(--ink); margin:0 0 8px; text-align:center; text-wrap:balance; }
    .rate-mk-link{ color:var(--gold-d); font-weight:900; text-decoration:underline; text-underline-offset:2px; }
    .rate-mk-cp{ color:#E0322C; font-weight:900; }
    .rate-mk-up{ display:inline-block; position:relative; overflow:hidden; margin-top:2px; font-size:clamp(15px,4.7vw,19px); font-weight:900; line-height:1.55; color:#E0322C; background:linear-gradient(transparent 62%, #FFE08A 62%); padding:0 4px; }
    .rate-mk-up::after{ content:""; position:absolute; top:-30%; left:-72%; width:40%; height:170%; background:linear-gradient(100deg,transparent,rgba(255,255,255,.85),transparent); transform:skewX(-18deg); pointer-events:none; animation:bannerShine 2.6s ease-in-out infinite; }
    @keyframes rateUpPulse{ 0%,100%{ transform:scale(1); } 50%{ transform:scale(1.05); } }
    @media (prefers-reduced-motion:reduce){ .rate-mk-up::after{ animation:none; display:none; } }
    .rate-mk-offer .btn-phone{ width:100%; }
    .fv-tr-cta .fv-td,.fv-tr-cta .fv-td1{ padding:10px 6px; vertical-align:top; }
    .cta-sub{ display:block; font-size:10px; color:var(--sub); margin-bottom:5px; }
    .mt4{ margin-top:4px; }
    .countdown{ margin:6px 0 0; font-size:10px; color:var(--coral-d); line-height:1.4; }
    .countdown b{ font-size:13px; }

    /* セクション共通 */
    .sec{ padding:38px 0; }
    .sec-mint{ background:var(--mint); background-image:url("data:image/svg+xml,%3Csvg width='20' height='20' viewBox='0 0 20 20' xmlns='http://www.w3.org/2000/svg'%3E%3Ccircle cx='1' cy='1' r='1' fill='%230e7864' fill-opacity='.06'/%3E%3C/svg%3E"); }
    .sec-cream{ background:var(--cream); background-image:url("data:image/svg+xml,%3Csvg width='24' height='24' viewBox='0 0 24 24' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M0 12 L12 0 L24 12 L12 24 Z' fill='none' stroke='%23c8a000' stroke-opacity='.07' stroke-width='1'/%3E%3C/svg%3E"); }
    .sec-head{ text-align:center; margin-bottom:22px; }
    .chip{ display:inline-block; background:#fff; border:1px solid var(--line); color:var(--green-d); font-weight:900; font-size:12px; border-radius:999px; padding:5px 14px; }
    .sec-head h2{ font-size:23px; font-weight:900; margin:10px 0 6px; line-height:1.4; }
    .sec-head p{ font-size:13px; color:var(--body); margin:0; }
    .note{ font-size:11px; color:var(--sub); line-height:1.6; margin:12px 0 0; }
    .note.note-basis{ font-size:9px; line-height:1.55; color:#9aa5ac; }

    /* 02 相場 */
    .rate-purity-note{ font-size:11px; color:var(--sub); line-height:1.6; margin:6px 0 0; }
    .rate-grid{ display:grid; grid-template-columns:1fr 1fr; gap:10px; }
    .rate-grid>div{ background:#fff; border:1px solid var(--line); border-radius:14px; padding:14px; text-align:center; box-shadow:0 4px 14px rgba(20,60,50,.05); }
    .rate-grid span{ display:block; font-size:13px; color:var(--sub); font-weight:700; }
    .rate-grid b{ font-size:22px; color:var(--ink); }
    .rate-grid small{ color:var(--sub); font-size:12px; }
    .rate-grid .rate-diff{ display:inline-block; margin-top:5px; font-size:11px; font-weight:900; padding:1px 8px; border-radius:999px; line-height:1.6; }
    .rate-diff.up{ background:#FDE7E7; color:#C0271F; }
    .rate-diff.down{ background:#E7EEFD; color:#2A5BD7; }
    .rate-note-ingot{ font-size:11px; color:var(--sub); line-height:1.6; margin:8px 0 0; }
    .rate-hot{ border-color:var(--green) !important; background:#F2FBF8 !important; }
    .rate-hot b{ color:var(--green-d); }
    .rate-updated{ text-align:center; font-size:11px; color:var(--sub); margin:10px 0 0; }
    .rate-ex{ margin-top:20px; background:#fff; border:1px solid var(--line); border-radius:16px; padding:16px; }
    .rate-ex h3{ font-size:15px; margin:0 0 10px; }
    .rate-ex ul{ list-style:none; margin:0; padding:0; }
    .rate-ex li{ display:flex; justify-content:space-between; align-items:center; padding:10px 0; border-top:1px dashed var(--line); font-size:14px; }
    .rate-ex li span{ color:var(--body); }
    .rate-ex li b{ color:var(--green-d); }

    /* ① FV結論ボックス（最初の数秒で結論に答える・55歳以上も読める大きさ） */
    .fv-conc{ background:#fff; border:2px solid var(--green); border-radius:16px; padding:16px 16px 14px; margin:14px 0; box-shadow:0 8px 22px rgba(14,120,100,.12); }
    .fv-conc-ttl{ font-size:19px; font-weight:900; text-align:center; margin:0 0 12px; color:var(--ink); line-height:1.4; }
    .fv-conc ul{ list-style:none; margin:0 0 14px; padding:0; display:grid; gap:9px; }
    .fv-conc li{ font-size:16px; font-weight:700; padding-left:28px; position:relative; line-height:1.5; color:var(--ink); }
    .fv-conc li::before{ content:"✓"; position:absolute; left:0; top:0; color:var(--green); font-weight:900; font-size:18px; }
    .fv-conc li b{ color:var(--green-d); }
    .fv-conc .cta-pair{ margin-top:0; }
    /* ⑤ FV口コミ1件 */
    .fv-voice{ background:#fff; border:1px solid var(--line); border-left:4px solid var(--gold); border-radius:14px; padding:14px 16px; margin-top:14px; box-shadow:0 4px 14px rgba(20,60,50,.05); }
    .fv-voice-ttl{ display:block; font-size:15px; font-weight:900; color:var(--green-d); margin:6px 0 4px; line-height:1.5; }
    .fv-voice-txt{ font-size:13.5px; font-weight:500; color:var(--ink); margin:4px 0; line-height:1.8; }
    .fv-voice small{ color:var(--sub); font-weight:700; font-size:12px; }

    /* ⑥ 損したくない人向け（不安→まねきやの答え） */
    .fear-list{ list-style:none; margin:0 0 16px; padding:0; display:grid; gap:10px; }
    .fear-list li{ background:#fff; border:1px solid var(--line); border-radius:12px; padding:12px 14px 12px 40px; position:relative; }
    .fear-list li::before{ content:"😟"; position:absolute; left:12px; top:11px; font-size:16px; }
    .fear-list b{ display:block; font-size:14.5px; color:var(--ink); }
    .fear-list span{ display:block; font-size:13px; color:var(--green-d); font-weight:700; margin-top:3px; line-height:1.6; }
    .fuan-img{ display:block; width:100%; height:auto; border-radius:14px; box-shadow:0 6px 18px rgba(20,60,50,.1); }

    /* B-2 相場トレンド */
    .rate-trend{ display:inline-flex; align-items:center; background:#FFF3E0; color:var(--coral-d); font-weight:900; font-size:11px; border-radius:999px; padding:3px 10px; }
    .rate-trend-lg{ text-align:center; font-size:12.5px; font-weight:700; color:var(--coral-d); background:#FFF3E0; border-radius:10px; padding:9px 12px; margin:10px 0 0; line-height:1.6; }

    /* A-3 計算式 */
    .calc{ margin-top:14px; background:#fff; border:1px solid var(--line); border-radius:16px; padding:16px; }
    .calc h3{ font-size:15px; margin:0 0 12px; }
    .calc-formula{ display:flex; flex-wrap:wrap; align-items:center; justify-content:center; gap:6px; margin:0 0 6px; }
    .calc-formula span{ background:var(--mint); color:var(--green-d); font-weight:900; font-size:12.5px; border-radius:8px; padding:6px 10px; }
    .calc-formula i{ font-style:normal; font-weight:900; color:var(--sub); font-size:14px; }
    .calc-formula b{ background:var(--green-d); color:#fff; font-size:13px; border-radius:8px; padding:6px 12px; }

    /* A-2 純度・刻印 */
    .purity{ margin-top:14px; background:#fff; border:1px solid var(--line); border-radius:16px; padding:16px; }
    .purity h3{ font-size:15px; margin:0 0 12px; }
    .purity-list{ list-style:none; margin:0 0 12px; padding:0; display:grid; gap:8px; }
    .purity-list li{ display:flex; align-items:baseline; gap:10px; font-size:13px; padding:8px 12px; background:#FAFCFB; border:1px solid var(--line); border-radius:10px; }
    .purity-list b{ flex:0 0 64px; color:var(--green-d); font-size:14px; }
    .purity-list span{ color:var(--body); }
    .purity-where{ font-size:13px; color:var(--body); margin:0 0 10px; line-height:1.7; }
    .purity-warn{ font-size:12.5px; color:var(--body); background:#FFF7EC; border:1px solid var(--gold); border-radius:10px; padding:10px 12px; margin:0; line-height:1.7; }

    /* 07 ためらう方へ */
    .push-lead{ font-size:14.5px; line-height:1.85; color:var(--body); text-align:center; margin:0 0 18px; }
    .push-points{ list-style:none; margin:0 0 16px; padding:0; display:grid; gap:10px; }
    .push-points li{ display:flex; gap:12px; align-items:flex-start; background:#fff; border:1px solid var(--line); border-radius:14px; padding:14px; box-shadow:0 4px 14px rgba(20,60,50,.05); }
    .push-points i{ font-style:normal; font-size:24px; flex-shrink:0; line-height:1.2; }
    .push-points b{ display:block; font-size:14px; color:var(--green-d); margin-bottom:3px; }
    .push-points div{ font-size:13px; color:var(--body); line-height:1.7; }
    .push-safe{ background:var(--cream); border:1px solid var(--gold); border-radius:16px; padding:16px; }
    .push-safe>b{ display:block; font-size:14.5px; color:var(--gold-d); margin-bottom:10px; }
    .push-safe ul{ list-style:none; margin:0; padding:0; display:grid; gap:8px; }
    .push-safe li{ font-size:13px; color:var(--body); line-height:1.6; padding-left:20px; position:relative; }
    .push-safe li::before{ content:"✓"; position:absolute; left:0; color:var(--gold-d); font-weight:900; }

    /* 03 高く売るポイント（画像） */
    .point-img{ display:block; width:100%; height:auto; font-size:0; line-height:0; border-radius:14px; overflow:hidden; box-shadow:0 8px 22px rgba(20,60,50,.1); }
    .point-img img{ width:100%; height:auto; display:block; }
    .point-cta{ margin-top:16px; }
    .point-cta-note{ text-align:center; font-size:12px; color:var(--sub); margin:8px 0 0; }


    /* まねきや口コミブロック（ランキング内） */
    .rk-voice-block{ background:var(--cream); border:1px solid var(--gold); border-radius:16px; padding:18px 16px 14px; margin-bottom:18px; }
    .rk-voice-ttl{ font-weight:900; font-size:14px; margin-bottom:14px; display:flex; align-items:center; gap:8px; }
    .rk-voice-list{ display:grid; gap:12px; }

    /* 05 ランキング */
    .rk{ background:#fff; border:1px solid var(--line); border-radius:20px; padding:20px 16px 16px; margin-bottom:18px; box-shadow:0 10px 26px rgba(20,60,50,.08); position:relative; }
    .rk-1{ border:2px solid var(--gold); box-shadow:0 14px 32px rgba(217,150,42,.18); }
    .rk-ribbon{ position:absolute; top:-14px; left:16px; background:var(--sub); color:#fff; font-weight:900; font-size:13px; border-radius:999px; padding:5px 14px; display:flex; align-items:center; gap:4px; }
    .rk-ribbon i{ font-style:normal; }
    .rk-1 .rk-ribbon{ background:linear-gradient(135deg,#f6c64d,var(--gold-d)); color:#5a3d00; }
    .rk-2 .rk-ribbon{ background:#9AA7B0; }
    .rk-3 .rk-ribbon{ background:#C8A06A; }
    .rk-camp-img{ display:block; border-radius:12px; overflow:hidden; margin:14px 0; box-shadow:0 6px 16px rgba(183,28,22,.25); text-decoration:none; }
    .rk-camp-img img{ width:100%; height:auto; display:block; }
    .rk-head{ display:flex; align-items:center; gap:8px; margin-top:6px; }
    .rk-head h3{ font-size:22px; margin:0; }
    .rk-star{ color:var(--star); font-weight:900; font-size:14px; }
    .rk-head .pr{ margin-left:auto; }
    .rk-for{ font-size:13px; color:var(--green-d); font-weight:700; background:var(--mint); border-radius:8px; padding:7px 10px; margin:10px 0; }
    .rk-reasons{ list-style:none; margin:0 0 12px; padding:0; display:grid; gap:7px; }
    .rk-reasons li{ font-size:13.5px; padding-left:24px; position:relative; }
    .rk-reasons li::before{ content:"✓"; position:absolute; left:0; color:var(--green); font-weight:900; }
    .rk-meta{ display:grid; gap:8px; background:#FAFCFB; border:1px solid var(--line); border-radius:12px; padding:12px; margin-bottom:12px; }
    .rk-meta div{ display:grid; grid-template-columns:88px 1fr; gap:8px; font-size:12.5px; }
    .rk-meta span{ color:var(--sub); }
    .rk-reviews{ display:grid; gap:7px; margin-bottom:6px; }
    .rk-reviews p{ font-size:12.5px; color:var(--body); background:#fff; border:1px solid var(--line); border-radius:10px; padding:8px 10px; margin:0; }
    .rk-reviews small{ display:block; color:var(--sub); margin-top:2px; }

    /* 06 深掘り */
    .deep{ display:grid; gap:14px; }
    .deep-merit{ list-style:none; margin:0; padding:0; display:grid; gap:8px; }
    .deep-merit li{ background:#fff; border:1px solid var(--line); border-radius:12px; padding:12px 14px; font-size:13.5px; }
    .flow{ background:#fff; border:1px solid var(--line); border-radius:16px; padding:16px; }
    .flow h3{ font-size:15px; margin:0 0 12px; }
    .flow ol{ margin:0; padding:0; list-style:none; display:grid; gap:10px; counter-reset:f; }
    .flow li{ display:flex; align-items:baseline; gap:10px; font-size:13.5px; counter-increment:f; }
    .flow li::before{ content:counter(f); flex:0 0 26px; width:26px; height:26px; background:var(--green-d); color:#fff; border-radius:50%; display:grid; place-items:center; font-weight:900; font-size:13px; }
    .flow li b{ margin-right:4px; }
    .flow li span{ color:var(--body); }
    .flow-fee{ font-size:13px; background:var(--mint); border-radius:10px; padding:10px 12px; margin:12px 0 0; }

    /* 07 口コミ */
    .voice-list{ display:grid; gap:12px; }
    .voice-grid{ display:grid; gap:12px; }
    .voice{ background:#fff; border:1px solid var(--line); border-radius:16px; padding:14px 16px; box-shadow:0 4px 14px rgba(20,60,50,.05); }
    .voice-lg{ border-left:4px solid var(--green); }
    .voice-ttl{ display:block; font-size:14.5px; color:var(--green-d); font-weight:900; margin:6px 0 4px; }
    .stars{ color:var(--star); font-size:14px; letter-spacing:1px; }
    .voice p{ font-size:13.5px; margin:6px 0; line-height:1.7; }
    .voice small{ color:var(--sub); font-weight:700; }

    /* 08 不安解消 */
    .fits{ background:#F2FBF8; border:1px solid var(--green); border-radius:16px; padding:16px; margin-bottom:14px; }
    .fits-ttl{ font-size:15px; font-weight:900; color:var(--green-d); margin:0 0 12px; text-align:center; }
    .fits ul{ list-style:none; margin:0; padding:0; display:grid; grid-template-columns:1fr 1fr; gap:10px 12px; }
    .fits li{ font-size:13px; color:var(--ink); font-weight:700; display:flex; align-items:center; gap:8px; }
    .fits li svg{ flex-shrink:0; }
    .worry-grid{ display:grid; gap:10px; }
    .worry{ background:#fff; border:1px solid var(--line); border-radius:14px; padding:14px 16px; }
    .worry h3{ font-size:14px; margin:0 0 5px; color:var(--green-d); }
    .worry h3::before{ content:"Q. "; }
    .worry p{ font-size:13px; color:var(--body); margin:0; }
    .worry p::before{ content:"A. "; font-weight:900; color:var(--ink); }

    /* 09 FAQ */
    .faq{ display:grid; gap:10px; }
    .faq details{ background:#fff; border:1px solid var(--line); border-radius:12px; overflow:hidden; }
    .faq summary{ list-style:none; cursor:pointer; padding:14px 40px 14px 16px; font-weight:700; font-size:14px; position:relative; }
    .faq summary::-webkit-details-marker{ display:none; }
    .faq summary::after{ content:"+"; position:absolute; right:16px; top:12px; font-size:20px; color:var(--green-d); }
    .faq details[open] summary::after{ content:"−"; }
    .faq p{ margin:0; padding:0 16px 14px; font-size:13px; color:var(--body); }

    /* 10 最終CTA */
    .final-banner{ display:block; position:relative; overflow:hidden; margin:14px 0 4px; border-radius:14px; box-shadow:0 8px 20px rgba(183,28,22,.28); text-decoration:none; animation:pokopoko 1.3s ease-in-out infinite; }
    .final-banner img{ width:100%; height:auto; display:block; }
    .final-banner::after{ content:""; position:absolute; top:-20%; left:-70%; width:45%; height:140%; background:linear-gradient(100deg,transparent,rgba(255,255,255,.6),transparent); transform:skewX(-18deg); pointer-events:none; animation:bannerShine 3s ease-in-out infinite; }
    @media (prefers-reduced-motion:reduce){ .final-banner{ animation:none; } .final-banner::after{ animation:none; display:none; } }
    .sec-final{ background:linear-gradient(180deg,#fff,var(--mint)); text-align:center; }
    .sec-final h2{ font-size:22px; font-weight:900; margin:0 0 8px; line-height:1.45; }
    .sec-final>.wrap>p{ font-size:14px; color:var(--body); margin:0 0 4px; }

    /* フッター */
    .ft{ background:#23303A; color:#cfd8de; padding:24px 0; }
    .ft-trust{ background:rgba(255,255,255,.06); border:1px solid rgba(255,255,255,.12); border-radius:12px; padding:14px 16px; margin:0 0 14px; }
    .ft-trust-ttl{ font-size:12px; font-weight:900; color:#e7eef2; margin:0 0 8px; }
    .ft-trust ul{ list-style:none; margin:0; padding:0; }
    .ft-trust li{ font-size:11.5px; line-height:1.7; color:#cfd8de; padding-left:14px; position:relative; }
    .ft-trust li::before{ content:"・"; position:absolute; left:0; }
    .ft-method{ background:rgba(255,255,255,.06); border:1px solid rgba(255,255,255,.12); border-radius:12px; padding:14px 16px; margin:0 0 14px; }
    .ft-method-ttl{ font-size:12px; font-weight:900; color:#e7eef2; margin:0 0 8px; }
    .ft-method p:not(.ft-method-ttl){ font-size:11.5px; line-height:1.8; color:#cfd8de; margin:0; }
    .ft-note{ font-size:11px; line-height:1.7; margin:0 0 12px; }
    .ft nav{ display:flex; flex-wrap:wrap; gap:14px; margin-bottom:10px; }
    .ft a{ color:#aeecdf; color:#a9d5cd; font-size:12px; }
    .ft small{ color:#7d8a92; font-size:11px; }

    /* スマホ下部固定 */
    .sticky{ position:fixed; left:0; right:0; bottom:0; z-index:60; display:grid; grid-template-columns:1.4fr 1fr; gap:8px; padding:8px 10px; background:rgba(255,255,255,.97); backdrop-filter:blur(6px); border-top:1px solid var(--line); }
    .sticky a{ text-decoration:none; font-weight:900; border-radius:999px; min-height:50px; display:flex; align-items:center; justify-content:center; gap:6px; font-size:14px; }
    .sticky i{ font-style:normal; }
    .sticky-phone{
      background:linear-gradient(180deg,#FF5A4D,#E01F1F); color:#fff;
      box-shadow:0 5px 0 #B0160F, 0 8px 14px rgba(224,31,31,.3);
      border:2px solid #ffd9d4; animation:pokopoko 1.1s ease-in-out infinite;
    }
    .sticky-phone i{ display:inline-flex; align-items:center; justify-content:center; width:26px; height:26px; border-radius:50%; background:#fff; color:#E0322C; font-size:14px; }
    .sticky-web{ background:var(--green-d); color:#fff; }
    .sticky-official{ grid-column:1 / -1; position:relative; overflow:hidden; flex-direction:column; gap:1px; padding:4px 10px; background:linear-gradient(180deg,#FF5A4D,#E01F1F); color:#fff; border:2px solid #ffd9d4; box-shadow:0 5px 0 #B0160F, 0 8px 14px rgba(224,31,31,.3); animation:pokopoko 1.1s ease-in-out infinite; }
    .sticky-official::after{ content:""; position:absolute; top:-30%; left:-65%; width:35%; height:160%; background:linear-gradient(100deg,transparent,rgba(255,255,255,.55),transparent); transform:skewX(-18deg); pointer-events:none; animation:bbCtaShine 3.2s ease-in-out infinite; }
    .sticky-cp{ display:inline-block; background:linear-gradient(180deg,#FFE9A8,#F2C14A); color:#7a2a00; font-size:10px; font-weight:900; line-height:1.4; border-radius:999px; padding:0 9px; box-shadow:0 1px 2px rgba(0,0,0,.18); }
    .sticky-main{ font-size:14.5px; font-weight:900; line-height:1.2; }
    @media (prefers-reduced-motion:reduce){ .sticky-official::after{ animation:none; display:none; } }

    @media (min-width:600px){
      .voice-grid,.worry-grid{ grid-template-columns:1fr 1fr; }
    }
  
    /* ===== ブラッシュアップ（構成不変・視覚/CWVのみ） ===== */
    /* ① 電話CTAに光が流れる */
    .btn-phone{ position:relative; overflow:hidden; }
    .btn-phone::after{ content:""; position:absolute; top:-30%; left:-65%; width:35%; height:160%;
      background:linear-gradient(100deg,transparent,rgba(255,255,255,.5),transparent);
      transform:skewX(-18deg); pointer-events:none; animation:bbCtaShine 3.2s ease-in-out infinite; }
    @keyframes bbCtaShine{ 0%{ left:-65%; } 60%,100%{ left:145%; } }
    /* ② trust-strip 可読性UP */
    .trust-strip span{ font-size:11px; line-height:1.3; }
    /* ③ 比較表 横スクロール示唆（モバイル） */
    .fv-tbl-wrap{ position:relative; }
    @media (max-width:600px){
      .fv-tbl-wrap::after{ content:"→"; position:absolute; top:6px; right:6px; z-index:2;
        font-weight:900; font-size:12px; color:var(--green-d); background:rgba(255,255,255,.92);
        border:1px solid var(--line); border-radius:999px; padding:1px 7px;
        animation:bbScrollHint 1.4s ease-in-out infinite; }
    }
    @keyframes bbScrollHint{ 0%,100%{ transform:translateX(0); } 50%{ transform:translateX(4px); } }
    /* ⑤ スティッキー：微脈動＋iPhoneセーフエリア */
    .sticky{ padding-bottom:calc(8px + env(safe-area-inset-bottom)); }
    .sticky-phone{ animation:bbStickyPulse 1.9s ease-in-out infinite; }
    @keyframes bbStickyPulse{ 0%,100%{ transform:scale(1); } 50%{ transform:scale(1.03); } }
    /* ⑦ 安心訴求（既存文言）をやわらかく強調 */
    .cta-note{ background:#F2FBF8; border-radius:10px; padding:8px 10px; }
    /* ⑧ ランキングカード ホバー浮上＋1位の影強調 */
    .rk{ transition:transform .18s ease, box-shadow .18s ease; }
    .rk:hover{ transform:translateY(-4px); }
    .rk-1{ box-shadow:0 16px 36px rgba(217,150,42,.22); }
    /* ⑨ 薄色テキストのコントラスト改善（AA寄せ） */
    :root{ --sub:#6E7B85; }
    /* ⑩ CLS保険：画像は縦横比維持 */
    .fv-hero-img,.point-img img,.camp-img img,.rk-zisseki,.fuan-img,.fv-banner-link img{ height:auto; }
    @media (prefers-reduced-motion:reduce){
      .btn-phone::after,.sticky-phone,.fv-tbl-wrap::after{ animation:none; }
    }
  
    /* 見やすさ微調整：小注記の底上げ */
    .note{ font-size:12px; }
    .rate-updated{ font-size:12px; }
      .fv-hero-link{ display:block; font-size:0; }
  
    /* ===== LP2nd 個別ブラッシュアップ ===== */
    .fv-datebadge{ display:flex; align-items:center; justify-content:center; flex-wrap:wrap; gap:8px; width:100%; margin:0 auto 14px; padding:9px 14px; background:#fff; border:1px solid #F0DBB0; border-radius:12px; box-shadow:0 4px 14px rgba(183,28,28,.13); font-weight:900; }
    .fv-db-tag{ display:inline-flex; align-items:center; gap:6px; background:linear-gradient(180deg,#E0322C,#B71C1C); color:#fff; font-size:15px; padding:7px 14px; border-radius:999px; letter-spacing:.04em; }
    .fv-db-dot{ width:9px; height:9px; border-radius:50%; background:#fff; animation:dbpulse 1.5s ease-out infinite; }
    @keyframes dbpulse{ 0%{box-shadow:0 0 0 0 rgba(255,255,255,.85)} 70%{box-shadow:0 0 0 7px rgba(255,255,255,0)} 100%{box-shadow:0 0 0 0 rgba(255,255,255,0)} }
    .fv-db-date{ font-size:16.5px; color:var(--ink); letter-spacing:.01em; }
    .fv-db-txt{ font-size:16.5px; color:#B71C1C; }
    @media (max-width:360px){ .fv-db-tag{ font-size:13px; } .fv-db-date,.fv-db-txt{ font-size:14.5px; } }
    .fv-cta1{ text-align:center; background:#FFF7EC; border:2px dashed var(--gold); border-radius:14px; padding:15px 14px; margin:0 0 14px; }
    .fv-cta1-badge{ display:inline-block; background:var(--gold-d); color:#fff; font-weight:900; font-size:12px; border-radius:999px; padding:3px 12px; margin-bottom:7px; }
    .fv-cta1 p{ margin:0; font-size:18px; font-weight:900; color:var(--ink); line-height:1.5; }
    .fv-cta1 b{ color:var(--coral-d); }
    .wrap{ padding:0 10px; }
    .fv-rate,.rate-ex{ padding-left:12px; padding-right:12px; }
    .rk{ padding-left:12px; padding-right:12px; }
    .fv-tbl{ min-width:0; width:100%; table-layout:fixed; font-size:12px; }
    .fv-tbl th,.fv-tbl td{ padding:9px 4px; }
    .fv-th-item,.fv-td-item{ white-space:normal; position:static; font-size:11px; }
    .fv-tbl-wrap{ overflow-x:hidden; }
    .fv-tbl-wrap::after{ display:none; }
    .fv-td .mk.good,.mk.good{ color:#D81F1F; font-weight:900; }
    .fv-td .mk.good{ font-size:22px; }
    .camp2-cta{ font-size:clamp(17px,5vw,21px); }
    .camp2-cta-lg{ font-size:clamp(18px,5.4vw,22px); margin-top:6px; }
    .btn-phone{ font-size:clamp(15px,4.6vw,18px); }
    .rk-1 .rk-reasons{ display:grid; grid-template-columns:1fr 1fr; gap:8px; }
    .rk-1 .rk-reasons li{ background:#F2FBF8; border:1px solid var(--line); border-radius:10px; padding:9px 10px; font-size:12px; line-height:1.45; }
    .rk-1 .rk-reasons li::before{ display:none; }
    @media (max-width:380px){ .rk-1 .rk-reasons{ grid-template-columns:1fr; } }
    /* 口コミ：横スワイプ（縦スクロール不可） */
    .rk-voice-list{ display:flex; flex-wrap:nowrap; overflow-x:auto; overflow-y:hidden; scroll-snap-type:x mandatory; gap:12px; -webkit-overflow-scrolling:touch; padding-bottom:4px; }
    .rk-voice-list > *{ flex:0 0 86%; scroll-snap-align:center; }
    .rk-voice-block::after{ content:"← スワイプで他の口コミ →"; display:block; text-align:center; font-size:11px; color:var(--sub); margin-top:6px; }
    /* まねきや30%CTA：ポコポコ＋キラキラ（FVバナーと同じ動き） */
    .camp-img{ position:relative; animation:pokopoko 1.15s ease-in-out infinite; }
    .camp-img::after{ content:""; position:absolute; top:-20%; left:-70%; width:45%; height:140%; background:linear-gradient(100deg,transparent,rgba(255,255,255,.65),transparent); transform:skewX(-18deg); pointer-events:none; animation:bannerShine 2.8s ease-in-out infinite; }
    /* ランキング1位スペック表（カード型） */
    .rk-spec{ width:100%; table-layout:fixed; border-collapse:separate; border-spacing:0; margin:4px 0 12px; border:2px solid #C8102E; border-radius:6px; overflow:hidden; }
    .rk-spec th{ background:#C8102E; color:#fff; font-weight:900; font-size:11.5px; text-align:center; padding:7px 3px; line-height:1.3; border-right:1px solid rgba(255,255,255,.45); border-bottom:1px solid #fff; }
    .rk-spec .rs-head th:last-child{ border-right:none; }
    .rk-spec td{ background:#fff; text-align:center; font-size:12px; font-weight:700; color:var(--ink); padding:11px 5px; line-height:1.45; vertical-align:middle; border-right:1px solid #F1CDD2; border-bottom:1px solid #F1CDD2; }
    .rk-spec td:last-child{ border-right:none; }
    .rk-spec .rs-val td{ border-bottom:none; }
    .rk-spec .rs-ic{ display:block; font-size:22px; line-height:1; margin-bottom:7px; color:#D81F1F; font-weight:900; }
    .rk-spec .rs-ic.ring{ color:#F2A20C; font-weight:900; font-size:26px; }
    .rk-spec .rs-long{ font-size:11px; font-weight:700; color:var(--body); line-height:1.6; vertical-align:middle; border-left:1px solid #F1CDD2; }
    .rk-spec .rs-camp{ display:inline-block; color:var(--ink); font-weight:900; font-size:12px; line-height:1.35; }
    .rk-spec .rs-camp em{ font-style:normal; color:#D81F1F; font-size:16px; }
    .rk-spec .rs-camp-big{ font-size:13.5px; line-height:1.45; }
    .rk-spec .rs-camp-big em{ font-size:19px; }
    /* おすすめポイント（ゴールド） */
    .rk-osusume{ border:2px solid var(--gold); border-radius:8px; overflow:hidden; margin:0 0 16px; }
    .rk-osusume-h{ background:linear-gradient(135deg,#F4A81F,#D9962A); color:#fff; font-weight:900; font-size:14px; padding:9px 13px; text-shadow:0 1px 2px rgba(0,0,0,.18); }
    .rk-osusume ul{ list-style:none; margin:0; padding:12px 14px; display:grid; gap:10px; background:#FFFDF6; }
    .rk-osusume li{ font-size:13px; line-height:1.55; font-weight:700; color:var(--ink); display:flex; gap:7px; align-items:flex-start; }
    .rk-osusume .chk{ color:#1AA251; font-weight:900; flex:0 0 auto; font-size:15px; }
