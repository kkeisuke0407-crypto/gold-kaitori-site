<body data-landing-intent="lp_pt"
  data-aff-manekiya={AFF_MANEKIYA} data-aff-otakaraya={AFF_OTAKARAYA} data-aff-buraiba="https://brandrevalue.com/">

  <main>
    <!-- 01 FV -->
    <section class="fv">
      <div class="wrap">
        <!-- ヒーロー画像 -->
        <h1 class="fv-hero-wrap">
          <a href="#" class="fv-hero-link" data-aff="manekiya" data-track="fv_hero" rel="nofollow sponsored"><img src="/images/hero-pt-kaitori.webp" alt="Pt900・Pt950のプラチナ指輪、売る前に査定条件を比較｜まねきや・おたからや・ブラリバ" width="1672" height="941" loading="eager" fetchpriority="high" decoding="async" class="fv-hero-img" /></a>
        </h1>


        <!-- ① 結論ボックス：最初の数秒で結論に答える -->
        <div class="fv-conc">
          <p class="fv-conc-ttl">Pt900・Pt950のプラチナ指輪、売る前に査定条件を比較</p>
          <p class="fv-conc-sub">査定料・キャンセル条件・電話相談・WEB査定予約のしやすさを比較。金額だけでなく、売る前に確認したい条件を整理しました。</p>
          <ul>
            <li>1位 <b>まねきや</b>（編集部評価）</li>
            <li>買取<b>手数料0円</b>＝手取りが減りにくい</li>
            <li>電話申込で買取金額<b>最大30%UP</b></li>
            <li>結婚指輪・刻印・片方だけ・石付きも査定対象</li>
            <li><b>査定だけでもOK</b>／売るかは金額を見てから</li>
          </ul>
          <div class="cta-pair">
            <a href="#" class="btn btn-phone" data-aff="manekiya" data-track="fv_conc_phone" rel="nofollow sponsored"><i>☎</i>今の査定額を電話で聞く</a>
            <a href="#" class="btn btn-web" data-aff="manekiya" data-track="fv_conc_web" rel="nofollow sponsored">WEBで査定予約する</a>
          </div>
        </div>

        <!-- FV直下の不安解消3点＋対象商品 -->
        <div class="fv-q3"><span>Q. 査定だけでもいい？</span><span>Q. 手数料は？</span><span>Q. 古い指輪でもいい？</span></div>
        <p class="fv-target">対象：Pt900指輪 / Pt950指輪 / プラチナリング / 古い指輪 / 宝石付き指輪</p>

        <!-- ④ キャンペーンバナー（電話申込限定 最大30%UP・手数料完全無料）ポコポコ＋キラキラ -->
        <div class="fv-banner">
          {campDays > 0 ? (
            <a href="#" class="fv-banner-link" data-aff="manekiya" data-track="camp_fv" rel="nofollow sponsored">
              <img src="/images/fv-camp30.webp" alt="6/1〜6/30 期間限定 まねきや お電話申込の方限定 買取金額 最大30%UP・買取手数料完全無料 今すぐ電話で申し込む" width="1536" height="1024" loading="eager" decoding="async" />
            </a>
          ) : (
            <a href="#" class="camp2-cta" data-aff="manekiya" data-track="camp_fv_cta" rel="nofollow sponsored">
              <i>☎</i>電話で無料査定する
            </a>
          )}
        </div>

        <!-- ① 本日のプラチナ相場（価格を最速で表示）＋ ② 重さ別参考価格 -->
        <div class="fv-rate" id="rate">
          <p class="fv-rate-ttl"><i class="live-dot"></i>プラチナ指輪を売る前に確認したい相場の見方</p>
          <div class="rate-grid">
            <div><span>Pt1000</span><b>{yen(rates.pt1000)}</b><small>/g</small></div>
            <div><span>Pt950</span><b>{yen(rates.pt950)}</b><small>/g</small></div>
            <div class="rate-hot"><span>Pt900</span><b>{yen(rates.pt900)}</b><small>/g</small></div>
            <div><span>Pt850</span><b>{yen(rates.pt850)}</b><small>/g</small></div>
          </div>
          <p class="rate-updated">{rates.updatedAt}・出典：まねきや本日相場 ／ 📈 歴史的な高値圏</p>

          <div class="rate-ex">
            <h3>あなたの指輪は今いくら？（Pt900・重さ別の目安）</h3>
            <ul>
              <li><span>細めの指輪（約3g）</span><b>{ringEx(3)}</b></li>
              <li><span>標準的な指輪（約5g）</span><b>{ringEx(5)}</b></li>
              <li><span>太め・甲丸（約10g）</span><b>{ringEx(10)}</b></li>
            </ul>
            <p class="note">※地金だけのおおよその目安。結婚指輪・婚約指輪・コンビ（金とのミックス）もOK。宝石・ブランド・デザインでさらに上がることがあります（重量・状態で変動）。</p>
          </div>
          <a href="#" class="camp2-cta" data-aff="manekiya" data-track="rate_top_phone" rel="nofollow sponsored">
            <i>☎</i>今いくら？を電話で聞く
          </a>
        </div>

        <!-- 3社比較表 -->
        <div class="fv-tbl-head"><span class="fv-tbl-ttl">査定方法・手数料・相談しやすさの比較</span><i class="pr">PR</i></div>
        <div class="fv-tbl-wrap">
          <table class="fv-tbl">
            <thead>
              <tr>
                <th class="fv-th-item"></th>
                <th class="fv-th fv-th1 fv-th-gold"><span class="fv-rk-badge">👑 1位</span>まねきや<br /><a href="#" data-aff="manekiya" data-track="fv_tbl_bn_manekiya" rel="nofollow sponsored" style="display:block;"><img src="/images/manekiya_bn.png" alt="まねきや" style="width:100%;max-width:110px;height:auto;display:block;margin:4px auto 0;border-radius:4px;" loading="lazy" /></a></th>
                <th class="fv-th"><span class="fv-rk-badge2">🥈 2位</span>おたからや<br /><a href="#" data-aff="otakaraya" data-track="fv_tbl_bn_otakaraya" rel="nofollow sponsored" style="display:block;"><img src="/images/300_250-2.jpg" alt="おたからや" style="width:100%;max-width:110px;height:auto;display:block;margin:4px auto 0;border-radius:4px;" loading="lazy" /></a></th>
                <th class="fv-th"><span class="fv-rk-badge3">🥉 3位</span>ブラリバ<br /><a href="#" data-aff="buraiba" data-track="fv_tbl_bn_buraiba" rel="nofollow sponsored" style="display:block;"><img src="/images/300_250-3.jpg" alt="ブラリバ" style="width:100%;max-width:110px;height:auto;display:block;margin:4px auto 0;border-radius:4px;" loading="lazy" /></a></th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td class="fv-td-item">買取価格</td>
                <td class="fv-td fv-td1"><span class="mk good">◎</span><b>高価買取に強み<br />（編集部評価）</b></td>
                <td class="fv-td"><span class="mk ok">〇</span>高め</td>
                <td class="fv-td"><span class="mk ok">〇</span>高め</td>
              </tr>
              <tr>
                <td class="fv-td-item">手数料</td>
                <td class="fv-td fv-td1"><span class="mk good">◎</span><b>0円（完全無料）</b></td>
                <td class="fv-td"><span class="mk ok">〇</span>0円</td>
                <td class="fv-td"><span class="mk ok">〇</span>0円</td>
              </tr>
              <tr class="fv-tr-camp">
                <td class="fv-td-item">当サイト限定<br />キャンペーン</td>
                <td class="fv-td fv-td1">
                  {campDays > 0 ? (
                    <>
                      <span class="camp-badge">手数料10%無料</span><br />
                      <b class="up30">買取金額<br />最大<em>30%</em>UP</b>
                    </>
                  ) : (
                    <b>公式キャンペーン<br />要確認</b>
                  )}
                </td>
                <td class="fv-td"><span class="mk ok">〇</span><b>買取価格<br />最大20%UP</b></td>
                <td class="fv-td gray"><span class="mk bad">✕</span>なし</td>
              </tr>
              <tr>
                <td class="fv-td-item">結婚指輪<br />刻印対応</td>
                <td class="fv-td fv-td1"><span class="mk good">◎</span>結婚指輪・刻印<br />名前入り・片方OK</td>
                <td class="fv-td"><span class="mk good">◎</span>結婚指輪<br />対応</td>
                <td class="fv-td"><span class="mk ok">〇</span>宝石付き<br />中心</td>
              </tr>
              <tr>
                <td class="fv-td-item">壊れた品<br />でもOK</td>
                <td class="fv-td fv-td1"><span class="mk good">◎</span>他社で断られた<br />物でもOK</td>
                <td class="fv-td"><span class="mk good">◎</span>他社で断られた<br />物でもOK</td>
                <td class="fv-td"><span class="mk tri">△</span>要相談</td>
              </tr>
              <tr>
                <td class="fv-td-item">査定方法</td>
                <td class="fv-td fv-td1"><span class="mk good">◎</span>店舗・宅配<br />・出張</td>
                <td class="fv-td"><span class="mk ok">〇</span>店舗・出張</td>
                <td class="fv-td"><span class="mk good">◎</span>店舗・宅配<br />・出張</td>
              </tr>
              <tr class="fv-tr-cta">
                <td class="fv-td-item">電話相談</td>
                <td class="fv-td fv-td1">
                  <small class="cta-sub">＼査定だけでもOK／</small>
                  <a href="#" class="btn btn-phone sm" data-aff="manekiya" data-track="fv_tbl_phone" rel="nofollow sponsored"><i>☎</i>30%UP条件を聞く</a>
                  <a href="#" class="btn btn-web sm mt4" data-aff="manekiya" data-track="fv_tbl_web" rel="nofollow sponsored">WEBで査定</a>
                  {campDays > 0 && <p class="countdown">⏳ キャンペーン終了まで<br /><b>あと{campDays}日！</b></p>}
                </td>
                <td class="fv-td">
                  <a href="#" class="btn btn-ghost sm" data-aff="otakaraya" data-track="fv_tbl_otakaraya" rel="nofollow sponsored">公式サイト</a>
                </td>
                <td class="fv-td">
                  <a href="#" class="btn btn-ghost sm" data-aff="buraiba" data-track="fv_tbl_buraiba" rel="nofollow sponsored">公式サイト</a>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
        <p class="note">※買取価格・キャンペーン内容は変更になる場合があります。最新情報は各社公式でご確認ください。</p>

        <p class="cta-rec">📞 一番高くなりやすいのは“電話申込”（まねきや限定で最大30%UP）</p>
        <div class="cta-pair">
          <a href="#" class="btn btn-phone" data-aff="manekiya" data-track="fv_phone" rel="nofollow sponsored"><i>☎</i>今の査定額を電話で聞く</a>
          <a href="#" class="btn btn-web" data-aff="manekiya" data-track="fv_web" rel="nofollow sponsored">WEBで査定予約する</a>
        </div>
        <p class="cta-note">📞 電話申込で最大30%UP／無料・出張＆宅配OK・売らなくても大丈夫</p>

        <!-- ⑤ 比較表の下に口コミを1件だけ前出し（LP3にもそのまま流用可） -->
        <div class="fv-voice">
          <span class="stars">★★★★★</span>
          <b class="fv-voice-ttl">何でも相談できるスタッフさんで、安心！</b>
          <p class="fv-voice-txt">友人の紹介でまねきやさんへ。初めは緊張しましたが、疑問にもとても詳しく親切に答えてくださり、安心して取引できました。無理な要望にも嫌な顔ひとつせず交渉してくださり、予想より高く買い取っていただいて大変満足しています。</p>
          <small>ブランド品・貴金属</small>
        </div>
      </div>
    </section>

    <!-- ⑥ 損したくない人向け訴求（不安→まねきやの答え／LP3にも流用可） -->
    <section class="sec" id="fear">
      <div class="wrap">
        <img class="fuan-img" src="/images/fuan.webp" alt="売る前のこんな不安、先に解消します（査定後に断れる・手数料0円・X線で適正査定・相見積もりOK）" width="1024" height="1536" loading="lazy" decoding="async" />
        <a href="#" class="camp2-cta" data-aff="manekiya" data-track="fear_phone" rel="nofollow sponsored">
          <i>☎</i>不安なことをそのまま電話で聞く
        </a>
        <p class="point-cta-note">9時〜21時（年中無休）／査定だけ・相談だけでもOK</p>
      </div>
    </section>

    <!-- 05 ランキング -->
    <section class="sec" id="ranking">
      <div class="wrap">
        <div class="sec-head"><span class="chip">🏆 ランキング</span><h2>プラチナ指輪の査定相談先を比較</h2><p>編集部がおすすめする3社をくわしく紹介します。</p></div>

        <!-- 1位 -->
        <article class="rk rk-1">
          <div class="rk-editor-pick">編集部イチオシ</div>
          <div class="rk-ribbon"><i>👑</i>第1位</div>
          <div class="rk-head"><h3>まねきや</h3><span class="rk-star">★4.8</span><i class="pr">PR</i></div>
          <a href="#" data-aff="manekiya" data-track="rk_head_bn" rel="nofollow sponsored" style="display:block;margin:10px 0;">
            <img src="/images/manekiya_bn.png" alt="まねきや" style="width:100%;max-width:320px;height:auto;display:block;margin:0 auto;border-radius:8px;" loading="lazy" />
          </a>
          <p class="rk-for">プラチナ指輪を、できるだけ高く・手取りを減らさず売りたい人に</p>
          <ul class="rk-reasons">
            <li>✅ <b>査定料・キャンセル料0円！</b></li>
