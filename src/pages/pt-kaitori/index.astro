      letter-spacing:.02em; box-shadow:0 1px 2px rgba(0,0,0,.25);
    }
    .camp2-cond{ display:block; font-size:clamp(10px,3.2vw,15px); font-weight:800; text-shadow:0 1px 3px rgba(0,0,0,.45); white-space:nowrap; }
    .camp2-note{ font-size:10px; color:var(--sub); line-height:1.55; margin:8px 4px 0; }
    .camp2-main{ display:block; font-size:clamp(14px,4.6vw,22px); font-weight:900; line-height:1.05; text-shadow:0 1px 4px rgba(0,0,0,.4); }
