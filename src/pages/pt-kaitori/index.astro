    /* ポコポコ動くCTAボタン */
    .camp2-cta{
      display:flex; align-items:center; justify-content:center; gap:8px;
      width:92%; margin:10px auto 0; padding:14px 0; border-radius:999px;
      background:linear-gradient(180deg,#FF5A4D,#E01F1F); color:#fff;
