---
const PAGE_TITLE = "プラチナ指輪は今いくら？｜売る前に買取金額の目安をチェック";
const PAGE_DESC = "プラチナ指輪(Pt900/Pt950)が今だいたいいくらで売れそうか、重さと刻印を選ぶだけで30秒でわかります。安く買われないためのコツや、どこに持っていけばいいかも紹介。結婚指輪・古い指輪もOK。";
const CANONICAL = "https://kaitori.hakobu-family.com/pt-shindan/";
const OGP_IMAGE = "https://kaitori.hakobu-family.com/images/item-platinum-ring.webp";

import { getRates, yen, MARKET_SOURCE_URL } from "../../lib/rates.js";
const rates = await getRates();
const pt950 = rates.pt950;

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "ここで出る金額って何ですか？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "今日のプラチナの値段と、入力した重さでざっくり計算した「だいたいの金額」です。売る前に目安を知っておくと、お店で安く買われにくくなります。石やデザイン、状態によって実際の金額は変わります。"
      }
    },
    {
      "@type": "Question",
      "name": "なぜピッタリの金額じゃなく、幅があるんですか？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "金属だけの値段はだいたい決まりますが、状態やデザイン、石の有無で上がることがあるためです。なので「これくらい〜これくらい」と幅で出しています。"
      }
    },
    {
      "@type": "Question",
      "name": "結婚指輪や古い指輪でも分かりますか？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "はい。刻印が薄い・片方だけ・金と混ざった指輪でも、だいたいの目安が出せます。捨てたりする前に、まず一度見てみてください。"
      }
    },
    {
      "@type": "Question",
      "name": "このページはお店の公式サイトですか？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "いいえ。広告（PR）を含む案内ページです。金額はあくまで目安なので、正確な値段や条件はリンク先のお店で確認してください。"
      }
    }
  ]
};
---
<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{PAGE_TITLE}</title>
  <meta name="description" content={PAGE_DESC} />
  <link rel="canonical" href={CANONICAL} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={PAGE_TITLE} />
  <meta property="og:description" content={PAGE_DESC} />
  <meta property="og:url" content={CANONICAL} />
  <meta property="og:image" content={OGP_IMAGE} />
  <meta property="og:locale" content="ja_JP" />
  <meta property="og:site_name" content="金買取査定ナビ" />
  <meta name="twitter:card" content="summary_large_image" />
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700;900&family=Noto+Serif+JP:wght@500;700;900&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/styles.css?v=20260531-2" />
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-DMCWVLP3E3"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){ dataLayer.push(arguments); }
    gtag('js', new Date());
    gtag('config', 'G-DMCWVLP3E3');
    gtag('config', 'AW-18129603657');
  </script>
  <script is:inline>
    (function(c,l,a,r,i,t,y){
      c[a]=c[a]||function(){ (c[a].q=c[a].q||[]).push(arguments); };
      t=l.createElement(r); t.async=1; t.src="https://www.clarity.ms/tag/"+i;
      y=l.getElementsByTagName(r)[0]; y.parentNode.insertBefore(t,y);
    })(window, document, "clarity", "script", "wxnujpnscp");
  </script>
</head>
<body data-landing-intent="platinum_report">
  <header class="site-header rep-header">
    <div class="container header-inner">
      <a href="/pt-shindan/" class="brand" aria-label="金買取査定ナビ">
        <span class="brand-mark rep-mark">Pt</span>
        <span class="brand-text">プラチナ指輪 買取金額チェック</span>
      </a>
      <span class="pr-chip header-pr">PR</span>
    </div>
  </header>

  <main>
    <!-- ① FV：判定の約束 -->
    <section class="rep-hero">
      <div class="container rep-hero-inner">
        <div class="rep-hero-copy">
          <p class="rep-eyebrow">プラチナや結婚指輪を売ろうか迷っている方へ</p>
          <h1 class="rep-h1" data-fv-headline>この指輪、<br /><span class="rep-h1-em">いくらくらいで売れる？</span></h1>
          <p class="rep-subbrand">プラチナ指輪の買取金額しらべ</p>
          <p class="rep-lead">重さと刻印を選ぶだけで、<strong>今だいたいいくらで売れそうか</strong>が30秒でわかります。売るかどうかは、金額を見てから決めればOKです。</p>
          <div class="rep-hero-actions">
            <a href="#shindan" class="btn rep-btn rep-btn-primary" data-scroll-to="#shindan" data-track="report_hero_start">30秒で金額の目安を見る</a>
            <a href="#" class="btn rep-btn rep-btn-ghost" data-affiliate="manekiya" data-track="report_hero_phone" rel="nofollow sponsored">電話で聞いてみる</a>
          </div>
          <ul class="rep-hero-points">
            <li>だいたい<b>いくらで売れそうか</b></li>
            <li>これより安いと<b>損かも、の目安</b></li>
            <li>安く買われないための<b>かんたんなコツ</b></li>
          </ul>
        </div>

        <!-- レポートのチラ見せ -->
        <aside class="rep-hero-card" aria-label="金額の目安の見本">
          <div class="rep-card rep-card-teaser">
            <div class="rep-card-seal" aria-hidden="true">金額の<br />目安</div>
            <span class="rep-card-kicker">見本 / 金額の目安</span>
            <div class="rep-card-amount">
              <span>だいたいの金額（例）</span>
              <strong>約35,000〜38,600円</strong>
            </div>
            <div class="rep-ruler rep-ruler-static" aria-hidden="true">
              <div class="rep-ruler-bar">
                <span class="rep-ruler-zone rep-zone-low">安すぎ</span>
                <span class="rep-ruler-zone rep-zone-fair">このくらい</span>
              </div>
              <span class="rep-ruler-marker" style="left:72%"></span>
            </div>
            <p class="rep-card-foot">今日のプラチナの値段（Pt900 {yen(rates.pt900)}/g）で計算しています。</p>
          </div>
        </aside>
      </div>
      <div class="container rep-rate-strip" aria-label="本日のプラチナ単価">
        <span>本日のプラチナ買取単価</span>
        <b>Pt900 {yen(rates.pt900)}/g</b>
        <b>Pt950 {yen(pt950)}/g</b>
        <b>Pt1000 {yen(rates.pt1000)}/g</b>
        <small>{rates.updatedAt}・<a href={MARKET_SOURCE_URL} target="_blank" rel="noopener noreferrer nofollow sponsored">まねきや本日相場</a></small>
      </div>
    </section>

    <!-- ② 金額の目安／③ 結果表示 -->
    <section class="section rep-shindan-section" id="shindan">
      <div class="container">
        <div class="rep-section-head">
          <span class="rep-kicker">STEP 1 / かんたん入力</span>
          <h2 class="rep-h2">まず、だいたいの<br />金額を見てみましょう。</h2>
        </div>

        <div class="rep-shindan-grid">
          <form
            class="rep-form"
            data-appraisal
            data-rate-pt1000={rates.pt1000}
            data-rate-pt950={pt950}
            data-rate-pt900={rates.pt900}
            data-rate-pt850={rates.pt850}
            data-rate-k18={rates.k18}
          >
            <label class="rep-field">
              <span>① 刻印（純度）</span>
              <select name="purity" data-appraisal-purity>
                <option value="pt900">Pt900</option>
                <option value="pt950">Pt950</option>
                <option value="pt1000">Pt1000</option>
                <option value="pt850">Pt850</option>
                <option value="k18">K18 / 金とのコンビ</option>
              </select>
            </label>
            <label class="rep-field">
              <span>② 重さ（g）<small>分からなければ指輪は3〜5g目安</small></span>
              <input type="number" inputmode="decimal" min="0" step="0.1" placeholder="例：4" name="weight" data-appraisal-weight />
            </label>
            <fieldset class="rep-field rep-field-stone">
              <span>③ 宝石・装飾</span>
              <div class="rep-radio-row">
                <label><input type="radio" name="stone" value="none" checked data-appraisal-stone /> 地金のみ</label>
                <label><input type="radio" name="stone" value="stone" data-appraisal-stone /> 宝石・石付き</label>
              </div>
            </fieldset>
            <button type="submit" class="btn rep-btn rep-btn-primary rep-btn-wide" data-track="report_generate">金額の目安を見る</button>
            <p class="rep-form-note">入力した内容はどこにも送られません。今日の値段でその場で計算するだけです。</p>
          </form>

          <!-- ③ 生成されるレポート -->
          <div class="rep-card rep-card-result" data-appraisal-report hidden aria-live="polite">
            <div class="rep-card-seal" aria-hidden="true">金額の<br />目安</div>
            <span class="rep-card-kicker">あなたの指輪の目安</span>
            <div class="rep-card-amount">
              <span data-report-label>だいたいこのくらい</span>
              <strong data-report-range>—</strong>
            </div>

            <div class="rep-loss" data-report-loss-box hidden>
              <span>⚠ 何も知らずに売ると</span>
              <strong>最大 <b data-report-loss>—</b> くらい損するかも</strong>
              <small>高めに売れた場合と、安く買われた場合の差です</small>
            </div>
            <p class="rep-loss-lead">だから、<b>1社だけで決めない</b>のが安心です。何社か聞いてから決めましょう。</p>

            <div class="rep-ruler" aria-label="金額の目安">
              <div class="rep-ruler-bar">
                <span class="rep-ruler-zone rep-zone-low">安すぎ</span>
                <span class="rep-ruler-zone rep-zone-fair">このくらい</span>
              </div>
              <span class="rep-ruler-line" data-report-line><i>これ以下は安すぎ</i></span>
              <span class="rep-ruler-range" data-report-rangebar></span>
            </div>

            <dl class="rep-breakdown">
              <div><dt>今日の値段</dt><dd data-report-rate>—</dd></div>
              <div><dt>重さ</dt><dd data-report-weight>—</dd></div>
              <div class="rep-breakdown-warn"><dt>これ以下は安すぎ</dt><dd data-report-floor>—</dd></div>
            </dl>

            <p class="rep-report-note" data-report-note></p>

            <div class="rep-warn-box">
              <strong>⚠ ただし、お店によってはこの金額より下がることもあります</strong>
              <ul>
                <li>あとから手数料を引かれる</li>
                <li>石やデザインの分を0円にされる</li>
                <li>その場で急かされて安く売ってしまう</li>
              </ul>
              <p>なので、<b>1社だけで決めずに、何社か聞いて比べる</b>のが一番安心です。</p>
            </div>

            <a href="#compare" class="btn rep-btn rep-btn-primary rep-btn-wide" data-scroll-to="#compare" data-track="report_cta_compare">どこに持っていけばいいか見る</a>
            <a href="#" class="rep-report-sub" data-affiliate="manekiya" data-track="report_cta_phone" rel="nofollow sponsored">または、電話でこの金額を伝えて聞いてみる →</a>
            <small class="rep-report-disclaimer">※この金額は今日の値段と重さで計算した目安です。石やデザイン、状態によって実際の金額は変わります。</small>
          </div>
        </div>
      </div>
    </section>

    <!-- ④ 安く買われないためのコツ -->
    <section class="section rep-armor-section">
      <div class="container">
        <div class="rep-section-head">
          <span class="rep-kicker">STEP 2 / 知っておくと安心</span>
          <h2 class="rep-h2">安く買われやすい、3つのパターン。</h2>
          <p class="rep-sub">だいたいの金額を知っていれば、どれもかんたんに防げます。</p>
        </div>
        <div class="rep-armor-grid">
          <article class="rep-armor-card">
            <span class="rep-armor-no">パターン 01</span>
            <h3>1gあたりの値段を低くする</h3>
            <p>「手数料0円」と言いつつ、1gの値段を相場より低くしているお店があります。<b>→「今日の1gの値段はいくらですか？」と聞いてみましょう。</b></p>
          </article>
          <article class="rep-armor-card">
            <span class="rep-armor-no">パターン 02</span>
            <h3>あとから費用を引く</h3>
            <p>査定のあとで、手数料や送料を引かれることがあります。<b>→「この金額、そのまま受け取れますか？」と先に聞きましょう。</b></p>
          </article>
          <article class="rep-armor-card">
            <span class="rep-armor-no">パターン 03</span>
            <h3>その場で急かす</h3>
            <p>「今日だけ」「今決めれば」と急かしてくることがあります。<b>→「一度持ち帰って考えます」と言って大丈夫です。</b></p>
          </article>
        </div>
        <div class="rep-armor-line">
          <strong>覚えておく一言：</strong>「今日の1gの値段は？」「この金額、そのまま受け取れますか？」<br />
          — この2つを聞くだけで、安く買われるのはほぼ防げます。
        </div>
      </div>
    </section>

    <!-- ⑤ テストに通った相談先（PR・順位は適性で） -->
    <section class="section rep-pick-section" id="compare">
      <div class="container">
        <div class="rep-section-head">
          <span class="rep-kicker">STEP 3 / どこに持っていく？</span>
          <h2 class="rep-h2"><span class="rep-echo" data-report-echo>この金額</span>くらいで売るなら、<br />1社だけで決めないのが安心。</h2>
          <p class="rep-sub">同じ指輪でも、お店によって金額は変わります。下の2つに当てはまるお店で、この金額を目安に聞いてみてください。</p>
        </div>
        <div class="rep-criteria">
          <span class="rep-criteria-label">お店選びのポイント</span>
          <ul>
            <li>出た金額が、そのまま受け取れる（あとから引かれない）</li>
            <li>今日の1gの値段を、その場で教えてくれる</li>
          </ul>
        </div>
        <div class="rep-pick-grid">
          <article class="rep-pick-card rep-pick-top">
            <div class="rank-badge rank-gold"><span aria-hidden="true">👑</span><span class="rank-no">迷ったらここ</span></div>
            <div class="rep-pick-head"><span>こんな人に</span><h3>手数料を引かれて、手取りが減るのがイヤな人</h3></div>
            <div class="rep-pick-name"><strong class="rep-brand">まねきや</strong><span class="pr-chip">PR</span></div>
            <p class="rep-pick-lead">海外にも売り先を持っているお店で、その分、高めの金額が出やすいのが特長です。<b>X線の機械</b>で調べてくれるので、刻印がない指輪や古い指輪でも、ちゃんと見てもらえます。</p>
            <ul class="rep-pick-points">
              <li><b>手数料が0円</b>。出た金額をそのまま受け取りやすい</li>
              <li>刻印のない指輪や、変形・キズありでも調べてもらえる</li>
              <li>査定料・出張料・キャンセル料も0円</li>
              <li>お店・出張・宅配から選べる（ネット申込は1分ほど）</li>
            </ul>
            <div class="rep-pick-flag">電話で申し込むと買取額アップの対象になることも<small>※今やっているかは公式ページでご確認ください</small></div>
            <a href="#" class="btn rep-btn rep-btn-primary rep-btn-wide" data-affiliate="manekiya" data-track="report_pick_manekiya" rel="nofollow sponsored">無料で査定してもらう</a>
            <a href="#" class="rep-pick-phone" data-affiliate="manekiya" data-track="report_pick_manekiya_phone" rel="nofollow sponsored">☎ 電話で聞いてみる</a>
          </article>
          <article class="rep-pick-card rep-pick-second">
            <div class="rank-badge rank-silver"><span aria-hidden="true">🏅</span><span class="rank-no">大手で安心</span></div>
            <div class="rep-pick-head"><span>こんな人に</span><h3>大手のお店に、直接持っていって相談したい人</h3></div>
            <div class="rep-pick-name"><strong class="rep-brand">おたからや</strong><span class="pr-chip">PR</span></div>
            <p class="rep-pick-lead">買取専門で<b>26年</b>、世界に<b>1,800店舗以上</b>ある大手です。お店の数が多いので、近くに持っていきやすいのが安心。手数料も0円です。</p>
            <ul class="rep-pick-points">
              <li>世界<b>1,800店舗以上</b>、26年やっている大手で安心</li>
              <li>大手なので、高めの金額が出ることも</li>
              <li>査定料・手数料・出張料は0円</li>
              <li>近くのお店への持ち込みも、出張もOK</li>
            </ul>
            <div class="rep-pick-flag">今だけのキャンペーンをやっていることも<small>※今やっているかは公式ページでご確認ください</small></div>
            <a href="#" class="btn rep-btn rep-btn-primary rep-btn-wide" data-affiliate="otakaraya" data-track="report_pick_otakaraya" rel="nofollow sponsored">無料で査定してもらう</a>
            <a href="#" class="rep-pick-phone" data-affiliate="otakaraya" data-track="report_pick_otakaraya_link" rel="nofollow sponsored">お店や条件を見てみる →</a>
          </article>
        </div>
        <p class="rep-pick-tip">迷ったら、<b>まねきや</b>と<b>おたからや</b>の両方に査定してもらって、高い方に売るのが一番損しません。どちらも査定だけ・無料で大丈夫です。</p>
        <div class="rep-memo">
          <span class="rep-memo-label">お店で見せれば伝わる、ひとことメモ</span>
          <p data-report-memo>「プラチナの指輪です。今日の値段だと◯円くらいって見たんですが、これ以上出せますか？」</p>
          <button type="button" class="rep-memo-btn" data-report-copy data-track="report_copy">この文をコピーする</button>
        </div>
        <p class="campaign-note">※当ページは広告（PR）を含みます。各社の最新の価格・手数料・対応条件はリンク先の公式ページで確認してください。</p>
      </div>
    </section>

    <!-- 安心バー -->
    <section class="reassurance-band rep-reassure" aria-label="査定前の安心ポイント">
      <div class="container reassurance-grid">
        <div><span>01</span><strong>査定だけでもOK・売るかは後で決められる</strong><p>金額を見てから、売るかどうか決めて大丈夫です。</p></div>
        <div><span>02</span><strong>古くても値段が付くことがある</strong><p>変形・刻印が薄い・片方だけの結婚指輪も、まず見てもらえます。</p></div>
        <div><span>03</span><strong>持ち歩くのが不安なら出張・宅配も</strong><p>家にいながら見てもらう方法もあります。</p></div>
      </div>
    </section>

    <!-- 最終CTA -->
    <section class="section rep-final-section">
      <div class="container rep-final-box">
        <h2 class="rep-h2">まずは、だいたいの金額を知ってから。</h2>
        <p>いくらくらいか分かっていれば、安く買われる心配がぐっと減ります。30秒でわかるので、売る前に一度見てみてください。</p>
        <div class="rep-hero-actions rep-final-actions">
          <a href="#shindan" class="btn rep-btn rep-btn-primary" data-scroll-to="#shindan" data-track="report_final_start">30秒で金額の目安を見る</a>
          <a href="#" class="btn rep-btn rep-btn-ghost" data-affiliate="manekiya" data-track="report_final_phone" rel="nofollow sponsored">電話で聞いてみる</a>
        </div>
      </div>
    </section>

    <section class="section faq-section rep-faq" id="faq">
      <div class="container">
        <div class="rep-section-head"><span class="rep-kicker">FAQ</span><h2 class="rep-h2">よくある質問</h2></div>
        <div class="faq-list">
          <article class="faq-item open"><button class="faq-q" type="button">ここで出る金額って何ですか？</button><div class="faq-a">今日のプラチナの値段と、入力した重さでざっくり計算した「だいたいの金額」です。売る前に目安を知っておくと、お店で安く買われにくくなります。石やデザイン、状態によって実際の金額は変わります。</div></article>
          <article class="faq-item"><button class="faq-q" type="button">なぜピッタリの金額じゃなく、幅があるんですか？</button><div class="faq-a">金属だけの値段はだいたい決まりますが、状態やデザイン、石の有無で上がることがあるためです。なので「これくらい〜これくらい」と幅で出しています。</div></article>
          <article class="faq-item"><button class="faq-q" type="button">結婚指輪や古い指輪でも分かりますか？</button><div class="faq-a">はい。刻印が薄い・片方だけ・金と混ざった指輪でも、だいたいの目安が出せます。捨てたりする前に、まず一度見てみてください。</div></article>
          <article class="faq-item"><button class="faq-q" type="button">このページはお店の公式サイトですか？</button><div class="faq-a">いいえ。広告（PR）を含む案内ページです。金額はあくまで目安なので、正確な値段や条件はリンク先のお店で確認してください。</div></article>
        </div>
