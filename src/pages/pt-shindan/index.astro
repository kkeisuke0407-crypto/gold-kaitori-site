---
const PAGE_TITLE = "プラチナ指輪の適正額レポート｜査定前に「買い叩かれない数字」を3分で";
const PAGE_DESC = "あなたのプラチナ指輪(Pt900/Pt950)の適正額レンジと、買い叩かれないための「買い叩きライン」を3分で。査定に行く前に、当日単価で算出した自分専用の適正額レポートを持てます。結婚指輪・古い指輪も。";
const CANONICAL = "https://kaitori.hakobu-family.com/pt-shindan/";
const OGP_IMAGE = "https://kaitori.hakobu-family.com/images/item-platinum-ring.webp";
const MARKET_SOURCE_URL = "https://manekiya.shop/rate/";

const fallbackRates = {
  updatedAt: "2026年5月29日 現在",
  pt1000: 10602,
  pt900: 9648,
  pt850: 9065,
  k18: 18824,
  gold: 25132
};

function parseYen(value) {
  return Number(String(value || "").replace(/[^\d-]/g, ""));
}
function yen(value) {
  return `${Number(value).toLocaleString("ja-JP")}円`;
}

async function getPlatinumRates() {
  try {
    const response = await fetch(MARKET_SOURCE_URL);
    if (!response.ok) throw new Error("rate_fetch_failed");
    const html = await response.text();
    const text = html
      .replace(/<script[\s\S]*?<\/script>/gi, " ")
      .replace(/<style[\s\S]*?<\/style>/gi, " ")
      .replace(/<[^>]+>/g, " ")
      .replace(/&nbsp;|&#160;/g, " ")
      .replace(/\s+/g, " ")
      .trim();
    const updated = text.match(/※(20\d{2})年(\d{1,2})月(\d{1,2})日現在/);
    const pt1000 = text.match(/Pt\s+([\d,]+)円/);
    const pt900 = text.match(/Pt900\s+([\d,]+)円/);
    const pt850 = text.match(/Pt850\s+([\d,]+)円/);
    const k18 = text.match(/K18\s+([\d,]+)円/);
    const gold = text.match(/金\s+([\d,]+)円/);
    if (!pt900 && !pt1000) throw new Error("rate_parse_failed");
    return {
      updatedAt: updated ? `${updated[1]}年${updated[2]}月${updated[3]}日 更新` : fallbackRates.updatedAt,
      pt1000: pt1000 ? parseYen(pt1000[1]) : fallbackRates.pt1000,
      pt900: pt900 ? parseYen(pt900[1]) : fallbackRates.pt900,
      pt850: pt850 ? parseYen(pt850[1]) : fallbackRates.pt850,
      k18: k18 ? parseYen(k18[1]) : fallbackRates.k18,
      gold: gold ? parseYen(gold[1]) : fallbackRates.gold
    };
  } catch (_) {
    return { ...fallbackRates };
  }
}

const rates = await getPlatinumRates();
const pt950 = Math.round((rates.pt1000 + rates.pt900) / 2);

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "「適正額レポート」とは何ですか？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "当日のプラチナ買取単価をもとに、あなたの指輪の適正額レンジと、これを下回ると買い叩きと判断できる「買い叩きライン」を算出した、自分専用の目安レポートです。査定前に持っておくことで、提示額が適正かを自分で判断できます。実額は刻印・重量・宝石やデザイン・査定日で変わります。"
      }
    },
    {
      "@type": "Question",
      "name": "なぜ単一の金額でなく「レンジ」で出すのですか？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "地金の重さと当日単価で下限はほぼ決まりますが、状態・デザイン・宝石の有無で上振れするためです。1点の額を約束する店ほど内訳が不透明なことがあります。適正レンジと内訳を開示することが、買い叩きを防ぐ一番の武器になります。"
      }
    },
    {
      "@type": "Question",
      "name": "結婚指輪や古いプラチナ指輪でもレポートは出ますか？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "はい。刻印が薄い・片方だけ・金とのコンビでも、プラチナとして地金の適正額の目安が出せます。自分で価値を決めて処分する前に、まず適正額を確認してください。"
      }
    },
    {
      "@type": "Question",
      "name": "このページは買取店の公式サイトですか？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "いいえ。当サイトは買取店の公式サイトではなく、広告（PR）を含む案内ページです。レポートは目安であり、最新の価格・条件はリンク先の公式ページで確認してください。"
      }
    }
  ]
};
