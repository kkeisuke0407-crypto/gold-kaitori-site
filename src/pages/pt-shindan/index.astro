<body data-landing-intent="platinum_report">
  <header class="site-header rep-header">
    <div class="container header-inner">
      <a href="/pt-shindan/" class="brand" aria-label="金買取査定ナビ">
        <span class="brand-mark rep-mark">Pt</span>
        <span class="brand-text">プラチナ指輪 売却前診断</span>
      </a>
      <span class="pr-chip header-pr">PR</span>
    </div>
  </header>

  <main>
    <!-- ① FV：判定の約束 -->
    <section class="rep-hero">
      <div class="container rep-hero-inner">
        <div class="rep-hero-copy">
          <p class="rep-eyebrow">結婚指輪・プラチナ指輪をお持ちの方へ</p>
          <h1 class="rep-h1">その金額で、<br /><span class="rep-h1-em">売って大丈夫</span>ですか？</h1>
          <p class="rep-lead">たった30秒。あなたの指輪の<strong>適正売却価格</strong>を確認してから、売るか決められます。当日単価で、自分専用の<strong>査定レポート</strong>を作ります。</p>
          <div class="rep-hero-actions">
            <a href="#shindan" class="btn rep-btn rep-btn-primary" data-scroll-to="#shindan" data-track="report_hero_start">30秒で無料診断する</a>
            <a href="#" class="btn rep-btn rep-btn-ghost" data-affiliate="manekiya" data-track="report_hero_phone" rel="nofollow sponsored">電話で適正額を聞く</a>
          </div>
          <ul class="rep-hero-points">
            <li>あなたの指輪の<b>適正売却価格レンジ</b></li>
            <li>これ以下は損する<b>買い叩きライン</b></li>
            <li>査定で損しない<b>複数比較のコツ</b></li>
          </ul>
        </div>

        <!-- レポートのチラ見せ -->
        <aside class="rep-hero-card" aria-label="適正額レポートの見本">
          <div class="rep-card rep-card-teaser">
            <div class="rep-card-seal" aria-hidden="true">適正額<br />REPORT</div>
            <span class="rep-card-kicker">SAMPLE / 適正額レポート</span>
            <div class="rep-card-amount">
              <span>あなたの適正額レンジ（例）</span>
              <strong>約35,000〜38,600円</strong>
            </div>
            <div class="rep-ruler rep-ruler-static" aria-hidden="true">
              <div class="rep-ruler-bar">
                <span class="rep-ruler-zone rep-zone-low">買い叩き</span>
                <span class="rep-ruler-zone rep-zone-fair">適正</span>
              </div>
              <span class="rep-ruler-marker" style="left:72%"></span>
            </div>
            <p class="rep-card-foot">本日Pt900単価 {yen(rates.pt900)}/g をもとに算出。あなたの指輪で作れます。</p>
          </div>
        </aside>
      </div>
      <div class="container rep-rate-strip" aria-label="本日のプラチナ単価">
        <span>本日のプラチナ買取単価</span>
        <b>Pt900 {yen(rates.pt900)}/g</b>
        <b>Pt950 {yen(pt950)}/g</b>
        <b>Pt1000 {yen(rates.pt1000)}/g</b>
        <small>{rates.updatedAt}・<a href={MARKET_SOURCE_URL} target="_blank" rel="noopener noreferrer nofollow sponsored">まねきや本日相場</a></small>
      </div>
    </section>

    <!-- ② 適正レンジ診断＝ものさし／③ レポート生成 -->
    <section class="section rep-shindan-section" id="shindan">
      <div class="container">
        <div class="rep-section-head">
          <span class="rep-kicker">STEP 1 / 30秒で診断</span>
          <h2 class="rep-h2">あなたの指輪、<br />いくらなら売っていい？</h2>
        </div>

        <div class="rep-shindan-grid">
          <form
            class="rep-form"
            data-appraisal
            data-rate-pt1000={rates.pt1000}
            data-rate-pt950={pt950}
            data-rate-pt900={rates.pt900}
            data-rate-pt850={rates.pt850}
            data-rate-k18={rates.k18}
          >
            <label class="rep-field">
              <span>① 刻印（純度）</span>
              <select name="purity" data-appraisal-purity>
                <option value="pt900">Pt900</option>
                <option value="pt950">Pt950</option>
                <option value="pt1000">Pt1000</option>
                <option value="pt850">Pt850</option>
                <option value="k18">K18 / 金とのコンビ</option>
              </select>
            </label>
            <label class="rep-field">
              <span>② 重さ（g）<small>分からなければ指輪は3〜5g目安</small></span>
              <input type="number" inputmode="decimal" min="0" step="0.1" placeholder="例：4" name="weight" data-appraisal-weight />
            </label>
            <fieldset class="rep-field rep-field-stone">
              <span>③ 宝石・装飾</span>
              <div class="rep-radio-row">
                <label><input type="radio" name="stone" value="none" checked data-appraisal-stone /> 地金のみ</label>
                <label><input type="radio" name="stone" value="stone" data-appraisal-stone /> 宝石・石付き</label>
              </div>
            </fieldset>
            <button type="submit" class="btn rep-btn rep-btn-primary rep-btn-wide" data-track="report_generate">適正額レポートを作る</button>
            <p class="rep-form-note">入力情報は送信されません。当日単価をもとにその場で計算する目安です。</p>
          </form>

          <!-- ③ 生成されるレポート -->
          <div class="rep-card rep-card-result" data-appraisal-report hidden aria-live="polite">
            <div class="rep-card-seal" aria-hidden="true">適正額<br />REPORT</div>
            <span class="rep-card-kicker">あなたの適正額レポート</span>
            <div class="rep-card-amount">
              <span data-report-label>適正額レンジ</span>
              <strong data-report-range>—</strong>
            </div>

            <div class="rep-ruler" aria-label="適正額のものさし">
              <div class="rep-ruler-bar">
                <span class="rep-ruler-zone rep-zone-low">買い叩き</span>
                <span class="rep-ruler-zone rep-zone-fair">適正</span>
              </div>
              <span class="rep-ruler-line" data-report-line><i>買い叩きライン</i></span>
              <span class="rep-ruler-range" data-report-rangebar></span>
            </div>

            <dl class="rep-breakdown">
              <div><dt>当日単価</dt><dd data-report-rate>—</dd></div>
              <div><dt>重さ</dt><dd data-report-weight>—</dd></div>
              <div class="rep-breakdown-warn"><dt>買い叩きライン</dt><dd data-report-floor>—</dd></div>
            </dl>

            <p class="rep-report-note" data-report-note></p>

            <div class="rep-warn-box">
              <strong>⚠ ただし、実際の査定ではこの額より下がることがあります</strong>
              <ul>
                <li>手数料・目減り計算で差し引かれる</li>
                <li>宝石・デザイン部分を0円査定にされる</li>
                <li>その場の即決で安く流される</li>
              </ul>
              <p>だから<b>1社で決めず、この適正額を守れる相談先で複数比較</b>するのが、損しない一番の近道です。</p>
            </div>

            <a href="#compare" class="btn rep-btn rep-btn-primary rep-btn-wide" data-scroll-to="#compare" data-track="report_cta_compare">この適正額を守れる相談先を見る</a>
            <a href="#" class="rep-report-sub" data-affiliate="manekiya" data-track="report_cta_phone" rel="nofollow sponsored">または、電話でこの適正額を伝えて聞く →</a>
            <small class="rep-report-disclaimer">※適正額は当日単価×重さの目安です。宝石・デザイン・状態で実額は変わります。正式な金額は査定で確定します。</small>
          </div>
        </div>
      </div>
    </section>

    <!-- ④ 武装ブリーフィング -->
    <section class="section rep-armor-section">
      <div class="container">
        <div class="rep-section-head">
          <span class="rep-kicker">STEP 2 / 武装する</span>
          <h2 class="rep-h2">店があなたを買い叩く、3つの手口。</h2>
          <p class="rep-sub">レポートの数字を持っていれば、どれも怖くありません。</p>
        </div>
        <div class="rep-armor-grid">
          <article class="rep-armor-card">
            <span class="rep-armor-no">手口 01</span>
            <h3>グラム単価を下げる</h3>
            <p>「手数料無料」と言いながら、単価そのものを相場より下げて回収する。<b>→ レポートの当日単価を見せて「この単価で計算して」と言う。</b></p>
          </article>
          <article class="rep-armor-card">
            <span class="rep-armor-no">手口 02</span>
            <h3>後出しで費用を引く</h3>
            <p>査定後に出張料・手数料・送料を差し引く。<b>→「提示額がそのまま手取りですか？引かれる費用は？」と先に聞く。</b></p>
          </article>
          <article class="rep-armor-card">
            <span class="rep-armor-no">手口 03</span>
            <h3>その場で決めさせる</h3>
            <p>「今だけ」「今日決めれば」で即決を迫る。<b>→「適正レンジは分かっているので、持ち帰って比べます」で十分。</b></p>
          </article>
        </div>
