---
import ShiftLandingPage from "../../components/gold-shift/ShiftLandingPage.astro";
import { goldShiftPages, type GoldShiftPage } from "../../data/goldShiftPages";

export function getStaticPaths() {
  return goldShiftPages.map((page) => ({ params: { slug: page.slug }, props: { page } }));
}

type Props = { page: GoldShiftPage };
const { page } = Astro.props;
---
<ShiftLandingPage page={page} />
