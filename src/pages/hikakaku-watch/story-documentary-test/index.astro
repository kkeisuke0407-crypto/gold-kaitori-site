    <script is:inline>
      (function(){
        var counter = document.querySelector('.js-count');
        if(!counter) return;
        var target = Number(counter.getAttribute('data-count')) || 73000;
        var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if(reduced){ counter.textContent = target.toLocaleString('ja-JP'); return; }
        var start = performance.now();
        var duration = 1200;
        function frame(now){
          var progress = Math.min((now - start) / duration, 1);
          var eased = 1 - Math.pow(1 - progress, 4);
          counter.textContent = Math.round(target * eased).toLocaleString('ja-JP');
          if(progress < 1) requestAnimationFrame(frame);
        }
        requestAnimationFrame(frame);
      })();
    </script>
