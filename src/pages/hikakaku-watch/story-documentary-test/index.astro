---
const affiliateUrl = 'https://tr.slvrbullet.com/cl/w0000678724/47671/39865/6';
const sourceModelUrl = 'https://hikakaku.com/category/all-category/watch/items/3311449/';

const faqItems = [
  {
    q: '査定したら、必ず売らないといけませんか？',
    a: 'いいえ。査定額を確認してから、売るかどうかを判断できます。金額に納得できなければ、売らない選択もできます。',
  },
  {
    q: '必ず20社から査定が来ますか？',
    a: 'いいえ。「最大20社」であり、商品や地域、条件などによって査定を行う業者数は異なります。',
  },
  {
    q: '事前査定額は、そのまま確定価格になりますか？',
    a: '確定価格とは限りません。実物の傷、使用状態、付属品などを確認した結果、最終査定額が変わる場合があります。このモデルケースでは、228,000円前後から218,000円になりました。',
  },
  {
    q: '古い時計や、長く使っていない時計も対象ですか？',
    a: '商品や業者によりますが、古い時計や長く使っていない時計でも査定対象になる場合があります。最終的な査定可否や査定額は各買取業者の判断になります。',
  },
  {
    q: '型番が分からない場合はどうしますか？',
    a: '時計本体や保証書などで確認できます。分からない場合は、申込画面の案内や査定業者へ確認してください。',
  },
  {
    q: '個人情報が心配です。',
    a: 'サービス利用時には必要な情報の入力があります。利用前に、ヒカカク！および各買取業者のプライバシーポリシーや連絡方法を確認することをおすすめします。',
  },
];

const comparisonRows = [
  { company: 'A社', price: '155,000円', delta: '基準' },
  { company: 'B社', price: '180,000円前後', delta: '+25,000円' },
  { company: 'C社', price: '205,000円前後', delta: '+50,000円' },
  { company: 'D社', price: '228,000円前後', delta: '+73,000円' },
];
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content="使っていないオメガの査定額を4社で比べ、最終判断までを追うモデルストーリーです。" />
    <meta name="robots" content="noindex, nofollow" />
    <title>155,000円で決めなかった理由｜時計査定ナビ・ドキュメンタリー版</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600;700&family=Noto+Sans+JP:wght@400;500;700;800;900&family=Noto+Serif+JP:wght@600;700;900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/hikakaku-watch-story/documentary-test.css" />

    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-DMCWVLP3E3"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){ dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', 'G-DMCWVLP3E3');
      gtag('config', 'AW-18129603657');
    </script>
    <script is:inline>
      (function(c,l,a,r,i,t,y){ c[a]=c[a]||function(){ (c[a].q=c[a].q||[]).push(arguments); };
        t=l.createElement(r); t.async=1; t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0]; y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", "wxnujpnscp");
    </script>
    <script is:inline>
      (function(){
        var INTENT = "hikakaku_watch_story_documentary_test";
        document.addEventListener("click", function(e){
          var a = e.target && e.target.closest ? e.target.closest('a[href^="https://tr.slvrbullet.com/"]') : null;
          if(!a) return;
          var params = {
            landing_intent: INTENT,
            cta_label: (a.getAttribute("aria-label") || a.textContent || "").trim().slice(0, 60),
            link_url: a.getAttribute("href"),
            transport_type: "beacon"
          };
          if(window.dataLayer) window.dataLayer.push(Object.assign({ event: "hikakaku_watch_mcv" }, params));
          if(typeof gtag === "function") gtag("event", "hikakaku_watch_mcv", params);
        }, true);
      })();
    </script>
  </head>
  <body>
    <main class="documentary-page">
      <header class="masthead" aria-label="時計査定ナビ">
        <p class="masthead__issue">ADVERTISEMENT · MODEL STORY · 2026</p>
        <p class="masthead__name">WATCH VALUE JOURNAL</p>
        <div class="masthead__meta">
          <span>時計査定ナビ</span>
          <span>PR</span>
        </div>
      </header>

      <div class="pr-note">
        <strong>広告｜当サイトは提携広告を含む比較・案内メディアです</strong>
        <span>本ページ経由で申込み等が行われた場合、当サイトが広告報酬を受け取ることがあります。</span>
      </div>

      <section class="hero" aria-labelledby="hero-title">
        <div class="hero__copy">
          <p class="hero__kicker">使っていなかったオメガ。</p>
          <h1 id="hero-title">近所の店にそのまま売らなくて、本当によかった。</h1>
          <p class="hero__lead"><strong>最初の査定は155,000円。</strong><br />そこで決めずに比べると、数字は3度変わりました。</p>
          <div class="hero__stat" aria-label="最大差額73,000円">
            <span class="hero__stat-label">同じ時計でも、最大</span>
            <strong><span class="js-count" data-count="73000">73,000</span><small>円差</small></strong>
          </div>
          <p class="hero__qualifier">OMEGA スピードマスター デイト 3511.50を想定した、査定比較のモデルストーリーです。</p>
          <a class="cta cta--hero" href={affiliateUrl} target="_blank" rel="sponsored noreferrer">査定額を比べてみる <span aria-hidden="true">›</span></a>
          <p class="cta-note">査定額を確認してから、売るかどうかを判断できます。</p>
        </div>
        <figure class="hero__visual">
          <img src="/hikakaku-watch-story/assets/hero-chronograph.webp" width="1080" height="1620" fetchpriority="high" alt="木目の机に置かれた銀色のクロノグラフ腕時計" />
          <figcaption>OMEGA SPEEDMASTER DATE · REF. 3511.50</figcaption>
        </figure>
      </section>

      <section class="opening-proof" aria-labelledby="opening-proof-title">
        <h2 id="opening-proof-title">155,000円は、答えではなく最初の数字だった。</h2>
        <ol class="price-run" aria-label="査定額の推移">
          {comparisonRows.map((row, index) => (
            <li class:list={{ 'price-run__best': index === comparisonRows.length - 1 }}>
              <span>{row.company}</span>
              <strong>{row.price}</strong>
              <small>{row.delta}</small>
            </li>
          ))}
        </ol>
        <p class="model-note">※公開情報と想定条件をもとに再構成したモデルケースです。査定額・売却額を保証するものではありません。</p>
      </section>

      <nav class="contents" aria-label="このページで分かること">
        <p>このページで分かること</p>
        <ul>
          <li><a href="#before">一店舗だけで決めない理由</a></li>
          <li><a href="#comparison">同じ時計でも変わる査定額</a></li>
          <li><a href="#final">事前査定と最終査定の違い</a></li>
          <li><a href="#criteria">価格だけで決めない基準</a></li>
        </ul>
      </nav>

      <article class="story">
        <section class="chapter" id="before" aria-labelledby="before-title">
          <header class="chapter__head">
            <p>売るつもりは、なかった。</p>
            <h2 id="before-title">クローゼットの奥から出てきた、昔のオメガ</h2>
          </header>
          <div class="editorial-split">
            <div class="prose">
              <p>きっかけは、クローゼットの整理でした。奥から出てきたのは、<strong>OMEGA スピードマスター デイト 3511.50。</strong>20代の頃によく使っていた時計です。</p>
              <p>最近はスマートウォッチばかりで、気づけば何年もほとんど出番がありません。ただ、手放すと決めていたわけでもありませんでした。</p>
              <blockquote>「これ、今いくらくらいになるんだろう？」</blockquote>
              <p>この時点では、<strong>値段を知りたかっただけ</strong>です。</p>
            </div>
            <figure class="media media--portrait">
              <img loading="lazy" decoding="async" src="/hikakaku-watch-story/assets/watch-accessories.webp" width="960" height="960" alt="時計と箱、保証書、余りコマのイメージ" />
              <figcaption>時計本体に加え、箱・保証書・余りコマも確認。</figcaption>
            </figure>
          </div>

          <div class="nearby-grid">
            <figure class="media media--person">
              <img loading="lazy" decoding="async" src="/hikakaku-watch-story/assets/story-person.webp" width="640" height="960" alt="近所の買取店に持ち込むか考える男性のイメージ" />
            </figure>
            <div class="prose">
              <h3>最初に考えたのは「近所の買取店」</h3>
              <p>「オメガ 買取」と検索すると、近所にも店はたくさんあります。けれど、どのサイトにも「高価買取」「査定無料」と似た言葉が並び、<strong>どこが本当に高いのかは分かりません。</strong></p>
              <p>もし一店舗で「15万円ですね」と言われたら、その場で納得していたかもしれません。比較する数字がないからです。</p>
            </div>
          </div>

          <div class="decision" aria-labelledby="decision-title">
            <h3 id="decision-title">あなたなら、15万円と言われたらどうしますか？</h3>
            <div class="decision__options">
              <div><span>A</span><strong>「そんなものかな」と、その場で売る</strong></div>
              <div><span>B</span><strong>他の店の査定額も見てから決める</strong></div>
            </div>
            <p>比較しない限り、<strong>“安いことに気づけない”可能性がある。</strong>このモデルケースではBを選びます。</p>
          </div>
        </section>

        <section class="chapter chapter--tint" aria-labelledby="start-title">
          <header class="chapter__head">
            <p>値段だけ知りたい。</p>
            <h2 id="start-title">売るかどうかは、結果を見てから決める</h2>
          </header>
          <div class="prose prose--wide">
            <p>ヒカカク！は、売りたい商品の情報を入力して、複数の買取業者へ査定を依頼できる比較サービスです。最大20社から査定を受けられますが、実際の業者数は商品や条件によって異なります。</p>
          </div>
          <ol class="mini-flow" aria-label="査定依頼から判断まで">
            <li><span>情報を入力</span><small>型番・状態・付属品</small></li>
            <li><span>査定額を比較</span><small>複数社の数字を見る</small></li>
            <li><span>結果から判断</span><small>売らない選択もできる</small></li>
          </ol>
          <a class="cta" href={affiliateUrl} target="_blank" rel="sponsored noreferrer">自分の時計を査定する <span aria-hidden="true">›</span></a>
        </section>

        <section class="chapter" aria-labelledby="input-title">
          <header class="chapter__head">
            <p>入力した条件。</p>
            <h2 id="input-title">型番も状態も、分かる範囲で正直に</h2>
          </header>
          <div class="input-layout">
            <figure class="media media--form">
              <img loading="lazy" decoding="async" src="/hikakaku-watch-story/assets/entry-form-with-copy-v3.webp" width="1024" height="1536" alt="OMEGA スピードマスター 3511.50の査定入力例" />
              <figcaption>入力画面のイメージ</figcaption>
            </figure>
            <div>
              <dl class="spec-sheet">
                <div><dt>ブランド</dt><dd>OMEGA</dd></div>
                <div><dt>モデル</dt><dd>スピードマスター</dd></div>
                <div><dt>型番</dt><dd>3511.50</dd></div>
                <div><dt>状態</dt><dd>使用感・細かな傷あり</dd></div>
                <div><dt>動作</dt><dd>正常</dd></div>
                <div><dt>付属品</dt><dd>箱・保証書・余りコマ</dd></div>
              </dl>
              <div class="prose">
                <p>写真は正面、裏側、ベルト、箱、保証書、余りコマをスマホで撮影。特別な撮影技術より、状態が伝わることを優先します。</p>
              </div>
            </div>
          </div>
        </section>

        <section class="data-chapter" id="comparison" aria-labelledby="comparison-title">
          <div class="data-chapter__inner">
            <p class="data-chapter__intro">そして、次の査定が届いた。</p>
            <h2 id="comparison-title">155,000円で終わらなかった。</h2>
            <ol class="data-timeline">
              {comparisonRows.map((row, index) => (
                <li>
                  <span class="data-timeline__index">0{index + 1}</span>
                  <div>
                    <small>{row.company}</small>
                    <strong>{row.price}</strong>
                  </div>
                  <em>{row.delta}</em>
                </li>
              ))}
            </ol>
            <div class="data-conclusion">
              <span>最小 → 最大</span>
              <strong>73,000円</strong>
              <p>同じ時計・同じ入力内容でも、提示される数字は一つではありません。</p>
            </div>
            <p class="data-chapter__note">※モデルケース。商品・状態・付属品・査定時期・業者等によって異なります。</p>
          </div>
        </section>

        <section class="chapter" aria-labelledby="compare-meaning-title">
          <header class="chapter__head">
            <p>比較する意味。</p>
            <h2 id="compare-meaning-title">一社の数字を、相場だと思い込まない</h2>
          </header>
          <div class="prose prose--wide">
            <p>最初の155,000円しか知らなければ、「この時計は15万円くらいなんだ」と判断していたかもしれません。複数社を見ることで、<strong>自分の時計がどの価格帯で評価されているのか</strong>が初めて見えてきます。</p>
          </div>
          <a class="cta cta--outline" href={affiliateUrl} target="_blank" rel="sponsored noreferrer">査定額を比べてみる <span aria-hidden="true">›</span></a>
        </section>

        <section class="chapter chapter--tint" id="criteria" aria-labelledby="criteria-title">
          <header class="chapter__head">
            <p>最高額だけでは決めない。</p>
            <h2 id="criteria-title">228,000円の周りに、4つの確認項目を置く</h2>
          </header>
          <div class="criteria-map" aria-label="査定額以外に確認する4項目">
            <div class="criteria-map__center"><small>事前査定最高額</small><strong>228,000円前後</strong></div>
            <article>
              <span aria-hidden="true">01</span><h3>口コミ・評判</h3><p>利用者の評価と対応への声</p>
            </article>
            <article>
              <span aria-hidden="true">02</span><h3>時計の買取実績</h3><p>ブランド時計の取扱経験</p>
            </article>
            <article>
              <span aria-hidden="true">03</span><h3>査定後の対応</h3><p>減額理由と説明の明瞭さ</p>
            </article>
            <article>
              <span aria-hidden="true">04</span><h3>買取方法・条件</h3><p>手数料、入金、受け渡し方法</p>
            </article>
          </div>
          <div class="prose prose--wide">
            <p>高い金額と、安心して取引できることは別です。<strong>「いくらで売れるか」だけでなく「誰に売るか」</strong>まで確認して判断します。</p>
          </div>
        </section>

        <section class="chapter" aria-labelledby="message-title">
          <header class="chapter__head">
            <p>事前査定は確定額ではない。</p>
            <h2 id="message-title">状態を詳しく伝えて、現物確認へ</h2>
          </header>
          <figure class="media media--conversation">
            <img loading="lazy" decoding="async" src="/hikakaku-watch-story/assets/dealer-conversation-with-copy-v3.webp" width="1536" height="1024" alt="ベルトの傷や付属品を伝え、現物確認後の正式査定について回答を受けるやり取りのイメージ" />
            <figcaption>ベルトの傷、箱、保証書、余りコマ、オーバーホール状況を共有。</figcaption>
          </figure>
          <div class="message-summary">
            <div><strong>伝えたこと</strong><span>傷・付属品・整備状況</span></div>
            <div><strong>業者の回答</strong><span>現物確認後に正式な査定額を案内</span></div>
          </div>
          <div class="shipping-layout">
            <div class="prose">
              <h3>高級時計を送るのは、少し怖い</h3>
              <p>時計本体をクッション材で包み、箱、保証書、余りコマを梱包。一度閉じた後に、保証書を入れたかもう一度確認して発送します。</p>
            </div>
            <figure class="media media--shipping">
              <img loading="lazy" decoding="async" src="/hikakaku-watch-story/assets/shipping-box.webp" width="1280" height="854" alt="時計と付属品を緩衝材で梱包した箱のイメージ" />
            </figure>
          </div>
        </section>

        <section class="final-result" id="final" aria-labelledby="final-title">
          <div class="final-result__inner">
            <p>現物確認後の判断。</p>
            <h2 id="final-title">最終査定は218,000円。</h2>
            <div class="final-result__compare">
              <div><small>事前査定</small><strong>228,000円前後</strong></div>
              <span aria-hidden="true">→</span>
              <div><small>現物確認後</small><strong>218,000円</strong></div>
            </div>
            <p class="final-result__delta">使用傷などを確認し、事前査定から <strong>−10,000円</strong></p>
            <blockquote>他社の数字を知っていたから、218,000円を自分で判断できた。</blockquote>
          </div>
        </section>

        <section class="chapter" aria-labelledby="what-if-title">
          <header class="chapter__head">
            <p>もし最初の査定で売っていたら。</p>
            <h2 id="what-if-title">差額より怖いのは、安さに気づけないこと</h2>
          </header>
          <div class="versus" aria-label="最初の査定額と最終売却額の比較">
            <div><small>最初の査定</small><strong>155,000円</strong></div>
            <span>VS</span>
            <div><small>最終売却額</small><strong>218,000円</strong></div>
          </div>
          <p class="versus__delta"><small>差額</small><strong>63,000円</strong></p>
          <blockquote class="large-quote">比較しなければ、155,000円が安いことにすら気づけなかったかもしれない。</blockquote>
          <a class="cta" href={affiliateUrl} target="_blank" rel="sponsored noreferrer">売る前に査定額を見る <span aria-hidden="true">›</span></a>
        </section>

        <section class="chapter chapter--tint" aria-labelledby="basis-title">
          <header class="chapter__head">
            <p>得たのは「最高値」より「基準」。</p>
            <h2 id="basis-title">納得して判断するための3つの数字</h2>
          </header>
          <div class="basis-list">
            <article><span>1</span><h3>価格の基準</h3><p>自分の時計が評価される価格帯を知る。</p></article>
            <article><span>2</span><h3>業者選びの基準</h3><p>口コミ、実績、対応、条件を確認する。</p></article>
            <article><span>3</span><h3>売る・売らないの基準</h3><p>結果を見て、今回は売らない判断もできる。</p></article>
          </div>
          <p class="section-statement">最高値を探せたことより、何も知らないまま売らなくて済んだこと。</p>
        </section>

        <section class="chapter" aria-labelledby="public-title">
          <header class="chapter__head">
            <p>公開相場は、材料のひとつ。</p>
            <h2 id="public-title">公開されている価格＝自分の時計の査定額ではない</h2>
          </header>
          <div class="reference-sheet">
            <dl>
              <div><dt>対象モデル</dt><dd>OMEGA スピードマスター デイト 3511.50</dd></div>
              <div><dt>モデルケースの事前最高額</dt><dd>228,000円前後</dd></div>
              <div><dt>モデルケースの最終売却額</dt><dd>218,000円</dd></div>
            </dl>
            <a href={sourceModelUrl} target="_blank" rel="nofollow noreferrer">ヒカカク！公式の同型番ページを確認 ↗</a>
          </div>
          <div class="prose prose--wide">
            <p>同じ型番でも、状態・傷・付属品・査定時期・買取業者によって金額は変わります。公開相場は目安であり、最後は自分の時計を見てもらわなければ分かりません。</p>
          </div>
        </section>

        <section class="chapter chapter--tint" aria-labelledby="check-title">
          <header class="chapter__head">
            <p>家に、こんな時計はありませんか。</p>
            <h2 id="check-title">値段を見てから売るか決めたい人へ</h2>
          </header>
          <ul class="checklist">
