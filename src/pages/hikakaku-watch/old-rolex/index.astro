---
// SLVRbullet の広告リンク（計測URL）。ページ末尾の引き継ぎタグが gclid 等を引き継ぐ対象がこのURL。
// ヒカカクの直リンクに戻すと成果が Google 広告へ連携されなくなる。
const affiliateUrl = 'https://tr.slvrbullet.com/cl/w0000678724/47671/39865/6';
const privacyUrl = 'https://hikakaku.com/privacypolicy';
// 引用元（ヒカカク！公式サイト）
const sourceRecordsUrl = 'https://hikakaku.com/category/all-category/watch/assessment_achievements/';
const sourceCaseUrl = 'https://hikakaku.com/estimate_form/watch';

// 証拠①：古いロレックスの査定実績（ヒカカク！公式の掲載実績より抜粋）
const pickRecords = [
  { model: 'デイトナ 16520', state: '中古品・使用感あり', price: '3,300,000', date: '2025.03.29' },
  { model: 'GMTマスターⅠ 16700 N番 赤青ベゼル', state: '中古美品', price: '1,600,000', date: '2025.03.11' },
  { model: 'エクスプローラーⅠ 114270', state: '中古美品', price: '880,000', date: '2025.03.16' },
];

// 証拠②：同一型番でも業者で提示額が変わる事例。棒の長さは最高額を100%とした相対値。
const spread = {
  model: 'ROLEX サブマリーナ デイト 16610',
  rows: [
    { label: 'A社', yen: '850,000', pct: 100, best: true },
    { label: 'B社', yen: '750,000', pct: 88, best: false },
    { label: 'C社', yen: '590,000', pct: 69, best: false },
  ],
  gap: '260,000',
};

// 「こんな時計でも」＝検索者の不安に即答するチェック項目
const doubts = [
  '何年も使っていない',
  '傷や使用感がある',
  '箱をなくした',
  '保証書がない',
  '型番が分からない',
  '長く動かしていない',
  '譲り受けたもの',
];

// 査定額を決める要素：時計側と業者側に分けて示す
const watchFactors = [
  { title: 'モデル・型番', body: '同じロレックスでもモデルや型番で評価は異なります。生産終了モデルなども含め、型番ごとの確認が必要です。' },
  { title: '時計の状態', body: '傷、使用感、動作状態、修理歴などが確認されます。' },
  { title: '付属品', body: '箱・保証書・余りコマなどの有無で査定額が変わる場合があります。' },
];
const shopFactors = [
  { title: '在庫状況', body: 'そのモデルを今欲しい店と、すでに在庫を多く持っている店では評価が変わることがあります。' },
  { title: '得意ジャンル', body: 'ロレックスの販売・買取を得意とする業者、アンティーク時計に強い業者など、得意分野は会社ごとに異なります。' },
  { title: '販売ルート', body: '国内店舗、海外販売、業者間取引など、買い取った時計を販売する方法も業者ごとに異なります。' },
  { title: '相場・タイミング', body: '為替や海外需要などによって、高級時計の相場が動く場合があります。' },
];

// 査定前に確認しておきたいこと
const prepareItems = [
  { title: '型番', body: '分かる場合は保証書などで確認。分からなくても、時計本体や写真から確認できる場合があります。' },
  { title: '箱・保証書・余りコマ', body: '残っているものがあれば、一緒に確認しておきます。' },
  { title: '時計の状態', body: '傷や使用感があっても、無理に自分で磨いたり修理したりする必要はありません。' },
  { title: '長く使っていない場合', body: '自己判断で処分せず、そのままの状態で査定可能か確認します。' },
];

const faqs = [
  { q: '査定だけでも利用できますか？', a: '査定額を確認してから、売るかどうかを判断できます。金額に納得できなければ、売らない選択もできます。' },
  { q: '古いロレックスでも査定できますか？', a: 'モデル・状態等によりますが、古い時計でも査定対象になる場合があります。具体的な査定可否や査定額は各買取業者が判断します。' },
  { q: '箱や保証書がありません。', a: '付属品が揃っていない場合でも、査定対象になる場合があります。現在手元にあるものを確認して査定を依頼してください。' },
  { q: '長く使っていません。', a: '長く使っていない時計でも査定対象になる場合があります。無理に自分で修理・研磨せず、現在の状態を伝えて確認する方法があります。' },
  { q: '必ず20社から査定が来ますか？', a: 'いいえ。「最大20社」であり、商品・地域・条件等によって査定を行う業者数は異なります。' },
  { q: '査定額は確定価格ですか？', a: '事前査定の場合、現物確認後に金額が変わる場合があります。傷・動作状態・付属品などを確認したうえで最終的な査定額が決まります。' },
];
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="昔買ったロレックスは、古いからといって価値がないとは限りません。複数の買取業者へまとめて査定を依頼し、金額を比べてから売るかどうかを決められる比較・案内ページです。" />
    <title>古いロレックスの買取価格を比べてから決める | 時計査定ナビ</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;600;700;800;900&family=Noto+Serif+JP:wght@600;700;900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/hikakaku-watch-compare/site.css" />
    <link rel="stylesheet" href="/hikakaku-watch-old-rolex/site.css" />
    <!-- 計測タグ（貴金属LP19ページと同じプロパティに相乗り）。GA4 → Clarity の順。 -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-DMCWVLP3E3"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){ dataLayer.push(arguments); }
      gtag('js', new Date()); gtag('config', 'G-DMCWVLP3E3'); gtag('config', 'AW-18129603657');
    </script>
    <script is:inline>
      (function(c,l,a,r,i,t,y){ c[a]=c[a]||function(){ (c[a].q=c[a].q||[]).push(arguments); };
        t=l.createElement(r); t.async=1; t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0]; y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", "wxnujpnscp");
    </script>
    <!-- 中間CV（MCV）＝CTAクリックの計測。GA4イベントとして送る。 -->
    <script is:inline>
      (function(){
        var INTENT = "hikakaku_watch_old_rolex";
        document.addEventListener("click", function(e){
          var a = e.target && e.target.closest ? e.target.closest('a[href^="https://tr.slvrbullet.com/"]') : null;
          if(!a) return;
          var params = {
            landing_intent: INTENT,
            cta_label: (a.getAttribute("aria-label") || a.textContent || "").trim().slice(0, 60),
            link_url: a.getAttribute("href"),
            transport_type: "beacon"
          };
          if(window.dataLayer) window.dataLayer.push(Object.assign({ event: "hikakaku_watch_mcv" }, params));
          if(typeof gtag === "function") gtag("event", "hikakaku_watch_mcv", params);
          // ★Google広告のイベントスニペット（CV-B）が届いたらここに追加：
          // if(typeof gtag === "function") gtag("event", "conversion", { send_to: "AW-18129603657/XXXXXXXX" });
        }, true);
      })();
    </script>

  </head>
  <body>
    <main class="watch-compare watch-compare--rolex">
      <div class="pr-bar">当サイトは提携広告を含む比較・案内メディアです</div>
      <div class="single-column-layout">

      <!-- 1. 約束 -->
      <section class="hero" aria-labelledby="page-title">
        <div class="hero__inner content">
          <p class="hero__kicker">昔買ったロレックス</p>
          <h1 id="page-title">古いからといって、<br /><strong>価値がないとは限りません。</strong></h1>
          <p class="hero__lead">まず今の査定額を確認して、<br />複数社を比べてから決められます。</p>
          <a class="cta cta--hero" href={affiliateUrl} target="_blank" rel="sponsored noreferrer">古いロレックスの査定額を調べる <span aria-hidden="true">›</span></a>
          <ul class="trust-list"><li>利用無料</li><li>査定だけでもOK</li><li>最大20社へ一括依頼</li></ul>
          <p class="image-note">※査定を行う業者数は商品・地域・条件等によって異なります。※査定の可否・査定額は時計の状態・型番・付属品・時期・買取業者等によって異なります。</p>
        </div>
      </section>

      <!-- 2. 不安に即答 -->
      <section class="section section--doubt" aria-labelledby="doubt-title">
        <div class="content">
          <p class="eyebrow">まず、よくある不安から</p>
          <h2 id="doubt-title">「こんな古いロレックスでも売れるの？」</h2>
          <p class="lead">下のような時計でも、査定対象になる場合があります。</p>
          <ul class="chips">{doubts.map((d) => <li>{d}</li>)}</ul>
          <p class="statement">「古いから安いだろう」と<br /><strong>自分だけで判断しないこと。</strong></p>
          <p class="lead">ロレックスはモデル・型番・状態・付属品・査定する業者によって評価が変わります。確認したいのは一般的な相場ではなく、<b>自分の1本がいくらか</b>です。</p>
          <p class="note-inline">※査定の可否・査定額は提携買取業者が時計の状態等を確認したうえで判断します。</p>
        </div>
      </section>

      <!-- 3. 証拠①：実際の査定額 -->
      <section class="section section--proof" aria-labelledby="proof-title">
        <div class="content">
          <p class="eyebrow">実績</p>
          <h2 id="proof-title">古いモデルも、実際に<br />この金額で査定されています</h2>
          <div class="proof-cards">
            {pickRecords.map((r) => (
              <article class="proof-card">
                <h3>{r.model}</h3>
                <p class="proof-card__state">{r.state}</p>
                <p class="proof-card__price"><b>{r.price}</b><span>円</span></p>
                <p class="proof-card__date">{r.date} 査定</p>
              </article>
            ))}
          </div>
          <p class="notice">出典：ヒカカク！公式サイト「腕時計の売買価格相場・査定実績」 <a href={sourceRecordsUrl} target="_blank" rel="nofollow noreferrer">{sourceRecordsUrl}</a> 掲載実績より抜粋。<br />※掲載金額は各査定日時点の事例です。現在の査定額を保証するものではありません。実際の査定額は状態・付属品・相場・時期・買取業者等によって異なります。</p>
          <a class="cta" href={affiliateUrl} target="_blank" rel="sponsored noreferrer">自分のロレックスはいくらか確認する <span aria-hidden="true">›</span></a>
        </div>
      </section>

      <!-- 4. 証拠②：業者による差 -->
      <section class="section section--spread" aria-labelledby="spread-title">
        <div class="content">
          <p class="eyebrow">業者による差</p>
          <h2 id="spread-title">同じ型番でも、<br />提示額はここまで変わります</h2>
          <p class="lead">近所の1社で「60万円です」と言われたとして、その金額が高いのか安いのか。普段から相場を見ていなければ、判断は難しいはずです。</p>

          <figure class="spread">
            <figcaption class="spread__model">{spread.model}</figcaption>
            <div class="spread__rows">
              {spread.rows.map((r) => (
                <div class:list={['spread__row', r.best && 'is-best']}>
                  <span class="spread__label">{r.label}</span>
                  <span class="spread__bar" style={`--w:${r.pct}%`}><b>{r.yen}<i>円</i></b></span>
                </div>
              ))}
            </div>
            <p class="spread__gap"><span>最高額と最低額の差</span><strong>{spread.gap}<i>円</i></strong></p>
          </figure>

          <p class="notice">出典：ヒカカク！公式サイト 腕時計の一括査定ページ掲載の買取事例（2018年7月3日時点の情報） <a href={sourceCaseUrl} target="_blank" rel="nofollow noreferrer">{sourceCaseUrl}</a><br />※過去の査定事例であり、現在の16610の査定相場を示すものではありません。現在の査定額を保証するものでもありません。※掲載内容は引用時点の情報です。</p>
          <p class="statement statement--quiet">この事例が示すのは「16610が85万円」ではなく、<br /><strong>同じ時計でも、聞く相手で提示額が変わること。</strong></p>
          <a class="cta" href={affiliateUrl} target="_blank" rel="sponsored noreferrer">売る前に複数社の査定額を比べる <span aria-hidden="true">›</span></a>
        </div>
      </section>

      <!-- 5. 仕組み：時計側／業者側 -->
      <section class="section section--why" aria-labelledby="why-title">
        <div class="content">
          <p class="eyebrow">仕組み</p>
          <h2 id="why-title">査定額は、何で決まるのか</h2>
          <p class="lead">検索して出てくる「買取相場」は平均値です。実際の金額は、<b>時計側の要素</b>と<b>業者側の事情</b>の両方で決まります。</p>

          <div class="why-col">
            <h3 class="why-head why-head--watch"><span>あなたの時計側</span>3つの要素</h3>
            <dl class="deflist">
              {watchFactors.map((f) => <div><dt>{f.title}</dt><dd>{f.body}</dd></div>)}
            </dl>
          </div>

          <div class="why-col">
            <h3 class="why-head why-head--shop"><span>買取業者側</span>4つの事情</h3>
            <dl class="deflist">
              {shopFactors.map((f) => <div><dt>{f.title}</dt><dd>{f.body}</dd></div>)}
            </dl>
          </div>

          <p class="statement statement--quiet">時計側は変えられませんが、<br /><strong>「どの業者に聞くか」は選べます。</strong></p>
          <a class="cta" href={affiliateUrl} target="_blank" rel="sponsored noreferrer">まとめて査定を依頼してみる <span aria-hidden="true">›</span></a>
        </div>
      </section>

      <!-- 6. 準備 -->
      <section class="section section--prepare" aria-labelledby="prepare-title">
        <div class="content">
          <p class="eyebrow">準備</p>
          <h2 id="prepare-title">査定前に確認しておく4つ</h2>
          <ol class="prep-list">
            {prepareItems.map((p) => <li><b>{p.title}</b><span>{p.body}</span></li>)}
          </ol>
          <p class="note-inline">※無理に自分で研磨・修理をすると、かえって評価が下がることがあります。</p>
        </div>
      </section>

      <!-- 7. 選択肢 -->
      <section class="section section--options" aria-labelledby="options-title">
        <div class="content">
          <p class="eyebrow">選択肢</p>
          <h2 id="options-title">売る方法は、一括査定だけではありません</h2>
          <div class="table-scroll">
            <table class="opt-table">
              <thead><tr><th>方法</th><th>特徴</th><th>向いている人</th></tr></thead>
              <tbody>
                <tr class="is-focus"><th>一括査定</th><td>複数社の査定額を比較して判断できる</td><td>なるべく比較してから決めたい</td></tr>
                <tr><th>買取店へ持込</th><td>その場で査定できる</td><td>早く現金化したい</td></tr>
                <tr><th>フリマ・個人売買</th><td>自分で価格を設定できる</td><td>出品・発送の手間をかけられる</td></tr>
                <tr><th>質屋</th><td>売却せず預けて借入できる場合がある</td><td>手放したくない</td></tr>
              </tbody>
            </table>
          </div>
          <div class="verdict">
            <p><b>今日中に必ず現金化したい</b>なら、店頭買取のほうが向いています。</p>
            <p><b>金額を比べてから決めたい</b>なら、一括査定が向いています。</p>
          </div>
        </div>
      </section>

      <!-- 8. 手順 -->
      <section class="section section--steps" aria-labelledby="steps-title">
        <div class="content">
          <p class="eyebrow">手順</p>
          <h2 id="steps-title">一度の入力で、比較まで進みます</h2>
          <ol class="steps4">
            <li><b>時計の情報を入力</b><span>ブランド・型番・状態・付属品など</span></li>
            <li><b>査定を依頼</b><span>対応可能な買取業者へまとめて依頼</span></li>
            <li><b>査定額を確認</b><span>各社から届いた内容を確認</span></li>
            <li><b>比較して決める</b><span>金額と業者の情報を見て判断</span></li>
          </ol>
          <p class="statement statement--quiet"><strong>査定額を見てから、売らないという選択もできます。</strong></p>

          <div class="callout">
            <h3>型番が分からなくても大丈夫</h3>
            <p>「昔買ったから型番なんて覚えていない」という場合も進められます。時計本体や保証書から確認する方法のほか、写真を撮ってブランドを判別する入口も用意されています。</p>
          </div>
          <a class="cta" href={affiliateUrl} target="_blank" rel="sponsored noreferrer">古いロレックスの査定額を比べてみる <span aria-hidden="true">›</span></a>
        </div>
      </section>

      <!-- 9. 疑問 -->
      <section class="section section--faq" aria-labelledby="faq-title">
        <div class="content">
          <p class="eyebrow">疑問</p>
          <h2 id="faq-title">よくある質問</h2>
          <div class="faq-list">{faqs.map((item) => <details><summary><span>Q</span>{item.q}</summary><div><b>A.</b><p>{item.a}</p></div></details>)}</div>
        </div>
      </section>

      <!-- 10. クロージング -->
      <section class="section section--closing" aria-labelledby="closing-title">
        <div class="content">
          <p class="eyebrow">最後に</p>
          <h2 id="closing-title">今いくらになるのか、<br />確認してから決めればいい。</h2>
          <p class="lead">古いから安い。傷があるから売れない。箱がないから価値がない。そう思っていても、実際に査定してみなければ分からないことがあります。</p>
          <p class="statement">まず査定額を確認する。複数社を比べる。<br /><strong>売るかどうかは、そのあとで決められます。</strong></p>
          <a class="cta cta--closing" href={affiliateUrl} target="_blank" rel="sponsored noreferrer">自分のロレックスの査定額を調べてみる <span aria-hidden="true">›</span></a>
          <p class="source-note">※査定額は時計のモデル・型番・状態・付属品・時期・買取業者等によって異なります。<br />※ヒカカク！は買取業者の査定・比較サービスであり、実際の買取は各買取業者との取引になります。個人情報の取り扱いは<a href={privacyUrl} target="_blank" rel="nofollow noreferrer">ヒカカク！プライバシーポリシー</a>をご確認ください。</p>
        </div>
      </section>

      </div>
      <footer class="footer"><div class="content"><p class="footer__name">時計査定ナビ <b>PR</b></p><p>当サイトはアフィリエイトプログラムを利用した第三者メディアです。掲載内容は株式会社じげん（ZIGExN Co., Ltd.）の公式サイト掲載情報をもとに作成しています。実際の条件は各社公式サイトでご確認ください。</p></div></footer>
    </main>
    <!-- is:inline 必須。外すと Astro が type="module" でバンドルし、CORSヘッダの無い外部スクリプトの読み込みに失敗する。 -->
    <script is:inline src="https://js.slvrbullet.com/pt.min.js"></script>
  </body>
</html>
