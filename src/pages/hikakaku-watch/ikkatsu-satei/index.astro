---
// 時計一括査定の汎用記事LP。
// 型番LP（/hikakaku-watch/story/[model]）のデザインを継承し、ストーリーを
// 「売る店どうする？ → 1店だけは不安 → でも店舗巡りは面倒 → 比較して選ぶ」に置き換えたもの。
// ブランド別LPは量産せず、?brand= で見出しとCTAの主語だけ差し替える（未指定時は「時計」）。

// SLVRbullet の広告リンク（計測URL）。遷移先はヒカカク！通常LP。
// ページ末尾の引き継ぎタグが gclid 等をこのURLへ引き継ぐ。直リンクに変えると成果が広告へ連携されない。
const affiliateUrl = 'https://tr.slvrbullet.com/cl/w0000678724/47671/39865/6';
const canonicalUrl = 'https://kaitori.hakobu-family.com/hikakaku-watch/ikkatsu-satei/';
// 査定事例の出典（ヒカカク！公式 腕時計の一括査定ページ）
const sourceCaseUrl = 'https://hikakaku.com/estimate_form/watch';

// 同じ時計で査定額が分かれた実例。/compare/ と /old-rolex/ で出典付き掲載中のデータと同一。
// 金額は変えないこと（架空の数字は載せない）。bar は最高額を100%とした棒の長さ。
const evidenceCase = {
  model: 'ROLEX サブマリーナ デイト 16610',
  rows: [
    { label: 'A社', yen: '85万円', bar: 100, best: true },
    { label: 'B社', yen: '75万円', bar: 88, best: false },
    { label: 'C社', yen: '59万円', bar: 69, best: false },
  ],
  gap: '26万円',
};

// ?brand= に使える値。URLから任意の文字列を表示させないため、必ずこの表に通す。
// label は本文に差し込む日本語表記、grid は「こんな時計も査定対象」の表示名。
const brands = [
  { slug: 'tagheuer', label: 'タグ・ホイヤー', grid: 'TAG HEUER' },
  { slug: 'longines', label: 'ロンジン', grid: 'LONGINES' },
  { slug: 'seiko', label: 'セイコー', grid: 'SEIKO' },
  { slug: 'omega', label: 'オメガ', grid: 'OMEGA' },
  { slug: 'grandseiko', label: 'グランドセイコー', grid: 'Grand Seiko' },
  { slug: 'breitling', label: 'ブライトリング', grid: 'BREITLING' },
  { slug: 'hamilton', label: 'ハミルトン', grid: 'HAMILTON' },
  { slug: 'rolex', label: 'ロレックス', grid: 'ROLEX' },
];

// 「買取店へ直接 vs 一括査定」の比較表。◎=向いている / △=やや不向き。
// 片側だけを持ち上げないよう、スピードとやり取りの少なさは買取店側を◎にしている。
const fitRows = [
  { label: 'すぐ売りたい', direct: ['good', '向いている'], bulk: ['fair', '比較する分、時間がかかることも'] },
  { label: '1店舗だけで決めるのが不安', direct: ['fair', '他店にも査定が必要'], bulk: ['good', '複数社を比べやすい'] },
  { label: '何店舗も回りたくない', direct: ['fair', '店舗ごとに移動・査定'], bulk: ['good', '店舗巡りを減らせる'] },
  { label: '査定額を比べたい', direct: ['fair', '自分で各店へ依頼'], bulk: ['good', 'まとめて査定依頼'] },
  { label: '売るかまだ迷っている', direct: ['fair', '店頭で判断しがち'], bulk: ['good', '金額を見てから考えやすい'] },
  { label: 'やり取りを少なくしたい', direct: ['good', '基本1社'], bulk: ['fair', '複数社から連絡の場合あり'] },
];
const fitMark = { good: { sym: '◎', sr: '向いている' }, fair: { sym: '△', sr: 'やや不向き' } };

const faqItems = [
  { q: '査定したら必ず売らないといけませんか？', a: 'いいえ。査定結果を確認して、金額に納得できなければ売却しなくても構いません。' },
  { q: '一括査定は無料ですか？', a: '査定依頼は無料です。' },
  { q: '型番が分からなくても大丈夫？', a: '時計に書かれている情報や、分かる範囲の情報から査定を進められる場合があります。' },
  { q: '古い時計でも査定できますか？', a: 'ブランド・モデル・状態によっては、古い時計でも査定対象になる場合があります。' },
  { q: '壊れた時計でも売れますか？', a: '故障品や不動品でも査定可能な業者があります。実際の査定可否は時計の状態などによって異なります。' },
  { q: '一括査定するとたくさん電話が来ますか？', a: '査定後の連絡方法や連絡数は、査定を担当する業者などによって異なります。複数社へ査定依頼をするサービスなので、複数の業者から連絡が入る場合があります。' },
];
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="時計1本を売るために何店舗も回るのは面倒。でも最初の1店舗だけで決めるのも不安。買取店へ直接売る方法と一括査定を比べ、まとめて査定額を比較してから売るかどうかを決める方法を紹介します。" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />
    <title>時計1本売るために、何店舗も回りますか？｜時計査定ナビ</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;600;700;800;900&family=Noto+Serif+JP:wght@600;700;900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/hikakaku-watch-story/site.css" />
    <link rel="stylesheet" href="/hikakaku-watch-story/visual-test.css" />
    <link rel="stylesheet" href="/hikakaku-watch-story/search-model.css" />
    <link rel="stylesheet" href="/hikakaku-watch-ikkatsu/site.css" />
    <!-- 計測タグ（他の時計LPと同じプロパティに相乗り）。GA4 → Clarity の順。 -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-DMCWVLP3E3"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){ dataLayer.push(arguments); }
      gtag('js', new Date()); gtag('config', 'G-DMCWVLP3E3'); gtag('config', 'AW-18129603657');
    </script>
    <script is:inline>
      (function(c,l,a,r,i,t,y){ c[a]=c[a]||function(){ (c[a].q=c[a].q||[]).push(arguments); };
        t=l.createElement(r); t.async=1; t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0]; y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", "wxnujpnscp");
    </script>
    <!-- 中間CV（MCV）＝アフィリエイトリンクのクリック計測。GA4へ1クリック1回だけ送る。 -->
    <script is:inline>
      (function(){
        var INTENT = "hikakaku_watch_ikkatsu_satei";
        document.addEventListener("click", function(e){
          var a = e.target && e.target.closest ? e.target.closest('a[href^="https://tr.slvrbullet.com/"]') : null;
          if(!a) return;
          if(typeof gtag !== "function") return;
          // クリック位置。data-cta があればそれを、無ければ包含セクションから導出する。
          var img = a.querySelector("img");
          var pos = a.getAttribute("data-cta");
          if(!pos){
            var sec = a.closest("section");
            if(sec){
              var m = String(sec.className || "").match(/section--([\w-]+)/);
              // /story/ のようにセクションへ id も section-- も付いていないページ向けに、
              // 最後の手段として aria-labelledby（"xxx-title"）から名前を取る。
              var al = (sec.getAttribute("aria-labelledby") || "").replace(/-title$/, "");
              pos = sec.id || (m && m[1]) || (/\bhero\b/.test(sec.className) ? "hero" : "") || al;
            }
          }
          // window.dataLayer.push({event:...}) は併用しない。gtag が同じ dataLayer に
          // 積むため、GTM を導入した時点で同一クリックが二重計上される。
          gtag("event", "hikakaku_watch_mcv", {
            landing_intent: INTENT,
            cta_position: pos || "unknown",
            // 画像だけのリンク（キャンペーンバナー）は textContent が改行だけになる。
            // trim してから候補を切り替えないと alt に到達しない。
            cta_label: ((a.getAttribute("aria-label") || "").trim()
              || (a.textContent || "").trim()
              || (img && img.getAttribute("alt") || "").trim()).slice(0, 60),
            link_url: a.getAttribute("href"),
            transport_type: "beacon"
          });
          // ★Google広告のイベントスニペット（CV-B）が届いたらここに追加：
          // gtag("event", "conversion", { send_to: "AW-18129603657/XXXXXXXX" });
        }, true);
      })();
    </script>
  </head>
  <body>
    <main class="watch-story watch-story--visual-test watch-story--search-model watch-story--ikkatsu">
      <div class="story-disclosure">当サイトは提携広告を含む比較・案内メディアです</div>

      {/* SECTION 1｜FV */}
      <section class="hero hero--search-model hero--ikkatsu" aria-labelledby="story-title">
        <img class="hero__image" src="/hikakaku-watch-story/assets/hero-chronograph.webp" width="1080" height="1620" alt="銀色のクロノグラフ腕時計のイメージ" />
        <div class="hero__content">
          <p class="hero__kicker"><span data-brand-label>時計</span>を売ろうと思っている方へ</p>
          <h1 id="story-title">時計1本売るために、<br /><strong>何店舗も回りますか？</strong></h1>
          <p class="hero__lead">1店舗だけで決めるのはちょっと不安。<br />でも、買取店を3店も4店も回って、そのたびに査定を待つのは正直めんどうです。</p>
          <p class="hero__message">一括査定で<br /><span>「比べてから売る」</span><br />という方法があります。</p>
          <p class="hero__point"><b>一度の申込みで複数社へ査定依頼</b>査定額を確認してから、売るかどうかを決められます。</p>
          <a class="story-cta story-cta--hero" data-cta="hero" href={affiliateUrl} target="_blank" rel="sponsored noreferrer">複数社の査定額を無料で比較する <span aria-hidden="true">›</span></a>
          <ul class="hero__checks">
            <li>最大20社へ査定依頼可能</li>
            <li>査定額に納得できなければ売却しなくてもOK</li>
          </ul>
          <p class="hero__note">※査定可能な業者数は商品・地域などによって異なります。</p>
        </div>
      </section>

      {/* SECTION 2｜あなたに合うのはどっち？
          機能説明ではなく、読者に「1店で即決したいわけじゃない／でも店は回りたくない
          ／だから一括査定が合う」と自己判断させるためのセクション。 */}
      <section class="story-section story-section--tint story-section--fit" aria-labelledby="fit-title">
        <p class="fit-pre">1店舗で決めるのは不安。<br />でも、何店舗も回るのは面倒。</p>
        <h2 class="section-heading" id="fit-title">あなたに合うのはどっち？</h2>
        <div class="story-copy">
          <p>時計を売る方法は、<strong class="neutral-strong">「買取店へ直接」</strong>と<strong class="neutral-strong">「一括査定で比較」</strong>の2つ。</p>
          <p>どちらが良い悪いではなく、<span class="mark">何を優先したいか</span>で向いている方法が変わります。</p>
        </div>

        <table class="fit-table">
          <caption class="sr-only">買取店へ直接売る方法と一括査定の比較（◎は向いている、△はやや不向き）</caption>
          <colgroup><col class="fit-table__c1" /><col /><col /></colgroup>
          <thead>
            <tr><th scope="col">比べたいこと</th><th scope="col">買取店へ直接</th><th scope="col">一括査定</th></tr>
          </thead>
          <tbody>
            {fitRows.map((row) => (
              <tr>
                <th scope="row">{row.label}</th>
                {[row.direct, row.bulk].map(([mark, text], i) => (
                  <td class:list={[`is-${mark}`, i === 1 && 'is-bulk']}>
                    <span class="fit-mark" aria-hidden="true">{fitMark[mark].sym}</span>
                    <span class="sr-only">{fitMark[mark].sr}：</span>
                    <span class="fit-text">{text}</span>
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>

        <div class="fit-cards">
          <div class="fit-card">
            <p class="fit-card__if">すぐ売りたいなら</p>
            <p class="fit-card__name">買取店へ直接</p>
            <ul>
              <li>売りたい店が決まっている</li>
              <li>比較よりスピード優先</li>
              <li>やり取りを少なくしたい</li>
            </ul>
          </div>
          <div class="fit-card fit-card--bulk">
            <p class="fit-card__if">比較してから決めたいなら</p>
            <p class="fit-card__name">一括査定</p>
            <ul>
              <li><b>1店舗だけで決めるのは不安</b></li>
              <li><b>何店舗も回るのは面倒</b></li>
              <li><b>査定額を比べてから決めたい</b></li>
              <li><b>金額を見て売るか考えたい</b></li>
            </ul>
          </div>
        </div>

        <div class="fit-verdict">
          <p class="fit-verdict__voice">「何店舗も回りたくない。<br />でも、最初の1店舗だけで<br class="sp-only" />決めるのも不安。」</p>
          <p>そんな方には、<strong>一括査定が向いています。</strong></p>
          <p>一度の申込みで複数社へ査定依頼できるので、店舗を探して回る手間を減らしながら、<span class="mark">査定額を比較してから判断できます。</span></p>
        </div>

        <p class="fit-cta-lead">まずは、今の査定額を<br class="sp-only" />比べてみませんか？</p>
        <a class="story-cta" data-cta="fit" href={affiliateUrl} target="_blank" rel="sponsored noreferrer">複数社の査定額を無料で比較する <span aria-hidden="true">›</span></a>
        <p class="fit-cta-note">査定額を確認してから売るか判断できます</p>
      </section>

      {/* SECTION 3｜共感 */}
      <section class="story-section story-section--empathy" aria-labelledby="empathy-title">
        <h2 class="section-heading" id="empathy-title">こんな時計、<br />家に眠っていませんか？</h2>
        <figure class="wide-visual"><img loading="lazy" decoding="async" src="/hikakaku-watch-story/assets/watch-accessories.webp" width="960" height="960" alt="箱や付属品と一緒にしまわれている腕時計のイメージ" /></figure>
        <ul class="check-list">
          <li>昔買ったけど、最近ほとんど使っていない</li>
          <li>プレゼントでもらったけど、今は着けていない</li>
          <li>新しい時計を買ってから、ずっとケースに入ったまま</li>
        </ul>
        <div class="story-copy">
          <p>そんな時計を見て、<strong class="neutral-strong">「これ、今売ったらいくらくらいになるんだろう？」</strong>と思ったことはありませんか？</p>
          <p>それなりに値段は付きそう。でも時計1本のために、買取店を調べて、店舗まで行って、査定を待って、さらに別のお店でも同じことをする。<span class="mark">そこまでするのは面倒。</span></p>
        </div>
        <div class="quote-panel">
          <p>とはいえ、<strong>最初のお店で出された金額だけで決めてしまうのも、ちょっと不安。</strong></p>
        </div>
        <p class="section-close">今回一括査定を使う理由は、ここです。</p>
      </section>

      {/* SECTION 4｜なぜ比較した方がいい？ */}
      <section class="story-section story-section--tint story-section--why" aria-labelledby="why-title">
        <h2 class="section-heading" id="why-title">同じ時計でも、<br />査定額が同じとは限りません</h2>
        <div class="story-copy">
          <p>時計の査定額は、ブランドやモデル、状態だけで決まるわけではありません。買取店によって、次のようなことが違います。</p>
        </div>
        <ul class="search-factors">
          <li>得意なブランドやモデル</li>
          <li>在庫状況</li>
          <li>販売ルート</li>
          <li>その時に欲しい時計</li>
        </ul>
        <div class="quote-panel">
          <p>そのため、<strong>同じ時計でも買取店によって査定額が変わることがあります。</strong></p>
        </div>
        <figure class="evidence" aria-label="同じ時計で査定額が分かれた実際の事例">
          <figcaption class="evidence__head"><img class="evidence__img" loading="lazy" decoding="async" src="/hikakaku-watch-old-rolex/img/submariner-16610.webp" width="1024" height="1536" alt={`${evidenceCase.model}のイメージ`} /><span class="evidence__meta"><span>実際の査定事例</span><b>{evidenceCase.model}</b></span></figcaption>
          <ul class="evidence__rows">
            {evidenceCase.rows.map((r) => (
              <li class:list={[r.best && 'is-best']}><span class="evidence__label">{r.label}</span><span class="evidence__bar" style={`--w:${r.bar}%`}><b>{r.yen}</b></span></li>
            ))}
          </ul>
          <p class="evidence__gap"><span>同じ時計でも</span><strong>{evidenceCase.gap}</strong><span>の差</span></p>
          <p class="evidence__so">だから、<b>比較してから決める意味があります。</b></p>
        </figure>
        <p class="story-note">出典：ヒカカク！公式サイト 腕時計の一括査定ページ掲載の買取事例（2018年7月3日時点の情報） <a href={sourceCaseUrl} target="_blank" rel="nofollow noreferrer">{sourceCaseUrl}</a><br />※過去の査定事例であり、現在の査定相場を示すものではありません。現在の査定額を保証するものでもありません。※時計の画像はイメージです。</p>
        <div class="story-copy">
          <p>高く売りたいなら、複数店舗で査定してもらう方法があります。ただし問題は、<span class="mark">そのために何店舗も回るのが面倒なこと。</span></p>
        </div>
        <p class="turn-line"><span>「店舗を回る」のではなく</span><strong>「査定額をまとめて比較する」</strong><span>という方法があります。</span></p>
      </section>

      {/* SECTION 5｜一括査定とは */}
      <section class="story-section story-section--service" aria-labelledby="service-title">
        <h2 class="section-heading" id="service-title">店舗を何軒も回る前に、<br />まず査定額を比べてみる</h2>
        <p class="service-logo"><img src="/hikakaku-watch-ikkatsu/img/hikakaku-logo.webp" width="350" height="100" loading="lazy" decoding="async" alt="ヒカカク！ 買取価格を比較するなら" /><span>最大20社の査定額をまとめて比較できるサービス</span></p>
        <div class="story-copy with-visual--wrap">
          <figure class="visual-card visual-card--flat visual-card--watch"><img loading="lazy" decoding="async" src="/hikakaku-watch-old-rolex/img/gmt-16700.webp" width="1024" height="1536" alt="赤と青のベゼルの腕時計のイメージ" /></figure>
          <p>ヒカカク！では、時計の情報を入力して査定を申し込むことで、<span class="mark">最大20社へ査定依頼</span>ができます。</p>
          <p>複数の査定結果を確認して、<strong class="neutral-strong">「この金額なら売ってもいい」</strong>と思える買取先があれば、その業者との売却を検討できます。</p>
          <p>逆に、<strong class="neutral-strong">「この金額なら今は売らなくていいかな」</strong>と思えば、無理に売却する必要はありません。</p>
        </div>
        <div class="point-box">
          <p class="point-box__label">POINT</p>
          <ol class="point-box__list">
            <li><span>1</span>無料で査定依頼</li>
            <li><span>2</span>複数社の金額を比較</li>
            <li><span>3</span>査定後に売るか判断</li>
          </ol>
        </div>
        <a class="story-cta" data-cta="service" href={affiliateUrl} target="_blank" rel="sponsored noreferrer">複数社の査定額を無料で比較する <span aria-hidden="true">›</span></a>
      </section>

      {/* SECTION 6｜核心：店舗巡りの手間 */}
      <section class="story-section story-section--tint story-section--route" aria-labelledby="route-title">
        <h2 class="section-heading" id="route-title">時計を売るために、<br />休日を使って3店舗回りますか？</h2>
        <div class="story-copy"><p>店舗を回って比べる場合と、一括査定で比べる場合を並べると、こうなります。</p></div>
        <div class="route-vs" role="group" aria-label="店舗を回る場合と一括査定の比較">
          <div class="route-vs__col route-vs__col--stores">
            <p class="route-vs__head">店舗を回る</p>
            <ol>
              <li>A店へ移動</li>
              <li class="is-wait">査定待ち</li>
              <li>B店へ移動</li>
              <li class="is-wait">査定待ち</li>
              <li>C店へ移動</li>
            </ol>
          </div>
          <p class="route-vs__vs" aria-hidden="true">VS</p>
          <div class="route-vs__col route-vs__col--bulk">
            <p class="route-vs__head">一括査定</p>
            <ol>
              <li>一度入力</li>
              <li>複数社から査定</li>
              <li class="is-goal">比較</li>
            </ol>
          </div>
        </div>
        <div class="person-row">
          <figure class="person-row__img"><img loading="lazy" decoding="async" src="/hikakaku-watch-story/assets/story-person.webp" width="640" height="960" alt="時計を売るためにどうするか考える男性のイラスト" /></figure>
          <div class="story-copy">
          <p>もちろん、これでも比較できます。でも、<strong>時計1本を売るためにそこまで時間を使うのは大変。</strong></p>
          <p>一括査定なら、最初の査定依頼をまとめて行い、届いた査定結果から比較できます。</p>
          </div>
        </div>
        <p class="turn-line turn-line--middle"><span>つまり、</span><strong>「1店舗だけで決める不安」と<br />「何店舗も回る面倒」の</strong><span>間を取れる方法です。</span></p>
