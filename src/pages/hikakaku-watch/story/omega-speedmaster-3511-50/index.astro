---
import { watchModelStoryBySlug, type WatchModelStory } from '../../../../data/hikakaku-watch-model-stories';

type Props = { storyVariant?: string; modelStory?: WatchModelStory };
const { storyVariant = 'omega-speedmaster-3511-50', modelStory } = Astro.props as Props;
const activeModelStory = modelStory ?? watchModelStoryBySlug[storyVariant];
const isModelStory = Boolean(activeModelStory);
const modelAssetRoot = activeModelStory ? `/hikakaku-watch-story/models/${activeModelStory.slug}-${activeModelStory.assetVersion ?? 'v2'}` : '';

const watchConfig = activeModelStory ? {
  search: {
    brand: 'ROLEX',
    brandSlug: 'rolex',
    model: activeModelStory.modelName,
    modelSlug: activeModelStory.slug.replace(/^rolex-/, '').replace(/-\d+[a-z]*$/i, ''),
    ref: activeModelStory.reference,
    slug: activeModelStory.slug,
  },
  story: {
    brand: 'ROLEX',
    model: activeModelStory.modelName,
    ref: activeModelStory.reference,
  },
  heroImage: `${modelAssetRoot}/hero.webp`,
  tracking: {
    landingIntent: 'hikakaku_watch_model_value',
  },
} as const : {
  search: {
    brand: 'OMEGA',
    brandSlug: 'omega',
    model: 'スピードマスター デイト',
    modelSlug: 'speedmaster-date',
    ref: '3511.50',
    slug: 'omega-speedmaster-3511-50',
  },
  story: {
    brand: 'OMEGA',
    model: 'スピードマスター デイト',
    ref: '3511.50',
  },
  heroImage: '/hikakaku-watch-story/assets/hero-chronograph.webp',
  tracking: {
    landingIntent: 'hikakaku_watch_model_value',
  },
} as const;

const formatYen = (value: number) => `${value.toLocaleString('ja-JP')}円`;
const formatSpokenYen = (value: number) => {
  if (value < 10000) return formatYen(value);
  const man = Math.floor(value / 10000);
  const remainder = value % 10000;
  return `${man}万${remainder ? remainder.toLocaleString('ja-JP') : ''}円`;
};

const modelCase = activeModelStory?.modelCase;
const modelSpread = modelCase ? modelCase.amountD - modelCase.amountA : 0;
const roundedModelSpread = activeModelStory?.slug === 'rolex-submariner-16610'
  ? '20万円以上'
  : `${Math.max(1, Math.floor(modelSpread / 50000) * 5)}万円以上`;

const storyData = activeModelStory && modelCase ? {
  amountA: formatYen(modelCase.amountA),
  amountB: formatYen(modelCase.amountB),
  amountC: formatYen(modelCase.amountC),
  amountD: formatYen(modelCase.amountD),
  amountFinal: formatYen(modelCase.amountFinal),
  amountASpoken: formatSpokenYen(modelCase.amountA),
  amountFirstNarrative: formatSpokenYen(modelCase.amountA),
  amountBSpoken: formatSpokenYen(modelCase.amountB),
  amountCSpoken: formatSpokenYen(modelCase.amountC),
  amountDSpoken: formatSpokenYen(modelCase.amountD),
  amountFinalSpoken: formatSpokenYen(modelCase.amountFinal),
  preToFinalDifference: formatYen(Math.abs(modelCase.amountD - modelCase.amountFinal)),
  finalDifference: formatYen(Math.abs(modelCase.amountFinal - modelCase.amountA)),
  maxDifference: formatYen(modelSpread),
  roundedDifference: roundedModelSpread,
  searchTerm: `${activeModelStory.shortName} ${activeModelStory.reference} 買取相場`,
  nearbySearchTerm: 'ロレックス 買取',
  accessoriesImage: `${modelAssetRoot}/watch-accessories.webp`,
  entryImage: `${modelAssetRoot}/entry-form-with-copy.webp`,
  sourceModelUrl: activeModelStory.officialUrl,
  sourceLinks: modelCase.sourceLinks,
} : {
  amountA: '155,000円',
  amountB: '180,000円',
  amountC: '205,000円',
  amountD: '228,000円',
  amountFinal: '218,000円',
  amountASpoken: '15万5,000円',
  amountFirstNarrative: '15万円',
  amountBSpoken: '18万円',
  amountCSpoken: '20万5,000円',
  amountDSpoken: '22万8,000円',
  amountFinalSpoken: '21万8,000円',
  preToFinalDifference: '10,000円',
  finalDifference: '63,000円',
  maxDifference: '73,000円',
  roundedDifference: '7万円以上',
  searchTerm: 'スピードマスター 3511.50 買取相場',
  nearbySearchTerm: 'オメガ 買取',
  accessoriesImage: '/hikakaku-watch-story/assets/watch-accessories.webp',
  entryImage: '/hikakaku-watch-story/assets/entry-form-with-copy-v3.webp',
  sourceModelUrl: 'https://hikakaku.com/category/all-category/watch/items/3311449/',
  sourceLinks: [{ label: 'ヒカカク！', url: 'https://hikakaku.com/category/all-category/watch/items/3311449/' }],
};

const searchWatch = {
  ...watchConfig.search,
  fullName: `${watchConfig.search.brand} ${watchConfig.search.model} ${watchConfig.search.ref}`,
};
const storyWatch = watchConfig.story;
const pageTitle = `${searchWatch.model} ${searchWatch.ref}の買取相場を調べる前に｜時計査定ナビ`;
const metaDescription = isModelStory
  ? `${searchWatch.fullName}の買取相場を調べている方向けに、${storyData.amountA}〜${storyData.amountD}の査定額モデルと、複数社比較で分かる価格差を紹介します。`
  : `${searchWatch.fullName}の買取相場を調べている方向けに、実際の査定額155,000円〜228,000円と、複数社比較で分かった価格差を紹介します。`;
const canonicalUrl = `https://kaitori.hakobu-family.com/hikakaku-watch/story/${searchWatch.slug}/`;

// SLVRbullet の広告リンク（計測URL）。ページ末尾の引き継ぎタグが gclid 等を引き継ぐ対象がこのURL。
// ヒカカク！の直リンクに戻すと成果が Google 広告へ連携されなくなる。
const affiliateUrl = 'https://tr.slvrbullet.com/cl/w0000678724/47671/39865/6';

// 型番別ページでは複数の公開査定・買取実績、元のオメガページではヒカカク！公式ページを参考元として表示する。
// 型番別ページの金額は公開情報をもとに再構成したモデルケースで、特定の一取引結果ではない。
const sourceModelUrl = storyData.sourceModelUrl;

const faqItems = [
  {
    q: '査定したら必ず売らないとダメ？',
    a: 'いいえ。査定額を確認してから、売るかどうかを判断できます。金額に納得できなければ、売らない選択もできます。',
  },
  {
    q: '必ず20社から査定が来る？',
    a: 'いいえ。「最大20社」なので、商品や地域、条件などによって査定を行う業者数は異なります。',
  },
  {
    q: '査定額は確定価格？',
    a: isModelStory
      ? `事前査定の場合、確定価格ではありません。実物の傷や使用状態、付属品などを確認した結果、最終査定額が変わる場合があります。このモデルケースでも、${storyData.amountD}前後から${storyData.amountFinal}になっています。`
      : '事前査定の場合、確定価格ではありません。実物の傷や使用状態、付属品などを確認した結果、最終査定額が変わる場合があります。僕の場合も、228,000円前後から218,000円になりました。',
  },
  {
    q: '古い時計や長く使っていない時計でも査定してもらえる？',
    a: '商品や業者によりますが、古い時計や長く使っていない時計でも査定の対象になる場合があります。査定の可否・査定額は、提携買取業者が現物を確認したうえで判断します。「値段がつかないだろう」と思っていても、一度確認してみる価値はあると思います。',
  },
  {
    q: '個人情報が心配です',
    a: '申し込み時には、サービス利用に必要な情報の入力があります。利用する前に、ヒカカク！や各買取業者のプライバシーポリシー、連絡方法などを確認したうえで利用するのがおすすめです。',
  },
];
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={metaDescription} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />
    <title>{pageTitle}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;600;700;800;900&family=Noto+Serif+JP:wght@600;700;900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/hikakaku-watch-story/site.css" />
    <link rel="stylesheet" href="/hikakaku-watch-story/visual-test.css" />
    <link rel="stylesheet" href="/hikakaku-watch-story/search-model.css" />
    {isModelStory && (
      <style is:global>
        @media (max-width: 340px) {
          .story-disclosure { padding-inline: 8px; font-size: 10px; letter-spacing: 0; }
          .price-strip { padding-inline: 10px; gap: 14px 8px; }
          .price-strip__label { font-size: 10px; letter-spacing: 0.02em; }
          .price-cell strong { font-size: 18px; }
        }
      </style>
    )}
    <!-- 計測タグ（貴金属LP19ページと同じプロパティに相乗り）。GA4 → Clarity の順。 -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-DMCWVLP3E3"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){ dataLayer.push(arguments); }
      gtag('js', new Date()); gtag('config', 'G-DMCWVLP3E3'); gtag('config', 'AW-18129603657');
    </script>
    <script is:inline>
      (function(c,l,a,r,i,t,y){ c[a]=c[a]||function(){ (c[a].q=c[a].q||[]).push(arguments); };
        t=l.createElement(r); t.async=1; t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0]; y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", "wxnujpnscp");
    </script>
    <!-- 中間CV（MCV）＝CTAクリックの計測。GA4イベントとして送る。 -->
    <script is:inline>
      (function(){
        var INTENT = "hikakaku_watch_model_value";
        function watchContext(){
          var body = document.body;
          var query = new URLSearchParams(window.location.search);
          return {
            watch_brand: body ? body.dataset.watchBrand : "",
            watch_model: body ? body.dataset.watchModel : "",
            watch_ref: body ? body.dataset.watchRef : "",
            compop: query.get("compop") || "",
            cluster_id: query.get("cluster_id") || ""
          };
        }
        document.addEventListener("click", function(e){
          var a = e.target && e.target.closest ? e.target.closest('a[href^="https://tr.slvrbullet.com/"]') : null;
          if(!a) return;
          var params = Object.assign({
            landing_intent: (document.body && document.body.dataset.intent) || INTENT,
            cta_label: (a.getAttribute("aria-label") || a.textContent || "").trim().slice(0, 60),
            link_url: a.getAttribute("href"),
            transport_type: "beacon"
          }, watchContext());
          if(window.dataLayer) window.dataLayer.push(Object.assign({ event: "hikakaku_watch_mcv" }, params));
          if(typeof gtag === "function") gtag("event", "hikakaku_watch_mcv", params);
          // ★Google広告のイベントスニペット（CV-B）が届いたらここに追加：
          // if(typeof gtag === "function") gtag("event", "conversion", { send_to: "AW-18129603657/XXXXXXXX" });
        }, true);
      })();
    </script>

  </head>
  <body
    data-intent={watchConfig.tracking.landingIntent}
    data-watch-brand={searchWatch.brandSlug}
    data-watch-model={searchWatch.modelSlug}
    data-watch-ref={searchWatch.ref}
  >
    <main class="watch-story watch-story--visual-test watch-story--search-model">
      <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
        <defs>
          <symbol id="ic-review" viewBox="0 0 48 48">
            <path d="M27 11h11a3 3 0 0 1 3 3v8a3 3 0 0 1-3 3h-1v4l-4.5-4H31" fill="none" stroke="currentColor" stroke-width="1.7" opacity=".4" stroke-linecap="round" stroke-linejoin="round" />
            <path d="M9 12h20a4 4 0 0 1 4 4v11a4 4 0 0 1-4 4H19l-7 6v-6H9a4 4 0 0 1-4-4V16a4 4 0 0 1 4-4z" fill="var(--icon-fill)" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
            <path d="M19 15.6l2.6 5.3 5.8.9-4.2 4.1 1 5.8-5.2-2.7-5.2 2.7 1-5.8-4.2-4.1 5.8-.9z" fill="var(--story-gold)" stroke="var(--story-gold)" stroke-width="1.2" stroke-linejoin="round" />
          </symbol>
          <symbol id="ic-record" viewBox="0 0 48 48">
            <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12.5 15.5V10a1.5 1.5 0 0 1 1.5-1.5h6A1.5 1.5 0 0 1 21.5 10v5.5" />
              <path d="M12.5 32.5V38a1.5 1.5 0 0 0 1.5 1.5h6a1.5 1.5 0 0 0 1.5-1.5v-5.5" />
              <circle cx="17" cy="24" r="9.5" />
              <path d="M17 24v-4.6M17 24l3.6 2.1" />
            </g>
            <path d="M29 40h16" fill="none" stroke="currentColor" stroke-width="1.6" opacity=".38" stroke-linecap="round" />
            <g stroke="var(--story-gold)" stroke-width="2.6" stroke-linecap="round" fill="none">
              <path d="M31.5 36.5v-5" /><path d="M37.5 36.5v-10" /><path d="M43.5 36.5v-15" />
            </g>
          </symbol>
          <symbol id="ic-support" viewBox="0 0 48 48">
            <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="16.5" cy="17.5" r="6" />
              <path d="M6 40c0-5.8 4.7-10.5 10.5-10.5S27 34.2 27 40" />
            </g>
            <path d="M30 8h11a3 3 0 0 1 3 3v8.5a3 3 0 0 1-3 3h-4.5L32 27v-4.5h-2a3 3 0 0 1-3-3V11a3 3 0 0 1 3-3z" fill="var(--icon-fill)" stroke="var(--story-gold)" stroke-width="2" stroke-linejoin="round" />
            <path d="M31.5 13.5h8M31.5 17.5h5" fill="none" stroke="var(--story-gold)" stroke-width="1.8" stroke-linecap="round" />
          </symbol>
          <symbol id="ic-fee" viewBox="0 0 48 48">
            <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="5" y="16" width="26" height="22" rx="2.5" />
              <path d="M5 23.5h26" /><path d="M18 16v7.5" />
            </g>
            <circle cx="36" cy="31" r="9.5" fill="var(--icon-fill)" stroke="var(--story-gold)" stroke-width="2" />
            <path d="M32.4 26.2l3.6 4.1 3.6-4.1M32.4 31.8h7.2M32.4 34.6h7.2M36 30.3V37" fill="none" stroke="var(--story-gold)" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
          </symbol>
        </defs>
      </svg>

      <div class="story-disclosure">当サイトは提携広告を含む比較・案内メディアです</div>

      <section class="hero hero--search-model" aria-labelledby="story-title">
        <img class="hero__image" src={watchConfig.heroImage} width="1080" height="1620" alt={isModelStory ? `${searchWatch.fullName}をイメージした腕時計` : `${searchWatch.fullName}をイメージした銀色のクロノグラフ腕時計`} />
        <div class="hero__content">
          <h1 id="story-title">
            <span class="hero__watch-name">{searchWatch.brand}<br />{searchWatch.model}<br />{searchWatch.ref}。</span>
            <span class="hero__question">今売ったら、<strong>いくらになる？</strong></span>
          </h1>
          <p class="hero__lead"><strong>最初の査定は{storyData.amountA}。</strong><br />でも、複数の買取店を比べてみると<br />査定額に<span>{storyData.roundedDifference}の差</span>が出ました。</p>
          <p class="hero__message">近所の店にそのまま<br />売らなくて、本当によかった。</p>
          <p class="hero__tagline">{isModelStory ? '35歳の僕が「ヒカカク！」で査定額を比べてみた話' : '35歳の僕が「ヒカカク！」を実際に使ってみた話'}</p>
          <a class="story-cta story-cta--hero" href={affiliateUrl} target="_blank" rel="sponsored noreferrer">{searchWatch.ref}の査定額を調べてみる <span aria-hidden="true">›</span></a>
        </div>
      </section>

      <section aria-label="査定額の比較">
        <div class="price-strip">
          <div class="price-strip__label">{searchWatch.fullName}<br />{isModelStory ? '査定額比較' : '実際の査定額比較'}</div>
          <div class="price-cell"><small>A社（最初の査定）</small><strong>{storyData.amountA}</strong></div>
          <div class="price-cell"><small>B社</small><strong>{storyData.amountB}</strong></div>
          <div class="price-cell"><small>C社</small><strong>{storyData.amountC}</strong></div>
          <div class="price-cell price-cell--best"><small>D社</small><strong>{storyData.amountD}</strong></div>
        </div>
        {isModelStory ? (
          <p class="story-note">※本ページは公開されている買取相場・査定実績等を参考に、状態や付属品等を想定して構成したモデルストーリーです。掲載金額は特定の1取引の実績ではなく、実際の査定・売却額を保証するものではありません。※掲載画像はイメージです。<br />参考：{storyData.sourceLinks.map((source, index) => (<><a href={source.url} target="_blank" rel="nofollow noreferrer">{source.label}</a>{index < storyData.sourceLinks.length - 1 ? '／' : ''}</>))}</p>
        ) : (
          <p class="story-note">※本ページは筆者の実体験をもとにしています。査定額は商品・状態・時期・買取業者によって異なり、実際の査定・売却額を保証するものではありません。※掲載の画像はイメージです。<br />参考：ヒカカク！公式サイト「OMEGA スピードマスター デイト 3511.50 の買取価格を比較」 <a href={sourceModelUrl} target="_blank" rel="nofollow noreferrer">{sourceModelUrl}</a></p>
        )}
      </section>

      <section class="story-section story-section--search-answer story-section--tint" aria-labelledby="search-answer-title">
        <h2 class="section-heading" id="search-answer-title">{searchWatch.ref}の買取相場を調べているなら、<br />本当に知りたいのは<br />「自分の{searchWatch.ref}はいくらになるか」だと思います。</h2>
        <div class="story-copy">
          <p>ネットで<strong class="neutral-strong">「{storyData.searchTerm}」</strong>と検索すると、過去の買取価格や参考価格は見つかります。</p>
          <p>ただ、それだけでは、自分が持っている{searchWatch.ref}が実際にいくらになるかは分かりません。</p>
          <p>同じ{searchWatch.ref}でも、次の条件によって査定額は変わります。</p>
        </div>
        <ul class="search-factors">
          <li>時計の状態</li>
          <li>ベルトやケースの傷</li>
          <li>箱や保証書などの付属品</li>
          <li>オーバーホールの状況</li>
          <li>査定する買取業者</li>
        </ul>
        <div class="story-copy">
          <p>だから僕も、<strong>「{searchWatch.ref}の一般的な相場」</strong>を見るだけではなく、<span class="mark">「自分の{searchWatch.ref}ならいくらになるのか」</span>を実際に確認してみることにしました。</p>
        </div>
        <a class="story-cta" href={affiliateUrl} target="_blank" rel="sponsored noreferrer">自分の{searchWatch.ref}はいくらか確認する <span aria-hidden="true">›</span></a>
      </section>

      <section class="story-section" aria-labelledby="sell-intent-title">
        <h2 class="section-heading" id="sell-intent-title">そもそも、売るつもりはなかった</h2>
        <div class="story-copy with-visual--wrap">
          <p>きっかけは、クローゼットの整理でした。</p>
          {isModelStory ? (
            <p>奥から出てきたのは、昔買った{storyWatch.brand}の腕時計。<strong class="neutral-strong">{storyWatch.brand} {storyWatch.model} {storyWatch.ref}。</strong>20代の頃から大切に使ってきた時計です。</p>
          ) : (
            <p>奥から出てきたのは、昔買ったオメガの腕時計。<strong class="neutral-strong">OMEGA スピードマスター デイト 3511.50。</strong>20代の頃によく使っていた時計です。</p>
          )}
          <figure class="visual-card visual-card--flat"><img loading="lazy" decoding="async" src={storyData.accessoriesImage} width="960" height="960" alt={isModelStory ? `${searchWatch.fullName}と箱、付属品のイメージ` : '腕時計と箱、付属品のイメージ'} /></figure>
          <p>当時は仕事でも休日でもかなり使っていましたが、最近はスマートウォッチばかり。気づけば、<span class="mark">ほとんど出番がなくなっていました</span>。</p>
          <p>時計自体が嫌いになったわけでもありません。ただ、<strong>「これ、今いくらくらいになるんだろう？」</strong>と、ふと思いました。</p>
          <p>最初はそれだけでした。売るかどうかまで決めていたわけではありません。</p>
        </div>
      </section>

      <section class="story-section story-section--tint" aria-labelledby="nearby-title">
        <h2 class="section-heading" id="nearby-title">最初は近所の買取店へ行こうとした</h2>
        <div class="story-copy with-visual--wrap">
          <p>スマホで、<strong class="neutral-strong">「{storyData.nearbySearchTerm}」</strong>と検索しました。すると、近所にも買取店がたくさん出てきます。</p>
          <figure class="visual-card visual-card--person"><img loading="lazy" decoding="async" src="/hikakaku-watch-story/assets/story-person.webp" width="640" height="960" alt="時計を売る店を考える男性のイラスト" /></figure>
          <p>どのサイトを見ても、似たようなキャッチコピーが並びます。でも、<span class="mark">正直どこが高いのか分かりません。</span></p>
          {isModelStory ? (
            <p>仮に近所の店へ持っていって、「{storyData.amountASpoken}ですね」と言われたとしても、<strong>その金額が高いのか、安いのか、自分には判断できない。</strong></p>
          ) : (
            <p>仮に近所の店へ持っていって、「15万円ですね」と言われたとしても、<strong>その15万円が高いのか、安いのか、自分には判断できない。</strong></p>
          )}
          <p>時計の買取価格なんて普段から見ているわけでもないので、<span class="mark">比べる基準がありません</span>。一店舗だけで決めるのは、ちょっと怖いなと思いました。</p>
        </div>
      </section>

      <section class="story-section" aria-labelledby="hikakaku-title">
        <h2 class="section-heading" id="hikakaku-title">「値段だけ知りたい」でヒカカク！を使った</h2>
        <div class="story-copy">
          <p>そこで見つけたのが、<strong class="neutral-strong">「ヒカカク！」</strong>でした。</p>
          <p>ヒカカク！は、売りたい商品の情報を<span class="mark">一度入力するだけで、最大20社へまとめて査定を依頼できる</span>サービスです。</p>
          <p>僕はこの時点でも、「絶対に売ろう」とは思っていませんでした。ただ、<strong class="neutral-strong">「とりあえず、今いくらになるのか知りたい」</strong>それだけ。</p>
          <p>値段を見て、安ければそのまま持っておけばいい。納得できる金額なら、そのとき売るか考えればいい。<span class="mark">売るかどうかは、あとから決められます。</span></p>
        </div>
        <a class="story-cta" href={affiliateUrl} target="_blank" rel="sponsored noreferrer">{searchWatch.ref}を売る前に査定額を比べる <span aria-hidden="true">›</span></a>
      </section>

      <section class="story-section story-section--tint" aria-labelledby="entry-title">
        <h2 class="section-heading" id="entry-title">実際に入力したもの</h2>
        <p class="section-lead">僕が入力した内容はこちらです。</p>
        <div class="form-visual">
          <figure class="form-visual__generated">
            <img loading="lazy" decoding="async" src={storyData.entryImage} width="1024" height="1536" alt={isModelStory ? `入力画面のイメージ。ヒカカク！で、ブランド ${searchWatch.brand}、モデル ${searchWatch.model}、型番 ${searchWatch.ref}、状態 使用感あり、ケース・ブレスに細かい傷あり、動作 正常に動作、付属品 箱あり・保証書あり・余りコマありと入力した様子。` : '入力画面のイメージ。ヒカカク！で、ブランド OMEGA、モデル スピードマスター、型番 3511.50、状態 使用感あり、ベルトに細かい傷あり、動作 正常に動作、付属品 箱あり・保証書あり・余りコマありと入力した様子。'} />
            <figcaption class="sr-only">{isModelStory ? `ヒカカク！。ブランド ROLEX。モデル ${searchWatch.model}。型番 ${searchWatch.ref}。状態 使用感あり。ケース・ブレスに細かい傷あり。動作 正常に動作。付属品 箱あり、保証書あり、余りコマあり。` : 'ヒカカク！。ブランド OMEGA。モデル スピードマスター。型番 3511.50。状態 使用感あり、ベルトに細かい傷あり。動作 正常に動作。付属品 箱あり、保証書あり、余りコマあり。'}</figcaption>
          </figure>
          <div class="story-copy">
            <p>型番なんて覚えていなかったので、時計本体と保証書を見ながら確認しました。</p>
            <p>状態についても、できるだけ正直に入力。{isModelStory ? 'ブレスレット' : 'ベルト'}やケースには細かい使用傷があります。ガラス面には大きな傷はありません。オーバーホールについても、最近はしていません。</p>
            <p>写真もスマホで撮りました。正面、裏側、ベルト、箱、保証書、余りコマ。特別きれいに撮影したわけではなく、普通にスマホで撮っただけです。</p>
            <p>入力自体は、思っていたより簡単でした。</p>
          </div>
        </div>
      </section>

      <section class="story-section" aria-labelledby="first-appraisal-title">
        <h2 class="section-heading" id="first-appraisal-title">最初の査定「{storyData.amountA}」</h2>
        <div class="with-visual with-visual--appraisal">
          <div class="story-copy">
            <p>申し込みをしてしばらくすると、最初の査定が届きました。</p>
            <p>最初に見たときは、「まあ、こんなものなのかな」という感じでした。何年も使った時計です。<span class="amount">{storyData.amountFirstNarrative}</span>になるなら、悪くない。</p>
            <p>正直、この時点では、<strong class="neutral-strong">「このくらいなら売ってもいいかな」</strong>と少し思いました。でも、せっかく複数社へ査定をお願いしているので、他の結果も見てから決めることにしました。</p>
          </div>
          <div class="appraisal-card"><span>A社の査定額</span><strong>{storyData.amountA}</strong></div>
        </div>
      </section>

      <section class="story-section story-section--tint" aria-labelledby="change-title">
        <h2 class="section-heading" id="change-title">査定額がどんどん変わった</h2>
        <div class="story-copy">
          <p>少しすると、次の査定が届きました。B社は<span class="amount">{storyData.amountB}</span>前後。<span class="mark mark--red">{isModelStory ? '「え、さっきより金額が上がった」' : '「え、さっきより2万5,000円高い」'}</span>。さらに、C社は<span class="amount">{storyData.amountC}</span>前後。そして、D社は<span class="amount">{storyData.amountD}</span>前後。</p>
          <p>ここでかなり驚きました。<span class="mark">同じ時計、同じ入力内容</span>。それなのに、<span class="mark mark--red">査定額にこれだけの差が出ました。</span></p>
        </div>
        <div class="result-reveal">
          <dl class="result-table" aria-label="届いた査定額">
            <div><dt>A社（最初の査定）</dt><dd>{storyData.amountA}</dd></div>
            <div><dt>B社</dt><dd>{storyData.amountB}</dd></div>
            <div><dt>C社</dt><dd>{storyData.amountC}</dd></div>
            <div><dt>D社（最高額）</dt><dd>最大 {storyData.amountD}前後</dd></div>
          </dl>
          <div class="difference"><span>最大と最小の差額</span><strong>{isModelStory ? storyData.maxDifference : '73,000円以上'}</strong></div>
        </div>
        <a class="story-cta" href={affiliateUrl} target="_blank" rel="sponsored noreferrer">自分の{searchWatch.ref}はいくらか調べてみる <span aria-hidden="true">›</span></a>
        <p class="under-price">※{isModelStory ? '公開実績をもとに再構成したモデルケースであり' : '個人の体験にもとづく例であり'}、実際の査定・売却額を保証するものではありません。</p>
        <div class="story-copy">
          <p>最初の{storyData.amountASpoken}だけ見ていたら、「こんなものなんだ」と思って、そのまま売っていたかもしれません。でも比較したことで、<strong class="neutral-strong">「複数の店を見る意味って、こういうことか」</strong>と初めて実感しました。</p>
        </div>
      </section>

      <section class="story-section" aria-labelledby="reviews-title">
        <h2 class="section-heading" id="reviews-title">「一番高い店に売ればいい」ではなかった</h2>
        <div class="story-copy">
          <p>ただし、「{storyData.amountDSpoken}が一番高いから、ここで即決！」とはなりませんでした。むしろ、<strong class="neutral-strong">「本当にこの金額になるの？」</strong>という疑問が出てきました。</p>
          <p>そこで、<span class="mark">査定額だけではなく「売る相手」も</span>確認しました。</p>
        </div>
        <div class="process-proof" aria-label="確認したこと">
          <article><svg class="proof-icon" aria-hidden="true"><use href="#ic-review" /></svg><p>口コミ・評判</p></article>
          <article><svg class="proof-icon" aria-hidden="true"><use href="#ic-record" /></svg><p>時計の買取実績</p></article>
          <article><svg class="proof-icon" aria-hidden="true"><use href="#ic-support" /></svg><p>査定後の対応</p></article>
          <article><svg class="proof-icon" aria-hidden="true"><use href="#ic-fee" /></svg><p>買取方法・手数料</p></article>
        </div>
        <div class="story-copy">
          <p>僕が見たのは、時計の買取実績がありそうか、口コミや評判はどうか、査定後に大きく減額されたという口コミが多くないか、対応について悪い口コミが多くないか、入金までのスピード、手数料の有無、宅配・店頭などどの買取方法に対応しているかというところ。</p>
          <p>金額が高くても、対応に不安があるところへ大事な時計を送るのはちょっと怖い。ヒカカク！では金額だけでなく、業者ごとの口コミや情報も確認できるので、<strong class="neutral-strong">「価格だけではなく、売る相手も比較する」</strong>という使い方ができました。</p>
        </div>
      </section>

      <section class="story-section story-section--tint" aria-labelledby="message-title">
        <h2 class="section-heading" id="message-title">実際に業者とやり取りしてみた</h2>
        <div class="story-copy"><p>最終的に、査定額が一番高かったD社に、時計の状態についてもう少し詳しく伝えてみました。</p></div>
        <figure class="conversation-visual">
          <img loading="lazy" decoding="async" src="/hikakaku-watch-story/assets/dealer-conversation-with-copy-v3.webp" width="1536" height="1024" alt="自分と業者とのやり取りのイメージ。自分はベルトの傷、箱・保証書・余りコマ、オーバーホールの状況を伝え、業者は現物確認後に正式な査定額を案内すると回答している。" />
          <figcaption class="sr-only">自分：ベルトに細かい傷があります。箱・保証書・余りコマはあります。オーバーホールは数年前からしていません。業者：詳しい情報ありがとうございます。現物を確認後、正式な査定額をご案内させていただきます。</figcaption>
        </figure>
        <div class="story-copy">
          <p>やり取りも丁寧で、説明も分かりやすかったです。この段階でも、<strong class="neutral-strong">「安かったら売らなくていい」</strong>と思っていました。だから、無理に決める必要はありませんでした。</p>
        </div>
      </section>

      <section class="story-section" aria-labelledby="shipping-title">
        <h2 class="section-heading" id="shipping-title">時計を送ったときは少し緊張した</h2>
        <div class="ship-panel">
          <div class="ship-panel__copy">
            <p>最終的に宅配査定をお願いすることにしました。時計を梱包して発送します。</p>
            <p>正直ここが、<span class="mark">一番緊張しました</span>。何十万円もした時計を箱に入れて送るわけです。</p>
            <p>時計本体をクッション材で包む。箱、保証書、余りコマ。必要なものを全部入れる。</p>
          </div>
          <img loading="lazy" decoding="async" class="ship-panel__image" src="/hikakaku-watch-story/assets/shipping-box.webp" width="1280" height="854" alt="時計用のポーチと緩衝材を入れた梱包箱のイメージ" />
        </div>
        <div class="story-copy">
          <p>一度箱を閉じたあと、<strong class="neutral-strong">「保証書、ちゃんと入れたよな？」</strong>と不安になって、もう一度開けました（笑）。ちゃんと入っていました。もう一度閉じて発送。あとは査定結果を待ちます。</p>
        </div>
      </section>

      <section class="story-section story-section--tint" aria-labelledby="final-title">
        <h2 class="section-heading" id="final-title">最終査定の結果</h2>
        <div class="story-copy"><p>数日後、最終的な査定額の連絡が来ました。事前に出ていた一番高い査定額は、{storyData.amountD}前後。</p></div>
        <div class="final-price" aria-label="事前査定と現物確認後の査定額">
          <div class="final-price__box"><b>事前査定</b><strong>{storyData.amountD}前後</strong></div>
          <div class="price-arrow" aria-hidden="true">›</div>
          <div class="final-price__box final-price__box--confirmed"><b>現物確認後の査定額</b><strong>{storyData.amountFinal}</strong></div>
        </div>
        {isModelStory ? (
          <p class="under-price">理由：使用傷や個体条件などを確認した想定で、事前査定より{storyData.preToFinalDifference}下がるモデルとしています。<br />※公開実績をもとに再構成したモデルケースであり、実際の査定・売却額を保証するものではありません。</p>
        ) : (
          <p class="under-price">理由：使用傷などを確認したため、事前査定より1万円下がりました。<br />※個人の体験にもとづく例であり、実際の査定・売却額を保証するものではありません。</p>
        )}
        <div class="quote-panel">
          <p>ただ、自分としては十分納得できる金額でした。すでに他社の査定額を知っていたからです。<strong>「{storyData.amountFinalSpoken}なら納得できる」</strong>と自分で判断できました。そこで、その金額で売却することにしました。</p>
        </div>
        <div class="story-copy"><p>{storyData.amountASpoken}。{storyData.amountBSpoken}。{storyData.amountCSpoken}。<span class="mark">それらと比較して、納得したうえで決められました。</span></p></div>
      </section>

      <section class="story-section" aria-labelledby="what-if-title">
        <h2 class="section-heading" id="what-if-title">もし最初の査定で売っていたら？</h2>
        <div class="story-copy"><p>最初に届いた査定額は<span class="amount">{storyData.amountA}</span>。{isModelStory ? '現物確認後の査定額は' : '今回実際に売却した金額は'}<span class="amount">{storyData.amountFinal}</span>でした。</p></div>
        <div class="compare-price">
          <div class="compare-price__box"><span>最初の査定額</span><strong>{storyData.amountA}</strong></div>
          <div class="compare-price__arrow" aria-hidden="true">vs</div>
          <div class="compare-price__box compare-price__box--red"><span>{isModelStory ? '現物確認後の査定額' : '実際の売却額'}</span><strong>{storyData.amountFinal}</strong></div>
        </div>
        <p class="compare-difference"><small>差額</small> {storyData.finalDifference}</p>
        <a class="story-cta" href={affiliateUrl} target="_blank" rel="sponsored noreferrer">{searchWatch.ref}を売る前に査定額を比べる <span aria-hidden="true">›</span></a>
        <p class="under-price">※{isModelStory ? '公開実績をもとに再構成したモデルケースであり' : '個人の体験にもとづく例であり'}、実際の査定・売却額を保証するものではありません。</p>
        <div class="story-copy">
          <p>もちろん、一社目でも現物査定後に金額が変わった可能性はあります。逆に、もっと高く買ってくれる業者があった可能性もあります。</p>
          <p>だから、<strong class="neutral-strong">{isModelStory ? '「ヒカカク！を使えば必ず高く売れる」' : '「ヒカカク！を使えば必ず6万円以上高く売れる」'}</strong>という話ではありません。</p>
          <p>僕が一番怖いと思ったのは、<strong>比較しなければ、その金額が安いことにすら気づけない可能性がある</strong>ということでした。もし何も知らず近所の店へ行って、「{storyData.amountASpoken}です」と言われていたら、僕は普通に、「そんなものなのかな」と思っていたかもしれません。</p>
        </div>
      </section>

      <section class="story-section story-section--tint" aria-labelledby="learned-title">
        <h2 class="section-heading" id="learned-title">ヒカカク！を使って分かった3つのこと</h2>
        <div class="three-points">
          <p><span class="number-dot">1</span><span>一店舗だけでは相場が分からない</span></p>
          <p><span class="number-dot">2</span><span>同じ時計でも査定額は違う</span></p>
          <p><span class="number-dot">3</span><span>売らなくても「自分の時計の基準価格」が分かる</span></p>
        </div>
        <div class="story-copy">
          <p>一店舗だけで査定すると、その金額しか見えません。複数社を見ることで、<span class="mark">「この時計はこのくらいなんだ」というおおよその基準</span>が分かります。</p>
          {isModelStory ? (
            <p>今回のモデルケースでも、{storyData.amountASpoken}から{storyData.amountDSpoken}前後まで差が出ました。業者によって在庫状況や販売ルート、得意なブランドなどが違うため、査定額も変わります。</p>
          ) : (
            <p>今回、自分の時計でも、15万5,000円から22万8,000円前後まで差が出ました。業者によって在庫状況や販売ルート、得意なブランドなどが違うため、査定額も変わります。</p>
          )}
          <p>これが、自分には一番大きかったです。<span class="mark">査定したからといって、必ず売る必要はありません。</span>価格を見て、「思ったより安いから今回はやめる」でもいい。逆に、「この金額なら売ってもいいな」と思ったら、そのとき売ればいい。</p>
          <p><strong class="neutral-strong">「最高値を探せたこと」ではなく、何も知らないまま売らなくて済んだこと</strong>が、一番便利でした。</p>
        </div>
      </section>

      <section class="story-section" aria-labelledby="for-you-title">
        <h2 class="section-heading" id="for-you-title">こんな人なら、一度査定してみてもいいかもしれない</h2>
        <div class="story-copy"><p>こんな時計、家にありませんか？</p></div>
        <ul class="check-list">
          <li>昔買ったけど最近ほとんど使っていない</li>
          <li>売るかどうかは値段を見て決めたい</li>
          <li>スマートウォッチに変えてから出番がない</li>
          <li>一店舗ずつ買取店を回るのは面倒</li>
          <li>ロレックス・オメガなどのブランド時計を持っている</li>
          <li>今の査定額だけ一度知りたい</li>
        </ul>
        <p class="section-close">ひとつでも当てはまれば、まず今の査定額を見てから考えるのがおすすめです。</p>
      </section>

      <section class="story-section story-section--tint" aria-labelledby="flow-title">
        <h2 class="section-heading" id="flow-title">ヒカカク！の仕組みはとてもシンプル</h2>
        <div class="steps" aria-label="査定から売却までの流れ">
          <div class="step"><span class="step-number">1</span><b>時計の情報を入力</b><span>まずは今の状態を伝える</span></div>
          <div class="step"><span class="step-number">2</span><b>査定額を比べる</b><span>最大20社からの結果を確認</span></div>
          <div class="step"><span class="step-number">3</span><b>業者を選ぶ</b><span>口コミ・条件も見て判断</span></div>
          <div class="step"><span class="step-number">4</span><b>納得できれば売却</b><span>売らない選択もできる</span></div>
        </div>
        <p class="steps-note">最初から売ると決めなくても大丈夫。まずは、自分の時計はいくらになるのかを確認するところから始められます。</p>
      </section>

      <section class="story-section story-section--dense" aria-labelledby="faq-title">
        <h2 class="section-heading" id="faq-title">よくある質問</h2>
        {faqItems.map((item) => (
          <details class="faq">
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))}
      </section>

      <section class="closing" aria-labelledby="closing-title">
        <div class="closing__copy">
          <p class="closing__kicker">最後に</p>
          <h2 id="closing-title">売るかどうかは、値段を見てから決めればいい。</h2>
          <p>僕も最初は、<strong>「これ、いくらになるんだろう？」</strong>それだけでした。最初から売る気満々だったわけではありません。</p>
          <p>でも、実際に複数社の査定を見てみたことで、<span class="mark">自分の時計がだいたいいくらなのか</span>分かった。業者によって金額が違うことも分かった。</p>
          <p>そして、「この金額なら売ろう」と、自分で納得して決めることができました。</p>
          <p>もし家に、使っていない時計があるなら。いきなり近所のお店へ持っていく前に、<strong>まず今いくらになるのか確認してみる。</strong>そこから考えても遅くないと思います。</p>
        </div>
        <a class="story-cta" href={affiliateUrl} target="_blank" rel="sponsored noreferrer">まずは今の{searchWatch.ref}の価格だけ確認する <span aria-hidden="true">›</span></a>
