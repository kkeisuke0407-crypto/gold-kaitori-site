---
import StoryPage from './omega-speedmaster-3511-50/index.astro';
import { watchModelStories, type WatchModelStory } from '../../../data/hikakaku-watch-model-stories';

export function getStaticPaths() {
  return watchModelStories
    .filter((story) => story.slug !== 'rolex-submariner-16610')
    .map((story) => ({ params: { model: story.slug }, props: { story } }));
}

type Props = { story: WatchModelStory };
const { story } = Astro.props as Props;
---

<StoryPage modelStory={story} />
