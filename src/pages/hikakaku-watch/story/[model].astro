---
import { watchModelStories, type WatchModelStory } from '../../../data/hikakaku-watch-model-stories';

export function getStaticPaths() {
  return watchModelStories.map((story) => ({ params: { model: story.slug }, props: { story } }));
}

type Props = { story: WatchModelStory };
const { story } = Astro.props;
const affiliateUrl = 'https://tr.slvrbullet.com/cl/w0000678724/47671/39865/6';
const formatYen = (value: number) => `${value.toLocaleString('ja-JP')}円`;
const formatMan = (value: number) => `${(value / 10000).toLocaleString('ja-JP')}万円`;
const quoteGap = story.quotes[3] - story.quotes[0];
const saleGap = story.finalPrice - story.quotes[0];
const preFinalGap = story.quotes[3] - story.finalPrice;
const pageIntent = `hikakaku_watch_model_${story.slug}`;
const pageTitle = `${story.shortName}の買取価格を1社だけで決めなくてよかった。 | 時計査定ナビ`;
const faqItems = [
  { q: '査定したら必ず売らないとダメ？', a: 'いいえ。査定額を確認してから、売るかどうかを判断できます。金額に納得できなければ、売らない選択もできます。' },
  { q: 'このページの金額で売れる？', a: `いいえ。掲載額は公開査定例を参考に再構成したモデルケースです。同じ${story.shortName}でも、型番・状態・付属品・査定時期・買取業者によって金額は変わります。` },
  { q: '必ず20社から査定が来る？', a: 'いいえ。「最大20社」なので、商品や地域、条件などによって査定を行う業者数は異なります。' },
  { q: '事前査定は確定価格？', a: `確定価格ではありません。実物の状態や付属品を確認した結果、最終査定額が変わる場合があります。このモデルケースでも、事前査定${formatYen(story.quotes[3])}から現物確認後${formatYen(story.finalPrice)}になっています。` },
  { q: '型番が分からなくても査定できる？', a: '時計本体や保証書の写真を用意すると確認しやすくなります。分からない項目がある場合は、申込画面の案内や査定業者の確認に沿って入力してください。' },
];
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={`${story.searchLabel}を調べている方向けに、複数社の査定額を比較して考える流れをモデルストーリーで紹介します。`} />
    <meta name="robots" content="noindex, nofollow" />
    <title>{pageTitle}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;600;700;800;900&family=Noto+Serif+JP:wght@600;700;900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/hikakaku-watch-story/site.css" />
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-DMCWVLP3E3"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){ dataLayer.push(arguments); }
      gtag('js', new Date()); gtag('config', 'G-DMCWVLP3E3'); gtag('config', 'AW-18129603657');
    </script>
    <script is:inline>
      (function(c,l,a,r,i,t,y){ c[a]=c[a]||function(){ (c[a].q=c[a].q||[]).push(arguments); }; t=l.createElement(r); t.async=1; t.src="https://www.clarity.ms/tag/"+i; y=l.getElementsByTagName(r)[0]; y.parentNode.insertBefore(t,y); })(window, document, "clarity", "script", "wxnujpnscp");
    </script>
    <script is:inline>
      document.addEventListener('click', function(e){
        var a = e.target && e.target.closest ? e.target.closest('a[href^="https://tr.slvrbullet.com/"]') : null;
        if(!a) return;
        var params = { landing_intent: document.body.dataset.intent || 'hikakaku_watch_model', cta_label: (a.getAttribute('aria-label') || a.textContent || '').trim().slice(0, 60), link_url: a.getAttribute('href'), transport_type: 'beacon' };
        if(window.dataLayer) window.dataLayer.push(Object.assign({ event: 'hikakaku_watch_mcv' }, params));
        if(typeof gtag === 'function') gtag('event', 'hikakaku_watch_mcv', params);
      }, true);
    </script>
  </head>
  <body data-intent={pageIntent}>
    <main class="watch-story">
      <div class="story-disclosure">当サイトは提携広告を含む比較・案内メディアです</div>

      <section class="hero" aria-labelledby="story-title">
        <img class="hero__image" src={story.heroImage} width="1024" height="1536" alt={`木目の上に置かれた${story.shortName} ${story.reference}をイメージした腕時計`} />
        <div class="hero__content">
          <p class="story-kicker">使わなくなった{story.shortName}。</p>
          <h1 id="story-title">その買取価格、<br /><span>1社だけで</span>決めていませんか。</h1>
          <p class="hero__lead">同じ型番でも、<br />査定額に<span>{formatMan(quoteGap)}の差</span>が出ることも。</p>
          <p class="hero__tagline">{story.shortName} {story.reference}の{story.referenceLabel}を参考にしたモデルストーリー</p>
        </div>
      </section>

      <section aria-label="査定額の比較">
        <div class="price-strip">
          <div class="price-strip__label">モデルケースの<br />査定額<br />比較</div>
          {story.quotes.map((price, index) => (
            <div class:list={['price-cell', { 'price-cell--best': index === story.quotes.length - 1 }]}>
              <small>{String.fromCharCode(65 + index)}社{index === 0 ? '（最初の査定）' : index === 3 ? '（最高額）' : ''}</small>
              <strong>{formatYen(price)}</strong>
            </div>
          ))}
        </div>
        <p class="story-note">※本ページは複数の{story.referenceLabel}を参考に再構成したモデルストーリーです。掲載額は実際の申込結果ではなく、査定・売却額を保証するものではありません。価格は状態・付属品・時期・業者によって変動します。※掲載の画像はイメージです。<br />参考：{story.sourceReferences.map((source, index) => <><a href={source.url} target="_blank" rel="nofollow noreferrer">{source.label}</a>{index < story.sourceReferences.length - 1 ? ' ／ ' : ''}</>)}（2026年9月1日確認）</p>
      </section>

      <section class="story-section" aria-labelledby="sell-intent-title">
        <h2 class="section-heading" id="sell-intent-title">そもそも、売るつもりはなかった</h2>
        <div class="story-copy with-visual--wrap">
          <p>きっかけは、時計ケースの整理でした。</p>
          <p>出てきたのは、<strong class="neutral-strong">ROLEX {story.modelName} {story.reference}</strong>。{story.origin}です。</p>
          <figure class="visual-card visual-card--flat"><img loading="lazy" decoding="async" src="/hikakaku-watch-story/assets/watch-accessories.webp" width="960" height="960" alt="腕時計と箱、付属品のイメージ" /></figure>
          <p>{story.unusedReason}。</p>
          <p>時計自体が嫌いになったわけではありません。ただ、<strong>「{story.shortName}の買取相場って、今どのくらいなんだろう？」</strong>と気になりました。</p>
          <p>最初はそれだけでした。売るかどうかまで決めていたわけではありません。</p>
        </div>
      </section>

      <section class="story-section story-section--tint" aria-labelledby="nearby-title">
        <h2 class="section-heading" id="nearby-title">検索で相場を見ても、自分の時計の値段は分からない</h2>
        <div class="story-copy with-visual--wrap">
          <p>スマホで、<strong class="neutral-strong">「{story.searchLabel}」</strong>と検索しました。</p>
          <figure class="visual-card visual-card--person"><img loading="lazy" decoding="async" src="/hikakaku-watch-story/assets/story-person.webp" width="640" height="960" alt="時計を売る店を考える男性のイラスト" /></figure>
          <p>相場表や高額な事例は見つかります。でも、同じモデル名でも型番や状態が違い、<span class="mark">自分の時計がその金額になるのかは分かりません。</span></p>
          <p>仮に一社から金額を聞いても、その金額が高いのか安いのか、自分には判断できない。</p>
          <p>時計の買取価格を普段から見ているわけでもないので、<span class="mark">比べる基準がありません</span>。一社だけで決めるのは、少し怖いなと思いました。</p>
        </div>
      </section>

      <section class="story-section" aria-labelledby="hikakaku-title">
        <h2 class="section-heading" id="hikakaku-title">「自分の{story.shortName}の値段」を知るために一括査定へ</h2>
        <div class="story-copy">
          <p>そこで見つけたのが、買取価格比較サービスの<strong class="neutral-strong">「ヒカカク！」</strong>でした。</p>
          <p>売りたい商品の情報を<span class="mark">一度入力するだけで、最大20社へまとめて査定を依頼できる</span>サービスです。</p>
          <p>この時点では、絶対に売ると決めていたわけではありません。ただ、<strong class="neutral-strong">「とりあえず、今いくらになるのか知りたい」</strong>それだけです。</p>
          <p>値段を見て、安ければそのまま持っておけばいい。納得できる金額なら、そのとき売るか考えればいい。<span class="mark">売るかどうかは、あとから決められます。</span></p>
        </div>
        <a class="story-cta" href={affiliateUrl} target="_blank" rel="sponsored noreferrer">{story.shortName}の査定額を比べてみる <span aria-hidden="true">›</span></a>
      </section>

      <section class="story-section story-section--tint" aria-labelledby="entry-title">
        <h2 class="section-heading" id="entry-title">実際に入力したもの</h2>
        <p class="section-lead">このモデルケースで入力した内容はこちらです。</p>
        <div class="form-visual">
          <figure class="form-visual__generated">
            <img loading="lazy" decoding="async" src={story.entryImage} width="1024" height="1536" alt={`入力画面のイメージ。ブランド ROLEX、モデル ${story.modelName}、型番 ${story.reference}、状態 使用感あり、${story.conditionDetail}、動作 正常、付属品 箱・保証書・余りコマあり。`} />
            <figcaption class="sr-only">ブランド ROLEX。モデル {story.modelName}。型番 {story.reference}。状態 使用感あり、{story.conditionDetail}。動作 正常。付属品 箱、保証書、余りコマあり。</figcaption>
          </figure>
          <div class="story-copy">
            <p>型番は時計本体や保証書を見ながら確認しました。</p>
            <p>状態についても、できるだけ正直に入力。{story.conditionDetail}。動作と付属品の有無も、分かる範囲でそろえます。</p>
            <p>査定時に見られやすいのは、{story.appraisalFocus.join('、')}です。正面、裏側、ブレスレット、箱、保証書、余りコマをスマホで撮影して伝えます。</p>
            <p>入力自体は、思っていたより簡単です。</p>
          </div>
        </div>
      </section>

      <section class="story-section" aria-labelledby="first-appraisal-title">
        <h2 class="section-heading" id="first-appraisal-title">最初の査定「{formatYen(story.quotes[0])}」</h2>
        <div class="with-visual with-visual--appraisal">
          <div class="story-copy">
            <p>申し込みをしてしばらくすると、最初の査定が届きました。</p>
            <p>このモデルケースでは、最初の提示額は<span class="amount">{formatYen(story.quotes[0])}</span>。相場を調べている段階では、この金額だけで売るかどうかを決めるのは早いと考えます。</p>
            <p>せっかく複数社へ査定をお願いしているので、<strong class="neutral-strong">他の結果も見てから決める</strong>流れにしました。</p>
          </div>
          <div class="appraisal-card"><span>A社の査定額</span><strong>{formatYen(story.quotes[0])}</strong></div>
        </div>
      </section>

      <section class="story-section story-section--tint" aria-labelledby="change-title">
        <h2 class="section-heading" id="change-title">査定額がどんどん変わった</h2>
        <div class="story-copy">
          <p>少しすると、次の査定が届きました。B社は<span class="amount">{formatYen(story.quotes[1])}</span>。さらに、C社は<span class="amount">{formatYen(story.quotes[2])}</span>。そして、D社は<span class="amount">{formatYen(story.quotes[3])}</span>です。</p>
          <p>同じ型番、同じ入力内容。それなのに、<span class="mark mark--red">査定額にこれだけの差が出ました。</span></p>
        </div>
        <div class="result-reveal">
          <dl class="result-table" aria-label="モデルケースの査定額">
            {story.quotes.map((price, index) => (
              <div><dt>{String.fromCharCode(65 + index)}社{index === 0 ? '（最初の査定）' : index === 3 ? '（最高額）' : ''}</dt><dd>{formatYen(price)}</dd></div>
            ))}
          </dl>
          <div class="difference"><span>最大と最小の差額</span><strong>{formatYen(quoteGap)}</strong></div>
        </div>
        <p class="under-price">※{story.referenceLabel}を参考にしたモデルケースであり、実際の査定・売却額を保証するものではありません。</p>
        <div class="story-copy"><p>最初の提示額だけ見ていたら、その金額が相場どおりなのか判断できません。でも比較したことで、<strong class="neutral-strong">「複数の店を見る意味って、こういうことか」</strong>と考えやすくなります。</p></div>
      </section>

      <section class="story-section" aria-labelledby="reviews-title">
        <h2 class="section-heading" id="reviews-title">「一番高い店に売ればいい」ではなかった</h2>
        <div class="story-copy">
          <p>ただし、最高額が出たからといって、そこで即決するわけではありません。<strong class="neutral-strong">「本当にこの金額になるの？」</strong>という疑問も確認します。</p>
          <p>そこで、<span class="mark">査定額だけではなく「売る相手」も</span>確認します。</p>
        </div>
        <div class="process-proof" aria-label="確認すること">
          <article><span class="sprite-icon sprite-icon--1"></span><p>口コミ・評判</p></article>
          <article><span class="sprite-icon sprite-icon--2"></span><p>時計の買取実績</p></article>
          <article><span class="sprite-icon sprite-icon--3"></span><p>査定後の対応</p></article>
          <article><span class="sprite-icon sprite-icon--4"></span><p>買取方法・手数料</p></article>
        </div>
        <div class="story-copy">
          <p>見るのは、時計の買取実績があるか、口コミや評判はどうか、査定後に大きく減額されたという声が多くないか、対応について不安がないか、入金までのスピード、手数料の有無、宅配・店頭などどの買取方法に対応しているかというところです。</p>
          <p>金額が高くても、対応に不安があるところへ大事な時計を送るのは少し怖い。ヒカカク！では金額だけでなく、業者ごとの口コミや情報も確認できるので、<strong class="neutral-strong">「価格だけではなく、売る相手も比較する」</strong>という使い方ができます。</p>
        </div>
      </section>

      <section class="story-section story-section--tint" aria-labelledby="message-title">
        <h2 class="section-heading" id="message-title">業者へ状態を詳しく伝える</h2>
        <div class="story-copy"><p>最高額を提示した業者に、時計の状態についてもう少し詳しく伝えます。</p></div>
        <figure class="conversation-visual">
          <img loading="lazy" decoding="async" src="/hikakaku-watch-story/assets/dealer-conversation-with-copy-v3.webp" width="1536" height="1024" alt="時計の傷、箱・保証書・余りコマ、オーバーホール状況を伝え、現物確認後の正式査定を確認するやり取りのイメージ" />
          <figcaption class="sr-only">ベルトの傷、箱・保証書・余りコマ、整備状況を伝え、業者が現物確認後に正式な査定額を案内すると回答するやり取りのイメージです。</figcaption>
        </figure>
        <div class="story-copy"><p>説明を確認したうえで、<strong class="neutral-strong">「安かったら売らなくていい」</strong>と考えます。だから、無理に決める必要はありません。</p></div>
      </section>

      <section class="story-section" aria-labelledby="shipping-title">
        <h2 class="section-heading" id="shipping-title">時計を送る前に確認したいこと</h2>
        <div class="ship-panel">
          <div class="ship-panel__copy">
            <p>宅配査定を選ぶ場合は、時計を梱包して発送します。</p>
            <p>高額な時計ほど、<span class="mark">梱包前の確認が大切です</span>。何十万円もする時計を箱に入れて送ることになります。</p>
            <p>時計本体をクッション材で包む。箱、保証書、余りコマ。必要なものを全部入れる。</p>
          </div>
          <img class="ship-panel__image" loading="lazy" decoding="async" src="/hikakaku-watch-story/assets/shipping-box.webp" width="1280" height="854" alt="時計用のポーチと緩衝材を入れた梱包箱のイメージ" />
        </div>
        <div class="story-copy"><p>発送前に、<strong class="neutral-strong">「保証書や余りコマを、ちゃんと入れたか」</strong>をもう一度確認します。現物確認へ進む前に、必要なものをそろえておくと安心です。</p></div>
      </section>

      <section class="story-section story-section--tint" aria-labelledby="final-title">
        <h2 class="section-heading" id="final-title">最終査定のモデルケース</h2>
        <div class="story-copy"><p>現物確認後の査定額は、事前に出ていた一番高い査定額と異なる場合があります。</p></div>
        <div class="final-price" aria-label="事前査定と現物確認後の査定額">
          <div class="final-price__box"><b>事前査定</b><strong>{formatYen(story.quotes[3])}</strong></div>
          <div class="price-arrow" aria-hidden="true">›</div>
          <div class="final-price__box final-price__box--confirmed"><b>現物確認後の査定額</b><strong>{formatYen(story.finalPrice)}</strong></div>
        </div>
        <p class="under-price">モデルケースでは使用傷などの確認により、事前査定から{formatYen(preFinalGap)}下がっています。実際の増減理由・金額は商品と業者によって異なります。</p>
        <div class="quote-panel"><p>すでに他社の査定額を知っていれば、<strong>「この金額なら納得できるか」</strong>を自分で判断できます。最高額だけを追うのではなく、比較したうえで決めることが大切です。</p></div>
        <div class="story-copy"><p>最初の査定から最高額までを比較して、<span class="mark">納得したうえで判断できます。</span></p></div>
      </section>

      <section class="story-section" aria-labelledby="what-if-title">
        <h2 class="section-heading" id="what-if-title">もし最初の査定で決めていたら？</h2>
        <div class="story-copy"><p>最初に届いた査定額は<span class="amount">{formatYen(story.quotes[0])}</span>。このモデルケースで現物確認後に提示された金額は<span class="amount">{formatYen(story.finalPrice)}</span>です。</p></div>
        <div class="compare-price">
          <div class="compare-price__box"><span>最初の査定額</span><strong>{formatYen(story.quotes[0])}</strong></div>
          <div class="compare-price__arrow" aria-hidden="true">vs</div>
          <div class="compare-price__box compare-price__box--red"><span>現物確認後の査定額</span><strong>{formatYen(story.finalPrice)}</strong></div>
        </div>
        <p class="compare-difference"><small>差額</small> {formatYen(saleGap)}</p>
        <p class="under-price">※モデルケースの比較です。この差額が実際に生じることを保証するものではありません。</p>
        <div class="story-copy">
          <p>もちろん、一社目でも現物査定後に金額が変わった可能性はあります。逆に、もっと高く買ってくれる業者があった可能性もあります。</p>
          <p>だから、<strong class="neutral-strong">「ヒカカク！を使えば必ず{formatYen(saleGap)}高く売れる」</strong>という話ではありません。</p>
          <p>比較しなければ、その金額が安いことにすら気づけない可能性があります。まず複数社の査定額を見て、納得してから決めることが大切です。</p>
        </div>
      </section>

      <section class="story-section story-section--tint" aria-labelledby="learned-title">
        <h2 class="section-heading" id="learned-title">モデルケースから分かる3つのこと</h2>
        <div class="three-points">
          <p><span class="number-dot">1</span><span>一店舗だけでは相場が分からない</span></p>
          <p><span class="number-dot">2</span><span>同じ時計でも査定額は違う</span></p>
          <p><span class="number-dot">3</span><span>売らなくても「自分の時計の基準価格」が分かる</span></p>
        </div>
        <div class="story-copy">
          <p>一店舗だけで査定すると、その金額しか見えません。複数社を見ることで、<span class="mark">「この時計はこのくらいなんだ」というおおよその基準</span>が分かります。</p>
          <p>同じ型番でも、業者によって在庫状況や販売ルート、得意なモデルなどが違うため、査定額も変わります。</p>
          <p><span class="mark">査定したからといって、必ず売る必要はありません。</span>価格を見て、「思ったより安いから今回はやめる」でもいい。逆に、「この金額なら売ってもいいな」と思ったら、そのとき売ればいい。</p>
          <p><strong class="neutral-strong">「最高値を探せたこと」ではなく、何も知らないまま売らずに済むこと</strong>が、比較する価値です。</p>
        </div>
      </section>

      <section class="story-section" aria-labelledby="for-you-title">
        <h2 class="section-heading" id="for-you-title">こんな人なら、一度査定してみてもいいかもしれない</h2>
        <div class="story-copy"><p>こんな時計、家にありませんか？</p></div>
        <ul class="check-list">
          <li>昔買ったけど最近ほとんど使っていない</li>
          <li>売るかどうかは値段を見て決めたい</li>
          <li>スマートウォッチに変えてから出番がない</li>
          <li>一店舗ずつ買取店を回るのは面倒</li>
          <li>ロレックスなどのブランド時計を持っている</li>
          <li>今の査定額だけ一度知りたい</li>
        </ul>
        <p class="section-close">ひとつでも当てはまれば、まず今の査定額を見てから考えるのがおすすめです。</p>
      </section>

      <section class="story-section story-section--tint" aria-labelledby="flow-title">
        <h2 class="section-heading" id="flow-title">ヒカカク！の仕組みはとてもシンプル</h2>
        <div class="steps" aria-label="査定から売却までの流れ">
          <div class="step"><span class="step-number">1</span><b>時計の情報を入力</b><span>まずは今の状態を伝える</span></div>
          <div class="step"><span class="step-number">2</span><b>査定額を比べる</b><span>最大20社からの結果を確認</span></div>
          <div class="step"><span class="step-number">3</span><b>業者を選ぶ</b><span>口コミ・条件も見て判断</span></div>
          <div class="step"><span class="step-number">4</span><b>納得できれば売却</b><span>売らない選択もできる</span></div>
        </div>
        <p class="steps-note">最初から売ると決めなくても大丈夫。まずは、自分の時計はいくらになるのかを確認するところから始められます。</p>
      </section>

      <section class="story-section story-section--dense" aria-labelledby="faq-title">
        <h2 class="section-heading" id="faq-title">よくある質問</h2>
        {faqItems.map((item) => <details class="faq"><summary>{item.q}</summary><p>{item.a}</p></details>)}
      </section>

      <section class="closing" aria-labelledby="closing-title">
        <div class="closing__copy">
          <p class="closing__kicker">最後に</p>
          <h2 id="closing-title">売るかどうかは、値段を見てから決めればいい。</h2>
          <p>最初は、<strong>「これ、いくらになるんだろう？」</strong>それだけでも構いません。最初から売る気満々である必要はありません。</p>
          <p>複数社の査定を見ることで、<span class="mark">自分の時計がだいたいいくらなのか</span>が分かる。業者によって金額が違うことも分かります。</p>
          <p>そして、「この金額なら売ろう」と、自分で納得して決めることができます。</p>
          <p>もし家に、使っていない{story.shortName}があるなら。いきなり一店舗へ持ち込む前に、<strong>まず今いくらになるのか確認してみる。</strong>そこから考えても遅くありません。</p>
        </div>
        <a class="story-cta" href={affiliateUrl} target="_blank" rel="sponsored noreferrer">自分の{story.shortName}の査定額を調べてみる <span aria-hidden="true">›</span></a>
      </section>

      <p class="disclaimer">※本記事は公開査定例を参考に再構成したモデルストーリーです。掲載額は実際の申込結果ではなく、査定・売却額を保証するものではありません。<br />※ヒカカク！は買取業者の査定・比較サービスであり、実際の買取は各買取業者との取引になります。</p>
    </main>
    <script is:inline src="https://js.slvrbullet.com/pt.min.js"></script>
  </body>
</html>
