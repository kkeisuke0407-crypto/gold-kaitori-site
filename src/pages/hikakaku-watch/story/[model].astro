---
import { watchModelStories, type WatchModelStory } from '../../../data/hikakaku-watch-model-stories';

export function getStaticPaths() {
  return watchModelStories.map((story) => ({ params: { model: story.slug }, props: { story } }));
}

type Props = { story: WatchModelStory };
const { story } = Astro.props;
const affiliateUrl = 'https://tr.slvrbullet.com/cl/w0000678724/47671/39865/6';
const formatYen = (value: number) => `${value.toLocaleString('ja-JP')}円`;
const formatMan = (value: number) => `${(value / 10000).toLocaleString('ja-JP')}万円`;
const quoteGap = story.quotes[3] - story.quotes[0];
const saleGap = story.finalPrice - story.quotes[0];
const preFinalGap = story.quotes[3] - story.finalPrice;
const pageIntent = `hikakaku_watch_model_${story.slug}`;
const pageTitle = `${story.shortName}の買取価格を1社だけで決めなくてよかった。 | 時計査定ナビ`;
const faqItems = [
  {
    q: '査定したら必ず売らないとダメ？',
    a: 'いいえ。査定額を確認してから、売るかどうかを判断できます。金額に納得できなければ、売らない選択もできます。',
  },
  {
    q: 'このページの金額で売れる？',
    a: `いいえ。掲載額は公開査定例を参考に再構成したモデルケースです。同じ${story.shortName}でも、型番・状態・付属品・査定時期・買取業者によって金額は変わります。`,
  },
  {
    q: '必ず20社から査定が来る？',
    a: 'いいえ。「最大20社」なので、商品や地域、条件などによって査定を行う業者数は異なります。',
  },
  {
    q: '事前査定は確定価格？',
    a: `確定価格ではありません。実物の状態や付属品を確認した結果、最終査定額が変わる場合があります。このモデルケースでも、事前査定${formatYen(story.quotes[3])}から現物確認後${formatYen(story.finalPrice)}になっています。`,
  },
  {
    q: '型番が分からなくても査定できる？',
    a: '時計本体や保証書の写真を用意すると確認しやすくなります。分からない項目がある場合は、申込画面の案内や査定業者の確認に沿って入力してください。',
  },
];
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={`${story.searchLabel}を調べている方向けに、複数社の査定額を比較して考える流れをモデルストーリーで紹介します。`} />
    <meta name="robots" content="noindex, nofollow" />
    <title>{pageTitle}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;600;700;800;900&family=Noto+Serif+JP:wght@600;700;900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/hikakaku-watch-story/site.css" />
    <link rel="stylesheet" href="/hikakaku-watch-story/model.css" />
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-DMCWVLP3E3"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){ dataLayer.push(arguments); }
      gtag('js', new Date()); gtag('config', 'G-DMCWVLP3E3'); gtag('config', 'AW-18129603657');
    </script>
    <script is:inline>
      (function(c,l,a,r,i,t,y){ c[a]=c[a]||function(){ (c[a].q=c[a].q||[]).push(arguments); };
        t=l.createElement(r); t.async=1; t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0]; y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", "wxnujpnscp");
    </script>
    <script is:inline>
      document.addEventListener('click', function(e){
        var a = e.target && e.target.closest ? e.target.closest('a[href^="https://tr.slvrbullet.com/"]') : null;
        if(!a) return;
        var params = {
          landing_intent: document.body.dataset.intent || 'hikakaku_watch_model',
          cta_label: (a.getAttribute('aria-label') || a.textContent || '').trim().slice(0, 60),
          link_url: a.getAttribute('href'),
          transport_type: 'beacon'
        };
        if(window.dataLayer) window.dataLayer.push(Object.assign({ event: 'hikakaku_watch_mcv' }, params));
        if(typeof gtag === 'function') gtag('event', 'hikakaku_watch_mcv', params);
      }, true);
    </script>
  </head>
  <body data-intent={pageIntent}>
    <main class="watch-story watch-story--model">
      <div class="story-disclosure">当サイトは提携広告を含む比較・案内メディアです</div>

      <section class="hero hero--model" aria-labelledby="story-title">
        <img class="hero__image" src={story.heroImage} width="1024" height="1536" alt={`木目の上に置かれた${story.shortName} ${story.reference}をイメージした腕時計`} />
        <div class="hero__content">
          <p class="story-kicker">使わなくなった{story.shortName}。</p>
          <h1 id="story-title">その買取価格、<br /><span>1社だけで</span>決めていませんか。</h1>
          <p class="hero__lead">同じ型番でも、<br />査定額に<span>{formatMan(quoteGap)}の差</span>が出ることも。</p>
          <p class="hero__tagline">{story.shortName} {story.reference}の公開査定例を参考にしたモデルストーリー</p>
        </div>
      </section>

      <section aria-label="査定額の比較">
        <div class="price-strip">
          <div class="price-strip__label">モデルケースの査定額比較</div>
          {story.quotes.map((price, index) => (
            <div class:list={['price-cell', { 'price-cell--best': index === story.quotes.length - 1 }]}>
              <small>{String.fromCharCode(65 + index)}社{index === 0 ? '（最初の査定）' : index === 3 ? '（最高額）' : ''}</small>
              <strong>{formatYen(price)}</strong>
            </div>
          ))}
        </div>
        <p class="story-note">※本ページは複数の公開査定例を参考に再構成したモデルストーリーです。掲載額は実際の申込結果ではなく、査定・売却額を保証するものではありません。価格は状態・付属品・時期・業者によって変動します。<br />参考：<a href={story.sourceUrl} target="_blank" rel="nofollow noreferrer">{story.sourceLabel}</a>（2026年9月1日確認）</p>
      </section>

      <aside class="model-answer" aria-label={`${story.shortName}の公開査定例`}>
        <p class="model-answer__eyebrow">まず知っておきたい参考情報</p>
        <h2>{story.shortName} {story.reference}の公開査定例</h2>
        <p class="model-answer__range">{story.observedRange}</p>
        <p>ただし、この範囲がそのままあなたの時計に当てはまるとは限りません。だからこそ、<strong>自分の時計の状態で複数社へ確認する</strong>ことが判断材料になります。</p>
        <a class="story-cta story-cta--compact" href={affiliateUrl} target="_blank" rel="sponsored noreferrer">自分の{story.shortName}の査定額を比べる <span aria-hidden="true">›</span></a>
      </aside>

      <section class="story-section" aria-labelledby="sell-intent-title">
        <h2 class="section-heading" id="sell-intent-title">そもそも、すぐ売るつもりはなかった</h2>
        <div class="story-copy with-visual--wrap">
          <p>きっかけは、時計ケースの整理でした。</p>
          <p>出てきたのは、<strong class="neutral-strong">ROLEX {story.modelName} {story.reference}</strong>。{story.origin}です。</p>
          <figure class="visual-card visual-card--flat"><img src="/hikakaku-watch-story/assets/watch-accessories.webp" width="960" height="960" alt="腕時計と箱、付属品のイメージ" /></figure>
          <p>{story.unusedReason}。</p>
          <p>売ると決めていたわけではありません。ただ、<strong>「{story.shortName}の買取相場って、今どのくらいなんだろう？」</strong>と気になりました。</p>
        </div>
      </section>

      <section class="story-section story-section--tint" aria-labelledby="nearby-title">
        <h2 class="section-heading" id="nearby-title">検索で相場を見ても、自分の時計の値段は分からない</h2>
        <div class="story-copy with-visual--wrap">
          <p>スマホで、<strong class="neutral-strong">「{story.searchLabel}」</strong>と検索しました。</p>
          <figure class="visual-card visual-card--person"><img src="/hikakaku-watch-story/assets/story-person.webp" width="640" height="960" alt="時計の売却先を考える男性のイラスト" /></figure>
          <p>相場表や高額な事例は見つかります。でも、同じモデル名でも型番や状態が違い、<span class="mark">自分の時計がその金額になるのかは分かりません。</span></p>
          <p>一店舗で金額を聞いても、それが高いのか安いのか判断できない。比較の基準が欲しいと思いました。</p>
        </div>
      </section>

      <section class="story-section" aria-labelledby="hikakaku-title">
        <h2 class="section-heading" id="hikakaku-title">「自分の{story.shortName}の値段」を知るために一括査定へ</h2>
        <div class="story-copy">
          <p>そこで使ったのが、買取価格比較サービスの<strong class="neutral-strong">「ヒカカク！」</strong>です。</p>
          <p>売りたい商品の情報を一度入力し、<span class="mark">最大20社へまとめて査定を依頼</span>できます。</p>
          <p>相場記事を読むだけで終わらず、<strong>自分の型番・状態・付属品で、いくらの査定が出るのか</strong>を確認できます。金額を見てから、売るか持っておくかを考える流れです。</p>
        </div>
        <a class="story-cta" href={affiliateUrl} target="_blank" rel="sponsored noreferrer">{story.shortName}の査定額を比べてみる <span aria-hidden="true">›</span></a>
      </section>

      <section class="story-section story-section--tint" aria-labelledby="factors-title">
        <h2 class="section-heading" id="factors-title">{story.shortName}で査定時に見られやすいポイント</h2>
        <div class="model-factors">
          {story.appraisalFocus.map((factor, index) => (
            <div><span>{index + 1}</span><p>{factor}</p></div>
          ))}
        </div>
        <p class="steps-note">モデル名だけでなく、型番・状態・付属品をそろえて伝えると、自分の時計に近い査定を受け取りやすくなります。</p>
      </section>

      <section class="story-section" aria-labelledby="entry-title">
        <h2 class="section-heading" id="entry-title">実際に入力する内容</h2>
        <p class="section-lead">このモデルケースでは、次の内容で査定を依頼します。</p>
        <div class="form-visual">
          <figure class="form-visual__generated">
            <img src={story.entryImage} width="1024" height="1536" alt={`入力画面のイメージ。ブランド ROLEX、モデル ${story.modelName}、型番 ${story.reference}、状態 使用感あり、${story.conditionDetail}、動作 正常、付属品 箱・保証書・余りコマあり。`} />
          </figure>
          <div class="story-copy">
            <p>型番は時計本体や保証書を見ながら確認。分からない部分は写真でも伝えます。</p>
            <p>状態は「使用感あり」。{story.conditionDetail}。大きく見せたり隠したりせず、分かる範囲で正直に入力します。</p>
            <p>正面、裏側、ブレスレット、箱、保証書、余りコマをスマホで撮影。査定側が型番や状態を判断しやすい材料をそろえました。</p>
          </div>
        </div>
      </section>

      <section class="story-section story-section--tint" aria-labelledby="change-title">
        <h2 class="section-heading" id="change-title">同じ{story.shortName}でも、査定額はそろわなかった</h2>
        <div class="story-copy">
          <p>最初の査定は<span class="amount">{formatYen(story.quotes[0])}</span>。その後、<span class="amount">{formatYen(story.quotes[1])}</span>、<span class="amount">{formatYen(story.quotes[2])}</span>、最高額は<span class="amount">{formatYen(story.quotes[3])}</span>というモデルケースです。</p>
          <p>同じ型番・同じ入力内容でも、<span class="mark mark--red">最初と最高額で{formatYen(quoteGap)}の差</span>。在庫状況や販売ルート、得意なモデルが業者ごとに違うため、提示額が同じになるとは限りません。</p>
        </div>
        <div class="result-reveal">
          <dl class="result-table" aria-label="モデルケースの査定額">
            {story.quotes.map((price, index) => (
              <div><dt>{String.fromCharCode(65 + index)}社{index === 0 ? '（最初）' : index === 3 ? '（最高額）' : ''}</dt><dd>{formatYen(price)}</dd></div>
            ))}
          </dl>
          <div class="difference"><span>最初と最高額の差</span><strong>{formatYen(quoteGap)}</strong></div>
        </div>
        <p class="under-price">※公開査定例を参考にしたモデルケースであり、実際の査定・売却額を保証するものではありません。</p>
      </section>

      <section class="story-section" aria-labelledby="reviews-title">
        <h2 class="section-heading" id="reviews-title">金額だけでなく、売る相手も確認する</h2>
        <div class="story-copy">
          <p>最高額が出ても、すぐに即決するのではなく、業者の口コミ・時計の買取実績・査定後の対応・買取方法や手数料も確認します。</p>
          <p>高額な時計ほど、<span class="mark">「いくらか」と同じくらい「誰に売るか」</span>が重要です。比較できる状態をつくってから、納得できる相手を選びます。</p>
        </div>
        <div class="process-proof" aria-label="確認すること">
          <article><span class="sprite-icon sprite-icon--1"></span><p>口コミ・評判</p></article>
          <article><span class="sprite-icon sprite-icon--2"></span><p>時計の買取実績</p></article>
          <article><span class="sprite-icon sprite-icon--3"></span><p>査定後の対応</p></article>
          <article><span class="sprite-icon sprite-icon--4"></span><p>買取方法・手数料</p></article>
        </div>
      </section>

      <section class="story-section story-section--tint" aria-labelledby="message-title">
        <h2 class="section-heading" id="message-title">業者へ状態を詳しく伝える</h2>
        <div class="story-copy"><p>最高額を提示した業者へ、傷・付属品・整備履歴を追加で伝え、現物確認後に正式な査定額が決まることを確認します。</p></div>
        <figure class="conversation-visual">
          <img src="/hikakaku-watch-story/assets/dealer-conversation-with-copy-v3.webp" width="1536" height="1024" alt="時計の傷、箱・保証書・余りコマ、オーバーホール状況を伝え、現物確認後の正式査定を確認するやり取りのイメージ" />
        </figure>
        <div class="story-copy"><p>この段階でも、金額に納得できなければ売らない選択ができます。先に比較しているので、判断の基準を持ったまま現物査定へ進めます。</p></div>
      </section>

      <section class="story-section" aria-labelledby="final-title">
        <h2 class="section-heading" id="final-title">現物確認後のモデルケース</h2>
        <div class="final-price" aria-label="事前査定と現物確認後の査定額">
          <div class="final-price__box"><b>事前査定</b><strong>{formatYen(story.quotes[3])}</strong></div>
          <div class="price-arrow" aria-hidden="true">›</div>
          <div class="final-price__box final-price__box--confirmed"><b>現物確認後</b><strong>{formatYen(story.finalPrice)}</strong></div>
        </div>
        <p class="under-price">モデルケースでは使用傷などの確認により、事前査定から{formatYen(preFinalGap)}下がっています。実際の増減理由・金額は商品と業者によって異なります。</p>
        <div class="quote-panel"><p>それでも、他社の提示額を知っていれば、<strong>「この金額なら納得できるか」</strong>を自分で判断できます。最高額だけを追うのではなく、比較したうえで決めることが大切です。</p></div>
      </section>

      <section class="story-section story-section--tint" aria-labelledby="what-if-title">
        <h2 class="section-heading" id="what-if-title">もし最初の査定だけで決めていたら？</h2>
        <div class="compare-price">
          <div class="compare-price__box"><span>最初の査定額</span><strong>{formatYen(story.quotes[0])}</strong></div>
          <div class="compare-price__arrow" aria-hidden="true">vs</div>
          <div class="compare-price__box compare-price__box--red"><span>現物確認後</span><strong>{formatYen(story.finalPrice)}</strong></div>
        </div>
        <p class="compare-difference"><small>差額</small> {formatYen(saleGap)}</p>
        <p class="under-price">※モデルケースの比較です。この差額が実際に生じることを保証するものではありません。</p>
        <div class="story-copy">
          <p>一社目だけなら、その金額が高いか安いか分からないままです。複数の査定があることで、<strong>自分の{story.shortName}を売るか、今回は持っておくか</strong>を考えやすくなります。</p>
        </div>
      </section>

      <section class="story-section" aria-labelledby="learned-title">
        <h2 class="section-heading" id="learned-title">{story.shortName}の相場検索で分かった3つのこと</h2>
        <div class="three-points">
          <p><span class="number-dot">1</span><span>相場表だけでは自分の査定額は決まらない</span></p>
          <p><span class="number-dot">2</span><span>同じ型番でも業者によって提示額は違う</span></p>
          <p><span class="number-dot">3</span><span>比較してから売らない選択もできる</span></p>
        </div>
      </section>

      <section class="story-section story-section--tint" aria-labelledby="flow-title">
        <h2 class="section-heading" id="flow-title">査定から判断までの流れ</h2>
        <div class="steps" aria-label="査定から売却判断までの流れ">
          <div class="step"><span class="step-number">1</span><b>型番・状態を入力</b><span>写真と付属品も用意</span></div>
          <div class="step"><span class="step-number">2</span><b>査定額を比べる</b><span>最大20社から結果を確認</span></div>
          <div class="step"><span class="step-number">3</span><b>業者を確認</b><span>口コミ・条件も見る</span></div>
          <div class="step"><span class="step-number">4</span><b>納得して判断</b><span>売らない選択も可能</span></div>
        </div>
        <a class="story-cta" href={affiliateUrl} target="_blank" rel="sponsored noreferrer">自分の{story.shortName}を査定してみる <span aria-hidden="true">›</span></a>
      </section>

      <section class="story-section story-section--dense" aria-labelledby="faq-title">
        <h2 class="section-heading" id="faq-title">よくある質問</h2>
        {faqItems.map((item) => (
          <details class="faq"><summary>{item.q}</summary><p>{item.a}</p></details>
        ))}
      </section>

      <section class="closing" aria-labelledby="closing-title">
        <div class="closing__copy">
          <p class="closing__kicker">最後に</p>
          <h2 id="closing-title">{story.shortName}の買取価格は、自分の時計で比べてから決める。</h2>
          <p>検索で見つかる相場は、判断の入口です。大切なのは、<strong>自分の型番・状態・付属品で出た査定額</strong>を比べること。</p>
          <p>いきなり一店舗へ持ち込む前に、まず複数社の査定額を確認する。売るかどうかは、その結果を見てからでも遅くありません。</p>
        </div>
        <a class="story-cta" href={affiliateUrl} target="_blank" rel="sponsored noreferrer">{story.shortName}の査定額を比べる <span aria-hidden="true">›</span></a>
      </section>

      <nav class="model-nav" aria-label="ロレックス主要モデルの買取価格ページ">
        <p>ほかの主要モデルを見る</p>
        <div>{watchModelStories.filter((item) => item.slug !== story.slug).map((item) => <a href={`/hikakaku-watch/story/${item.slug}/`}>{item.shortName}</a>)}</div>
      </nav>

      <p class="disclaimer">※本記事は公開査定例を参考に再構成したモデルストーリーです。掲載額は実際の申込結果ではなく、査定・売却額を保証するものではありません。<br />※ヒカカク！は買取業者の査定・比較サービスであり、実際の買取は各買取業者との取引になります。</p>
    </main>
    <script is:inline src="https://js.slvrbullet.com/pt.min.js"></script>
  </body>
</html>
