---
const PAGE_TITLE = "K18・プラチナを売る前に無料査定｜金買取査定ナビ";
const PAGE_DESC = "K18、18金ネックレス、プラチナを売る前に確認。査定だけでも相談したい方へ、買取価格や手数料、店頭・出張・宅配査定の違いをまとめました。";
const CANONICAL = "https://kaitori.hakobu-family.com/";
const OGP_IMAGE = "https://kaitori.hakobu-family.com/images/hero-gold-appraisal.png";
const MARKET_SOURCE_URL = "https://www.gold-tsutsumida.co.jp/trans-gold/";
const MARKET_YEARLY_SOURCE_URL = "https://gold.tanaka.co.jp/commodity/souba/y-gold.php";

const fallbackMarket = {
  updatedAt: "2026年5月18日 14時00分",
  retail: 25748,
  retailDiff: -397,
  buy: 25392,
  buyDiff: -397,
  history: [
    { label: "4/20", buy: 26655 },
    { label: "4/21", buy: 26943 },
    { label: "4/22", buy: 26546 },
    { label: "4/23", buy: 26633 },
    { label: "4/24", buy: 26403 },
    { label: "4/27", buy: 26230 },
    { label: "4/28", buy: 26299 },
    { label: "4/30", buy: 25660 },
    { label: "5/1", buy: 25551 },
    { label: "5/11", buy: 25846 },
    { label: "5/12", buy: 26310 },
    { label: "5/13", buy: 26183 },
    { label: "5/14", buy: 26076 },
    { label: "5/15", buy: 25789 },
    { label: "5/18", buy: 25392 }
  ]
};

const fallbackLongTermMarket = [
  { label: "2000", value: 1014 },
  { label: "2005", value: 1619 },
  { label: "2010", value: 3477 },
  { label: "2015", value: 4564 },
  { label: "2020", value: 6122 },
  { label: "2021", value: 6402 },
  { label: "2022", value: 7649 },
  { label: "2023", value: 8834 },
  { label: "2024", value: 11718 },
  { label: "2025", value: 17302 }
];

function yen(value) {
  return `${Number(value).toLocaleString("ja-JP")}円`;
}

function parseYen(value) {
  return Number(String(value || "").replace(/[^\d-]/g, ""));
}

async function getGoldMarket() {
  try {
    const response = await fetch(MARKET_SOURCE_URL);
    if (!response.ok) throw new Error("market_fetch_failed");
    const html = await response.text();
    const compact = html.replace(/\s+/g, " ");
    const updatedAt = compact.match(/(\d{4}年\d{1,2}月\d{1,2}日\s+\d{1,2}時\d{2}分)\s+発表/)?.[1] || fallbackMarket.updatedAt;
    const today = compact.match(/金地金\s+([\d,]+)\s+円\s+([+-]?[\d,]+)\s+円\s+([\d,]+)\s+円\s+([+-]?[\d,]+)\s+円/);
    if (!today) throw new Error("market_parse_failed");
    const rowPattern = /(\d{1,2}\/\d{1,2})\s+([\d,]+)\s+円\s+([+-]?[\d,]+)\s+円\s+([\d,]+)\s+円\s+([+-]?[\d,]+)\s+円/g;
    const history = [];
    for (const match of compact.matchAll(rowPattern)) {
      history.push({ label: match[1], buy: parseYen(match[4]) });
    }
    return {
      updatedAt,
      retail: parseYen(today[1]),
      retailDiff: parseYen(today[2]),
      buy: parseYen(today[3]),
      buyDiff: parseYen(today[4]),
      history: history.length >= 6 ? history.reverse() : fallbackMarket.history,
      sourceUrl: MARKET_SOURCE_URL
    };
  } catch (_) {
    return { ...fallbackMarket, sourceUrl: MARKET_SOURCE_URL };
  }
}

async function getLongTermGoldMarket() {
  try {
    const response = await fetch(MARKET_YEARLY_SOURCE_URL);
    if (!response.ok) throw new Error("long_market_fetch_failed");
    const html = await response.text();
    const compact = html.replace(/\s+/g, " ");
    const rowPattern = /\b(20\d{2})\s+[\d,.]+\s+[\d,.]+\s+[\d,.]+\s+[\d.]+\s+([\d,]+)\s+([\d,]+)\s+([\d,]+)/g;
    const rows = [];
    for (const match of compact.matchAll(rowPattern)) {
      const year = Number(match[1]);
      if (year >= 2000 && year <= 2025) {
        rows.push({ label: String(year), value: parseYen(match[4]) });
      }
    }
    const uniqueRows = [...new Map(rows.map((row) => [row.label, row])).values()]
      .sort((a, b) => Number(a.label) - Number(b.label));
    return uniqueRows.length >= 10 ? uniqueRows : fallbackLongTermMarket;
  } catch (_) {
    return fallbackLongTermMarket;
  }
}

function buildChartPoints(history) {
  const points = history;
  const values = points.map((point) => point.value);
  const min = Math.min(...values);
  const max = Math.max(...values);
  const range = Math.max(1, max - min);
  return points.map((point, index) => {
    const x = 10 + (index * 80) / Math.max(1, points.length - 1);
    const y = 78 - ((point.value - min) / range) * 50;
    return { ...point, x: Number(x.toFixed(2)), y: Number(y.toFixed(2)) };
  });
}

const goldMarket = await getGoldMarket();
const longTermMarket = await getLongTermGoldMarket();
const longTermChartData = [...longTermMarket, { label: "2026", value: goldMarket.buy, current: true }];
const marketMilestones = ["2000", "2010", "2020", "2025"].map((label) => longTermMarket.find((point) => point.label === label)).filter(Boolean);
marketMilestones.push({ label: "現在", value: goldMarket.buy });
const marketChartPoints = buildChartPoints(longTermChartData);
const marketPath = marketChartPoints.map((point, index) => `${index === 0 ? "M" : "L"} ${point.x} ${point.y}`).join(" ");
const marketAreaPath = `${marketPath} L ${marketChartPoints.at(-1)?.x || 90} 88 L ${marketChartPoints[0]?.x || 10} 88 Z`;
const firstMarketPoint = longTermMarket[0]?.value || goldMarket.buy;
const marketRiseRate = Math.max(0, Math.round((goldMarket.buy / firstMarketPoint) * 10) / 10);
const k18Estimate = Math.round(goldMarket.buy * 0.75);

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "K18やプラチナの買取価格はどう決まりますか？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "主に品位、重さ、当日の相場、状態、付属品、手数料、査定方法で変わります。実際の金額は査定時に確認してください。"
      }
    },
    {
      "@type": "Question",
      "name": "査定だけでも利用できますか？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "多くの買取店では査定だけでも相談できます。売る前に、査定料、出張料、キャンセル時費用、返送料などを確認してください。"
      }
    },
    {
      "@type": "Question",
      "name": "壊れた指輪や片方だけのピアスも査定できますか？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "金やプラチナとして値段が付く場合があります。刻印が見えにくい品物や古いアクセサリーも、捨てる前に一度見てもらうのがおすすめです。"
      }
    },
    {
      "@type": "Question",
      "name": "査定後に売らない選択はできますか？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "売るかどうかは、査定額や費用を見てから決められます。申し込む前に、キャンセル時費用や返送料、出張料などを確認してください。"
      }
    },
    {
      "@type": "Question",
      "name": "このページは買取店の公式サイトですか？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "いいえ。当サイトは買取店の公式サイトではありません。最新の内容はリンク先で確認してください。"
      }
    }
  ]
};
