---
const PAGE_TITLE = "K18・プラチナを売る前に無料査定｜金買取査定ナビ";
const PAGE_DESC = "K18、18金ネックレス、プラチナ、金貨を売る前に確認。査定だけでも相談したい方へ、買取価格の見方、手数料、店頭・出張・宅配査定の違いを比較します。";
const CANONICAL = "https://kaitori.hakobu-family.com/";
const OGP_IMAGE = "https://kaitori.hakobu-family.com/images/hero-gold-appraisal.png";

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "K18やプラチナの買取価格はどう決まりますか？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "主に品位、重量、当日の相場、状態、付属品、手数料、査定方法によって変わります。掲載内容は参考情報であり、実際の買取価格を保証するものではありません。"
      }
    },
    {
      "@type": "Question",
      "name": "査定だけでも利用できますか？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "多くの買取店では査定だけの相談が可能です。売却前に、査定料、出張料、キャンセル時費用、返送料などを公式サイトで確認してください。"
      }
    },
    {
      "@type": "Question",
      "name": "壊れた指輪や片方だけのピアスも査定できますか？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "金やプラチナとして価値が付く場合があります。刻印が見えにくい品物や古いアクセサリーも、状態だけで判断せず無料査定で確認するのがおすすめです。"
      }
    },
    {
      "@type": "Question",
      "name": "査定後に売らない選択はできますか？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "売却するかは査定額や条件を確認してから判断します。申込前に、キャンセル時費用や返送料、出張料などを公式サイトで確認してください。"
      }
    },
    {
      "@type": "Question",
      "name": "このページは買取店の公式サイトですか？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "いいえ。当サイトは買取店の公式サイトではありません。最新条件は各公式サイトでご確認ください。"
      }
    }
  ]
};
---
<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{PAGE_TITLE}</title>
  <meta name="description" content={PAGE_DESC} />
  <link rel="canonical" href={CANONICAL} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={PAGE_TITLE} />
  <meta property="og:description" content={PAGE_DESC} />
  <meta property="og:url" content={CANONICAL} />
  <meta property="og:image" content={OGP_IMAGE} />
  <meta property="og:locale" content="ja_JP" />
  <meta property="og:site_name" content="金買取査定ナビ" />
  <meta name="twitter:card" content="summary_large_image" />
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700;900&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/styles.css?v=20260512-2" />
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-DMCWVLP3E3"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){ dataLayer.push(arguments); }
    gtag('js', new Date());
    gtag('config', 'G-DMCWVLP3E3');
