---
const PAGE_TITLE = "K18・プラチナを売る前に無料査定｜金買取査定ナビ";
const PAGE_DESC = "K18、18金ネックレス、プラチナを売る前に確認。査定だけでも相談したい方へ、買取価格や手数料、店頭・出張・宅配査定の違いをまとめました。";
const CANONICAL = "https://kaitori.hakobu-family.com/";
const OGP_IMAGE = "https://kaitori.hakobu-family.com/images/hero-gold-appraisal.png";

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "K18やプラチナの買取価格はどう決まりますか？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "主に品位、重さ、当日の相場、状態、付属品、手数料、査定方法で変わります。実際の金額は査定時に確認してください。"
      }
    },
    {
      "@type": "Question",
      "name": "査定だけでも利用できますか？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "多くの買取店では査定だけでも相談できます。売る前に、査定料、出張料、キャンセル時費用、返送料などを確認してください。"
      }
    },
    {
      "@type": "Question",
      "name": "壊れた指輪や片方だけのピアスも査定できますか？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "金やプラチナとして値段が付く場合があります。刻印が見えにくい品物や古いアクセサリーも、捨てる前に一度見てもらうのがおすすめです。"
      }
    },
    {
      "@type": "Question",
      "name": "査定後に売らない選択はできますか？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "売るかどうかは、査定額や費用を見てから決められます。申し込む前に、キャンセル時費用や返送料、出張料などを確認してください。"
      }
    },
    {
      "@type": "Question",
      "name": "このページは買取店の公式サイトですか？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "いいえ。当サイトは買取店の公式サイトではありません。最新の内容はリンク先で確認してください。"
      }
    }
  ]
};
---
<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{PAGE_TITLE}</title>
  <meta name="description" content={PAGE_DESC} />
  <link rel="canonical" href={CANONICAL} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={PAGE_TITLE} />
  <meta property="og:description" content={PAGE_DESC} />
  <meta property="og:url" content={CANONICAL} />
  <meta property="og:image" content={OGP_IMAGE} />
  <meta property="og:locale" content="ja_JP" />
  <meta property="og:site_name" content="金買取査定ナビ" />
  <meta name="twitter:card" content="summary_large_image" />
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700;900&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/styles.css?v=20260512-7" />
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-DMCWVLP3E3"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){ dataLayer.push(arguments); }
    gtag('js', new Date());
    gtag('config', 'G-DMCWVLP3E3');
    gtag('config', 'AW-18129603657');
  </script>
</head>
<body>
  <header class="site-header">
    <div class="container header-inner">
      <a href="/" class="brand" aria-label="金買取査定ナビ">
        <span class="brand-mark">Au</span>
        <span class="brand-text">金買取査定ナビ</span>
      </a>
      <nav class="nav" aria-label="ページ内ナビゲーション">
        <a href="#sell-now" data-scroll-to="#sell-now">今見る理由</a>
        <a href="#ai-check" data-scroll-to="#ai-check">査定前チェック</a>
        <a href="#compare" data-scroll-to="#compare">比較</a>
        <a href="#price" data-scroll-to="#price">価格</a>
        <a href="#items" data-scroll-to="#items">品目別</a>
        <a href="#check" data-scroll-to="#check">注意点</a>
        <a href="#faq" data-scroll-to="#faq">FAQ</a>
      </nav>
    </div>
  </header>

  <main>
    <section class="hero">
      <div class="hero-bg" aria-hidden="true">
        <img src="/images/hero-gold-appraisal.png" alt="" width="1536" height="864" decoding="async" fetchpriority="high" />
      </div>
      <div class="container hero-inner">
        <div class="hero-copy">
          <p class="eyebrow">金相場が高い今、しまったままはもったいない</p>
          <h1>そのK18・<span class="no-break">プラチナ</span>、<br />今いくらかだけ聞いてみる。</h1>
          <p class="hero-lead">
            切れたネックレス、古い指輪、片方だけのピアスも一度見てもらう価値があります。
            査定額を聞いてから売るか決めればいいので、まずは無料査定の内容だけ見てみましょう。
          </p>
          <div class="hero-actions" aria-label="主要アクション">
            <a href="#" class="btn btn-primary" data-affiliate="manekiya" data-track="hero_manekiya_primary" rel="nofollow sponsored">無料査定の内容を見る</a>
            <a href="#" class="btn btn-secondary" data-affiliate="manekiya" data-track="hero_manekiya" rel="nofollow sponsored">まねきや公式で無料査定予約へ</a>
          </div>
          <p class="cta-microcopy">査定料・出張料・キャンセル時の費用を見てから決められます。</p>
          <ul class="hero-points" aria-label="確認できること">
            <li>電話申し込み限定 最大30%UP</li>
            <li>金・プラチナ相場を確認</li>
            <li>壊れた金製品も見てもらえる</li>
            <li>店頭・出張・宅配に対応</li>
          </ul>
        </div>
        <aside class="hero-panel" aria-label="査定前チェック">
          <span class="panel-label">まねきやで確認</span>
          <h2>今日の相場とキャンペーンを見てから申し込める</h2>
          <div class="rate-mini-grid" aria-label="参考相場">
            <div><span>K18</span><strong>19,416円/g</strong></div>
            <div><span>Pt900</span><strong>9,945円/g</strong></div>
            <div><span>査定料</span><strong>無料</strong></div>
            <div><span>電話限定</span><strong>最大30%UP</strong></div>
          </div>
          <div class="hero-ticket">
            <span>見てもらいたい品物</span>
            <strong>切れたネックレス・古い指輪・金歯・プラチナ</strong>
          </div>
          <p>30%UPは電話申し込み限定です。地金・金貨・インゴット・金券などは対象外です。</p>
        </aside>
      </div>
    </section>

    <section class="reassurance-band" aria-label="査定前の安心ポイント">
      <div class="container reassurance-grid">
        <div>
          <span>01</span>
          <strong>売るかは金額を見てから</strong>
          <p>金額を聞いてから、売るかどうかを落ち着いて決められます。</p>
        </div>
        <div>
          <span>02</span>
          <strong>壊れた金製品も見てもらえる</strong>
          <p>切れたチェーンや片方ピアスも、金として値段が付く場合があります。</p>
        </div>
        <div>
          <span>03</span>
          <strong>持ち歩きが不安なら方法を選ぶ</strong>
          <p>持ち歩きたくない品物は、出張や宅配も選べます。</p>
        </div>
      </div>
    </section>

    <section class="section sell-now-section" id="sell-now">
      <div class="container">
        <div class="section-head">
          <span class="section-kicker">今見る理由</span>
          <h2>まねきやを見る前に、ここだけ押さえておけばOK</h2>
          <p>相場、キャンペーン、実績例、無料で見てもらえる範囲。金を売る前に気になるところだけまとめました。</p>
        </div>

        <div class="sell-now-layout">
          <div class="promo-board">
            <div class="promo-main">
              <span>5/1〜5/31</span>
              <strong>買取金額 最大30%UP</strong>
              <p>電話申し込み限定です。地金・金貨・インゴット・金券などは対象外です。</p>
            </div>
            <div class="promo-sub"><span>査定料</span><strong>無料</strong></div>
            <div class="promo-sub"><span>出張料</span><strong>無料</strong></div>
            <div class="promo-sub"><span>対象外</span><strong>地金など</strong></div>
          </div>

          <div class="visual-stack" aria-label="金買取のイメージ">
            <figure>
              <img src="/images/appraisal-desk-ai.png" alt="金のネックレスと指輪の査定イメージ" loading="lazy" />
              <figcaption>査定前に、刻印・重さ・状態をチェック</figcaption>
            </figure>
            <div class="visual-note">
              <span>見る順番</span>
              <strong>相場 → 手数料 → 査定方法 → キャンセル時の費用</strong>
            </div>
          </div>
        </div>

        <div class="example-strip" aria-label="買取実績例">
          <article>
            <span>査定例</span>
            <strong>石が取れた指輪・片方ピアス・切れたネックレス</strong>
            <p>壊れていても、金として値段が付く場合があります。</p>
          </article>
          <article>
            <span>査定例</span>
            <strong>金歯・古いアクセサリー・片方ピアス</strong>
            <p>アクセサリー以外の金製品も見てもらえる場合があります。</p>
          </article>
          <article>
            <span>高額品向け</span>
            <strong>店頭・出張・宅配を選べる</strong>
            <p>持ち歩きが不安な品物は、家にいながら相談する方法もあります。</p>
          </article>
        </div>

        <div class="sell-now-cta">
          <a href="#" class="btn btn-primary" data-affiliate="manekiya" data-track="sell_now_manekiya" rel="nofollow sponsored">まねきやで無料査定の内容を見る</a>
          <a href="#ai-check" class="btn btn-outline" data-scroll-to="#ai-check" data-track="sell_now_check">手元の品物を30秒で整理</a>
        </div>
        <p class="campaign-note">※キャンペーンは電話申し込み限定です。地金、金貨、インゴット、金券など一部対象外があります。最新の内容はリンク先で確認してください。</p>
      </div>
    </section>

    <section class="section ai-section" id="ai-check">
      <div class="container">
        <div class="ai-shell">
          <div class="ai-intro">
            <span class="section-kicker">査定前チェック</span>
            <h2>相談する前に、手元の品物をざっくり整理</h2>
            <p>
              品物、刻印、重さ、状態を選ぶだけで、何を聞けばいいか整理できます。
              写真を入れると、刻印らしき文字もこの画面内でチェックします。
            </p>
            <div class="ai-trust-grid" aria-label="査定前チェックでできること">
              <div><strong>見てもらいたい品物</strong><span>K18、Pt、金歯、壊れたアクセサリー</span></div>
              <div><strong>刻印整理</strong><span>K18、750、K24、Pt900、GP/GFなど</span></div>
              <div><strong>査定方法</strong><span>店頭・出張・宅配のどれが楽そうか</span></div>
            </div>
          </div>

          <div class="ai-card" aria-label="査定前チェックフォーム">
            <div class="ai-card-head">
              <span>30秒チェック</span>
              <strong>写真なしでも利用できます</strong>
            </div>

            <form class="ai-form" data-ai-form>
              <label>
                <span>写真チェック（任意）</span>
                <input type="file" accept="image/*" data-ai-photo />
                <small>写真はこの画面内で確認します。刻印OCRもブラウザ内で処理し、アップロード保存はしません。</small>
              </label>

              <div class="ai-photo-preview" data-ai-photo-preview hidden>
                <img alt="選択した品物の写真プレビュー" data-ai-photo-img />
                <div>
                  <p data-ai-photo-note>刻印・全体・傷や切れた部分が分かる写真もあると相談しやすくなります。</p>
                  <div class="ocr-status" data-ocr-status>写真を選ぶと、刻印候補を自動で読み取ります。</div>
                </div>
              </div>

              <div class="ai-fields">
                <label>
                  <span>品物</span>
                  <select name="item">
                    <option value="necklace">金・プラチナのネックレス</option>
                    <option value="ring">指輪・リング</option>
                    <option value="earring">片方ピアス・イヤリング</option>
                    <option value="coin">金貨・インゴット</option>
                    <option value="tooth">金歯・金板・破片</option>
                    <option value="unknown">よく分からない貴金属</option>
                  </select>
                </label>
                <label>
                  <span>刻印</span>
                  <select name="mark">
                    <option value="k18">K18 / 750</option>
                    <option value="k24">K24 / 純金</option>
                    <option value="pt900">Pt900 / Pt950</option>
                    <option value="pt850">Pt850</option>
                    <option value="unknown">刻印が読めない</option>
                    <option value="plated">GP / GF / メッキかも</option>
                  </select>
                </label>
                <label>
                  <span>重さ</span>
                  <select name="weight">
                    <option value="unknown">分からない</option>
                    <option value="light">5g未満</option>
                    <option value="middle">5〜20gくらい</option>
                    <option value="heavy">20g以上</option>
                    <option value="many">複数点ある</option>
                  </select>
                </label>
                <label>
                  <span>状態</span>
                  <select name="condition">
                    <option value="normal">目立つ破損はない</option>
                    <option value="broken">切れ・石取れ・片方だけ</option>
                    <option value="old">古い・変色・刻印が薄い</option>
                    <option value="high">高額品なので持ち歩きが不安</option>
                  </select>
                </label>
                <label>
                  <span>希望</span>
                  <select name="preference">
                    <option value="price">まず金額だけ知りたい</option>
                    <option value="fast">早く対面で相談したい</option>
                    <option value="safe">持ち歩かずに相談したい</option>
                    <option value="private">人に見られず進めたい</option>
                  </select>
                </label>
              </div>

              <button class="btn btn-primary" type="submit" data-track="ai_check_submit">確認ポイントを出す</button>
            </form>
          </div>

          <div class="ai-result" data-ai-result hidden aria-live="polite">
            <div class="ai-result-main">
              <span class="section-kicker">チェック結果</span>
              <h3 data-ai-title>査定前チェック結果</h3>
              <p data-ai-summary></p>
              <div class="ai-result-route" data-ai-route></div>
              <ul data-ai-points></ul>
            </div>
            <div class="ai-message-box">
              <strong>そのまま伝えやすい相談文</strong>
              <textarea data-ai-message readonly></textarea>
              <button type="button" class="btn btn-outline" data-ai-copy>相談文をコピー</button>
              <a href="#" class="btn btn-primary" data-affiliate="manekiya" data-track="ai_result_manekiya" rel="nofollow sponsored">この内容で無料査定を見てみる</a>
              <p>正確な査定額や費用は、申し込み先で確認してください。</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="conversion-bridge">
      <div class="container bridge-box">
        <div>
          <span class="section-kicker">次にやること</span>
          <h2>まずは「売る」ではなく、無料査定だけ見てみる</h2>
          <p>相場や買取方法、費用を見て、よさそうなら査定予約へ。金額を聞いてから売るか決める流れです。</p>
        </div>
        <a href="#" class="btn btn-primary" data-affiliate="manekiya" data-track="bridge_manekiya" rel="nofollow sponsored">無料査定ページを見る</a>
      </div>
    </section>

    <section class="section push-section">
      <div class="container push-layout">
        <div>
          <span class="section-kicker">申し込み前に</span>
          <h2>申し込み後の流れは、この3つだけ</h2>
          <p>いきなり売るわけではありません。先に費用や査定方法を見て、合いそうなら申し込めます。</p>
        </div>
        <div class="push-steps">
          <article>
            <span>1</span>
            <strong>費用を見る</strong>
            <p>査定料、出張・宅配、キャンセル時の費用をチェック。</p>
          </article>
          <article>
            <span>2</span>
            <strong>査定方法を選ぶ</strong>
            <p>店頭・出張・宅配から、持ち運びや点数に合う方法を選びます。</p>
          </article>
          <article>
            <span>3</span>
            <strong>金額を聞いて判断</strong>
            <p>金額と費用を見て、売るかどうかを決めます。</p>
          </article>
        </div>
      </div>
    </section>

    <section class="section consult-section">
      <div class="container">
        <div class="section-head">
          <span class="section-kicker">迷っている方へ</span>
          <h2>「まだ売るか分からない」人ほど、先に査定額を聞いた方が早い</h2>
          <p>金の相場を検索しても、手元の品物がいくらになるかは分かりません。悩むより、まず金額を聞いた方が早いです。</p>
        </div>
        <div class="consult-grid">
          <article>
            <strong>相場だけでは分からない</strong>
            <p>K18、K24、Pt900など、刻印によって単価が変わります。刻印が薄い品物も一度見てもらえます。</p>
          </article>
          <article>
            <strong>壊れていても値段が付くことがある</strong>
            <p>切れたチェーン、片方だけのピアス、古い指輪も、金として値段が付く場合があります。</p>
          </article>
          <article>
            <strong>手数料で手取りが変わる</strong>
            <p>査定料、出張料、キャンセル時の費用、返送料まで見てから売るか決めると安心です。</p>
          </article>
        </div>
      </div>
    </section>

    <section class="section item-proof-section">
      <div class="container">
        <div class="section-head">
          <span class="section-kicker">こんな品物も</span>
          <h2>「これも売れるの？」と思ったら、捨てる前に一度チェック</h2>
          <p>古いもの、壊れたもの、片方だけのものでも、金やプラチナとして値段が付く場合があります。</p>
        </div>
        <div class="item-proof-grid">
          <article><span>K18</span><strong>切れたネックレス</strong><p>チェーンが切れていても、金として値段が付く場合があります。</p></article>
          <article><span>Pt</span><strong>古いプラチナ指輪</strong><p>Pt900、Pt850などの刻印と重さを見てもらえます。</p></article>
          <article><span>K24</span><strong>金貨・インゴット</strong><p>高額品は持ち運びや入金方法も含めて相談方法を選びます。</p></article>
          <article><span>Au</span><strong>金歯・金板・破片</strong><p>アクセサリーの形でなくても、金なら見てもらえる場合があります。</p></article>
          <article><span>片方</span><strong>片方だけのピアス</strong><p>セットでなくても、金やプラチナなら値段が付く場合があります。</p></article>
          <article><span>石付き</span><strong>石付きの指輪</strong><p>石やデザイン部分の扱いも、実物を見てもらうのが確実です。</p></article>
        </div>
        <div class="item-proof-cta">
          <a href="#ai-check" class="btn btn-primary" data-scroll-to="#ai-check" data-track="item_proof_ai">手元の品物を整理する</a>
          <a href="#" class="btn btn-outline" data-affiliate="manekiya" data-track="item_proof_manekiya" rel="nofollow sponsored">まねきやで売れる品物を見る</a>
        </div>
      </div>
    </section>

    <section class="section proof-section">
      <div class="container proof-layout">
        <div>
          <span class="section-kicker">まねきやを選ぶ理由</span>
          <h2>まねきやを1位にした理由は、最初に見やすいから</h2>
          <p>
            金やプラチナは、相場だけ見ても自分の品物の金額までは分かりません。
            まねきやは、店頭・出張・宅配を選びながら、売る前に金額だけ聞きやすい買取店です。
          </p>
          <a href="#" class="btn btn-primary" data-affiliate="manekiya" data-track="proof_manekiya" rel="nofollow sponsored">まねきや公式で無料査定予約へ</a>
        </div>
        <div class="proof-grid">
          <article>
            <span>01</span>
            <h3>今日の相場を見やすい</h3>
