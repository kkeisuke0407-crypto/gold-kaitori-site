// 重さ別の参考買取額（既定はK18基準）
const goldEx = (w, karat = rates.k18) => `約${Math.round(karat * w * 0.9).toLocaleString("ja-JP")}〜${Math.round(karat * w).toLocaleString("ja-JP")}円`;
// 重さ別の参考買取額（万円表示・既定はK18基準）
const goldExMan = (w, karat = rates.k18) => {
  const fmt = (v) => {
    const man = v / 10000;
    return man >= 10 ? Math.round(man) : Math.round(man * 10) / 10;
  };
  return `約${fmt(karat * w * 0.9)}〜${fmt(karat * w)}万円`;
};
// キャンペーン残日数（まねきや 7/31まで）
const campMonth = new Date(new Date().toLocaleString('en-US', { timeZone: 'Asia/Tokyo' })).getMonth() + 1;
  const campMonthLabel = campMonth + "月限定";
  // キャンペーン終了＝おたからや「買取金額35%UP」の締切（2026/7/19 日・23:59 JST）。
  const campEnd = new Date(2026, 6, 19, 23, 59, 59);
  const _campWd = ['日','月','火','水','木','金','土'][campEnd.getDay()];
  const campEndMd = (campEnd.getMonth() + 1) + "月" + campEnd.getDate() + "日";
  const campEndLabel = campEndMd + "（" + _campWd + "）";
  const campEndYmd = campEnd.getFullYear() + "年" + campEndMd;
  // まねきやのキャンペーンは「当月1日〜当月末日」。おたからや(週次日曜=campEnd)と混同しないよう別変数で持つ。
  const _todayJst = new Date(new Date().toLocaleString('en-US', { timeZone: 'Asia/Tokyo' }));
  const mkCampStart = new Date(_todayJst.getFullYear(), _todayJst.getMonth(), 1);
  const mkCampEnd = new Date(_todayJst.getFullYear(), _todayJst.getMonth() + 1, 0, 23, 59, 59);
  const mkCampDays = Math.max(0, Math.ceil((mkCampEnd - _todayJst) / 86400000));
  const mkCampRangeLabel = (mkCampStart.getMonth() + 1) + "月" + mkCampStart.getDate() + "日〜" + (mkCampEnd.getMonth() + 1) + "月" + mkCampEnd.getDate() + "日";
const today   = new Date(new Date().toLocaleString('en-US',{timeZone:'Asia/Tokyo'}));
const todayLabel = today.getFullYear() + "年" + (today.getMonth() + 1) + "月" + today.getDate() + "日";
const campDays = Math.max(0, Math.ceil((campEnd - today) / 86400000));

// アフィリエイトリンク（manekiya / otakaraya は実リンク、buraibaは要設定）
