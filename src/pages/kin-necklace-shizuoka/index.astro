---
const PAGE_TITLE = "静岡で金ネックレスを高く売るなら｜手数料無料・電話予約で買取額最大30%UP｜まねきや";
const PAGE_DESC = "静岡で金ネックレスを高く売るならどこ？注力地域×金ネックレスはまねきやがおすすめ。電話査定予約で買取額最大30%UP＋金買取手数料10%が無料に。査定は無料・キャンセルOK。静岡の対象店舗を掲載。";
const CANONICAL = "https://kaitori.hakobu-family.com/kin-necklace-shizuoka/";
const REGION = "静岡"; // 注力地域名。各地域LPはここだけ差し替える。
const OGP_IMAGE = "https://kaitori.hakobu-family.com/images/og-gold.webp";

import { getRates, yen, MARKET_SOURCE_URL } from "../../lib/rates.js";
import { getOtakaraya } from "../../lib/otakaraya.js";
const rates = await getRates();
const otakaraya = getOtakaraya();
// 重さ別の参考買取額（既定はK18基準）
const goldEx = (w, karat = rates.k18) => `約${Math.round(karat * w * 0.9).toLocaleString("ja-JP")}〜${Math.round(karat * w).toLocaleString("ja-JP")}円`;
// 重さ別の参考買取額（万円表示・既定はK18基準）
const goldExMan = (w, karat = rates.k18) => {
  const fmt = (v) => {
    const man = v / 10000;
    return man >= 10 ? Math.round(man) : Math.round(man * 10) / 10;
  };
  return `約${fmt(karat * w * 0.9)}〜${fmt(karat * w)}万円`;
};
// キャンペーン残日数（まねきや 7/31まで）
const campMonth = new Date(new Date().toLocaleString('en-US', { timeZone: 'Asia/Tokyo' })).getMonth() + 1;
  const campMonthLabel = campMonth + "月限定";
  // キャンペーン終了＝おたからや「買取金額3倍 現金プレゼント（抽せんで10名様限定）」の締切（2026/7/13 月・23:59 JST）。
  const campEnd = new Date(2026, 6, 13, 23, 59, 59);
  const _campWd = ['日','月','火','水','木','金','土'][campEnd.getDay()];
  const campEndMd = (campEnd.getMonth() + 1) + "月" + campEnd.getDate() + "日";
  const campEndLabel = campEndMd + "（" + _campWd + "）";
  const campEndYmd = campEnd.getFullYear() + "年" + campEndMd;
  // まねきやのキャンペーンは「当月1日〜当月末日」。おたからや(週次日曜=campEnd)と混同しないよう別変数で持つ。
  const _todayJst = new Date(new Date().toLocaleString('en-US', { timeZone: 'Asia/Tokyo' }));
  const mkCampStart = new Date(_todayJst.getFullYear(), _todayJst.getMonth(), 1);
  const mkCampEnd = new Date(_todayJst.getFullYear(), _todayJst.getMonth() + 1, 0, 23, 59, 59);
  const mkCampDays = Math.max(0, Math.ceil((mkCampEnd - _todayJst) / 86400000));
  const mkCampRangeLabel = (mkCampStart.getMonth() + 1) + "月" + mkCampStart.getDate() + "日〜" + (mkCampEnd.getMonth() + 1) + "月" + mkCampEnd.getDate() + "日";
const today   = new Date(new Date().toLocaleString('en-US',{timeZone:'Asia/Tokyo'}));
const todayLabel = today.getFullYear() + "年" + (today.getMonth() + 1) + "月" + today.getDate() + "日";
const campDays = Math.max(0, Math.ceil((campEnd - today) / 86400000));

const faqJsonLd = {
  "@context": "https://schema.org", "@type": "FAQPage",
  "mainEntity": [
    ["金は1点だけでも査定できますか？", "はい、1点からでも無料で査定してもらえます。ネックレス1本・指輪1個でも断られることはほとんどありません。"],
    ["K18のネックレスはいくらで売れますか？", "重さ×その日のグラム単価がおおよその目安です。本日のK18は約" + yen(rates.k18) + "/gで、例えば10gのネックレスなら" + goldEx(10) + "ほどが目安です（状態・デザインで変わります）。"],
    ["壊れた金・切れたネックレスでも売れますか？", "売れます。壊れていても曲がっていても、金としての価値は重さで変わりません。地金として査定されます。"],
    ["刻印（K18・750など）がない金でも買取できますか？", "X線などの成分分析で純度を調べてもらえるため、刻印がなくても査定・買取できます。"],
    ["金貨・インゴット（地金）も売れますか？", "売れます。メイプルリーフやウィーン金貨などの金貨、インゴットも相場に応じて査定されます。"],
    ["金歯やメダル、仏具の金も買取できますか？", "買取できます。金歯（差し歯）・記念メダル・仏具など、金が含まれていれば査定対象です。"],
    ["鑑定書や保証書がなくても大丈夫ですか？", "なくても査定・買取できます。あれば査定がスムーズになることがありますが、必須ではありません。"],
    ["査定後にキャンセルできますか？", "ほとんどのお店で、査定額に納得できなければ無料でキャンセルできます。売るかは金額を見てから決められます。"],
    ["出張査定は無料ですか？", "今回紹介する店は出張料・査定料・キャンセル料が無料と案内されています。詳しくは各店の公式でご確認ください。"],
    ["どのタイミングで売るのがよいですか？", "金相場は毎日動き、今は過去最高水準で推移しています。相場が高いうちに、まず今の金額を確認しておくのがおすすめです。"]
  ].map(([q, a]) => ({ "@type": "Question", "name": q, "acceptedAnswer": { "@type": "Answer", "text": a } }))
};

// アフィリエイトリンク（manekiya / otakaraya は実リンク、buraibaは要設定）
const AFF_MANEKIYA = "https://ad-fam.com/ad/p/r?_site=49248&_article=16522";
const AFF_OTAKARAYA = "https://lp.otakaraya.jp/lp-gold-a/";
---
<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{PAGE_TITLE}</title>
  <meta name="description" content={PAGE_DESC} />
  <link rel="canonical" href={CANONICAL} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={PAGE_TITLE} />
  <meta property="og:description" content={PAGE_DESC} />
  <meta property="og:url" content={CANONICAL} />
  <meta property="og:image" content={OGP_IMAGE} />
  <meta property="og:locale" content="ja_JP" />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700;900&display=swap" onload="this.onload=null;this.rel='stylesheet'" />
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700;900&display=swap" /></noscript>
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-DMCWVLP3E3"></script>
  <script is:inline defer src="/cta-hours.js"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){ dataLayer.push(arguments); }
    gtag('js', new Date()); gtag('config', 'G-DMCWVLP3E3'); gtag('config', 'AW-18129603657');
  </script>
  <script is:inline>
    (function(c,l,a,r,i,t,y){ c[a]=c[a]||function(){ (c[a].q=c[a].q||[]).push(arguments); };
      t=l.createElement(r); t.async=1; t.src="https://www.clarity.ms/tag/"+i;
      y=l.getElementsByTagName(r)[0]; y.parentNode.insertBefore(t,y);
    })(window, document, "clarity", "script", "wxnujpnscp");
  </script>
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
</head>
<body data-landing-intent="lp_kin_necklace_shizuoka"
  data-aff-manekiya={AFF_MANEKIYA} data-aff-otakaraya={AFF_OTAKARAYA} data-aff-buraiba="https://brandrevalue.com/">

  <main>
    <!-- 01 FV -->
    <section class="fv">
      <div class="wrap">
        <h1 class="fv-area-hero">
          <a href="#rank-manekiya" class="fv-hero-link" aria-label={REGION + "で金ネックレスを高く売るならおすすめのまねきやを見る"}>
            <img src="/images/fv-hero-necklace-area.png" alt={REGION + "で金ネックレスを高く売るならどこがいい？査定後にキャンセルもOK・査定無料・はじめてでも安心の高価買取査定"} width="1672" height="941" loading="eager" fetchpriority="high" decoding="async" class="fv-hero-img" />
            <span class="fv-area-badge" aria-hidden="true">{REGION}</span>
          </a>
        </h1>

        <div class="fv-datebadge">
          <span class="fv-db-tag"><i class="fv-db-dot"></i>最新版</span>
          <span class="fv-db-date">{todayLabel}</span>
          <a href="#ranking" class="fv-db-txt fv-db-link">📍 {campMonthLabel}キャンペーンあり</a>
        </div>

        <div class="area-lead">
          <h2 class="area-lead-ttl"><span class="nb">{REGION}で金ネックレスを売るなら</span><span class="nb">「まねきや」がおすすめ</span></h2>
          <p class="area-lead-sub">査定は無料・売るかは金額を見てから決められます。まずは今の金額だけ確認しておきましょう。</p>
        </div>
      </div>
    </section>

    <!-- 02 まねきや（1位） -->
    <section class="sec" id="ranking">
      <div class="wrap">
        <article class="rk rk-necklace" id="rank-manekiya">
          <div class="rk-head"><h3>まねきや</h3><i class="pr">PR</i></div>
          <a href="#" data-aff="manekiya" data-track="rk_head_bn" rel="nofollow sponsored" style="display:block;margin:10px 0;">
            <img src="/images/manekiya_bn.png" width="300" height="250" alt="まねきや" style="width:100%;max-width:320px;height:auto;display:block;margin:0 auto;border-radius:8px;" loading="lazy" />
          </a>
          <p class="rk-for">{REGION}で金ネックレスを、できるだけ高く・手取りを減らさず売りたい人に</p>
          <table class="rk-spec">
            <tbody>
              <tr class="rs-head"><th>買取価格</th><th>買取方法</th><th>状態不良<br />の品物</th><th>査定士</th></tr>
              <tr class="rs-val">
                <td><span class="rs-ic">◎</span>業界最高<br />水準＋α</td>
                <td><span class="rs-ic">◎</span>店舗・出張<br />・宅配</td>
                <td><span class="rs-ic">◎</span>査定可能</td>
                <td><span class="rs-ic">◎</span>鑑定スペ<br />シャリスト</td>
              </tr>
              <tr class="rs-head"><th colspan="2">対応スピード</th><th colspan="2">{campMonthLabel}キャンペーン</th></tr>
              <tr class="rs-val">
                <td colspan="2"><span class="rs-ic">◎</span>即日現金化</td>
                <td colspan="2"><b class="rs-camp rs-camp-big">買取金額最大<em>30%</em>UP<br />＋手数料<em>10%</em>無料</b></td>
              </tr>
            </tbody>
          </table>
          <div class="rk-osusume">
            <div class="rk-osusume-h">💡 おすすめポイント</div>
            <div class="reco-lead">
              <h4 class="reco-lead-ttl"><span class="nb">{REGION}で金のネックレスを売るなら</span><span class="nb">「まねきや」がおすすめ</span></h4>
              <p class="reco-lead-p">「{REGION}」で「金のネックレス」を売る場合、電話で査定予約をすると、</p>
              <ul class="reco-lead-list">
                <li>買取金額が<b>最大30％アップ</b></li>
                <li>通常10％の<b>金買取手数料が無料</b></li>
              </ul>
              <p class="reco-lead-p">のキャンペーンが適用されます。そのため、対象条件を満たす金ネックレスなら、<b class="reco-hl">まねきやが最も手取り額が高くなる可能性</b>があります。</p>
              <p class="reco-lead-note">ただし、金貨・インゴット・地金・プラチナなどはキャンペーン対象外です。これらを売る場合は、2位の<a href="#" class="mk-reco-link" data-aff="otakaraya" data-track="reco_otakaraya" rel="nofollow sponsored">「おたからや」</a>がおすすめです。</p>
            </div>
            <ul>
              <li><span class="chk">✓</span><span><mark>「{REGION}」は注力地域</mark>のため、高額買取になる可能性あり</span></li>
              <li><span class="chk">✓</span><span><mark>金ネックレスはキャンペーン対象</mark>のため、高額買取になる可能性あり</span></li>
              <li><span class="chk">✓</span><span>電話査定予約で<mark>買取額30%UP＋金買取手数料10%→無料</mark></span></li>
              <li><span class="chk">✓</span><span>査定料・出張料・キャンセル料が<mark>0円</mark></span></li>
              <li><span class="chk">✓</span><span><mark>売るのは査定金額を聞いてからでOK</mark></span></li>
            </ul>
          </div>

          <!-- キャンペーンバナー（30%UP・手数料無料を横並び） -->
          <div class="camp-banners">
            <a href="#" class="camp-banner-cell" data-aff="manekiya" data-track="camp_30up" rel="nofollow sponsored">
              <img src="/images/info_img2.webp" width="3125" height="1218" alt="電話申込限定 買取金額最大30%UP ※地金・金貨・インゴット・金券は対象外です" loading="lazy" decoding="async" />
              {mkCampDays > 0 && <span class="offer-30-term">{mkCampRangeLabel}｜あと{mkCampDays}日</span>}
            </a>
            <a href="#" class="camp-banner-cell" data-aff="manekiya" data-track="camp_tesuryo" rel="nofollow sponsored">
              <img src="/images/precious-event.webp" width="1201" height="872" alt="金製品の買取 手数料無料（通常10%）※分析料のみかかります／金製品を高く売るなら「まねきや」" loading="lazy" decoding="async" />
            </a>
          </div>

          <div class="cta-pair">
            <a href="#" class="btn btn-phone" data-aff="manekiya" data-track="rk_manekiya_phone" rel="nofollow sponsored"><i>☎</i>電話で無料相談</a>
            <a href="#" class="btn btn-web" data-aff="manekiya" data-track="rk_manekiya_web" rel="nofollow sponsored">WEBで無料査定予約</a>
          </div>
        </article>
      </div>
    </section>

    <!-- 04 対象店舗（静岡） -->
    <section class="sec" id="stores">
      <div class="wrap">
        <div class="sec-head"><h2>{REGION}の対象店舗</h2><p>お近くの店舗で、無料査定が受けられます。</p></div>
        <div class="store-list">
          <div class="store">
            <img class="store-img" src="/images/stores/shop_img1-07.webp" width="251" height="251" alt="まねきや 静岡本店" loading="lazy" decoding="async" />
            <div class="store-body">
              <h3 class="store-name">静岡本店</h3>
              <p class="store-addr">〒420-0858 静岡県静岡市葵区伝馬町6-1 けやきプラザ B1F</p>
            </div>
          </div>
        </div>
        <div class="cta-pair">
          <a href="#" class="btn btn-phone" data-aff="manekiya" data-track="stores_phone" rel="nofollow sponsored"><i>☎</i>電話で無料相談</a>
          <a href="#" class="btn btn-web" data-aff="manekiya" data-track="stores_web" rel="nofollow sponsored">WEBで無料査定予約</a>
        </div>
        <p class="point-cta-note">査定だけ・相談だけでもOK／ご相談は無料です</p>
      </div>
    </section>

    <!-- ▼▼ ここから LP3（比較表〜以下）を継承 ▼▼ -->
    <!-- 03 高く売るコツ -->
    <section class="sec" id="point">
      <div class="wrap">
        <div class="sec-head sec-head-point"><h2>高く売るための3つのポイント</h2><p>お店選びの前に、これだけ知っておきましょう。</p></div>
        <img class="point-img" src="/images/point-takaku1.webp" alt="高く売るための3つのポイント（1）" width="1672" height="941" loading="lazy" decoding="async" />
        <div class="point-note">
          <p>金の買取相場は<span class="hl-u">歴史的な高水準</span>にありますが、実はピークからは<b class="hl-red">大きく値を下げています</b>。<br /><br />相場は2026年3月に<b class="hl-red">1gあたり約3万円</b>の過去最高値をつけましたが、7月時点では<b class="hl-red">約2万2,000円台</b>まで下落。<br />ピークとくらべると<mark>1gあたり約7,700円</mark>、<mark>50gの金なら約38万円</mark>もの差が出る計算です。<br /><br />「もう少し待てば…」と眠らせているうちに、これだけの価値が失われてしまうことも。<br /><b class="hl-green">まずは今の相場で手持ちの金がいくらになるか、一度確かめておきましょう。</b></p>
        </div>
        <img class="point-img" src="/images/point-takaku2.webp" alt="高く売るための3つのポイント（2）" width="1672" height="941" loading="lazy" decoding="async" />
        <div class="point-note">
          <p><span class="hl-u">1社だけでは、出てきた金額が適正かどうかを判断する材料がありません。</span><br /><br />買取店ごとに査定士の経験・目利き力や対応できる品目が異なり、<br />まったく同じ品でも<mark>数十万円の差</mark>が出ることも珍しくありません。<br /><br /><b class="hl-green">2社以上に金額を聞いておくこと</b>で<br />「他のお店ではこの金額でした」という一言が生まれ、<br />より高い金額に近づきやすくなります。</p>
        </div>
        <img class="point-img" src="/images/point-takaku3.webp" alt="高く売るための3つのポイント（3）" width="1672" height="941" loading="lazy" decoding="async" />
        <div class="point-note">
          <p>電話申込限定の<mark>買取金額UP</mark>など、特典を使えば<br />同じ品でも受取額が<b class="hl-red">上乗せ</b>されることがあります。<br /><br />期間や対象品の条件があるので、<span class="hl-u">"今やっているか"を申込前に確認</span>しておくと、<br />もらえるはずの金額を逃しません。</p>
        </div>
        <a href="#" class="camp2-cta" data-aff="manekiya" data-track="point_official" rel="nofollow sponsored">
          まずは電話で無料相談をする
        </a>
        <p class="point-cta-note">9時〜21時（年中無休）／査定だけ・相談だけでもOK</p>
      </div>
    </section>

    <section class="sec" id="hikaku">
      <div class="wrap">
        <div class="fv-tbl-head"><span class="fv-tbl-ttl">高く売れるのは？金・貴金属買取3社比較</span><i class="pr">PR</i></div>
        <div class="fv-tbl-wrap">
          <table class="fv-tbl">
            <thead>
              <tr>
                <th class="fv-th fv-th1 fv-th-gold"><span class="fv-rk-badge">👑 1位</span><a href="#" data-aff="manekiya" data-track="fv_tbl_bn_manekiya" rel="nofollow sponsored" style="display:block;"><img src="/images/manekiya_bn.png" width="300" height="250" alt="まねきや" style="width:100%;max-width:110px;height:auto;display:block;margin:4px auto 0;border-radius:4px;" loading="lazy" /><span class="fv-th-name">まねきや</span></a></th>
                <th class="fv-th"><span class="fv-rk-badge2">🥈 2位</span><a href="#" data-aff="otakaraya" data-track="fv_tbl_bn_otakaraya" rel="nofollow sponsored" style="display:block;"><img src="/images/300_250-2.jpg" width="300" height="250" alt="おたからや" style="width:100%;max-width:110px;height:auto;display:block;margin:4px auto 0;border-radius:4px;" loading="lazy" /><span class="fv-th-name">おたからや</span></a></th>
                <th class="fv-th"><span class="fv-rk-badge3">🥉 3位</span><a href="#" data-aff="buraiba" data-track="fv_tbl_bn_buraiba" rel="nofollow sponsored" style="display:block;"><img src="/images/300_250-3.jpg" width="300" height="250" alt="ブラリバ" style="width:100%;max-width:110px;height:auto;display:block;margin:4px auto 0;border-radius:4px;" loading="lazy" /><span class="fv-th-name">ブラリバ</span></a></th>
              </tr>
            </thead>
            <tbody>
              <tr class="cmp-band"><td colspan="3">当サイト限定キャンペーン</td></tr>
              <tr class="fv-tr-camp">
                <td class="fv-td fv-td1">
                  {mkCampDays > 0 ? (
                    <>
                      <span class="camp-badge camp-badge-sparkle">{campMonthLabel}</span>
                      <b class="camp-combined"><small class="cc-sm">買取金額</small><span class="cc-md">最大30%UP</span><small class="cc-sm">＋</small><small class="cc-sm">手数料10%無料</small><span class="cc-xl">＼実質40%／</span></b>
                    </>
                  ) : (
                    <b class="camp-tbd">公式キャンペーン<br />要確認</b>
                  )}
                </td>
                <td class="fv-td">
                  {campDays > 0 ? (
                    <>
                      <span class="camp-badge camp-badge-sparkle">期間限定</span><br />
                      <b class="up30">買取金額<em>3倍</em><br />現金プレゼント<br /><span class="up30-sub">抽せんで10名様</span></b>
