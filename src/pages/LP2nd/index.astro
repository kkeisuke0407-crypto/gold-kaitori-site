---
const PAGE_TITLE = "プラチナ指輪 高額買取おすすめTOP3｜結婚指輪・Pt900も無料査定";
const PAGE_DESC = "プラチナ指輪を高く売るならどこ？本日のPt900・Pt850相場と、結婚指輪・刻印入り・宝石付きにも対応した買取店をランキングと比較表でやさしく解説。査定は無料・売るかは後で決められます。";
const CANONICAL = "https://kaitori.hakobu-family.com/LP2nd/";
const OGP_IMAGE = "https://kaitori.hakobu-family.com/images/item-platinum-ring.webp";
const MARKET_SOURCE_URL = "https://manekiya.shop/rate/";

const fallbackRates = {
  updatedAt: "2026年5月29日 現在",
  pt1000: 10602, pt950: 10125, pt900: 9648, pt850: 9065
};
function parseYen(v) { return Number(String(v || "").replace(/[^\d-]/g, "")); }
function yen(v) { return `${Number(v).toLocaleString("ja-JP")}円`; }

async function getRates() {
  try {
    const res = await fetch(MARKET_SOURCE_URL);
    if (!res.ok) throw new Error("fail");
    const text = (await res.text())
      .replace(/<script[\s\S]*?<\/script>/gi, " ").replace(/<style[\s\S]*?<\/style>/gi, " ")
      .replace(/<[^>]+>/g, " ").replace(/&nbsp;|&#160;/g, " ").replace(/\s+/g, " ").trim();
    const u = text.match(/※(20\d{2})年(\d{1,2})月(\d{1,2})日現在/);
    const pt1000 = text.match(/Pt\s+([\d,]+)円/);
    const pt900 = text.match(/Pt900\s+([\d,]+)円/);
    const pt850 = text.match(/Pt850\s+([\d,]+)円/);
    if (!pt900 && !pt1000) throw new Error("parse");
    const r1000 = pt1000 ? parseYen(pt1000[1]) : fallbackRates.pt1000;
    const r900 = pt900 ? parseYen(pt900[1]) : fallbackRates.pt900;
    return {
      updatedAt: u ? `${u[1]}年${u[2]}月${u[3]}日 更新` : fallbackRates.updatedAt,
      pt1000: r1000, pt950: Math.round((r1000 + r900) / 2),
      pt900: r900, pt850: pt850 ? parseYen(pt850[1]) : fallbackRates.pt850
    };
  } catch (_) { return { ...fallbackRates }; }
}
const rates = await getRates();
// 指輪の重量別 参考額（地金のみのおおよそ。状態・宝石で変動）
const ringEx = (w) => `約${Math.round(rates.pt900 * w * 0.85).toLocaleString("ja-JP")}〜${Math.round(rates.pt900 * w).toLocaleString("ja-JP")}円`;

const faqJsonLd = {
  "@context": "https://schema.org", "@type": "FAQPage",
  "mainEntity": [
    ["プラチナ指輪は1点だけでも査定できますか？", "はい、1点からでも無料で査定してもらえます。点数が少なくても断られることはほとんどありません。"],
    ["Pt900の指輪はいくらで売れますか？", "重さ×その日のグラム単価がおおよその目安です。本日のPt900は約" + yen(rates.pt900) + "/gで、例えば4gの指輪なら地金だけで" + ringEx(4) + "ほどが目安です（状態・宝石で変わります）。"],
    ["結婚指輪や婚約指輪も売れますか？", "売れます。シンプルな結婚指輪はプラチナの地金として、宝石付きの婚約指輪は石も合わせて見てもらえます。"],
    ["刻印入りの指輪でも買取できますか？", "イニシャルや日付の刻印があっても、プラチナとしての価値は変わりません。問題なく買取できます。"],
    ["片方だけの指輪でも売れますか？", "片方だけ・ペアの一方だけでも売れます。地金として重さで査定されます。"],
    ["ダイヤや宝石付きの指輪は高くなりますか？", "石の種類や大きさによっては、地金に上乗せされて高くなることがあります。石も見てくれるお店を選ぶのがおすすめです。"],
    ["鑑定書や保証書がなくても大丈夫ですか？", "なくても査定・買取できます。あれば査定がスムーズになることがありますが、必須ではありません。"],
    ["査定後にキャンセルできますか？", "ほとんどのお店で、査定額に納得できなければ無料でキャンセルできます。売るかは金額を見てから決められます。"],
    ["出張査定は無料ですか？", "今回紹介する店は出張料・査定料・キャンセル料が無料と案内されています。詳しくは各店の公式でご確認ください。"],
    ["どのタイミングで売るのがよいですか？", "プラチナ相場は毎日動きます。相場が高いうちに、まず今の金額を確認しておくのがおすすめです。"]
  ].map(([q, a]) => ({ "@type": "Question", "name": q, "acceptedAnswer": { "@type": "Answer", "text": a } }))
};

// アフィリエイトリンク（manekiya / otakaraya は実リンク、buraibaは要設定）
const AFF_MANEKIYA = "https://ad-fam.com/ad/p/r?_site=49248&_article=16522";
const AFF_OTAKARAYA = "https://lp.otakaraya.jp/lp-gold-a/";
