    .fv-th{ background:#F4F8F6; font-weight:900; font-size:13px; color:var(--ink); }
    .fv-th1{ background:#FFFCF2; }
    .fv-td-item{ text-align:left; font-size:11px; font-weight:700; color:var(--sub); background:#FAFCFB; padding:10px 8px; white-space:nowrap; position:sticky; left:0; z-index:1; }
    .fv-td{ background:#fff; }
    .fv-td1{ background:#FFFCF2; }
