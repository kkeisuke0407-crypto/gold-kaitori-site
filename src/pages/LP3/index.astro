  <script>
    var AFF = {
      manekiya: document.body.getAttribute("data-aff-manekiya"),
      otakaraya: document.body.getAttribute("data-aff-otakaraya"),
      buraiba: document.body.getAttribute("data-aff-buraiba")
    };
    var KEEP = /^(utm_|gclid|gbraid|wbraid|gad_|campaignid|keyword|matchtype|device|network|creative)$/i;
    function track(name, params){
      try{ if(window.dataLayer) window.dataLayer.push({event:name, ...(params||{})});
        if(typeof gtag==="function") gtag("event", name, params||{}); }catch(_){}
    }
    function affLink(raw){
      if(!raw || raw === "#") return "#";
      try{ var u=new URL(raw);
        new URLSearchParams(location.search).forEach(function(v,k){ if(KEEP.test(k)&&!u.searchParams.has(k)) u.searchParams.set(k,v); });
        return u.toString();
      }catch(_){ return raw; }
    }
    // アフィリンク注入＋計測
    document.querySelectorAll("[data-aff]").forEach(function(el){
      var key = el.getAttribute("data-aff");
      var url = affLink(AFF[key]);
      el.setAttribute("href", url);
      // 未設定リンク（例：ブラリバ）は押せないようにして無反応クリックを防ぐ
      if(!url || url === "#"){ el.classList.add("aff-disabled"); el.setAttribute("aria-disabled","true"); }
      el.addEventListener("click", function(e){
        if(!url || url === "#"){ e.preventDefault(); return; }
        var tn = el.getAttribute("data-track") || "";
        var isPhone = tn.indexOf("phone")>=0;
        var params = { affiliate_key:key, track_name:tn, cta_type:(isPhone?"phone":"web"), landing_intent:"lp3", link_url:url };
        // 店別イベント：どの社の発火か一目で分かる（manekiya_click / otakaraya_click / buraiba_click。web/phoneは cta_type）
        track(key + "_click", params);
        // CVはまねきや・おたからやのみ。ブラリバは公式直リンク(報酬なし)のため gold_kaitori_affiliate_click から除外
        var __cv = (key === "manekiya" || key === "otakaraya") ? "gold_kaitori_affiliate_click" : "gold_kaitori_other_click";
        if(window.dataLayer) window.dataLayer.push(Object.assign({event:__cv}, params));
        // 修飾キー/中クリック（新規タブ等）は既定動作のまま、イベントだけ送って終了
        var __plain = !e.metaKey && !e.ctrlKey && !e.shiftKey && !e.altKey && (e.button===0 || e.button===undefined);
        if(!__plain){ if(typeof gtag==="function") gtag("event", __cv, params); return; }
        // 通常クリック：送信完了後に遷移（最大300ms・送れたら即）して取りこぼし防止
        e.preventDefault();
        var __navigated=false;
        function __go(){ if(__navigated) return; __navigated=true; window.location.href = url; }
        if(typeof gtag==="function"){
          gtag("event", __cv, Object.assign({}, params, { event_callback: __go, event_timeout: 300 }));
        } else { __go(); }
        setTimeout(__go, 300);
      });
    });
    // スマホ下部固定CTA：FVを過ぎたら表示
    var sticky = document.querySelector("[data-sticky]");
    var fv = document.querySelector(".fv");
    if(sticky && fv && "IntersectionObserver" in window){
      new IntersectionObserver(function(es){ es.forEach(function(en){ sticky.hidden = en.isIntersecting; }); }, {threshold:0})
        .observe(fv);
    } else if(sticky){ sticky.hidden = false; }
    track("lp3_open", { landing_intent:"lp3" });
    // 全リンクへ着地URLのクエリパラメーターを転送（タグ発火向上）
    window.addEventListener("load", function(){
      var search = window.location.search;
      if(!search) return;
      var incoming = new URLSearchParams(search);
      document.querySelectorAll("a[href]").forEach(function(a){
        var href = a.getAttribute("href");
        if(!href) return;
        var lower = href.toLowerCase();
        if(lower.charAt(0)==="#"||lower.startsWith("javascript")||lower.startsWith("mailto")||lower.startsWith("tel")) return;
        try{
          var u=new URL(href, window.location.href);
          incoming.forEach(function(v,k){ if(!u.searchParams.has(k)) u.searchParams.set(k,v); });
          a.setAttribute("href", u.toString());
        }catch(_){}
      });
    });
  </script>
  <script is:inline>
    (function(){
      var els = document.querySelectorAll('.sec, .rk, .voice, .fv-tbl-wrap, .point-img, .rk-voice-block');
      els.forEach(function(el){ el.classList.add('fade-in'); });
      var io = new IntersectionObserver(function(entries){
        entries.forEach(function(e){ if(e.isIntersecting){ e.target.classList.add('visible'); io.unobserve(e.target); } });
      }, { threshold: 0.07 });
      els.forEach(function(el){ io.observe(el); });
    })();
  </script>
  <script is:inline>
    (function(){
      if(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      if(!('IntersectionObserver' in window)) return;
      function animate(el){
        var raw=(el.textContent||'').replace(/[^\d]/g,''); if(!raw) return;
        var end=+raw, suffix=(el.textContent||'').replace(/[\d,]/g,''), t0=null;
        function step(t){ if(!t0)t0=t; var p=Math.min(1,(t-t0)/700);
          el.textContent=Math.round(end*p).toLocaleString('ja-JP')+suffix;
          if(p<1){ requestAnimationFrame(step); } else { el.textContent=end.toLocaleString('ja-JP')+suffix; } }
        requestAnimationFrame(step);
      }
      var io=new IntersectionObserver(function(es){ es.forEach(function(e){ if(e.isIntersecting){ animate(e.target); io.unobserve(e.target); } }); },{threshold:0.35});
      document.querySelectorAll('.rate-grid b').forEach(function(el){ io.observe(el); });
    })();
  </script>
