---
const PAGE_TITLE = "金買取 高額おすすめTOP3｜ネックレス・指輪・金貨・K18も無料査定";
const PAGE_DESC = "金・貴金属を高く売るならどこ？本日のK24・K18相場と、ネックレス・指輪・金貨・インゴット・壊れた金・金歯にも対応した買取店をランキングと比較表でやさしく解説。査定は無料・売るかは後で決められます。";
const CANONICAL = "https://kaitori.hakobu-family.com/LP3/";
const OGP_IMAGE = "https://kaitori.hakobu-family.com/images/og-gold.webp";

import { getRates, yen, MARKET_SOURCE_URL } from "../../lib/rates.js";
const rates = await getRates();
// 重さ別の参考買取額（既定はK18基準）
const goldEx = (w, karat = rates.k18) => `約${Math.round(karat * w * 0.9).toLocaleString("ja-JP")}〜${Math.round(karat * w).toLocaleString("ja-JP")}円`;
// 重さ別の参考買取額（万円表示・既定はK18基準）
const goldExMan = (w, karat = rates.k18) => {
  const fmt = (v) => {
    const man = v / 10000;
    return man >= 10 ? Math.round(man) : Math.round(man * 10) / 10;
  };
  return `約${fmt(karat * w * 0.9)}〜${fmt(karat * w)}万円`;
};
// キャンペーン残日数（まねきや 6/30まで）
const campEnd = new Date('2026-06-30T23:59:59+09:00');
const today   = new Date(new Date().toLocaleString('en-US',{timeZone:'Asia/Tokyo'}));
const todayLabel = today.getFullYear() + "年" + (today.getMonth() + 1) + "月" + today.getDate() + "日";
const campDays = Math.max(0, Math.ceil((campEnd - today) / 86400000));

const faqJsonLd = {
  "@context": "https://schema.org", "@type": "FAQPage",
  "mainEntity": [
    ["金は1点だけでも査定できますか？", "はい、1点からでも無料で査定してもらえます。ネックレス1本・指輪1個でも断られることはほとんどありません。"],
    ["K18のネックレスはいくらで売れますか？", "重さ×その日のグラム単価がおおよその目安です。本日のK18は約" + yen(rates.k18) + "/gで、例えば10gのネックレスなら" + goldEx(10) + "ほどが目安です（状態・デザインで変わります）。"],
    ["壊れた金・切れたネックレスでも売れますか？", "売れます。壊れていても曲がっていても、金としての価値は重さで変わりません。地金として査定されます。"],
    ["刻印（K18・750など）がない金でも買取できますか？", "X線などの成分分析で純度を調べてもらえるため、刻印がなくても査定・買取できます。"],
    ["金貨・インゴット（地金）も売れますか？", "売れます。メイプルリーフやウィーン金貨などの金貨、インゴットも相場に応じて査定されます。"],
    ["金歯やメダル、仏具の金も買取できますか？", "買取できます。金歯（差し歯）・記念メダル・仏具など、金が含まれていれば査定対象です。"],
    ["鑑定書や保証書がなくても大丈夫ですか？", "なくても査定・買取できます。あれば査定がスムーズになることがありますが、必須ではありません。"],
    ["査定後にキャンセルできますか？", "ほとんどのお店で、査定額に納得できなければ無料でキャンセルできます。売るかは金額を見てから決められます。"],
    ["出張査定は無料ですか？", "今回紹介する店は出張料・査定料・キャンセル料が無料と案内されています。詳しくは各店の公式でご確認ください。"],
    ["どのタイミングで売るのがよいですか？", "金相場は毎日動き、今は過去最高水準で推移しています。相場が高いうちに、まず今の金額を確認しておくのがおすすめです。"]
  ].map(([q, a]) => ({ "@type": "Question", "name": q, "acceptedAnswer": { "@type": "Answer", "text": a } }))
};

// アフィリエイトリンク（manekiya / otakaraya は実リンク、buraibaは要設定）
const AFF_MANEKIYA = "https://ad-fam.com/ad/p/r?_site=49248&_article=16522";
const AFF_OTAKARAYA = "https://lp.otakaraya.jp/lp-gold-a/";
---
<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{PAGE_TITLE}</title>
  <meta name="description" content={PAGE_DESC} />
  <link rel="canonical" href={CANONICAL} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={PAGE_TITLE} />
  <meta property="og:description" content={PAGE_DESC} />
  <meta property="og:url" content={CANONICAL} />
  <meta property="og:image" content={OGP_IMAGE} />
  <meta property="og:locale" content="ja_JP" />
  <meta name="twitter:card" content="summary_large_image" />
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700;900&display=swap" onload="this.onload=null;this.rel='stylesheet'" />
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700;900&display=swap" /></noscript>
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-DMCWVLP3E3"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){ dataLayer.push(arguments); }
    gtag('js', new Date()); gtag('config', 'G-DMCWVLP3E3'); gtag('config', 'AW-18129603657');
  </script>
  <script is:inline>
    (function(c,l,a,r,i,t,y){ c[a]=c[a]||function(){ (c[a].q=c[a].q||[]).push(arguments); };
      t=l.createElement(r); t.async=1; t.src="https://www.clarity.ms/tag/"+i;
      y=l.getElementsByTagName(r)[0]; y.parentNode.insertBefore(t,y);
    })(window, document, "clarity", "script", "wxnujpnscp");
