    /* ===== ブラッシュアップ（構成不変・視覚/CWVのみ） ===== */
    /* ① 電話CTAに光が流れる */
    .btn-phone{ position:relative; overflow:hidden; }
    .btn-phone::after{ content:""; position:absolute; top:-30%; left:-65%; width:35%; height:160%;
      background:linear-gradient(100deg,transparent,rgba(255,255,255,.5),transparent);
      transform:skewX(-18deg); pointer-events:none; animation:bbCtaShine 3.2s ease-in-out infinite; }
    @keyframes bbCtaShine{ 0%{ left:-65%; } 60%,100%{ left:145%; } }
    /* ② trust-strip 可読性UP */
    .trust-strip span{ font-size:11px; line-height:1.3; }
    /* ③ 比較表 横スクロール示唆（モバイル） */
    .fv-tbl-wrap{ position:relative; }
    @media (max-width:600px){
      .fv-tbl-wrap::after{ content:"→"; position:absolute; top:6px; right:6px; z-index:2;
        font-weight:900; font-size:12px; color:var(--green-d); background:rgba(255,255,255,.92);
        border:1px solid var(--line); border-radius:999px; padding:1px 7px;
        animation:bbScrollHint 1.4s ease-in-out infinite; }
    }
    @keyframes bbScrollHint{ 0%,100%{ transform:translateX(0); } 50%{ transform:translateX(4px); } }
    /* ⑤ スティッキー：微脈動＋iPhoneセーフエリア */
    .sticky{ padding-bottom:calc(8px + env(safe-area-inset-bottom)); }
    .sticky-phone{ animation:bbStickyPulse 1.9s ease-in-out infinite; }
    @keyframes bbStickyPulse{ 0%,100%{ transform:scale(1); } 50%{ transform:scale(1.03); } }
    /* ⑦ 安心訴求（既存文言）をやわらかく強調 */
    .cta-note{ background:#F2FBF8; border-radius:10px; padding:8px 10px; }
    /* ⑧ ランキングカード ホバー浮上＋1位の影強調 */
    .rk{ transition:transform .18s ease, box-shadow .18s ease; }
    .rk:hover{ transform:translateY(-4px); }
    .rk-1{ box-shadow:0 16px 36px rgba(217,150,42,.22); }
    /* ⑨ 薄色テキストのコントラスト改善（AA寄せ） */
    :root{ --sub:#6E7B85; }
    mark{ background:#FFF1A6; color:inherit; font-weight:900; padding:0 3px; border-radius:3px; }
    /* ⑩ CLS保険：画像は縦横比維持 */
    .fv-hero-img,.point-img img,.camp-img img,.rk-zisseki,.fuan-img,.fv-banner-link img{ height:auto; }
    @media (prefers-reduced-motion:reduce){
      .btn-phone::after,.sticky-phone,.fv-tbl-wrap::after{ animation:none; }
    }
  
    /* 見やすさ微調整：小注記の底上げ */
    .note{ font-size:13.5px; }
    .rate-updated{ font-size:12px; }
      .fv-hero-link{ display:block; font-size:0; }
  
    /* ===== 共通改善（チップ撤去/CTA四角/縦帯比較表/日付バッジ） ===== */
    .fv-datebadge{ display:flex; align-items:center; justify-content:center; flex-wrap:nowrap; gap:6px; width:100%; margin:0 0 12px; padding:9px 14px; background:#fff; border:1px solid #F0DBB0; border-radius:12px; box-shadow:0 4px 14px rgba(183,28,28,.13); font-weight:700; }
    .fv-db-tag{ display:inline-flex; align-items:center; gap:6px; background:linear-gradient(180deg,#E0322C,#B71C1C); color:#fff; font-size:clamp(10.5px,3.1vw,15px); padding:5px 10px; border-radius:999px; letter-spacing:.02em; white-space:nowrap; }
    .fv-db-dot{ width:9px; height:9px; border-radius:50%; background:#fff; animation:dbpulse 1.5s ease-out infinite; }
    @keyframes dbpulse{ 0%{box-shadow:0 0 0 0 rgba(255,255,255,.85)} 70%{box-shadow:0 0 0 7px rgba(255,255,255,0)} 100%{box-shadow:0 0 0 0 rgba(255,255,255,0)} }
    .fv-db-date{ font-size:clamp(11px,3.3vw,16.5px); color:var(--ink); letter-spacing:.01em; white-space:nowrap; }
    .fv-db-txt{ font-size:clamp(11px,3.3vw,16.5px); color:#B71C1C; white-space:nowrap; }
    .fv-db-link{ text-decoration:underline; text-underline-offset:2px; cursor:pointer; }
    #camp30-detail{ scroll-margin-top:16px; }
    #rank-manekiya{ scroll-margin-top:22px; }
    @media (max-width:360px){ .fv-datebadge{ gap:4px; padding:7px 8px; } }
    .cmp-band td{ background:var(--green); color:#fff; font-weight:900; font-size:14px; text-align:center; padding:7px 6px; letter-spacing:.04em; }
    .fv-tbl{ min-width:0; width:100%; table-layout:fixed; font-size:15px; }
    .fv-tbl th,.fv-tbl td{ padding:9px 4px; }
    /* 比較表の見出し（各社バナー）行をスクロール追従。表を過ぎたら自動で解除される */
    /* transformを持つ祖先があるとstickyがビューポート基準にならないため、この枠だけfade-inのtransformを無効化 */
    .fv-tbl-wrap{ overflow:visible; transform:none !important; opacity:1 !important; }
    .fv-tbl thead th{ position:sticky; top:0; z-index:6; box-shadow:0 4px 8px -4px rgba(20,60,50,.22); }
    .fv-tbl-wrap::after{ display:none; }
    .btn{ border-radius:10px; }
    .camp2-cta{ border-radius:12px; }
    .sticky a{ border-radius:10px; }
    .fv-tr-cta .btn{ display:flex; width:100%; max-width:160px; margin-left:auto; margin-right:auto; white-space:normal; min-height:38px; font-size:12px; padding:0 6px; line-height:1.2; border-radius:8px; }
    .fv-tr-cta .btn-phone{ font-size:12.5px; }
    .fv-tr-cta .btn i{ font-size:13px; }
    .fv-tr-cta .fv-td{ vertical-align:top; text-align:center; }
    .fv-tr-cta .fv-td1{ vertical-align:top; }
    .fv-tr-cta .cta-mid-spacer{ display:block; height:29px; }
  
    /* ===== ランキング1位 2nd化（スペックカード/おすすめ/挿入画像/口コミ横スクロール） ===== */
    .camp-img{ position:relative; animation:pokopoko 1.15s ease-in-out infinite; }
    .camp-img::after{ content:""; position:absolute; top:-20%; left:-70%; width:45%; height:140%; background:linear-gradient(100deg,transparent,rgba(255,255,255,.65),transparent); transform:skewX(-18deg); pointer-events:none; animation:bannerShine 2.8s ease-in-out infinite; }
    @media (prefers-reduced-motion:reduce){ .camp-img{ animation:none; } .camp-img::after{ animation:none; display:none; } }
    .rk-spec{ width:100%; table-layout:fixed; border-collapse:separate; border-spacing:0; margin:4px 0 14px; border:1px solid var(--line); border-radius:10px; overflow:hidden; }
    .rk-spec th{ background:#C8102E; color:#fff; font-weight:900; font-size:11.5px; text-align:center; padding:7px 3px; line-height:1.3; border-right:1px solid rgba(255,255,255,.45); border-bottom:1px solid #fff; }
    .rk-spec .rs-head th:last-child{ border-right:none; }
    .rk-spec td{ background:#fff; text-align:center; font-size:13px; font-weight:700; color:var(--ink); padding:11px 5px; line-height:1.45; vertical-align:middle; border-right:1px solid #F1CDD2; border-bottom:1px solid #F1CDD2; }
    .rk-spec td:last-child{ border-right:none; }
    .rk-spec .rs-val td{ border-bottom:none; }
    .rk-spec .rs-ic{ display:block; font-size:22px; line-height:1; margin-bottom:7px; color:#D81F1F; font-weight:900; }
    .rk-spec .rs-camp{ display:inline-block; color:var(--ink); font-weight:900; font-size:12px; line-height:1.35; }
    .rk-spec .rs-camp em{ font-style:normal; color:#D81F1F; font-size:16px; }
    /* 30%UP＋手数料無料を他項目より大きく強調 */
    .rk-spec .rs-camp-big{ font-size:13.5px; line-height:1.45; }
    .rk-spec .rs-camp-big em{ font-size:19px; }
    .rk-osusume{ background:#FFFDF5; border-radius:12px; overflow:hidden; margin:0 0 16px; }
    .rk-osusume-h{ background:linear-gradient(135deg,#F4A81F,#D9962A); color:#fff; font-weight:900; font-size:14px; padding:9px 13px; text-shadow:0 1px 2px rgba(0,0,0,.18); }
    .rk-osusume ul{ list-style:none; margin:0; padding:12px 14px; display:grid; gap:10px; background:#FFFDF6; }
    .rk-osusume li{ font-size:14px; line-height:1.55; font-weight:700; color:var(--ink); display:flex; gap:7px; align-items:flex-start; }
    .rk-osusume .chk{ color:#1AA251; font-weight:900; flex:0 0 auto; font-size:15px; }
    .rk-osusume mark{ background:#FFF1A6; color:inherit; font-weight:900; padding:0 3px; border-radius:3px; }
    .rk-area{ margin:0 14px 12px; padding:10px 12px; background:#FFF8E8; border:1px dashed var(--gold); border-radius:8px; }
    .rk-area-lead{ margin:0 0 4px; font-size:13px; font-weight:900; color:#B45309; }
    .rk-area-list{ margin:0 0 6px; font-size:12.5px; line-height:1.6; font-weight:700; color:var(--ink); }
    .rk-area-list b{ color:#B45309; }
    .rk-area-note{ margin:0; font-size:11.5px; line-height:1.6; color:var(--sub); font-weight:600; }
    .rk-area-note mark{ background:#FFF1A6; font-weight:900; padding:0 3px; border-radius:3px; }
    .rk-insert-img{ display:block; margin:0 0 18px; border-radius:14px; overflow:hidden; box-shadow:0 6px 18px rgba(20,60,50,.12); text-decoration:none; }
    .rk-insert-img img{ width:100%; height:auto; display:block; }
