    .hd-mark{ width:26px; height:26px; border-radius:8px; background:linear-gradient(150deg,var(--green),var(--green-d)); color:#fff; font-size:11px; display:grid; place-items:center; }
    .hd-cta{ margin-left:auto; background:var(--green-d); color:#fff; font-weight:900; font-size:13px; text-decoration:none; padding:8px 16px; border-radius:999px; }

    /* ボタン共通 */
    .btn{ display:inline-flex; align-items:center; justify-content:center; gap:6px; text-decoration:none; font-weight:900; border-radius:999px; min-height:54px; padding:0 14px; box-shadow:0 8px 18px rgba(14,120,100,.22); transition:transform .12s,box-shadow .12s; white-space:nowrap; font-size:15px; line-height:1.2; }
    /* B案：赤背景CTA（電話・公式）は文字を大きく＋影で背景から浮かせて視認性UP。小型(.sm)は据え置き */
    .btn-phone, .btn-official{ font-size:18px; letter-spacing:.3px; text-shadow:0 2px 3px rgba(0,0,0,.35); }
    .btn:active{ transform:scale(.97); }
    .btn i{ font-style:normal; }
    .btn-web{ background:var(--green-d); color:#fff; }
    /* 電話ボタン＝赤・キラキラ＋ポコポコで強調 */
    .btn-phone{
      position:relative; overflow:hidden;
      background:linear-gradient(180deg,#FF5A4D,#E01F1F); color:#fff;
      box-shadow:0 8px 0 #B0160F, 0 12px 18px rgba(224,31,31,.36);
      border:2px solid #ffd9d4;
      animation:pokopoko 1.15s ease-in-out infinite;
    }
    .btn-phone::after{ content:""; position:absolute; top:-30%; left:-70%; width:45%; height:160%; background:linear-gradient(100deg,transparent,rgba(255,255,255,.7),transparent); transform:skewX(-18deg); pointer-events:none; animation:bannerShine 2.8s ease-in-out infinite; }
    .btn-phone:hover{ transform:translateY(-2px); box-shadow:0 10px 0 #B0160F, 0 16px 22px rgba(224,31,31,.4); }
    @media (prefers-reduced-motion:reduce){ .btn-phone{ animation:none; } .btn-phone::after{ animation:none; display:none; } }
    .btn-ghost{ background:#fff; color:var(--green-d); border:2px solid var(--green-d); box-shadow:none; }
    /* 公式サイトCTA＝オレンジゴールドで強調＋ポコポコ＋光 */
    .btn-official{ position:relative; overflow:hidden; background:linear-gradient(180deg,#FF5A4D,#E01F1F); color:#fff; border:2px solid #ffd9d4; box-shadow:0 6px 0 #B0160F, 0 10px 16px rgba(224,31,31,.36); animation:pokopoko 1.15s ease-in-out infinite; }
    .btn-official::after{ content:""; position:absolute; top:-30%; left:-70%; width:45%; height:160%; background:linear-gradient(100deg,transparent,rgba(255,255,255,.7),transparent); transform:skewX(-18deg); pointer-events:none; animation:bannerShine 2.8s ease-in-out infinite; }
    .btn-official:hover{ transform:translateY(-2px); }
    /* 数字・CTAテキストの改行バランス調整（1文字だけ落ちるのを防止） */
    .rh-price{ white-space:nowrap; }
    .rate-grid b,.rh-num,.rate-grid-mini b{ font-variant-numeric:tabular-nums; }
    .faq-cta{ margin-top:20px; }
    .faq-cta-lead{ font-size:15px; font-weight:800; color:var(--ink); text-align:center; margin:0 0 8px; line-height:1.5; }
    .rate-grid-mini b,.rate-grid-mini span{ white-space:nowrap; }
    .camp2-cta,.btn-official,.sticky-official,.rate-cta-main{ text-wrap:balance; }
    .rate-hero-ttl,.ref-ttl,.sec-head h2,.sec-head p{ text-wrap:pretty; }
    /* 査定シミュレーター（相場 × あなたの品物 ＝ ??? の数式） */
    .satei-price{ background:linear-gradient(180deg,#FFFDF7,#fff); }
    .satei-eq{ display:flex; flex-direction:column; align-items:stretch; gap:0; }
    .satei-eq-cell{ position:relative; border-radius:14px; padding:13px 14px; text-align:center; }
    .satei-eq-cap{ display:block; font-size:12px; font-weight:800; letter-spacing:.2px; margin-bottom:4px; }
    .satei-eq-op{ align-self:center; font-size:24px; font-weight:900; color:#C9A24A; line-height:1; margin:7px 0; }
    .satei-eq-rate{ background:linear-gradient(135deg,#2B2B2B,#454039); box-shadow:0 10px 26px rgba(40,30,10,.28); overflow:hidden; }
    .satei-eq-rate::after{ content:""; position:absolute; top:-40%; left:-20%; width:80%; height:180%; background:linear-gradient(115deg,transparent,rgba(255,225,150,.18),transparent); transform:rotate(8deg); }
    .satei-eq-rate .satei-eq-cap{ position:relative; color:#F5E2B0; }
    .satei-eq-num{ position:relative; display:block; font-size:34px; font-weight:900; line-height:1.05; background:linear-gradient(180deg,#FFEDB0,#E0A53A); -webkit-background-clip:text; background-clip:text; -webkit-text-fill-color:transparent; text-shadow:0 1px 0 rgba(0,0,0,.15); }
    .satei-eq-num small{ font-size:15px; font-weight:800; -webkit-text-fill-color:#F0D89A; }
    .satei-eq-up{ position:relative; display:inline-block; margin-top:6px; font-size:11px; font-weight:800; color:#3CC79A; background:rgba(60,199,154,.14); border-radius:999px; padding:2px 10px; }
    .satei-eq-item{ background:#fff; border:1px solid #F0E2C2; box-shadow:0 4px 12px rgba(180,140,40,.08); }
    .satei-eq-item .satei-eq-cap{ color:var(--ink); }
    .satei-mini{ list-style:none; margin:0; padding:0; display:grid; gap:6px; }
    .satei-mini li{ display:flex; align-items:center; gap:8px; font-size:13px; font-weight:900; color:var(--ink); background:#FFFCF4; border-radius:9px; padding:7px 11px; text-align:left; }
    .satei-mini li i{ font-style:normal; font-size:17px; flex-shrink:0; line-height:1; }
    .satei-mini li small{ margin-left:auto; font-size:11px; font-weight:600; color:var(--sub); }
    .satei-eq-result{ background:#FFF7EC; border:2px dashed #E8C57E; }
    .satei-eq-result .satei-eq-cap{ color:var(--sub); }
    .satei-eq-mark{ display:block; font-size:32px; font-weight:900; letter-spacing:4px; color:#C98A12; line-height:1.1; }
    .satei-eq-rsub{ display:block; font-size:12px; font-weight:800; color:var(--hot); margin-top:3px; }
    .satei-loss{ display:flex; align-items:center; gap:10px; margin-top:14px; background:#FFF1EE; border:1px solid #F3C9C0; border-radius:12px; padding:11px 13px; }
    .satei-loss i{ font-style:normal; font-size:20px; flex-shrink:0; }
    .satei-loss p{ margin:0; font-size:12.5px; font-weight:700; line-height:1.6; color:var(--ink); text-align:left; }
    .satei-loss p b{ color:var(--hot); font-weight:900; }
    .satei-price .ref-bridge{ margin-top:14px; }
    .aff-disabled{ opacity:.5; pointer-events:none; cursor:default; }
    .btn.full{ display:flex; width:100%; margin-top:10px; }
    .btn.sm{ min-height:42px; font-size:13px; padding:0 12px; box-shadow:none; }
    /* 比較表：電話ボタンを2行（電話で買取／＼最大30%UP／） */
    .fv-cta-stack{ display:flex; flex-direction:column; gap:5px; align-items:center; width:100%; }
    .fv-cta-stack .btn{ width:100%; max-width:150px; }
    .btn.sm.btn-2line{ flex-direction:column; gap:1px; line-height:1.2; padding:6px 8px; min-height:48px; }
    .fv-td1 b.tbl-cta-main{ font-size:13px; font-weight:900; color:#fff; }
    .tbl-cta-up{ font-size:11px; font-weight:900; color:#FFE45C; }
    .cta-pair{ display:flex; flex-direction:column; gap:10px; margin-top:18px; }
    .cta-pair .btn{ width:92%; margin:0 auto; padding:0 16px; font-size:clamp(14px,4vw,16px); white-space:nowrap; }
    .cta-pair .btn i{ font-size:14px; }
    .cta-note{ text-align:center; font-size:12px; color:var(--sub); margin:8px 0 0; }

    /* 01 FV */
    .fv{ background:linear-gradient(180deg,#EAF6F2, #fff); padding:24px 0 34px; }

    /* ① FV結論ボックス（最初の数秒で結論に答える・55歳以上も読める大きさ） */
    .fv-conc{ background:#fff; border:2px solid var(--green); border-radius:16px; padding:16px 16px 14px; margin:14px 0; box-shadow:0 8px 22px rgba(14,120,100,.12); }
    .fv-conc-ttl{ font-size:19px; font-weight:900; text-align:center; margin:0 0 12px; color:var(--ink); line-height:1.4; }
    .fv-conc ul{ list-style:none; margin:0 0 14px; padding:0; display:grid; gap:9px; }
    .fv-conc li{ font-size:16px; font-weight:700; padding-left:28px; position:relative; line-height:1.5; color:var(--ink); }
    .fv-conc li::before{ content:"✓"; position:absolute; left:0; top:0; color:var(--green); font-weight:900; font-size:18px; }
    .fv-conc li b{ color:var(--green-d); }
    .fv-conc .cta-pair{ margin-top:0; }
    /* ④ キャンペーンバナー（ポコポコ＋キラキラ） */
    .fv-banner{ margin:14px 0; }
    .fv-banner-link{ display:block; position:relative; border-radius:14px; overflow:hidden; box-shadow:0 10px 24px rgba(201,126,0,.32); animation:pokopoko 1.15s ease-in-out infinite; }
    .fv-banner-link img{ width:100%; height:auto; display:block; }
    .fv-banner-link::after{ content:""; position:absolute; top:-20%; left:-70%; width:45%; height:140%; background:linear-gradient(100deg, transparent, rgba(255,255,255,.65), transparent); transform:skewX(-18deg); pointer-events:none; animation:bannerShine 2.8s ease-in-out infinite; }
    @keyframes bannerShine{ 0%{ left:-70%; } 55%{ left:130%; } 100%{ left:130%; } }
    .camp-img{ display:block; margin:0 0 16px; border-radius:14px; overflow:hidden; box-shadow:0 8px 20px rgba(183,28,22,.28); text-decoration:none; }
    .camp-img img{ width:100%; height:auto; display:block; }

    /* 背景画像バナー＋文字オーバーレイ */
    .camp2{ margin:0 0 16px; }
    .camp2-banner{
      position:relative; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:3px;
      aspect-ratio:995/295; width:100%; padding:2.5% 6%; box-sizing:border-box;
      background:url("/images/camp-banner-bg.webp") center/100% 100% no-repeat;
      text-decoration:none; color:#fff; text-align:center; filter:drop-shadow(0 6px 14px rgba(183,28,22,.28));
    }
    .camp2-term{
      display:inline-block; background:linear-gradient(180deg,#FFE9A8,#F2C14A); color:#7a2a00;
      font-weight:900; font-size:clamp(9px,2.6vw,13px); border-radius:999px; padding:2px 10px;
      letter-spacing:.02em; box-shadow:0 1px 2px rgba(0,0,0,.25);
    }
    .camp2-cond{ display:block; font-size:clamp(10px,3.2vw,15px); font-weight:800; text-shadow:0 1px 3px rgba(0,0,0,.45); white-space:nowrap; }
    .camp2-note{ font-size:10px; color:var(--sub); line-height:1.55; margin:8px 4px 0; }
    /* 目安→査定への橋渡しボックス */
    .ref-bridge{ margin-top:14px; background:#FFF7EC; border:1px solid #F2D9A8; border-radius:14px; padding:14px 14px 12px; }
    .ref-bridge-txt{ font-size:13px; line-height:1.8; color:var(--ink); margin:0 0 12px; font-weight:700; text-align:center; text-wrap:balance; }
    .ref-bridge-txt b{ color:var(--hot); font-weight:900; }
    .ref-bridge .camp2-cta{ margin-top:0; }
    /* CTAは中央寄せ＋バランス改行 */
    .camp2-cta.ref-cta{ flex-direction:column; gap:1px; font-size:clamp(15px,4.4vw,18px); line-height:1.3; padding:12px 10px; text-align:center; text-wrap:balance; }
    .camp2-cta.ref-cta .ref-cp{ font-size:.74em; font-weight:800; opacity:.95; }
    .camp2-cta.ref-cta .ref-mn{ font-weight:900; }
    .camp2-main{ display:block; font-size:clamp(14px,4.6vw,22px); font-weight:900; line-height:1.05; text-shadow:0 1px 4px rgba(0,0,0,.4); }
    .camp2-main em{ font-style:normal; }
    .camp2-main b{
      font-style:normal; font-size:clamp(28px,9vw,44px); vertical-align:-4px; padding:0 2px;
      background:linear-gradient(180deg,#FFF4C2,#FFD24D 55%,#E8A317);
      -webkit-background-clip:text; background-clip:text; -webkit-text-fill-color:transparent;
      text-shadow:0 2px 3px rgba(0,0,0,.25);
    }
    /* ポコポコ動くCTAボタン */
    .camp2-cta{
      display:flex; align-items:center; justify-content:center; gap:8px;
      width:92%; margin:10px auto 0; padding:14px 0; border-radius:999px;
      background:linear-gradient(180deg,#FF5A4D,#E01F1F); color:#fff;
      font-size:clamp(16px,4.6vw,20px); font-weight:900; text-decoration:none;
      box-shadow:0 8px 0 #B0160F, 0 12px 18px rgba(224,31,31,.35);
      border:2px solid #ffd9d4; animation:pokopoko 1.1s ease-in-out infinite;
    }
    .camp2-cta i{
      font-style:normal; display:inline-flex; align-items:center; justify-content:center;
      width:30px; height:30px; border-radius:50%; background:#fff; color:#E0322C; font-size:16px;
    }
    .camp2-cta:active{ transform:translateY(4px); box-shadow:0 4px 0 #B0160F, 0 6px 10px rgba(224,31,31,.3); }
    @keyframes pokopoko{
      0%,100%{ transform:scale(1); }
      50%{ transform:scale(1.06); }
    }
    /* ライブドット（相場チップ） */
    .live-dot{
      display:inline-block; width:8px; height:8px; border-radius:50%;
      background:#E0322C; margin-right:5px; vertical-align:middle;
      animation:livepulse 1.4s ease-in-out infinite;
    }
    @keyframes livepulse{
      0%,100%{ opacity:1; transform:scale(1); }
      50%{ opacity:.35; transform:scale(.7); }
    }
    /* 編集部イチオシリボン */
    .rk-editor-pick{
      position:absolute; top:-14px; right:16px;
      background:linear-gradient(135deg,#f6c64d,var(--gold-d)); color:#5a3d00;
      font-weight:900; font-size:11px; border-radius:999px; padding:4px 13px;
      box-shadow:0 2px 6px rgba(201,126,0,.35);
    }
    /* 比較表まねきや列ゴールドグラデ */
    .fv-th-gold{
      background:linear-gradient(180deg,#FFF4C2,#FFE08A) !important;
      border-bottom:2px solid var(--gold);
    }
    /* スクロールフェードイン */
    .fade-in{ opacity:0; transform:translateY(22px); transition:opacity .55s ease, transform .55s ease; }
    .fade-in.visible{ opacity:1; transform:translateY(0); }
    @media (prefers-reduced-motion:reduce){
      .camp2-cta{ animation:none; }
      .btn-official,.sticky-official{ animation:none; }
      .btn-official::after{ animation:none; display:none; }
      .fv-banner-link{ animation:none; }
      .fv-banner-link::after{ animation:none; display:none; }
      .live-dot{ animation:none; }
      .fade-in,.fade-in.visible{ opacity:1; transform:none; transition:none; }
    }
    /* ヒーロー画像 */
    .fv-hero-wrap{ width:100%; margin:0 0 12px; font-size:0; line-height:0; }
    .trust-strip{ list-style:none; display:grid; grid-template-columns:repeat(4,1fr); gap:6px; margin:0 0 14px; padding:0; }
    .trust-strip li{ background:var(--mint); border:1px solid #d6ece4; border-radius:10px; padding:8px 4px; text-align:center; display:flex; flex-direction:column; align-items:center; justify-content:flex-start; gap:2px; }
    .trust-strip b{ color:var(--green-d); font-size:clamp(15px,4.6vw,19px); line-height:1.1; }
    .trust-strip span{ color:var(--sub); font-size:9px; line-height:1.25; font-weight:700; }
    .fv-hero-img{ width:100%; height:auto; display:block; border-radius:14px; box-shadow:0 6px 18px rgba(0,0,0,.12); }
    /* スマホ：ヒーロー画像を枠なし・画面いっぱい（full-bleed）に */
    @media (max-width:600px){
      .fv{ padding-top:0; }
      .fv-hero-wrap{ width:100vw; margin-left:calc(50% - 50vw); margin-right:calc(50% - 50vw); margin-bottom:14px; }
      .fv-hero-img{ border-radius:0; box-shadow:none; }
      /* コンテンツ画像もヒーロー同様スマホ全幅・余白なし・角丸なし(□) */
      .wrap .point-img{ width:100vw; max-width:100vw; margin-left:calc(50% - 50vw); margin-right:calc(50% - 50vw); border-radius:0; box-shadow:none; }
      /* 買取実績画像もヒーロー同様：アンカーを全幅・画像は角丸/影なし(□) */
      a.rk-zisseki-link{ width:100vw; margin-left:calc(50% - 50vw); margin-right:calc(50% - 50vw); }
      .rk-zisseki-link .rk-zisseki{ border-radius:0; box-shadow:none; margin-bottom:18px; }
      .wrap .rk-zisseki{ width:100vw; max-width:100vw; margin-left:calc(50% - 50vw); margin-right:calc(50% - 50vw); border-radius:0; box-shadow:none; }
    }
    .rate-chip{ width:100%; margin:0 0 12px; background:#fff; border:1px solid var(--line); border-radius:14px; padding:12px 14px; display:flex; flex-wrap:wrap; align-items:center; gap:6px 12px; box-shadow:0 6px 18px rgba(20,60,50,.06); }
    .rate-chip>span{ font-size:12px; font-weight:900; color:var(--green-d); width:100%; }
    .rate-chip b{ font-size:16px; }
    .rate-chip small{ width:100%; color:var(--sub); font-size:11px; }

    /* FV 3社比較表 */
    .fv-tbl-head{ display:flex; align-items:center; gap:8px; margin:16px 0 6px; }
    .fv-tbl-ttl{ font-weight:900; font-size:clamp(11px,3.5vw,14px); color:var(--ink); white-space:nowrap; }
    .fv-tbl-head .pr{ margin-left:auto; }
    .fv-tbl-wrap{ margin:0 0 8px; overflow-x:auto; -webkit-overflow-scrolling:touch; border-radius:16px; border:1px solid var(--line); box-shadow:0 6px 18px rgba(20,60,50,.07); }
    .fv-tbl{ width:100%; min-width:340px; border-collapse:collapse; background:#fff; font-size:15px; }
    .fv-tbl th,.fv-tbl td{ padding:10px 7px; text-align:center; border-bottom:1px solid var(--line); vertical-align:middle; line-height:1.42; }
    .fv-th-item{ background:#F4F8F6; font-size:0; width:0; padding:0; }
    .fv-th{ background:#F4F8F6; font-weight:900; font-size:13px; color:var(--ink); }
    .fv-th-name{ display:block; text-align:center; font-size:.85em; font-weight:700; margin-top:4px; color:var(--ink); text-decoration:underline; }
    .fv-th1{ background:#FFFCF2; }
    .fv-td-item{ text-align:left; font-size:13px; font-weight:700; color:var(--sub); background:#FAFCFB; padding:10px 8px; white-space:nowrap; position:sticky; left:0; z-index:1; }
    .fv-td{ background:#fff; }
    .fv-td1{ background:#FFFCF2; }
    .fv-td .mk{ display:block; font-size:20px; font-weight:900; line-height:1; margin-bottom:3px; }
    .mk.good{ color:#E8920A; }
    .mk.ok{ color:#3AA17E; }
    .mk.tri{ color:#C99A3A; }
    .mk.bad{ color:#C0392B; }
    .fv-td .mk.good,.mk.good{ color:#D81F1F; font-weight:900; }
    .fv-td .mk.good{ font-size:22px; }
    .fv-td1 b,.fv-td1 strong{ color:var(--green-d); }
    .fv-td.gray{ color:var(--sub); }
    .fv-rk-badge{ display:block; font-size:11px; color:var(--coral-d); font-weight:900; margin-bottom:3px; }
    .fv-rk-badge2,.fv-rk-badge3{ display:block; font-size:11px; color:var(--sub); font-weight:700; margin-bottom:3px; }
    .fv-tr-camp .fv-td{ background:#FFF3E0; }
    .fv-tr-camp .fv-td1{ background:#FFF3E0; }
    .camp-badge{ display:inline-block; background:#E0322C; color:#fff; font-size:10px; font-weight:900; border-radius:999px; padding:1px 8px; margin-bottom:4px; }
    .up30{ font-size:14px; line-height:1.3; color:#E0322C; }
    .up30 em{ color:#E0322C; }
    .camp-tbd{ font-size:13px; line-height:1.4; color:#222; font-weight:800; }
    .up30 em{ font-style:normal; font-size:22px; font-weight:900; }
    .up30-sub{ display:inline-block; font-size:12px; font-weight:800; color:#E0322C; margin-top:2px; }
    /* 比較表：おたからや列(2列目)のキャンペーン表記は控えめ表示（視線と誘導は1位まねきやへ） */
    .fv-tr-camp .fv-td:nth-child(2) .camp-badge{ background:#ECEEF0; color:#8A959C; box-shadow:none; font-weight:700; }
    .fv-tr-camp .fv-td:nth-child(2) .camp-badge-sparkle::after{ display:none; }
    .fv-tr-camp .fv-td:nth-child(2) .up30{ color:#6E7B85; font-size:12px; font-weight:700; }
    .fv-tr-camp .fv-td:nth-child(2) .up30 em{ color:#6E7B85; font-size:14px; }
    .fv-tr-camp .fv-td:nth-child(2) .up30-sub{ color:#9AA5AC; font-weight:600; }
    /* {campMonthLabel}キャンペーンバッジ（キラキラ） */
    .camp-badge-sparkle{ position:relative; overflow:hidden; background:linear-gradient(180deg,#FF6B5C,#E0322C); box-shadow:0 2px 6px rgba(224,50,44,.35); }
    .camp-badge-sparkle::after{ content:""; position:absolute; top:-30%; left:-70%; width:45%; height:160%; background:linear-gradient(100deg,transparent,rgba(255,255,255,.9),transparent); transform:skewX(-18deg); pointer-events:none; animation:bannerShine 2.4s ease-in-out infinite; }
    @media (prefers-reduced-motion:reduce){ .camp-badge-sparkle::after{ animation:none; display:none; } }

    /* 加筆コピー用：見やすいカード（見出し・箇条書き・強調） */
    .copy-hl{ color:#B45309; }
    .copy-card{ margin:12px 2px 18px; padding:14px 14px 12px; background:#FFFBF3; border:1px solid #F0DBB0; border-left:4px solid #E9B970; border-radius:10px; }
    .copy-card-lead{ margin:0 0 8px; font-size:16px; font-weight:800; line-height:1.6; color:#222; }
    .copy-card-list{ margin:0 0 8px; padding-left:1.3em; font-size:14.5px; line-height:1.7; color:#3a3a3a; }
    .copy-card-list li{ margin-bottom:4px; }
    .copy-card-list li:last-child{ margin-bottom:0; }
    .copy-card-list-tags{ list-style:none; padding-left:0; display:flex; flex-wrap:wrap; gap:6px; margin:2px 0 10px; }
    .copy-card-list-tags li{ margin:0; background:#fff; border:1px solid #E9B970; color:#7C4A03; font-weight:700; font-size:12.5px; padding:4px 10px; border-radius:999px; }
    .copy-card-note{ margin:0; font-size:14.5px; line-height:1.7; color:#3a3a3a; }
    .copy-card-note + .copy-card-note{ margin-top:6px; }

    /* 3ポイント：番号バッジ付き説明 */
    .point-note{ display:flex; gap:10px; align-items:flex-start; margin:12px 4px 20px; padding:12px 14px; background:#FFFBF3; border:1px solid #F0DBB0; border-radius:10px; }
    .point-note-num{ flex:0 0 auto; width:26px; height:26px; line-height:26px; text-align:center; border-radius:50%; background:#E0322C; color:#fff; font-weight:900; font-size:14px; }
    .point-note-body{ flex:1 1 auto; min-width:0; }
    .point-note-ttl{ display:block; font-size:14.5px; color:#B45309; margin-bottom:4px; }
    .point-note-body p{ margin:0; font-size:14.5px; line-height:1.75; color:#3a3a3a; }
    @media (max-width:480px){
      .copy-card-lead{ font-size:15.5px; }
      .point-note{ padding:11px 12px; gap:8px; }
    }

    /* なぜまねきや1位（30%UPバナー直下） */
    .why1{ margin:6px auto 4px; max-width:640px; padding:16px 16px 14px; background:linear-gradient(180deg,#FFFBF3,#FFF3DF); border:2px solid #E9B970; border-radius:14px; box-shadow:0 4px 14px rgba(224,50,44,.1); }
    .why1-lead{ margin:0 0 10px; font-size:15px; font-weight:800; color:#B71C1C; line-height:1.6; }
    .why1-body{ margin:0 0 10px; font-size:14px; line-height:1.8; color:#3a3a3a; }
    .why1-body:last-child{ margin-bottom:0; }
    .why1-body b{ font-weight:800; }
    /* 相見積もりセクションのCTA（比較=ランキングへスクロール） */
    .aimitsu-cta{ display:flex; align-items:center; justify-content:center; max-width:560px; margin:14px auto 0; }

    /* おたからやランキング末尾：まねきやキャンペーンCTA（スマホで強調） */
    .rank-camp-cta{ padding:14px 12px; background:linear-gradient(180deg,#FFF7EC,#FFE9CC); border:2px solid #E0322C; border-radius:14px; box-shadow:0 6px 16px rgba(224,50,44,.18); }
    .rank-camp-flag{ margin:0 0 6px; font-weight:900; color:#fff; background:linear-gradient(180deg,#FF6B5C,#E0322C); display:inline-block; padding:4px 14px; border-radius:999px; font-size:14px; letter-spacing:.02em; }
    .rank-camp-days{ margin:0; font-weight:900; color:#B71C1C; font-size:16px; line-height:1.5; }
    .rank-camp-days-num{ font-size:1.7em; margin:0 1px; }
    .rank-camp-days small{ display:block; font-weight:700; color:#555; font-size:13.5px; margin-top:2px; }
    @media (max-width:480px){
      .rank-camp-cta{ padding:18px 14px; }
      .rank-camp-flag{ font-size:15.5px; padding:5px 16px; }
      .rank-camp-days{ font-size:19px; }
      .rank-camp-days-num{ font-size:2.1em; }
    }
    /* 相場下：まねきや電話査定オファー */
    .rate-mk-offer{ margin-top:14px; }
    .rate-mk-txt{ font-size:13px; line-height:1.7; font-weight:700; color:var(--ink); margin:0 0 8px; text-align:center; text-wrap:balance; }
    /* 先頭行「【N月限定】まねきやなら…していただくと」を1行に収める */
    .rmk-l1{ display:inline-block; white-space:nowrap; font-size:clamp(10px,3vw,13px); }
    .rate-mk-link{ color:var(--gold-d); font-weight:900; text-decoration:underline; text-underline-offset:2px; }
    .rate-mk-cp{ color:#E0322C; font-weight:900; }
    /* 買取額30%UP＋手数料10%無料：ボタンではなくテキストで大きく強調＋アニメ */
    .rate-mk-up{ display:inline-block; position:relative; overflow:hidden; margin-top:2px; font-size:clamp(15px,4.7vw,19px); font-weight:900; line-height:1.55; color:#E0322C; background:linear-gradient(transparent 62%, #FFE08A 62%); padding:0 4px; }
    .rate-mk-up::after{ content:""; position:absolute; top:-30%; left:-72%; width:40%; height:170%; background:linear-gradient(100deg,transparent,rgba(255,255,255,.85),transparent); transform:skewX(-18deg); pointer-events:none; animation:bannerShine 2.6s ease-in-out infinite; }
    @keyframes rateUpPulse{ 0%,100%{ transform:scale(1); } 50%{ transform:scale(1.05); } }
    @media (prefers-reduced-motion:reduce){ .rate-mk-up::after{ animation:none; display:none; } }
    .rate-mk-offer .btn-phone{ width:100%; }
    .fv-tr-cta .fv-td,.fv-tr-cta .fv-td1{ padding:10px 6px; vertical-align:top; }
    .cta-sub{ display:block; font-size:10px; color:var(--sub); margin-bottom:5px; }
    .mt4{ margin-top:4px; }
    .countdown{ margin:6px 0 0; font-size:12px; color:var(--ink); line-height:1.4; }
    .countdown b{ font-size:15px; color:#E0322C; }

    /* セクション共通 */
    .sec{ padding:46px 0; }
    .sec-mint{ background:var(--mint); background-image:url("data:image/svg+xml,%3Csvg width='20' height='20' viewBox='0 0 20 20' xmlns='http://www.w3.org/2000/svg'%3E%3Ccircle cx='1' cy='1' r='1' fill='%230e7864' fill-opacity='.06'/%3E%3C/svg%3E"); }
    .sec-cream{ background:var(--cream); background-image:url("data:image/svg+xml,%3Csvg width='24' height='24' viewBox='0 0 24 24' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M0 12 L12 0 L24 12 L12 24 Z' fill='none' stroke='%23c8a000' stroke-opacity='.07' stroke-width='1'/%3E%3C/svg%3E"); }
    .sec-head{ text-align:center; margin-bottom:22px; }
    .chip{ display:inline-block; background:#fff; border:1px solid var(--line); color:var(--green-d); font-weight:900; font-size:12px; border-radius:999px; padding:5px 14px; }
    .sec-head h2{ font-size:24px; font-weight:900; margin:10px 0 6px; line-height:1.45; letter-spacing:.01em; }
    .sec-head p{ font-size:15px; color:var(--body); margin:0; }
    .note{ font-size:13px; color:var(--sub); line-height:1.6; margin:12px 0 0; }
    .note.note-basis{ font-size:12.5px; line-height:1.55; color:#8a959c; }

    /* 02 相場 */
    .rate-purity-note{ font-size:11px; color:var(--sub); line-height:1.6; margin:6px 0 0; }
    .rate-grid{ display:grid; grid-template-columns:1fr 1fr; gap:10px; }
    .rate-grid>div{ background:#fff; border:1px solid var(--line); border-radius:14px; padding:14px; text-align:center; box-shadow:0 4px 14px rgba(20,60,50,.05); }
    .rate-grid span{ display:block; font-size:13px; color:var(--sub); font-weight:700; }
    .rate-grid b{ font-size:22px; color:var(--ink); }
    .rate-grid small{ color:var(--sub); font-size:12px; }
    .rate-grid .rate-diff{ display:inline-block; margin-top:5px; font-size:11px; font-weight:900; padding:1px 8px; border-radius:999px; line-height:1.6; }
    .rate-diff.up{ background:#FDE7E7; color:#C0271F; }
    .rate-diff.down{ background:#E7EEFD; color:#2A5BD7; }
    .rate-hot{ border-color:var(--green) !important; background:#F2FBF8 !important; }
    .rate-hot b{ color:var(--green-d); }
    .rate-updated{ text-align:center; font-size:11px; color:var(--sub); margin:10px 0 0; }
    .rate-ex{ margin-top:20px; background:#F7FAF9; border-radius:16px; padding:18px; }
    .rate-ex h3{ font-size:15px; margin:0 0 10px; }
    .rate-ex ul{ list-style:none; margin:0; padding:0; }
    .rate-ex li{ display:flex; justify-content:space-between; align-items:center; padding:10px 0; border-top:1px dashed var(--line); font-size:14px; }
    .rate-ex li span{ color:var(--body); }
    .rate-ex li b{ color:var(--green-d); }
    /* ▼ 相場ヒーロー＆参考価格（見やすさ強化） */
    .rate-hero{ background:#fff; border:1px solid var(--line); border-radius:18px; padding:18px 16px 16px; box-shadow:0 8px 24px rgba(20,60,50,.08); }
    .rate-hero-ttl{ display:flex; align-items:center; flex-wrap:wrap; gap:8px; font-size:18px; font-weight:900; color:var(--green-d); margin:0 0 12px; }
    .rate-hero-badge{ font-size:11px; font-weight:900; background:#FFF1A6; color:#9A6B00; border-radius:999px; padding:2px 9px; }
    .rate-hero-main{ display:grid; grid-template-columns:1fr 1fr; gap:12px; }
    .rh-card{ background:#F7FAF9; border:1.5px solid var(--line); border-radius:14px; padding:14px 8px; text-align:center; }
    .rh-card.rh-hot{ background:linear-gradient(180deg,#FFF9E9,#FFF2CE); border-color:var(--gold); }
    .rh-label{ display:block; font-size:13px; font-weight:800; color:var(--sub); }
    .rh-price{ display:block; font-weight:900; color:var(--ink); line-height:1.1; margin:5px 0 2px; }
    .rh-num{ font-size:30px; letter-spacing:-.01em; }
    .rh-price small{ font-size:14px; font-weight:700; color:var(--sub); margin-left:1px; }
    .rh-card.rh-hot .rh-price{ color:var(--gold-d); }
    .rh-note{ display:block; font-size:11px; color:var(--sub); }
    .rh-card .rate-diff{ display:inline-block; margin-top:6px; font-size:11px; font-weight:900; padding:1px 8px; border-radius:999px; line-height:1.6; }
    .rate-more{ margin-top:12px; }
    .rate-more summary{ cursor:pointer; list-style:none; text-align:center; font-size:13px; font-weight:800; color:var(--green-d); background:#F2FBF8; border:1px solid var(--line); border-radius:10px; padding:9px; }
    .rate-more summary::after{ content:" ▾"; }
    .rate-more[open] summary::after{ content:" ▴"; }
    .rate-more summary::-webkit-details-marker{ display:none; }
    .rate-grid-mini{ display:grid; grid-template-columns:repeat(4,1fr); gap:8px; margin-top:10px; }
    .rate-grid-mini>div{ background:#fff; border:1px solid var(--line); border-radius:10px; padding:8px 3px; text-align:center; }
    .rate-grid-mini span{ display:block; font-size:11px; color:var(--sub); font-weight:700; }
    .rate-grid-mini b{ font-size:13.5px; color:var(--ink); }
    .rate-hero-date{ text-align:center; font-size:12.5px; color:var(--sub); margin:12px 0 0; }
    .rate-stale-note{ text-align:center; font-size:12px; font-weight:800; color:#B45309; background:#FFF7E4; border:1px solid #F0DFA8; border-radius:8px; padding:8px 10px; margin:8px 0 0; line-height:1.6; }
    .rate-stale-note a{ color:#B45309; text-decoration:underline; }
    .ref-price{ margin-top:18px; background:#fff; border:2px solid var(--gold); border-radius:18px; padding:16px; box-shadow:0 8px 22px rgba(217,150,42,.14); }
    .ref-ttl{ font-size:18px; font-weight:900; color:var(--ink); margin:0 0 12px; text-align:center; line-height:1.4; }
    .ref-ttl span{ display:block; font-size:12px; font-weight:700; color:var(--sub); margin-top:3px; }
    .ref-list{ list-style:none; margin:0; padding:0; }
    .ref-list li{ display:flex; justify-content:space-between; align-items:center; gap:10px; padding:12px 4px; border-top:1px dashed var(--line); }
    .ref-list li:first-child{ border-top:none; }
    .ref-item{ font-size:14.5px; font-weight:800; color:var(--ink); }
    .ref-item em{ font-style:normal; font-size:12px; font-weight:700; color:var(--sub); margin-left:6px; }
    .ref-list li b{ font-size:19px; font-weight:900; color:var(--green-d); white-space:nowrap; }
    /* ▲ */

    /* 03 高く売るポイント（画像） */
    .point-img{ display:block; width:100%; height:auto; font-size:0; line-height:0; border-radius:14px; overflow:hidden; box-shadow:0 8px 22px rgba(20,60,50,.1); }
    .point-img img{ width:100%; height:auto; display:block; }
    .point-cta{ margin-top:16px; }
    .point-cta-note{ text-align:center; font-size:12px; color:var(--sub); margin:8px 0 0; }


    /* まねきや口コミブロック（ランキング内） */
    .rk-voice-block{ background:var(--cream); border-radius:16px; padding:20px 18px 16px; margin-bottom:22px; }
    .rk-zisseki-notes{ margin:-4px 0 16px; }
    .rk-zisseki-notes p{ margin:3px 0 0; font-size:11px; line-height:1.55; color:var(--sub); }
    .rk-zisseki{ display:block; width:100%; height:auto; border-radius:14px; margin:0 0 18px; box-shadow:0 6px 18px rgba(20,60,50,.1); }
    .rk-zisseki-link{ display:block; }
    .rk-voice-ttl{ font-weight:900; font-size:14px; margin-bottom:14px; display:flex; align-items:center; gap:8px; }
    .rk-voice-list{ display:grid; gap:12px; }
    .voice-swipe{ display:none; }

    /* 05 ランキング */
    .rk{ background:#fff; border-radius:20px; padding:22px 18px 18px; margin-bottom:22px; box-shadow:0 8px 22px rgba(20,60,50,.07); position:relative; }
    .rk-1{ border:2px solid var(--gold); box-shadow:0 14px 32px rgba(217,150,42,.18); }
    .rk-ribbon{ position:absolute; top:-14px; left:16px; background:var(--sub); color:#fff; font-weight:900; font-size:13px; border-radius:999px; padding:5px 14px; display:flex; align-items:center; gap:4px; }
    .rk-ribbon i{ font-style:normal; }
    .rk-1 .rk-ribbon{ background:linear-gradient(135deg,#f6c64d,var(--gold-d)); color:#5a3d00; }
    .rk-2 .rk-ribbon{ background:#9AA7B0; }
    .rk-3 .rk-ribbon{ background:#C8A06A; }
    .rk-camp-img{ display:block; border-radius:12px; overflow:hidden; margin:14px 0; box-shadow:0 6px 16px rgba(183,28,22,.25); text-decoration:none; }
    .rk-camp-img img{ width:100%; height:auto; display:block; }
    .rk-head{ display:flex; align-items:center; gap:8px; margin-top:6px; }
    .rk-head h3{ font-size:22px; margin:0; }
    .rk-star{ color:var(--star); font-weight:900; font-size:14px; }
    .rk-head .pr{ margin-left:auto; }
    .rk-for{ font-size:16px; color:var(--green-d); font-weight:700; background:var(--mint); border-radius:8px; padding:7px 10px; margin:10px 0; }
    .rk-reasons{ list-style:none; margin:0 0 12px; padding:0; display:grid; gap:7px; }
    .rk-reasons li{ font-size:16.5px; padding-left:24px; position:relative; }
    .rk-reasons li::before{ content:"✓"; position:absolute; left:0; color:var(--green); font-weight:900; }
    .rk-meta{ display:grid; gap:8px; background:#F7FAF9; border-radius:12px; padding:14px; margin-bottom:14px; }
    .rk-meta div{ display:grid; grid-template-columns:92px 1fr; gap:8px; font-size:15px; }
    .rk-meta span{ color:var(--sub); }
    .rk-reviews{ display:grid; gap:7px; margin-bottom:6px; }
    .rk-reviews p{ font-size:12.5px; color:var(--body); background:#fff; border:1px solid var(--line); border-radius:10px; padding:8px 10px; margin:0; }
    .rk-reviews small{ display:block; color:var(--sub); margin-top:2px; }

    /* 06 深掘り */
    .deep{ display:grid; gap:14px; }
    .deep-merit{ list-style:none; margin:0; padding:0; display:grid; gap:8px; }
    .deep-merit li{ background:#fff; border:1px solid var(--line); border-radius:12px; padding:12px 14px; font-size:13.5px; }
    .flow{ background:#F7FAF9; border-radius:16px; padding:18px; }
    .flow h3{ font-size:15px; margin:0 0 12px; }
    .flow ol{ margin:0; padding:0; list-style:none; display:grid; gap:10px; counter-reset:f; }
    .flow li{ display:flex; align-items:baseline; gap:10px; font-size:13.5px; counter-increment:f; }
    .flow li::before{ content:counter(f); flex:0 0 26px; width:26px; height:26px; background:var(--green-d); color:#fff; border-radius:50%; display:grid; place-items:center; font-weight:900; font-size:13px; }
    .flow li b{ margin-right:4px; }
    .flow li span{ color:var(--body); }
    .flow-fee{ font-size:13px; background:var(--mint); border-radius:10px; padding:10px 12px; margin:12px 0 0; }

    /* 07 口コミ */
    .voice-list{ display:grid; gap:12px; }
    .voice-grid{ display:grid; gap:12px; }
    .voice{ background:#F7FAF9; border-radius:16px; padding:16px 18px; }
    .voice-lg{ border-left:4px solid var(--green); }
    .voice-ttl{ display:block; font-size:16px; color:var(--green-d); font-weight:900; margin:6px 0 4px; }
    .stars{ color:var(--star); font-size:14px; letter-spacing:1px; }
    .voice p{ font-size:16px; margin:6px 0; line-height:1.75; }
    .voice small{ color:var(--sub); font-weight:700; }

    /* 08 不安解消 */
    .fits{ background:#F2FBF8; border-radius:16px; padding:18px; margin-bottom:14px; }
    .fits-ttl{ font-size:15px; font-weight:900; color:var(--green-d); margin:0 0 12px; text-align:center; }
    .fits ul{ list-style:none; margin:0; padding:0; display:grid; grid-template-columns:1fr 1fr; gap:10px 12px; }
    .fits li{ font-size:13px; color:var(--ink); font-weight:700; display:flex; align-items:center; gap:8px; }
    .fits li svg{ flex-shrink:0; }
    .worry-grid{ display:grid; gap:10px; }
    .worry{ background:#F7FAF9; border-radius:14px; padding:16px 18px; }
    .worry h3{ font-size:15px; margin:0 0 5px; color:var(--green-d); }
    .worry h3::before{ content:"Q. "; }
    .worry p{ font-size:14px; color:var(--body); margin:0; }
    .worry p::before{ content:"A. "; font-weight:900; color:var(--ink); }

    /* 09 FAQ */
    .faq{ display:grid; gap:10px; }
    .faq details{ background:#fff; border:1px solid var(--line); border-radius:12px; overflow:hidden; }
    .faq summary{ list-style:none; cursor:pointer; padding:14px 40px 14px 16px; font-weight:700; font-size:15px; position:relative; }
    .faq summary::-webkit-details-marker{ display:none; }
    .faq summary::after{ content:"+"; position:absolute; right:16px; top:12px; font-size:20px; color:var(--green-d); }
    .faq details[open] summary::after{ content:"−"; }
    .faq p{ margin:0; padding:0 16px 14px; font-size:14px; color:var(--body); }

    /* 10 最終CTA */
    .final-banner{ display:block; position:relative; overflow:hidden; margin:14px 0 4px; border-radius:14px; box-shadow:0 8px 20px rgba(183,28,22,.28); text-decoration:none; animation:pokopoko 1.3s ease-in-out infinite; }
    .final-banner img{ width:100%; height:auto; display:block; }
    .final-banner::after{ content:""; position:absolute; top:-20%; left:-70%; width:45%; height:140%; background:linear-gradient(100deg,transparent,rgba(255,255,255,.6),transparent); transform:skewX(-18deg); pointer-events:none; animation:bannerShine 3s ease-in-out infinite; }
    @media (prefers-reduced-motion:reduce){ .final-banner{ animation:none; } .final-banner::after{ animation:none; display:none; } }
    .sec-final{ background:linear-gradient(180deg,#fff,var(--mint)); text-align:center; }
    .sec-final h2{ font-size:24px; font-weight:900; margin:0 0 8px; line-height:1.45; }
    .sec-final>.wrap>p{ font-size:14px; color:var(--body); margin:0 0 4px; }

    /* フッター */
    .ft{ background:#23303A; color:#cfd8de; padding:24px 0; }
    .ft-trust{ background:rgba(255,255,255,.06); border:1px solid rgba(255,255,255,.12); border-radius:12px; padding:14px 16px; margin:0 0 14px; }
    .ft-trust-ttl{ font-size:12px; font-weight:900; color:#e7eef2; margin:0 0 8px; }
    .ft-trust ul{ list-style:none; margin:0; padding:0; }
    .ft-trust li{ font-size:11.5px; line-height:1.7; color:#cfd8de; padding-left:14px; position:relative; }
    .ft-trust li::before{ content:"・"; position:absolute; left:0; }
    .ft-note{ font-size:11px; line-height:1.7; margin:0 0 12px; }
    .ft nav{ display:flex; flex-wrap:wrap; gap:14px; margin-bottom:10px; }
    .ft a{ color:#aeecdf; color:#a9d5cd; font-size:12px; }
    .ft small{ color:#7d8a92; font-size:11px; }

    /* スマホ下部固定 */
    .sticky{ position:fixed; left:0; right:0; bottom:0; z-index:60; display:grid; grid-template-columns:1.4fr 1fr; gap:8px; padding:8px 10px; background:rgba(255,255,255,.97); backdrop-filter:blur(6px); border-top:1px solid var(--line); }
    .sticky a{ text-decoration:none; font-weight:900; border-radius:999px; min-height:50px; display:flex; align-items:center; justify-content:center; gap:6px; font-size:14px; }
    .sticky i{ font-style:normal; }
    .sticky-phone{
      background:linear-gradient(180deg,#FF5A4D,#E01F1F); color:#fff;
      box-shadow:0 5px 0 #B0160F, 0 8px 14px rgba(224,31,31,.3);
      border:2px solid #ffd9d4; animation:pokopoko 1.1s ease-in-out infinite;
    }
    .sticky-phone i{ display:inline-flex; align-items:center; justify-content:center; width:26px; height:26px; border-radius:50%; background:#fff; color:#E0322C; font-size:14px; }
    .sticky-web{ background:var(--green-d); color:#fff; }
    .sticky-official{ grid-column:1 / -1; position:relative; overflow:hidden; flex-direction:column; gap:1px; padding:4px 10px; background:linear-gradient(180deg,#FF5A4D,#E01F1F); color:#fff; border:2px solid #ffd9d4; box-shadow:0 5px 0 #B0160F, 0 8px 14px rgba(224,31,31,.3); animation:pokopoko 1.1s ease-in-out infinite; }
    .sticky-official::after{ content:""; position:absolute; top:-30%; left:-65%; width:35%; height:160%; background:linear-gradient(100deg,transparent,rgba(255,255,255,.55),transparent); transform:skewX(-18deg); pointer-events:none; animation:bbCtaShine 3.2s ease-in-out infinite; }
    .sticky-cp{ display:inline-block; background:linear-gradient(180deg,#FFE9A8,#F2C14A); color:#7a2a00; font-size:10px; font-weight:900; line-height:1.4; border-radius:999px; padding:0 9px; box-shadow:0 1px 2px rgba(0,0,0,.18); }
    .sticky-main{ font-size:14.5px; font-weight:900; line-height:1.2; }
    @media (prefers-reduced-motion:reduce){ .sticky-official::after{ animation:none; display:none; } }

    @media (min-width:600px){
