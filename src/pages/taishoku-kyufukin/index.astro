    /* ▼▼ 潜在層向け追記ゾーン スタイル ▼▼ */
    /* --- 共通タイポ（ゾーン全体で統一） --- */
    #latent .latent-p{ font-size:14.5px; line-height:1.95; color:var(--ink); margin:0 0 12px; text-wrap:pretty; }
    #latent .latent-p:last-child{ margin-bottom:0; }
    #latent mark{ background:linear-gradient(transparent 58%, #FFE9A8 58%); color:inherit; font-weight:900; padding:0 1px; }
    #latent b{ font-weight:900; color:var(--ink); }
    /* 番号つき見出し（読み物の順番を明示＝回遊しやすく） */
    .lz-h3{ display:flex; align-items:center; gap:10px; font-size:clamp(17px,4.6vw,21px); font-weight:900; color:var(--ink);
      line-height:1.45; margin:38px 0 8px; padding-bottom:10px; border-bottom:2px solid var(--gold); text-wrap:balance; }
    .lz-num{ flex:0 0 auto; width:30px; height:30px; border-radius:8px; background:linear-gradient(180deg,#F6C64D,var(--gold-d));
      color:#5a3d00; font-size:13px; font-weight:900; display:grid; place-items:center; font-variant-numeric:tabular-nums; }
    .lz-lead{ font-size:14px; color:var(--body); line-height:1.85; margin:0 0 14px; text-wrap:pretty; }
    /* 補足ノート（各ブロックの締め） */
    .lz-note{ margin:12px 0 0; padding:12px 14px; background:#FFF7EC; border:1px solid #F2D9A8; border-radius:10px;
      font-size:13px; line-height:1.8; color:var(--body); }
    /* --- カードグリッド（きっかけ） --- */
    .lz-grid2{ display:grid; grid-template-columns:1fr; gap:10px; }
    @media (min-width:600px){ .lz-grid2{ grid-template-columns:repeat(2,1fr); } }
    .lz-card{ background:#fff; border:1px solid var(--line); border-radius:14px; padding:15px 16px; box-shadow:0 4px 12px rgba(30,40,50,.05); }
    .lz-card-t{ display:block; font-size:15.5px; color:var(--ink); line-height:1.4; margin-bottom:8px; }
    .lz-ic{ font-size:22px; line-height:1; margin-right:7px; vertical-align:-3px; }
    .lz-card p{ margin:0; font-size:13.5px; color:var(--body); line-height:1.8; }
    /* --- 番号つきチェック（見分け方・選び方） --- */
    .lz-check{ list-style:none; counter-reset:lzc; margin:0; padding:0; display:grid; gap:10px; }
    .lz-check li{ counter-increment:lzc; position:relative; background:#fff; border:1px solid var(--line);
      border-radius:12px; padding:14px 16px 14px 52px; box-shadow:0 4px 12px rgba(30,40,50,.05); }
    .lz-check li::before{ content:counter(lzc); position:absolute; left:14px; top:15px; width:24px; height:24px; border-radius:50%;
      background:var(--hot); color:#fff; font-weight:900; font-size:12.5px; display:grid; place-items:center; font-variant-numeric:tabular-nums; }
    .lz-check-green li::before{ background:var(--green-d); }
    .lz-check li > b{ display:block; font-size:15px; color:var(--ink); line-height:1.5; margin-bottom:5px; }
    .lz-check li > p{ margin:0; font-size:13.5px; color:var(--body); line-height:1.8; }
    /* --- 買取方法 3カード --- */
    .lz-grid3{ display:grid; grid-template-columns:1fr; gap:10px; }
    @media (min-width:720px){ .lz-grid3{ grid-template-columns:repeat(3,1fr); } }
    .lz-method{ background:#fff; border:1px solid var(--line); border-radius:14px; padding:16px; box-shadow:0 4px 12px rgba(30,40,50,.05); }
    .lz-method-t{ display:block; font-size:16px; color:var(--ink); margin-bottom:6px; }
    .lz-method-d{ margin:0 0 10px; font-size:13px; color:var(--body); line-height:1.75; }
    .lz-pm{ list-style:none; margin:0 0 10px; padding:0; display:grid; gap:5px; }
    .lz-pm li{ position:relative; padding-left:22px; font-size:13px; line-height:1.6; color:var(--ink); }
    .lz-pm li::before{ position:absolute; left:0; top:0; font-weight:900; }
    .lz-pm .pm-o::before{ content:"○"; color:var(--green); }
    .lz-pm .pm-x::before{ content:"△"; color:#C99A2E; }
    .lz-fit{ margin:0; padding:9px 11px; background:var(--mint); border-radius:9px; font-size:12.5px; line-height:1.6; color:var(--ink); }
    .lz-fit b{ color:var(--green-dd); margin-right:4px; }
    /* --- 心配ごと（既存worryを踏襲・長文対応） --- */
    .worry-grid-latent .worry p{ font-size:13.5px; line-height:1.8; }
    /* --- アコーディオン（基礎知識・各社くわしく） --- */
    .acc details{ background:#fff; border:1px solid var(--line); border-radius:12px; margin:0 0 10px; overflow:hidden; }
    .acc summary{ list-style:none; cursor:pointer; padding:14px 44px 14px 16px; font-weight:800; font-size:15px; color:var(--ink); position:relative; line-height:1.5; }
    .acc summary::-webkit-details-marker{ display:none; }
    .acc summary::after{ content:"＋"; position:absolute; right:16px; top:50%; transform:translateY(-50%); color:var(--green-d); font-weight:900; font-size:18px; }
    .acc details[open] summary::after{ content:"－"; }
    .acc details[open] summary{ border-bottom:1px solid var(--line); }
    .acc details > p{ margin:0; padding:14px 16px 16px; font-size:14px; line-height:1.95; color:var(--body); }
    .acc details > p b{ color:var(--ink); font-weight:900; }
    /* ▲▲ 潜在層向け追記ゾーン スタイルここまで ▲▲ */
  
    /* ================= 退職給付金LP 固有 ================= */
    .fv-kyufu{ padding:18px 0 26px; }
    .fvk-h1{ margin:0 0 16px; text-align:center; }
    .fvk-sub{ display:block; font-size:clamp(14px,4vw,17px); font-weight:800; color:var(--green-d); letter-spacing:.04em; margin-bottom:8px; }
    .fvk-lead{ display:block; font-size:clamp(19px,5.6vw,27px); font-weight:900; line-height:1.6; color:var(--ink); }
