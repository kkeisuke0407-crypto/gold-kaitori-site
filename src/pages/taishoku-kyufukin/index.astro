---
// 退職給付金LP（潜在層 / PPC向け）
// ------------------------------------------------------------------
// 構造の土台は src/pages/LP3/index.astro（1社訴求の縦長LP）。
// CSS・CTA計測・スクロール追従CTA・パラメータ転送はLP3から継承している。
//
// 【この記事の設計】
//   狙う層 : 傷病手当金という制度を「知らない」人（潜在層）
//   入口   : 金額でドカンと殴る → CTA → LINEの手順3枚 → CTA
//   下半分 : 教育と不安解消。競合比較はせず「自分でやる vs 頼む」の手段比較に絞る
//   着地   : 自分では無理だと分かる → 頼むという選択肢が残る
//
// 【法令まわり・外さないこと】
//   - 案件レギュレーション＝法令順守・虚偽表現NG。記事確認必須（3営業日）。
//   - 国民生活センターがこのジャンルに注意喚起を出している。
//     金額は必ず「条件を満たした場合の制度上の目安」と添える。
//     「誰でももらえる」「必ずもらえる」は書かない。
//   - 労働組合なので団体交渉は可。法律事務の代理は書かない（弁護士法72条）。
//
// 【TODO：広告主から受領後に差し替える】
//   - AFF_RELIEF … SLVRbulletの実アフィリリンク（現在プレースホルダ）
//   - /images/kyufu-line-01〜03.webp … LINEの入力手順スクショ3枚
//   - /images/og-kyufukin.webp … OGP画像
const PAGE_TITLE = "退職後にもらえるお金、失業保険だけじゃありません｜最大365万円の傷病手当金";
const PAGE_DESC  = "病気やケガで働けず退職する場合、失業保険とは別に傷病手当金を受け取れる制度があります。給与の約3分の2を通算1年6か月まで。条件・申請の流れ・自分でやるとつまずく9つのポイントを解説します。";
const CANONICAL  = "https://kaitori.hakobu-family.com/taishoku-kyufukin/";
const OGP_IMAGE  = "https://kaitori.hakobu-family.com/images/og-kyufukin.webp";

const today = new Date(new Date().toLocaleString('en-US', { timeZone: 'Asia/Tokyo' }));
const todayLabel = today.getFullYear() + "年" + (today.getMonth() + 1) + "月" + today.getDate() + "日";

const faqJsonLd = {
  "@context": "https://schema.org", "@type": "FAQPage",
  "mainEntity": [
    ["傷病手当金は、いくらもらえますか？", "給与のおよそ3分の2が目安です。正確には、支給開始日以前12か月の標準報酬月額の平均を30で割り、その3分の2が1日あたりの金額になります。支給される期間は通算して1年6か月までです。"],
    ["誰でも受け取れますか？", "いいえ。病気やケガで働けない状態にあることが前提で、医師の証明と保険者の審査が必要です。単に退職するだけでは対象になりません。"],
    ["退職後も受け取るための条件は？", "3つあります。退職日の前日まで健康保険の被保険者期間が継続して1年以上あること、退職日の時点で受け取っている、または受け取れる状態であること、退職日に働いていないこと。ひとつでも欠けると対象外です。"],
    ["傷病手当金と失業保険は、両方もらえますか？", "同時には受け取れません。先に傷病手当金を受け取り、働ける状態になってから失業保険に切り替えます。その際、失業保険の受給期間延長の手続きが必要です。"],
    ["うつ病や適応障害でも対象になりますか？", "病名で決まるものではなく、働けない状態にあると医師が証明できるかで判断されます。心の不調も対象になり得ます。"],
    ["パートやアルバイトでも受け取れますか？", "勤務先の健康保険に加入していれば対象になり得ます。国民健康保険には傷病手当金の制度がありません。"],
    ["自分で申請しても同じ金額ですか？", "はい。条件を満たしていれば、自分で申請しても受け取れる金額は変わりません。サポートを使う価値は、手続きの失敗を防ぐことと、退職日や受け取る順番を組み立てられることにあります。"],
    ["サポートを頼めば、必ず受け取れますか？", "いいえ。支給を決めるのは保険者です。どこに頼んでも受給を保証することはできません。"],
    ["在職中でも相談できますか？", "できます。退職日が決まる前のほうが、選べる手は多く残っています。"],
    ["どのくらいの期間、受け取れますか？", "傷病手当金は通算1年6か月までです。そのあと働ける状態になれば、失業保険に切り替えられる場合があります。"]
  ].map(([q, a]) => ({ "@type": "Question", "name": q, "acceptedAnswer": { "@type": "Answer", "text": a } }))
};

// ▼TODO：SLVRbulletの実アフィリリンクに差し替える
const AFF_RELIEF = "https://taishoku-relief.com/";
---
<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{PAGE_TITLE}</title>
  <meta name="description" content={PAGE_DESC} />
  <link rel="canonical" href={CANONICAL} />
  <meta property="og:type" content="article" />
  <meta property="og:title" content={PAGE_TITLE} />
  <meta property="og:description" content={PAGE_DESC} />
  <meta property="og:url" content={CANONICAL} />
  <meta property="og:image" content={OGP_IMAGE} />
  <meta property="og:locale" content="ja_JP" />
  <meta name="twitter:card" content="summary_large_image" />
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700;900&display=swap" onload="this.onload=null;this.rel='stylesheet'" />
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700;900&display=swap" /></noscript>
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-DMCWVLP3E3"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){ dataLayer.push(arguments); }
    gtag('js', new Date()); gtag('config', 'G-DMCWVLP3E3'); gtag('config', 'AW-18129603657');
  </script>
  <script is:inline>
    (function(c,l,a,r,i,t,y){ c[a]=c[a]||function(){ (c[a].q=c[a].q||[]).push(arguments); };
      t=l.createElement(r); t.async=1; t.src="https://www.clarity.ms/tag/"+i;
      y=l.getElementsByTagName(r)[0]; y.parentNode.insertBefore(t,y);
    })(window, document, "clarity", "script", "wxnujpnscp");
  </script>
</head>
<body data-landing-intent="taishoku_kyufukin" data-aff-relief={AFF_RELIEF}>

  <main>

    <!-- ============ 01 FV｜ドカンと結論だけ ============
         細かい計算はここでは出さない。数字1つと「知ってる？」だけで殴る。 -->
    <section class="fv fv-kyufu">
      <div class="wrap">
        <h1 class="fvk-h1">
          <span class="fvk-sub">知っていますか？</span>
          <span class="fvk-lead">退職後にもらえるお金は、<br><b>失業保険だけじゃありません。</b></span>
        </h1>

        <div class="fvk-amount">
          <span class="fvk-amount-cap">月収30万円の人なら</span>
          <span class="fvk-amount-main">最大<em>365</em>万円</span>
          <span class="fvk-amount-note">条件を満たした場合の、制度上の目安です</span>
        </div>

        <p class="fvk-copy">
          病気やケガで働けずに退職する場合、<b class="hl-green">失業保険とは別のお金</b>を受け取れる制度があります。<br>
          <b class="hl-red">申請した人だけ</b>が受け取れる仕組みで、会社から案内されることはほとんどありません。
        </p>

        <div class="fvk-cta">
          <a href="#" class="btn btn-phone full fvk-btn" data-aff="relief" data-track="fv_line" rel="nofollow sponsored">
            <i>💬</i>まずは対象か、LINEで確認する
          </a>
          <p class="fvk-cta-note">無料／1分で完了／9:00〜21:00 年中無休</p>
        </div>

        <div class="fv-datebadge">
          <span class="fv-db-tag"><i class="fv-db-dot"></i>最新版</span>
          <span class="fv-db-date">{todayLabel}</span>
        </div>
      </div>
    </section>

    <!-- ============ 02 LINEの手順（スクショ3枚）============
         「難しそう」を最初に潰す。行動のコストが低いことを見せてからCTAを重ねる。 -->
    <section class="sec sec-mint" id="step">
      <div class="wrap">
        <div class="sec-head">
          <h2>申し込みは、LINEで3ステップ</h2>
          <p>入力するのは、かんたんな質問への回答だけです。</p>
        </div>

        <ol class="lstep">
          <li class="lstep-item">
            <div class="lstep-head"><span class="lstep-num">STEP 1</span><b class="lstep-ttl">LINEで友だち追加</b></div>
            <img class="lstep-img" src="/images/kyufu-line-01.webp" alt="退職リリーフのLINE友だち追加画面" width="750" height="1334" loading="lazy" decoding="async" />
            <p class="lstep-txt">ボタンを押すとLINEが開きます。<b>登録に費用はかかりません。</b></p>
          </li>
          <li class="lstep-item">
            <div class="lstep-head"><span class="lstep-num">STEP 2</span><b class="lstep-ttl">質問に答える</b></div>
            <img class="lstep-img" src="/images/kyufu-line-02.webp" alt="退職リリーフのLINEで年齢・退職予定・健康保険の加入期間を回答する画面" width="750" height="1334" loading="lazy" decoding="async" />
            <p class="lstep-txt">年齢・退職の予定・健康保険に入っていた期間など。<b>選ぶだけで進みます。</b></p>
          </li>
          <li class="lstep-item">
            <div class="lstep-head"><span class="lstep-num">STEP 3</span><b class="lstep-ttl">結果が届く</b></div>
            <img class="lstep-img" src="/images/kyufu-line-03.webp" alt="退職リリーフのLINEで受給できる可能性と金額の目安が届いた画面" width="750" height="1334" loading="lazy" decoding="async" />
            <p class="lstep-txt">対象になりそうかと、<b class="hl-green">金額の目安</b>が返ってきます。<b>ここまで無料です。</b></p>
          </li>
        </ol>

        <div class="lstep-time"><i>⏱</i><p>ここまで<b>およそ1分</b>。<b class="hl-green">やりとりはLINEだけ</b>で完結します。</p></div>

        <a href="#" class="btn btn-phone full fvk-btn" data-aff="relief" data-track="step_line" rel="nofollow sponsored">
          <i>💬</i>LINEで無料相談をはじめる
        </a>
        <p class="point-cta-note">相談だけでもOK／申し込みの義務はありません</p>
      </div>
    </section>

    <!-- ============ 03 そもそも何のお金か ============ -->
    <section class="sec" id="what">
      <div class="wrap">
        <div class="sec-head"><h2>退職後に受け取れるお金は、1つじゃない</h2></div>

        <div class="kbox">
          <div class="kbox-item">
            <span class="kbox-tag">よく知られている</span>
            <b class="kbox-ttl">失業保険（基本手当）</b>
            <p>働ける状態で、就職活動をしている人が対象。<b>療養中は受け取れません。</b></p>
          </div>
          <div class="kbox-item kbox-item--main">
            <span class="kbox-tag kbox-tag--hot">知られていない</span>
            <b class="kbox-ttl">傷病手当金</b>
            <p>病気やケガで働けない人が対象。<b class="hl-green">給与のおよそ3分の2</b>を、<b class="hl-green">通算1年6か月まで</b>。退職後も条件を満たせば受け取り続けられます。</p>
          </div>
          <div class="kbox-item">
            <span class="kbox-tag">見落とされがち</span>
            <b class="kbox-ttl">再就職手当</b>
            <p>失業保険の受給中に早く再就職すると、残りの一部がまとめて支給されます。</p>
          </div>
        </div>

        <div class="point-note">
          <p>この3つは<b class="hl-u">受け取る順番が決まっています</b>。<br><br>
          療養中は傷病手当金、働ける状態になってから失業保険。<b class="hl-red">同時には受け取れません。</b><br>
          そして失業保険には<b class="hl-red">「受給期間の延長」という手続き</b>があり、これを出し忘れると、受け取れるはずだった分が消えます。<br><br>
          <b class="hl-green">順番を間違えなければ、受け取れる総額は大きく変わります。</b></p>
        </div>

        <div class="seido-add">
          <b class="seido-add-h">自己都合で辞めると、失業保険はすぐには出ません</b>
          <p>手続きのあと<b>7日間の待期</b>があり、そのうえで自己都合退職には<b class="hl-red">原則1か月の給付制限</b>がかかります。5年以内に2回以上、自己都合で給付制限を受けている場合は3か月になることがあります。</p>
          <p>つまり<b>辞めてすぐは、収入が途切れます。</b>ここを埋められるかどうかが、退職後のいちばん苦しい時期を左右します。</p>
          <p class="seido-src">出典：<a href="https://www.mhlw.go.jp/stf/seisakunitsuite/bunya/0000139508.html" target="_blank" rel="noopener noreferrer">厚生労働省 Q&amp;A（基本手当・再就職手当）</a></p>
        </div>
      </div>
    </section>

    <!-- ============ 04 なぜ知られていないのか ============ -->
    <section class="sec sec-cream" id="why">
      <div class="wrap">
        <div class="sec-head"><h2>なぜ、ほとんどの人が知らないのか</h2></div>

        <ul class="rzn">
          <li><b>会社は教えてくれない</b><span>案内する義務がありません。人事の担当者自身が知らないことも珍しくありません。</span></li>
          <li><b>役所は聞かれたことにしか答えない</b><span>窓口は制度の説明はしてくれますが、「あなたはどうすべきか」までは踏み込みません。</span></li>
          <li><b>申請した人だけが受け取れる</b><span>自動的に振り込まれる仕組みではありません。<b class="hl-red">知らなければ、そのまま終わります。</b></span></li>
        </ul>

        <div class="point-note">
          <p>制度そのものは、<b>何十年も前からあります</b>。<br>
          特別な裏技でも、抜け道でもありません。<br><br>
          <b class="hl-green">ただ、知っていて申請した人だけが受け取っている</b>——それだけの話です。</p>
        </div>

        <a href="#" class="camp2-cta" data-aff="relief" data-track="why_line" rel="nofollow sponsored">自分が対象か、LINEで聞いてみる</a>
        <p class="point-cta-note">無料／9:00〜21:00 年中無休</p>
      </div>
    </section>

    <!-- ============ 05 手段比較（競合比較ではない）============
         ※他社との比較はしない。「自分でやる vs 頼む」の2択に絞る。 -->
    <section class="sec" id="hikaku">
      <div class="wrap">
        <div class="sec-head"><h2>ひとりでやる？　伴走してもらう？</h2><p>費用はひとりでやるほうが安い。問題はそこではありません。</p></div>

        <div class="daikou-note">
          <p><b>先に、いちばん誤解されやすいところを。</b><br />
          給付金の<b class="hl-red">申請そのものは、どちらの場合も本人が行います。</b>サポートを使っても、代わりに申請してもらえるわけではありません。<br />
          変わるのは<b class="hl-green">「何を、いつ、どう出すか」を自分ひとりで判断するかどうか</b>です。</p>
        </div>

        <div class="fv-tbl-wrap">
          <table class="fv-tbl shudan-tbl">
            <thead>
              <tr>
                <th class="fv-th">　</th>
                <th class="fv-th">ひとりでやる</th>
                <th class="fv-th fv-th1 fv-th-gold">伴走してもらう</th>
              </tr>
            </thead>
            <tbody>
              <tr class="cmp-band"><td colspan="3">費用</td></tr>
              <tr>
                <td class="fv-td shudan-lbl">かかるお金</td>
                <td class="fv-td"><span class="mk good">◎</span>0円</td>
                <td class="fv-td fv-td1"><span class="mk tri">△</span>かかる<br /><small>相談は無料。<br />金額は下で解説</small></td>
              </tr>
              <tr class="cmp-band"><td colspan="3">判断のむずかしさ</td></tr>
              <tr>
                <td class="fv-td shudan-lbl">退職日の決め方</td>
                <td class="fv-td gray"><span class="mk bad">✕</span>誰も教えて<br />くれない</td>
                <td class="fv-td fv-td1"><span class="mk good">◎</span>決める前に<br />相談できる</td>
              </tr>
              <tr>
                <td class="fv-td shudan-lbl">受け取る順番</td>
                <td class="fv-td gray"><span class="mk bad">✕</span>自分で調べる</td>
                <td class="fv-td fv-td1"><span class="mk good">◎</span>一緒に<br />組み立てる</td>
              </tr>
              <tr>
                <td class="fv-td shudan-lbl">書類の準備</td>
                <td class="fv-td gray"><span class="mk bad">✕</span>何を書くかも<br />自分で調べる</td>
                <td class="fv-td fv-td1"><span class="mk good">◎</span>準備と進め方を<br />支援してもらえる</td>
              </tr>
              <tr>
                <td class="fv-td shudan-lbl">毎月の手続き</td>
                <td class="fv-td gray"><span class="mk bad">✕</span>体調が悪い日<br />も自分で判断</td>
                <td class="fv-td fv-td1"><span class="mk good">◎</span>受給後まで<br />相談できる</td>
              </tr>
              <tr class="cmp-band"><td colspan="3">失敗したとき</td></tr>
              <tr>
                <td class="fv-td shudan-lbl">出し忘れ・不備</td>
                <td class="fv-td gray"><span class="mk bad">✕</span><b class="hl-red">取り返せない<br />ことがある</b></td>
                <td class="fv-td fv-td1"><span class="mk good">◎</span>先回りで<br />防げる</td>
              </tr>
              <tr class="cmp-band"><td colspan="3">会社に言い出せないとき</td></tr>
              <tr>
                <td class="fv-td shudan-lbl">退職の意思表示</td>
                <td class="fv-td gray"><span class="mk bad">✕</span>自分で伝える</td>
                <td class="fv-td fv-td1"><span class="mk ok">〇</span>退職代行の<br />オプションあり<br /><small>給付金サポートとは別</small></td>
              </tr>
            </tbody>
          </table>
        </div>
        <p class="note">※ 一般的な比較です。サポート内容・費用は事業者により異なります。給付金の申請は本人が行うものであり、支給可否は保険者（ハローワーク・健康保険者）の審査によります。</p>
      </div>
    </section>

    <!-- ============ 06 自分でやると、どこでつまずくか ============
         この記事のいちばん厚いブロック。全部が事実で、読むと「無理だ」となる設計。 -->
    <section class="sec sec-cream" id="tsumazuki">
      <div class="wrap">
        <div class="sec-head">
          <h2>自分でやる場合、つまずくのはここです</h2>
          <p>費用0円は魅力です。ただ、実際に自分でやると全部これを判断することになります。</p>
        </div>

        <ol class="tsz">
          <li>
            <b class="tsz-ttl">退職日に出勤すると、受け取れなくなる</b>
            <p>退職後も受け取り続けるには「退職日に働いていないこと」が条件です。<b class="hl-red">あいさつのために半日出社しただけで、対象外になることがあります。</b>有給にあてるなら問題ありません。<br>これを知らずに退職日を迎えると、もう取り返せません。</p>
          </li>
          <li>
            <b class="tsz-ttl">健康保険の加入期間が「1年」あるかを数える</b>
            <p>退職日の前日まで、継続して1年以上必要です。転職して間もない人はここで引っかかります。<b class="hl-green">退職日を数日ずらすだけで条件を満たせることもあります</b>が、自分で気づけるかどうかです。</p>
          </li>
          <li>
            <b class="tsz-ttl">医師に「働けない状態」の証明を書いてもらう</b>
