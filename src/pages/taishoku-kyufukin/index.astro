    .camp-combined .cc-md{ font-size:13px; font-weight:900; line-height:1.3; color:#E0322C; }
    .camp-combined .cc-xl{ font-size:16px; font-weight:900; line-height:1.4; color:#E0322C; background:linear-gradient(transparent 52%,rgba(255,220,0,.35) 52%); padding:0 3px; }
