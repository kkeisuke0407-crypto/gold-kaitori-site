    .rk-voice-list > *{ flex:0 0 86%; scroll-snap-align:center; }
    .voice-swipe{ display:block; margin:8px 0 2px; text-align:center; font-size:13.5px; font-weight:700; color:#0e7864; }

    /* ============================================================
       PC最適化（≥768px）：モバイルは一切無影響。520px固定の本文を適正幅に。
       ============================================================ */
    @media (min-width:768px){
      .wrap{ max-width:780px; padding:0 24px; }
      .hd-in{ max-width:900px; }
      .sec{ padding:58px 0; }
      .fv-hero-wrap{ max-width:560px; margin:0 auto 16px; }
      .fv-datebadge{ max-width:560px; margin-left:auto; margin-right:auto; }
      .rate-grid{ grid-template-columns:repeat(4,1fr); }
