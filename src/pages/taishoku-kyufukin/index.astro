    .fvk-amount-cap{ font-size:clamp(12px,3.6vw,15px); font-weight:800; color:#8A5A12; }
    .fvk-amount-main{ font-size:clamp(28px,8.4vw,44px); font-weight:900; color:#B4400F; line-height:1.15; letter-spacing:-.01em; }
    .fvk-amount-main em{ font-style:normal; font-size:1.5em; margin:0 .04em; }
    .fvk-amount-note{ font-size:clamp(10px,2.9vw,12px); color:#8A6A3A; line-height:1.5; text-align:center; margin-top:4px; }

    .fvk-copy{ max-width:560px; margin:0 auto 18px; font-size:clamp(13.5px,3.9vw,16px); line-height:2; color:var(--body); text-align:center; }
    .fvk-cta{ max-width:520px; margin:0 auto; }
    .fvk-btn{ font-size:clamp(15px,4.4vw,19px)!important; padding:17px 14px!important; }
    .fvk-cta-note{ margin:8px 0 0; text-align:center; font-size:12.5px; color:var(--muted); font-weight:700; }

    /* LINE手順 */
    .lstep{ list-style:none; margin:0 0 14px; padding:0; display:grid; gap:14px; }
    @media(min-width:680px){ .lstep{ grid-template-columns:repeat(3,1fr); } }
    .lstep-item{ background:#fff; border:1px solid var(--line); border-radius:14px; padding:14px 12px 12px; }
    .lstep-head{ display:flex; align-items:center; gap:8px; margin-bottom:10px; }
    .lstep-num{ flex:none; font-size:11px; font-weight:900; color:#fff; background:var(--green-d); padding:3px 9px; border-radius:99px; letter-spacing:.04em; }
    .lstep-ttl{ font-size:15px; font-weight:900; color:var(--ink); line-height:1.4; }
    .lstep-img{ width:100%; max-width:230px; height:auto; display:block; margin:0 auto 10px; border-radius:10px; border:1px solid var(--line); background:#F7F7F7; }
    .lstep-txt{ margin:0; font-size:13px; line-height:1.85; color:var(--body); }
    .lstep-time{ display:flex; align-items:center; gap:10px; justify-content:center; margin:0 0 14px; padding:12px 14px;
      background:#EAF7EF; border:1.5px solid #A9D9BC; border-radius:12px; }
    .lstep-time i{ font-size:20px; font-style:normal; }
    .lstep-time p{ margin:0; font-size:14px; line-height:1.7; color:var(--ink); font-weight:700; }

    /* 3つのお金 */
    .kbox{ display:grid; gap:12px; margin:0 0 18px; }
    .kbox-item{ background:#fff; border:1px solid var(--line); border-radius:14px; padding:14px 14px 12px; }
    .kbox-item--main{ border:2px solid #E9B970; background:linear-gradient(180deg,#FFFDF7,#FFF6E9); }
    .kbox-tag{ display:inline-block; font-size:11px; font-weight:800; color:var(--muted); background:#F0F0F0; padding:3px 9px; border-radius:99px; margin-bottom:7px; }
    .kbox-tag--hot{ color:#fff; background:#B4400F; }
    .kbox-ttl{ display:block; font-size:17px; font-weight:900; color:var(--ink); margin-bottom:6px; }
    .kbox-item p{ margin:0; font-size:13.5px; line-height:1.9; color:var(--body); }

    /* 知られていない理由 */
    .rzn{ list-style:none; margin:0 0 16px; padding:0; display:grid; gap:10px; }
    .rzn li{ background:#fff; border:1px solid var(--line); border-left:4px solid var(--green-d); border-radius:10px; padding:13px 14px; }
    .rzn b{ display:block; font-size:15.5px; font-weight:900; color:var(--ink); margin-bottom:5px; }
    .rzn span{ display:block; font-size:13.5px; line-height:1.9; color:var(--body); }

    /* 手段比較表 */
    .shudan-tbl .shudan-lbl{ font-weight:800; font-size:13px; color:var(--ink); background:#FAFAFA; }
    .shudan-tbl .fv-td{ font-size:13.5px; }

    /* つまずきポイント */
    .tsz{ list-style:none; counter-reset:tsz; margin:0 0 18px; padding:0; display:grid; gap:12px; }
    .tsz li{ position:relative; counter-increment:tsz; background:#fff; border:1px solid var(--line); border-radius:12px; padding:15px 14px 13px 14px; }
    .tsz li::before{ content:counter(tsz); position:absolute; top:-9px; left:12px; width:26px; height:26px; display:grid; place-items:center;
      background:#B4400F; color:#fff; font-size:13px; font-weight:900; border-radius:50%; box-shadow:0 2px 5px rgba(0,0,0,.16); }
    .tsz-ttl{ display:block; font-size:16px; font-weight:900; color:var(--ink); line-height:1.55; margin:6px 0 7px; }
    .tsz li p{ margin:0; font-size:13.5px; line-height:2; color:var(--body); }
    .tsz-concl{ background:linear-gradient(180deg,#FFF6E9,#FFEAD0); border:2px solid #E9B970; border-radius:14px; padding:16px 15px; margin:0 0 16px; }
    .tsz-concl-lead{ margin:0 0 10px; font-size:clamp(16px,4.6vw,20px); font-weight:900; color:#B4400F; line-height:1.6; text-align:center; }
    .tsz-concl p{ margin:0 0 9px; font-size:14px; line-height:2; color:var(--ink); }
    .tsz-concl p:last-child{ margin-bottom:0; }

    /* 最終CTA */
    .final-lead{ margin:0 0 12px; text-align:center; font-size:clamp(17px,5vw,24px); font-weight:900; line-height:1.65; color:var(--ink); }
    .final-lead b{ color:var(--red); }
    .final-sub{ margin:0 0 18px; text-align:center; font-size:clamp(13px,3.8vw,15.5px); line-height:1.95; color:var(--body); }

    /* 申請代行に関する注意（誤解を先に潰す） */
    .daikou-note{ background:#FFF4F2; border:1.5px solid #E9A79A; border-left:5px solid #C0442C; border-radius:12px; padding:14px 15px; margin:0 0 16px; }
    .daikou-note p{ margin:0; font-size:14px; line-height:2; color:var(--ink); }

    /* できること／できないこと */
    .dekiru{ display:grid; gap:10px; margin:14px 0 4px; }
    @media(min-width:600px){ .dekiru{ grid-template-columns:1fr 1fr; } }
    .dekiru-col{ border-radius:12px; padding:13px 14px; }
    .dekiru-col--o{ background:#EAF7EF; border:1.5px solid #A9D9BC; }
    .dekiru-col--x{ background:#FAFAFA; border:1.5px solid #DCDCDC; }
    .dekiru-h{ display:block; font-size:14.5px; font-weight:900; margin-bottom:8px; color:var(--ink); }
    .dekiru-col--o .dekiru-h::before{ content:"○ "; color:var(--green-d); }
    .dekiru-col--x .dekiru-h::before{ content:"× "; color:#B4400F; }
    .dekiru-col ul{ margin:0; padding-left:1.15em; }
    .dekiru-col li{ font-size:13px; line-height:1.9; color:var(--body); margin-bottom:3px; }

    /* 給付制限の補足 */
    .seido-add{ background:#fff; border:1px solid var(--line); border-top:4px solid #C0442C; border-radius:12px; padding:15px 15px 12px; margin:16px 0 0; }
    .seido-add-h{ display:block; font-size:16px; font-weight:900; color:var(--ink); line-height:1.55; margin-bottom:9px; }
    .seido-add p{ margin:0 0 9px; font-size:13.5px; line-height:2; color:var(--body); }
    .seido-src{ font-size:11.5px!important; color:var(--muted)!important; margin-bottom:0!important; }
    .seido-src a{ color:var(--green-d); }

    /* 料金表（不安解消アコーディオン内） */
    .ryokin{ width:100%; border-collapse:collapse; margin:10px 0; font-size:13px; }
    .ryokin th{ width:42%; text-align:left; padding:9px 10px; background:#FAFAFA; border:1px solid var(--line); font-weight:800; color:var(--ink); line-height:1.5; }
    .ryokin td{ padding:9px 10px; border:1px solid var(--line); line-height:1.75; color:var(--body); }
    .ryokin td b{ color:#B4400F; font-weight:900; font-size:15px; }
    .ryokin td small{ color:var(--muted); font-size:11.5px; }
    .ryokin-note{ font-size:11.5px!important; color:var(--muted)!important; line-height:1.8; }
    .ryokin-note a{ color:var(--green-d); }
    .kiken{ margin:8px 0 10px; padding-left:1.15em; }
    .kiken li{ font-size:13px; line-height:1.95; color:var(--body); margin-bottom:4px; }

    /* セルフチェック */
    .chk-list{ list-style:none; margin:0 0 14px; padding:0; display:grid; gap:8px; }
    .chk-list li{ display:flex; align-items:flex-start; gap:10px; background:#fff; border:1px solid var(--line); border-radius:10px;
      padding:13px 14px; font-size:14.5px; line-height:1.75; font-weight:700; color:var(--ink); }
    .chk-box{ flex:none; width:22px; height:22px; display:grid; place-items:center; border-radius:6px;
      background:#EAF7EF; border:1.5px solid var(--green-d); color:var(--green-d); font-size:13px; font-weight:900; margin-top:1px; }
    .chk-concl{ background:linear-gradient(180deg,#FFF9EC,#FFEFD2); border:2px solid #E9B970; border-radius:14px; padding:15px; margin:0 0 16px; }
    .chk-concl p{ margin:0; font-size:14px; line-height:2; color:var(--ink); }

    /* 免責 */
    .kin-disc{ background:#FAFAFA; border:1px solid var(--line); border-radius:10px; padding:14px 14px 12px; }
    .kin-disc ul{ margin:0; padding-left:1.1em; }
    .kin-disc li{ font-size:11.5px; line-height:1.9; color:var(--muted); margin-bottom:6px; }
    .kin-disc a{ color:var(--green-d); }
  </style>

  <script>
    var AFF = { relief: document.body.getAttribute("data-aff-relief") };
    var KEEP = /^(utm_|gclid|gbraid|wbraid|gad_|campaignid|keyword|matchtype|device|network|creative)$/i;
    function track(name, params){
      try{ if(window.dataLayer) window.dataLayer.push({event:name, ...(params||{})});
        if(typeof gtag==="function") gtag("event", name, Object.assign({}, params||{}, { transport_type:"beacon" })); }catch(_){}
    }
    function affLink(raw){
      if(!raw || raw === "#") return "#";
      try{ var u=new URL(raw);
        new URLSearchParams(location.search).forEach(function(v,k){ if(KEEP.test(k)&&!u.searchParams.has(k)) u.searchParams.set(k,v); });
        return u.toString();
      }catch(_){ return raw; }
    }
    // アフィリンク注入＋計測（成果地点＝LINE追加。イベント名は金買取と分ける）
    document.querySelectorAll("[data-aff]").forEach(function(el){
      var key = el.getAttribute("data-aff");
      var url = affLink(AFF[key]);
      el.setAttribute("href", url);
      if(!url || url === "#"){ el.classList.add("aff-disabled"); el.setAttribute("aria-disabled","true"); }
      el.addEventListener("click", function(e){
        if(!url || url === "#"){ e.preventDefault(); return; }
        var tn = el.getAttribute("data-track") || "";
        var params = { affiliate_key:key, track_name:tn, cta_type:"line", landing_intent:"taishoku_kyufukin", link_url:url };
        var __plain = !e.metaKey && !e.ctrlKey && !e.shiftKey && !e.altKey && (e.button===0 || e.button===undefined);
        if(__plain && el.__ctaBusy){ e.preventDefault(); return; }
        var __cv = "taishoku_relief_line_click";
        if(window.dataLayer) window.dataLayer.push(Object.assign({event:__cv}, params));
        if(typeof gtag==="function") gtag("event", "taishoku_relief_cta_click", Object.assign({}, params, { send_to:"G-DMCWVLP3E3", transport_type:"beacon" }));
        if(!__plain){
          if(typeof gtag==="function") gtag("event", __cv, Object.assign({}, params, { transport_type:"beacon" }));
          return;
        }
        e.preventDefault();
        el.__ctaBusy = true; el.classList.add("cta-busy");
        var __go = function(){ if(el.__ctaGone) return; el.__ctaGone = true; window.location.href = url; };
        if(typeof gtag==="function"){
          gtag("event", __cv, Object.assign({}, params, { transport_type:"beacon", event_callback: __go }));
        }
        setTimeout(__go, 700);
      });
    });
    // スマホ下部固定CTA：FVを過ぎたら表示
    var sticky = document.querySelector("[data-sticky]");
    var fv = document.querySelector(".fv");
    if(sticky && fv && "IntersectionObserver" in window){
      new IntersectionObserver(function(es){ es.forEach(function(en){ sticky.hidden = en.isIntersecting; }); }, {threshold:0})
        .observe(fv);
    } else if(sticky){ sticky.hidden = false; }
    track("taishoku_kyufukin_open", { landing_intent:"taishoku_kyufukin" });
    track("taishoku_relief_landing_intent", { landing_intent:"taishoku_kyufukin" });
    // 全リンクへ着地URLのクエリを転送（タグ発火向上）
    window.addEventListener("load", function(){
      var search = window.location.search;
      if(!search) return;
      var incoming = new URLSearchParams(search);
      document.querySelectorAll("a[href]").forEach(function(a){
        var href = a.getAttribute("href");
        if(!href) return;
        var lower = href.toLowerCase();
        if(lower.charAt(0)==="#"||lower.startsWith("javascript")||lower.startsWith("mailto")||lower.startsWith("tel")) return;
        try{
          var u=new URL(href, window.location.href);
          incoming.forEach(function(v,k){ if(!u.searchParams.has(k)) u.searchParams.set(k,v); });
          a.setAttribute("href", u.toString());
        }catch(_){}
      });
    });
  </script>
