# ---------------------------------------------------------------- アプリ
APP_ENV=development

# SQLite の保存先。外部サービス不要で永続化される。
DATABASE_PATH=./data/ppc.db

# 管理APIの認証キー。未設定だと管理APIが認証なしで公開される（起動時に警告が出る）。
# 本番では必ず設定すること。
ADMIN_API_KEY=

# ブラウザからAPIを呼ぶ場合の許可オリジン（カンマ区切り）。
# 本番で未設定なら全て拒否する（設定漏れで全開放にしないため）。
# 例: https://kaitori.example.com,http://localhost:8000
CORS_ALLOW_ORIGINS=

# 公開エンドポイント（LPクリック計測）のレート制限
TRACKING_RATE_LIMIT_PER_MINUTE=120

# ---------------------------------------------------------------- AI
# 数式・撤退判定はAIに依存しないので、未設定でもツールは動く。
# AIが担うのはシードKW生成とKW意図分類だけ。
AI_PROVIDER=anthropic

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# ---------------------------------------------------------------- Google Ads
# 未設定でも管理画面のCSVエクスポート取り込みで運用できる。
# Developer Token は審査に時間がかかるので、先に申請だけ出しておくとよい。
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_CUSTOMER_ID=

# ---------------------------------------------------------------- SLVRbullet
# SLVRbullet が作成したコンバージョンアクションを分離集計する場合に指定
SLVRBULLET_CONVERSION_ACTION_RESOURCE=
